{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/auth/health?ping=1", "schedule": "0 5 * * *" }],
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/early-christian/", "destination": "/saints/", "permanent": true },
    { "source": "/early-christian", "destination": "/saints/", "permanent": true },
    { "source": "/early-christian/martin-of-tours/", "destination": "/saints/martin-of-tours/", "permanent": true },
    { "source": "/early-christian/martin-of-tours", "destination": "/saints/martin-of-tours/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(img|og|tex|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon.ico|apple-touch-icon.png|icon-48.png|icon-96.png|icon-192.png|icon-512.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
