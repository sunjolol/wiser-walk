---
/**
 * The one band the account pages share.
 *
 * Five pages of the sign-up flow wear the same picture, the same two-ink headline and the
 * same slot (no chip since 2026-09-22: the owner had every label chip taken off the site), so that going from "keep your results" to "check your email"
 * to "choose a password" reads as one movement rather than five screens that happen to be
 * on the same site. The two back-of-house pages (/account/ and /account/setup/) pass
 * `kind="night"` and get the dark starry ground instead, because they are not a doorway.
 *
 * THE ACTION GOES IN THE SLOT, INSIDE THE BAND. That is the whole reason this component
 * exists: the owner's rule is that the main button is never below the fold on a phone, and
 * a band that ends before the form puts it there. At 390 a two-line headline, a two-line
 * lede, a field and a 52px button come to about 350px of content.
 *
 * `heads` is for the one page that has more than one state. /account/password/ is reached
 * from an email, from a link that has expired and from nowhere at all, and each of those is
 * a real page with its own headline rather than a toast over the wrong one. Which head is
 * showing is decided by `data-acct` on <html>, set before first paint; the rules are in
 * account.css, so nothing here needs to know.
 */

export interface Head {
  /** The `data-acct` value this head belongs to. Omitted on a page with one state. */
  state?: string;
  /** The one head that shows when the script is blocked and no state was ever decided. */
  fallback?: boolean;
  /** The whole headline, including the phrase `accent` picks out of it. */
  title: string;
  /** One phrase, set in italic and the band's warm ink. Never more than one. */
  accent?: string;
  lede?: string;
}

export interface Props extends Partial<Head> {
  kind?: 'photo' | 'night';
  /** Several heads, one per page state. Given these, the single-head props are ignored. */
  heads?: Head[];
  /** The giant ghost word behind a night band. */
  ghost?: string;
}

const {
  kind = 'photo', heads, ghost,
  title = '', accent, lede
} = Astro.props;

const all: Head[] = heads ?? [{ title, accent, lede }];

/** before / the accented phrase / after, so the em is never guessed at by a regex. */
const split = (h: Head) => {
  if (!h.accent) return [h.title, '', ''];
  const at = h.title.indexOf(h.accent);
  if (at < 0) return [h.title, '', ''];
  return [h.title.slice(0, at), h.accent, h.title.slice(at + h.accent.length)];
};
---
<header class:list={['ac-band', kind === 'night' && 'ac-band--night dark']}>
  {kind === 'photo' && (
    <img
      class="ac-band-img"
      src="/img/account-threshold.jpg"
      alt="A lane at first light, a gate standing open in a stone wall beside a house among bare trees."
      width="1500"
      height="996"
      fetchpriority="high"
      decoding="async"
    />
  )}
  {kind === 'night' && ghost && <span class="dark-ghost" aria-hidden="true">{ghost}</span>}

  <div class="ac-band-in">
    {all.map(h => {
      const [before, em, after] = split(h);
      return (
        <div class:list={['ac-head', h.fallback && 'ac-head--fallback']} data-state={h.state}>
          <h1>{before}{em && <em>{em}</em>}{after}</h1>
          {h.lede && <p class="ac-lede">{h.lede}</p>}
        </div>
      );
    })}
    <slot />
  </div>
</header>
