---
/**
 * The site's line marks.
 *
 * Emoji are out: they render at a different size and weight in every font stack, they carry
 * a vendor's cartoon styling into a page that has none, and in the share card their varying
 * widths broke the very column alignment the audit's eleven-slot bar was specified to fix.
 *
 * These are drawn in the same language as the theme's bulb toggle — a 1.6 stroke, round
 * caps and joins, on a 24 grid — so a mark beside a quiz title reads as part of the page
 * rather than as something pasted onto it.
 *
 * There is deliberately no per-axis icon. Six little pictures beside six axis names would
 * be decoration standing in for information: the rails already carry the axis name, both
 * pole names and a colour that means something. A mark earns its place where it does real
 * work — telling two quizzes apart on the hub.
 */
interface Props {
  name:
    | 'compass' | 'flame' | 'scroll' | 'book' | 'arrow'
    | 'users' | 'sparkle' | 'mail' | 'pencil' | 'clock' | 'quote' | 'play' | 'path';
  size?: number;
  class?: string;
}

const { name, size = 20, class: cls = '' } = Astro.props;
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="8.4" />
      <path d="M15.1 8.9 13.5 13.5 8.9 15.1 10.5 10.5Z" />
      <path d="M12 2.6v1.5M12 19.9v1.5M2.6 12h1.5M19.9 12h1.5" />
    </>
  )}
  {name === 'flame' && (
    <>
      <path d="M12 2.8c2.6 3 3.9 5.3 3.9 7a3.9 3.9 0 0 1-7.8 0c0-1 .4-2 1.2-3" />
      <path d="M12 21.4c-2.4 0-4.3-1.7-4.3-4 0-2.6 2.4-3.8 4.3-7 1.9 3.2 4.3 4.4 4.3 7 0 2.3-1.9 4-4.3 4Z" />
    </>
  )}
  {name === 'scroll' && (
    <>
      <path d="M6.5 3.5h11a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-11" />
      <path d="M6.5 3.5a2 2 0 0 0-2 2v1.6h2" />
      <path d="M6.5 20.5a2 2 0 0 0 2-2V5.5a2 2 0 0 0-2-2" />
      <path d="M11 8.5h5M11 12h5M11 15.5h3" />
    </>
  )}
  {name === 'book' && (
    <>
      <path d="M4.5 4.6v13.2a1.8 1.8 0 0 0 1.8 1.8H19" />
      <path d="M6.3 4.6H19v15" />
      <path d="M4.5 4.6a1.8 1.8 0 0 1 1.8-1.8" />
      <path d="M9.5 8.6h6M9.5 12h6" />
    </>
  )}
  {name === 'arrow' && <path d="M4.5 12h14M13 6.5l5.5 5.5L13 17.5" />}
  {/*
    Added 2026-09-20. The owner asked for marks wherever a box would otherwise have to be read
    to be understood: a correction bar, a sign-up, a game, an article. Same 24 grid, same
    stroke, so they sit with the five above.
  */}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3.4" />
      <path d="M2.8 20v-1.2a4.6 4.6 0 0 1 4.6-4.6h3.2a4.6 4.6 0 0 1 4.6 4.6V20" />
      <path d="M16 4.9a3.4 3.4 0 0 1 0 6.3M18.4 14.5a4.6 4.6 0 0 1 2.8 4.3V20" />
    </>
  )}
  {name === 'sparkle' && (
    <>
      <path d="M11 3.5l1.9 5.1 5.1 1.9-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9Z" />
      <path d="M18.5 15.5v4M16.5 17.5h4M18.8 3.2v2.6M17.5 4.5h2.6" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5.2" width="18" height="13.6" rx="2.4" />
      <path d="m3.6 7.4 8.4 6 8.4-6" />
    </>
  )}
  {name === 'pencil' && (
    <>
      <path d="M16.6 3.9a2.05 2.05 0 0 1 2.9 2.9L8 18.3l-4 1.1 1.1-4Z" />
      <path d="M14.6 5.9l2.9 2.9M13 20h8" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.6" />
      <path d="M12 7.2V12l3.2 2" />
    </>
  )}
  {name === 'quote' && (
    <>
      <path d="M4 11.2c0-3.4 1.7-5.6 5-6.4M4 11.2h4.6v6.2H4Z" />
      <path d="M13.4 11.2c0-3.4 1.7-5.6 5-6.4M13.4 11.2H18v6.2h-4.6Z" />
    </>
  )}
  {name === 'play' && <path d="M7.5 4.8v14.4L19 12Z" />}
  {name === 'path' && (
    <>
      <path d="M9.5 21c0-4 5-4.6 5-8.4 0-3-4-3.4-4-6.2 0-1.5 1-2.6 2.4-3.4" />
      <circle cx="17.6" cy="5.2" r="1.7" />
      <path d="M4 21h16" />
    </>
  )}
</svg>
