---
/**
 * THE Theology Compass card: one look wherever the Compass is offered (the owner, 2026-09-22:
 * "literally everywhere it appears it should be standardized"). Since 2026-09-26 it wears the
 * picture the home rail's Compass room wears, Raphael's Disputa in colour (lib/art.ts
 * COMPASS_ART), with the title, the counted facts and Start, and no kicker and no sentence (the
 * owner: the card should look the same everywhere, without the "Six questions..." line). The
 * wheel stays on the Compass's own quiz page, where it explains the quiz.
 *
 * It lays itself out by its OWN width (a container query), not the window's: a tall picture card
 * with the words at its foot when narrow; from 40rem of card, the whole fresco wide with the words
 * on its darker left. Styles: .ccard in kit.css.
 */
import Icon from './Icon.astro';
import { getQuiz, quizHref } from '../lib/engine/registry';
import { COMPASS_ART, COMPASS_ART_WIDE } from '../lib/art';

export interface Props {
  /** h3 under a section head, h2 where the card is a section of its own. */
  level?: 2 | 3;
}
const compass = getQuiz('theology-compass')!;
const { level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---
<div class="ccard-wrap">
  <a class="ccard" href={quizHref(compass)}>
    <img class="ccard-img ccard-img--tall" src={COMPASS_ART.src} alt="" loading="lazy" decoding="async" width="970" height="792" style={`object-position:${COMPASS_ART.objectPosition}`} />
    <img class="ccard-img ccard-img--wide" src={COMPASS_ART_WIDE} alt="" loading="lazy" decoding="async" width="1544" height="772" />
    <div class="ccard-body">
      <Heading class="ccard-title">{compass.title}</Heading>
      <ul class="ccard-facts">
        <li><Icon name="clock" size={13} /> {compass.minutes} min</li>
        <li>{compass.items.length} statements</li>
      </ul>
      <span class="ccard-go go-pill">Start <Icon name="arrow" size={16} /></span>
    </div>
  </a>
</div>
