---
/**
 * "Compare this tradition with…", on a tradition's own page.
 *
 * A reader who has just read what Lutherans hold is one tap from the page that puts
 * Lutherans beside Catholics. The list is built from the comparison files that actually
 * exist — a tradition with none renders nothing at all, and nothing here is a hard-coded
 * list that could point at a page that was never written.
 *
 * Each row names the OTHER tradition and says how many of the six axes put the two in the
 * same audited band. "Same band on 4 of 6" is a statement about the instrument's own
 * categories; it is never a percentage, and it never says the two agree.
 */
import Icon from './Icon.astro';
import { compare } from '../lib/engine/registry';
import type { BipolarComparison } from '../lib/engine/compare';
import { COMPARE_QUIZ, comparisonsFor, compareHref, traditionOf } from '../lib/comparisons';

interface Props {
  /** The tradition this page is about, by its built slug. */
  slug: string;
}
const { slug } = Astro.props;

const rows = comparisonsFor(slug).map(c => {
  const cmp = compare(
    COMPARE_QUIZ,
    traditionOf(c.a).position ?? [],
    traditionOf(c.b).position ?? []
  ) as BipolarComparison;
  const mine = c.a === slug;
  return {
    href: compareHref(c.slug),
    /** The side this page is NOT, which is the thing a reader is choosing between. */
    other: mine ? c.labelB : c.labelA,
    self: mine ? c.labelA : c.labelB,
    same: cmp.sameCount,
    total: cmp.total
  };
});

/* The count opens a sentence, so it is a word ("Four pages", not "4 pages"). */
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
  'eleven', 'twelve'];
const word = WORDS[rows.length] ?? String(rows.length);
const pagesWord = word.charAt(0).toUpperCase() + word.slice(1);
---
{rows.length > 0 && (
  <section class="cmpb" aria-labelledby="cmpb-h">
    <div class="cmpb-say">
      <h2 id="cmpb-h">Side by side</h2>
      <p>
        {rows.length === 1
          ? 'One page puts this tradition next to another on the same six rails, with the differences written out.'
          : `${pagesWord} pages put this tradition next to another on the same six rails, with the differences written out.`}
      </p>
    </div>
    <div class="cmpb-rows">
      <ul class="cmpb-list">
        {rows.map(r => (
          <li>
            <a href={r.href}>
              {/* {' '} and not a literal space: JSX drops the whitespace between two elements
                  on separate lines, and the row shipped as "Lutheran vsCatholic". */}
              <span class="cmpb-pair">
                <span class="cmpb-vs">{r.self} vs</span>{' '}<span class="cmpb-other">{r.other}</span>
              </span>
              <span class="cmpb-same">Same band on {r.same} of {r.total}</span>
              <Icon name="arrow" size={14} />
            </a>
          </li>
        ))}
      </ul>
      <p class="cmpb-all"><a class="go-pill" href="/compare/">All comparisons <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>
)}

<style>
  .cmpb {
    position: relative; overflow: hidden;
    margin: 2rem 0 .5rem; padding: 1.5rem 1.3rem 1.3rem; border-radius: 24px;
    background: var(--panel); box-shadow: var(--lift);
  }
  .cmpb::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 5px;
    background-image: var(--grad-r);
  }
  .cmpb h2 {
    margin: 0; font-family: var(--display); font-weight: 400; font-style: italic;
    font-size: clamp(1.5rem, 5.6vw, 1.95rem); line-height: 1.1; color: var(--ink);
  }
  .cmpb-say p { margin: .5rem 0 1.1rem; max-width: 30rem; color: var(--ink-soft); text-wrap: pretty; }

  .cmpb-list { margin: 0; padding: 0; list-style: none; }
  .cmpb-list li { border-top: 1px solid var(--rule); }
  .cmpb-list a {
    display: grid; grid-template-columns: 1fr auto; align-items: center;
    gap: .15rem .7rem; min-height: 52px; padding: .65rem .1rem; text-decoration: none;
  }
  .cmpb-pair { grid-column: 1; min-width: 0; font-size: .98rem; line-height: 1.3; color: var(--ink); }
  .cmpb-vs { color: var(--ink-mute); }
  .cmpb-other { font-weight: 600; }
  .cmpb-same {
    grid-column: 1; font-family: var(--ui); font-size: .68rem; font-weight: 600;
    letter-spacing: .06em; color: var(--ink-mute);
  }
  .cmpb-list a :global(.icon) {
    grid-column: 2; grid-row: 1 / span 2; flex: none; color: var(--accent);
    transition: transform .18s ease;
  }
  .cmpb-list a:hover .cmpb-other { color: var(--accent); }
  .cmpb-list a:hover :global(.icon) { transform: translateX(3px); }

  /* the way to the rest: a real button at every width (.go-pill, kit.css), in the accent */
  .cmpb-all { margin: 1.1rem 0 0; }
  .cmpb-all a { color: var(--accent); }

  @media (min-width: 52rem) {
    .cmpb {
      display: grid; grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: 2.2rem; padding: 2rem 2.1rem 1.9rem; align-items: start;
    }
    .cmpb-say p { margin-bottom: 0; }
    .cmpb-all { margin-top: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cmpb-list a :global(.icon) { transition: none; } }
</style>
