</article>
{/* The picture viewer: a wide screen only (the owner, 2026-09-25: a phone or a tablet already shows
    each picture at full width). The browser's own dialog, as the site's other popups use. */}
<dialog class="artbox" id="artbox" aria-label="Picture">
  <button class="artbox-x" type="button" aria-label="Close" data-artbox-close>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <figure class="artbox-fig"><img id="artbox-img" alt="" /><figcaption id="artbox-cap"></figcaption></figure>
</dialog>
{import.meta.env.DEV && (
  /* Development only, compiled out of anything served, as EarlyMine's: ?mine=<code> makes this
     tab hold that early-Christian result, so the page can be captured as a reader who has one. */
  <script is:inline>
    try {
      var devMine = new URLSearchParams(location.search).get('mine');
      if (devMine === '0') sessionStorage.removeItem('ww:took:which-early-christian');
      else if (devMine) sessionStorage.setItem('ww:took:which-early-christian', devMine.toUpperCase());
    } catch (e) {}
  </script>
)}

<script>
  import { dayOf, mineFor, resultHref } from '../lib/mine';

  /*
   * The reader's own answers on "Where he stood", as the early Christians' pages have them
   * (components/EarlyMine.astro): found on this device only, never sent anywhere.
   */
  const box = document.querySelector<HTMLElement>('[data-st-mine]');
  if (box) {
    try {
      const d = box.dataset;
      const mine = mineFor(d.quiz ?? '', { radix: Number(d.radix), slots: Number(d.slots), prefix: d.prefix ?? '' });
      if (mine) {
        const WORD: Record<string, string> = { '2': 'Strongly agree', '1': 'Agree', '0': 'Not sure', '-1': 'Disagree', '-2': 'Strongly disagree' };
        const answers = mine.values.map(v => Math.max(0, Math.min(4, Math.round(v / 25))) - 2);
        document.querySelectorAll<HTMLElement>('[data-st-index]').forEach(card => {
          const a = answers[Number(card.dataset.stIndex)] ?? 0;
          const you = card.querySelector<HTMLElement>('.st-you');
          const word = card.querySelector('[data-you-word]');
          if (word) word.textContent = WORD[String(a)] ?? '';
          if (you) you.hidden = false;
          card.querySelectorAll('.st-scale i')[a + 2]?.classList.add('you');
        });
        const day = box.querySelector('[data-st-day]');
        if (day) day.textContent = dayOf(mine.at);
        const link = box.querySelector<HTMLAnchorElement>('[data-st-href]');
        if (link) link.href = resultHref(d.quiz ?? '', mine.code, { codePrefix: d.prefix ?? '', shortLinks: d.short !== undefined });
        box.hidden = false;
      }
    } catch {
      /* a page that cannot find the reader's answers is simply the page it always was */
    }
  }

  /*
   * THE PICTURE VIEWER, on a wide screen only: a click (or Enter) on a picture in the sheet opens it
   * whole, with its caption; the dialog's backdrop, its cross and Escape close it. On a phone or a
   * tablet the pictures stay plain pictures.
   */
  const artBox = document.getElementById('artbox') as HTMLDialogElement | null;
  const wideArt = matchMedia('(min-width: 62rem)');
  if (artBox && typeof artBox.showModal === 'function') {
    const big = document.getElementById('artbox-img') as HTMLImageElement;
    const cap = document.getElementById('artbox-cap')!;
    const arts = [...document.querySelectorAll<HTMLElement>('[data-art]')];
    const arm = () => arts.forEach(a => {
      if (wideArt.matches) { a.tabIndex = 0; a.setAttribute('role', 'button'); a.setAttribute('aria-label', 'Open the picture full size'); }
      else { a.removeAttribute('tabindex'); a.removeAttribute('role'); a.removeAttribute('aria-label'); }
    });
    const open = (a: HTMLElement) => {
      const img = a.querySelector('img')!;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      const fc = a.closest('figure')?.querySelector('figcaption');
      const text = fc ? [...fc.childNodes].filter(n => !(n instanceof HTMLElement && n.tagName === 'B')).map(n => n.textContent).join('').trim() : '';
      cap.textContent = text;
      cap.hidden = !text;
      artBox.showModal();
      document.documentElement.classList.add('is-locked');
    };
    arts.forEach(a => {
      a.addEventListener('click', () => { if (wideArt.matches) open(a); });
      a.addEventListener('keydown', e => { if (wideArt.matches && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(a); } });
    });
    artBox.addEventListener('close', () => document.documentElement.classList.remove('is-locked'));
    artBox.addEventListener('click', e => { if (e.target === artBox || (e.target as Element).closest('[data-artbox-close]') || e.target === artBox.querySelector('.artbox-fig')) artBox.close(); });
    arm();
    wideArt.addEventListener('change', arm);
  }

  /*
   * The pager: previous, the section you are in (tap it for every section), next. The mock-up's
   * own script (design/saints-hub/mockup/src/app.js), without the mock-up's views and toasts.
   * Without it the menu's links still jump to each section.
   */
  const nav = document.querySelector<HTMLElement>('[data-pager]');
  const menu = document.getElementById('pg-menu');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-pg-menu]');
  if (nav && menu && menuBtn) {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-pg-go]')];
    const secs = links.map(a => ({ id: a.dataset.pgGo!, name: a.textContent || '' }));
    const arrows = [...document.querySelectorAll<HTMLButtonElement>('[data-pg-dir]')];
    const label = nav.querySelector('.pg-t')!;
    let cur = -1;
    const closeMenu = () => {
      if (!menu.hidden) { menu.hidden = true; menuBtn.setAttribute('aria-expanded', 'false'); }
    };
    const update = () => {
      const y = nav.getBoundingClientRect().bottom + 24;
      let at = 0;
      secs.forEach((s, i) => {
        const el = document.getElementById(s.id);
        if (el && el.getBoundingClientRect().top <= y) at = i;
      });
      // At the very bottom the last sections may never reach the top; the last one is where you are.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) at = secs.length - 1;
      if (at === cur) return;
      cur = at;
      label.textContent = secs[at]!.name;
      arrows[0]!.disabled = at === 0;
      arrows[1]!.disabled = at === secs.length - 1;
      links.forEach((a, i) => {
        a.classList.toggle('is-here', i === at);
        if (i === at) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      });
    };
    const go = (id: string) => {
      const el = document.getElementById(id);
      if (!el) return;
      const off = nav.getBoundingClientRect().height + 18;
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - off, behavior: smooth ? 'smooth' : 'auto' });
      history.replaceState(null, '', '#' + id);
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; update(); });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    arrows.forEach(b => b.addEventListener('click', () => {
      const n = cur + Number(b.dataset.pgDir);
      if (n >= 0 && n < secs.length) go(secs[n]!.id);
    }));
    menuBtn.addEventListener('click', () => {
      menu.hidden = !menu.hidden;
      menuBtn.setAttribute('aria-expanded', String(!menu.hidden));
    });
    links.forEach(a => a.addEventListener('click', e => { e.preventDefault(); closeMenu(); go(a.dataset.pgGo!); }));
    document.addEventListener('click', e => { if (!(e.target as Element).closest('[data-pager]')) closeMenu(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
    update();
  }
</script>
