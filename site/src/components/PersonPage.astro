    {p.wec && (
      <a class="squiz squiz--engr" href={quizEarly}>
        <img src="/img/durer-jerome.jpg" alt="" loading="lazy" />
        <span class="squiz-b">
          <span class="squiz-k">Quiz</span>
          <span class="squiz-t">Which early Christian thinks like you?</span>
          <span class="squiz-s">And which would argue with you? See where you stand beside {p.short}.</span>
          <span class="go-pill">Start <Icon name="arrow" size={16} /></span>
        </span>
      </a>
    )}
    <a class="squiz squiz--mosaic" href={quizType}>
      <img src="/img/personality/mosaic.jpg" alt="" loading="lazy" />
      <span class="squiz-b">
        <span class="squiz-k">Quiz</span>
        <span class="squiz-t">Christian Personality Test</span>
        <span class="squiz-s">{type ? `${p.short} reads as ${type.name}${p.typeYoung ? ` as a young man` : ''}. Find your own type.` : 'Which of eight types are you? Find your own.'}</span>
        <span class="go-pill">Start <Icon name="arrow" size={16} /></span>
      </span>
    </a>
  </div>

  {p.kin?.length ? (
    <>
      <SectionHead id="kin" title={title('kin').toLowerCase()} />
      <div class:list={['kin', pairs(p.kin.length) && 'kin--pairs']}>
        {p.kin.map(k => {
          const href = hubHref(k.key);
          const Tag = href ? 'a' : 'div';
          return (
            <Tag class="panel kc" href={href ?? undefined} style={type ? `--type: ${type.ink}` : undefined}>
              <span class="kc-h"><img src={faceFor(k.key)} alt="" loading="lazy" /><span><span class="kc-n">{k.name}</span>{type && <span class="tchip" style={`--t: ${type.ink}`}>{type.name}</span>}</span></span>
              <p set:html={rich(k.text)} />
