            <Fragment set:html={rich(p.death.later.text)} />
            <span class="cite">{p.death.later.cite.url ? <a href={p.death.later.cite.url} target="_blank" rel="noopener" set:html={rich(p.death.later.cite.text)} /> : <Fragment set:html={rich(p.death.later.cite.text)} />}</span>
          </div>
        )}
        </div>
        )}
      </div>
