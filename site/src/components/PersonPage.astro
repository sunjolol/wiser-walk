  )}

  {after('prayer').map(x => <SaintExtra x={x} />)}
  {p.reads?.length ? (
    <>
      <SectionHead id="read" title="what to read first" />
      <div class="sreads">
        {p.reads.map(r => (
          <div class="panel sread">
            <h3>{r.title}</h3>
            <p class="by">{r.by}</p>
            <p set:html={rich(r.text)} />
            <a class="go-pill" href={r.url} target="_blank" rel="noopener">{r.label ?? 'Read it free'} <Icon name="arrow" size={16} /></a>
          </div>
        ))}
      </div>
    </>
  ) : null}

  {after('read').map(x => <SaintExtra x={x} />)}
  {hasRecord && (
    <>
      <SectionHead id="record" title={recordTitle!.toLowerCase()} />
      <slot name="record" />
    </>
  )}
  {!hasRecord && <SectionHead id="quizzes" title="take the quizzes" />}
  <div class:list={['squizzes', hasRecord && 'squizzes--in-record']} id={hasRecord ? 'quizzes' : undefined}>
    {extraQuiz && (
      <a class="squiz squiz--engr" href={extraQuiz.href}>
        <img src={extraQuiz.img} alt="" loading="lazy" />
        <span class="squiz-b">
          <span class="squiz-k">Quiz</span>
          <span class="squiz-t">{extraQuiz.title}</span>
