---
/**
 * A person's page, as data: the body of every saint page (/saints/<slug>/) and of a Bible figure
 * page that has its own data file (/figure/<slug>/). Taken whole out of pages/saints/[slug].astro
 * on 2026-09-26, when the owner asked for the Bible figure pages to become "a lightened version of
 * the saints pages": one template, so a rule the owner makes for one page holds for both kinds.
 * The route wraps it in Base with its own title, structured data and breadcrumbs.
 *
 * The template of the Saints hub. Each person is a data file, src/data/saints/<slug>.json, in
 * the shape lib/saints/types.ts documents; this file lays it out exactly as the mock-up the
 * owner approved on 2026-09-24 (design/saints-hub/mockup/, St Martin of Tours). His notes on
 * that mock-up bind every page (design/saints-hub/README.md, "Draft 2" and "Draft 3").
 *
 * Rules this page keeps:
 *
 * 1. **Every word about the person is the data's**, and every line in it is checked against its
 *    source before the file is added (design/saints-hub/tools/verify-quotes.mjs). This file
 *    arranges it and writes no claim of its own beyond a few joining words.
 * 2. **A section with nothing to fill it is left off the page and out of the pager.** Never
 *    faked, never padded.
 * 3. **"Where he stood" is the quiz's own checked data** (src/data/which-early-christian.json),
 *    drawn the way the mock-up drew it. A line on record but not shown says so.
 * 4. **Links that leave the site open in a new tab; links inside it never do.**
 * 5. **No number against a person.** The numbers are facts with sources; the type is labelled
 *    as our reading.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import SaintExtra from './SaintExtra.astro';
import wecData from '../data/which-early-christian.json';
import personality from '../data/personality.json';
import { SAINTS, TYPES, hubHref, faceFor, pron } from '../lib/saints/data';
import { rich, plain, monthShort, spell } from '../lib/saints/rich';
import { focusOf, typeHref } from '../lib/personality-art';
import type { Cite, SaintPage } from '../lib/saints/types';
import { whichEarlyChristian as wecQuiz } from '../lib/quizzes/which-early-christian';
import '../styles/pages/mine.css';
import '../styles/pages/saints.css';

interface Props {
  p: SaintPage;
  /** The link at the top of the band: the Saints hub, or the Bible people on it. */
  crumb: { href: string; label: string };
  /** A quiz card before the personality test's, for a page with a quiz of its own (a Bible figure). */
  extraQuiz?: { href: string; title: string; say: string; img: string };
  /**
   * A section the route supplies in the slot "record", placed before "Take the quizzes" and named
   * in the pager: a Bible figure's own quiz argument ("Where the quiz places him").
   */
  recordTitle?: string;
}
const { p, crumb, extraQuiz, recordTitle } = Astro.props;
const hasRecord = !!recordTitle && Astro.slots.has('record');
const { he, his, him } = pron(p.she);
const His = his.charAt(0).toUpperCase() + his.slice(1);
const He = he.charAt(0).toUpperCase() + he.slice(1);

/* ---- the quiz's cells, for "Where he stood" */
type Cell = { v: number; work: string; by: string | null; own?: boolean; line?: string; hide?: boolean };
const wec = wecData as unknown as {
  statements: Array<{ id: string; text: string; topic: string; slug: string }>;
  people: Record<string, { cells: Record<string, Cell> }>;
};
const cells = p.wec ? wec.people[p.wec]?.cells ?? {} : {};
/* Each with its place in the quiz, which is its place in a result code: the reader's own answer
   is found by it (below, "the reader's own answers"). */
const stances = wec.statements.map((s, index) => ({ s, index, c: cells[s.id]! })).filter(x => x.c);
const VERB: Record<string, string> = {
  '-2': `${p.short} strongly disagrees`, '-1': `${p.short} disagrees`, '1': `${p.short} agrees`, '2': `${p.short} strongly agrees`
};
/** "On record in the Dialogues." A title that starts with a preposition or a number reads without "the". */
const onRecord = (work: string) => `On record in ${/^(On |Against |To |Letter|Oration|Homil|Sermon \d)/.test(work) ? '' : 'the '}${work}. Not quoted here.`;

/* ---- the personality type */
const type = p.type ? TYPES[p.type] : undefined;
const disp = type ? (personality.DISPOSITIONS as Record<string, { word: string }>)[type.disposition] : undefined;
const makeup = type ? (personality.MAKEUPS as Record<string, { gregory: string }>)[type.makeup] : undefined;
const typeTag = type
  ? type.tagline.replace(/\byourself\b/g, `${him}self`).replace(/\byour\b/g, his).replace(/\byou\b/g, he)
  : '';
const typeArtCredit = type
  ? ((personality.CREDITS as Array<{ key: string; line: string }>).find(c => c.key === p.type)?.line ?? '').split('. Wikimedia')[0]
  : '';

/* ---- the sections, in order: the pager lists exactly the ones the page shows */
const moments = p.moments ?? [];
const SECTIONS = [
  ['who', `Who was ${p.short}?`, true],
  ['glance', 'At a glance', true],
  ['like', `What was ${he} like?`, !!p.traits?.length],
  ['said', `What others said of ${him}`, !!p.said?.quotes.length],
  ['life', `${His} life in ${spell(moments.length)} moments`, moments.length > 0],
  ['miracles', `${His} miracles`, !!p.miracles],
  ['words', `${His} words`, !!p.words],
  ['myths', 'Often misquoted', !!p.myths?.length],
  ['stood', `Where ${he} stood`, stances.length > 0],
  ['circle', 'Friends, family and rivals', !!p.circle?.length],
  ['death', p.death?.title ?? `How ${he} died`, !!p.death],
  ['saint', `Is ${he} a saint?`, true],
  ['prayer', p.prayer?.title ?? `A prayer ${he} wrote`, !!p.prayer],
  ['read', 'What to read first', !!p.reads?.length],
  ['record', recordTitle ?? '', hasRecord],
  /* On a Bible figure's page the quizzes sit inside "Where the quiz places him": one pager item, not
     two (the owner, 2026-09-25: "less dropdown menu clutter"). */
  ['quizzes', 'Take the quizzes', !hasRecord],
  ['kin', `People like ${him}`, !!p.kin?.length],
  ['sources', 'Sources', true]
].filter(([, , on]) => on) as Array<[string, string, boolean]>;
/* A section of his own goes in straight after the standard section it names. */
const extras = p.extras ?? [];
for (const x of [...extras].reverse()) {
  const i = SECTIONS.findIndex(s => s[0] === x.after);
  SECTIONS.splice(i < 0 ? SECTIONS.length - 3 : i + 1, 0, [x.id, x.title, true]);
}
const after = (id: string) => extras.filter(x => x.after === id);
const title = (id: string) => SECTIONS.find(s => s[0] === id)?.[1] ?? '';
/** A count that leaves one card alone in rows of three, but pairs off evenly: 4, 10, 16. */
const pairs = (n: number) => n > 3 && n % 3 === 1 && n % 2 === 0;
/* "Doubted from the start" (the miracles' doubt box). Where the wonders above it leave the last
   cell of their two-across grid empty, it takes that cell instead of a row of its own (the owner,
   2026-09-25, on Macrina's page); a phone reads it after the wonders either way. */
const doubtInGrid = !!p.miracles?.doubt && (p.miracles.more?.length ?? 0) % 2 === 1;
/* Friends, family and rivals: the people with a face (a page of their own on the site) come
   first, so the portraits sit together instead of scattered through the grid (the owner, on
   Clement's page, 2026-09-25). Otherwise the data's own order holds. */
const circle = [...(p.circle ?? [])].sort((a, b) => Number(!a.key) - Number(!b.key));

/* ---- links */
const out = (c: Cite) => c.url;
const quizEarly = '/q/which-early-christian/';
const quizType = '/q/personality/';

const pic = p.band.picture;
---
<article class="sp">
  <section class="sband sband--saint">
    <img class="sband-img" style={`--pos-m: ${p.band.posM}; --pos-d: ${p.band.posD}`} src={pic.src} alt={pic.alt}
         width={pic.width} height={pic.height} fetchpriority="high" />
    <div class="sband-in">
      <a class="crumb" href={crumb.href}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        {crumb.label}
      </a>
      <h1>{p.name}</h1>
      <p class="sband-meta">{p.band.dates} · {p.band.where}</p>
      {p.status && <p class="sband-status">{p.status}</p>}
      <p class="sband-lede" set:html={rich(p.band.lede)} />
      {/* A band picture the owner supplied without a credit to print (Macrina's icon) has none. */}
      {pic.credit && <p class="sband-credit">Picture: {pic.credit}</p>}
    </div>
  </section>

  {/* The pager: previous, the section you are in (tap it for every section), next. */}
  <nav class="spager" aria-label="On this page" data-pager>
    <button class="pg-arrow" type="button" data-pg-dir="-1" aria-label="Previous section" disabled>‹</button>
    <button class="pg-cur" type="button" data-pg-menu aria-expanded="false" aria-controls="pg-menu">
      <span class="pg-t">{SECTIONS[0]![1]}</span><span class="pg-caret" aria-hidden="true"></span>
    </button>
    <button class="pg-arrow" type="button" data-pg-dir="1" aria-label="Next section">›</button>
    <ol class="pg-menu" id="pg-menu" hidden>
      {SECTIONS.map(([id, name]) => <li><a href={`#${id}`} data-pg-go={id}>{name}</a></li>)}
    </ol>
  </nav>

  <section class="panel answer" id="who">
    <h2>{title('who')}</h2>
    <p set:html={rich(p.who)} />
  </section>

  {/* AT A GLANCE: the sheet */}
  {after('who').map(x => <SaintExtra x={x} />)}
  <SectionHead id="glance" title="at a glance" />
  <div class="cs">
    {p.roles?.length ? (
      /* "path", not "roles": the owner, 2026-09-25, on Justin's page ("calling 'Martyr' a role
         is odd"). The data keeps the name `roles`. */
      <section class="cs-path panel" aria-label={`${His} path, in order`}>
        <div class="path-in">
          <p class="path-k">{His} path, in order</p>
          <ol class="path">
            {p.roles.map(r => <li><b>{r.name}</b><span set:html={rich(r.line)} /></li>)}
          </ol>
        </div>
      </section>
    ) : null}

    {p.numbers?.length || p.tidbits?.length ? (
      <section class="cs-stats dark" aria-label={p.numbers?.length ? `${p.short} in numbers` : 'Did you know?'}>
        {p.numbers?.length ? (
          <>
            <p class="cs-stats-t">in numbers</p>
            <ul class="stats">
              {p.numbers.map(n => (
                <li class="stat">
                  <span class="stat-chip">{n.chip}</span><b class="stat-n">{n.n}</b>
                  <ul class="stat-lines">{n.lines.map(l => <li set:html={rich(l)} />)}</ul>
                  <span class="stat-src">{n.src}</span>
                </li>
              ))}
            </ul>
          </>
        ) : null}
        {/* DID YOU KNOW? Short facts worth telling that are not numbers, under the numbers in the
            same dark column (the owner, 2026-09-25, on Irenaeus's page: fill the space "without
            forcing numbers where they don't belong"). */}
        {p.tidbits?.length ? (
          <div class="tids">
            <p class="cs-stats-t">did you know?</p>
            <ul class="tid-list">
              {p.tidbits.map(t => (
                <li class="tid">
                  <p set:html={rich(t.text)} />
                  <span class="cite">{t.cite.url ? <a href={t.cite.url} target="_blank" rel="noopener" set:html={rich(t.cite.text)} /> : <Fragment set:html={rich(t.cite.text)} />}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </section>
    ) : null}

    <section class="cs-main panel" aria-label="Quick facts">
      <dl class="sfacts">
        {p.facts.map(f => <div><dt>{f.label}</dt><dd set:html={rich(f.text)} /></div>)}
      </dl>
    </section>

    {(p.portrait || type || p.gallery?.length) && (
      <div class="cs-side">
        {p.portrait && (
          <figure class="panel portrait">
            <span class="art" data-art><img src={p.portrait.src} alt={p.portrait.alt} width={p.portrait.width} height={p.portrait.height} loading="lazy" /></span>
            <figcaption><b>In art</b><Fragment set:html={rich(p.portrait.caption)} /></figcaption>
          </figure>
        )}
        {/* MORE OF HIM IN ART, on a wide screen only, where the facts beside this column leave it
            room (the owner, 2026-09-25: fill the empty space on the right with more art of him;
            phones keep the one picture). Each page carries only as many as fit without making the
            sheet taller. */}
        {p.gallery?.map(g => (
          <figure class="panel portrait portrait--more">
            <span class="art" data-art><img src={g.src} alt={g.alt} width={g.width} height={g.height} loading="lazy" /></span>
            <figcaption><Fragment set:html={rich(g.caption)} /></figcaption>
          </figure>
        ))}
        {type && p.type && (
          <section class="panel temper" aria-label={`${His} personality type`} style={`--type: ${type.ink}`}>
            <div class="temper-pic">
              <img src={`/img/personality/art/${p.type}.jpg`} alt={typeArtCredit} loading="lazy" style={`object-position: ${focusOf(p.type)}`} />
              <span>{type.name}</span>
            </div>
            <div class="temper-b">
              <p class="temper-k">{His} personality type</p>
              <p class="temper-tag">{typeTag}</p>
              {disp && makeup && (
                <>
                  <p class="gchips-k">In Gregory the Great's terms</p>
                  <ul class="gchips"><li>{disp.word}</li><li>{makeup.gregory.charAt(0).toUpperCase() + makeup.gregory.slice(1)} mind</li></ul>
                </>
              )}
              <p>
                Our reading{p.typeYoung ? ` of ${him} as a young man` : ''}, from the <a href={quizType}>Christian Personality Test</a>.
                {p.typeNote && <Fragment set:html={' ' + rich(p.typeNote)} />}
              </p>
              <a class="go-pill" href={typeHref(p.type)}>See {type.name} <Icon name="arrow" size={16} /></a>
            </div>
          </section>
        )}
      </div>
    )}

    {p.feasts && (p.feasts.west.length || p.feasts.east.length) ? (
      <section class:list={['panel cs-feasts', !(p.feasts.west.length && p.feasts.east.length) && 'cs-feasts--one', Math.max(p.feasts.west.length, p.feasts.east.length) >= 4 && 'cs-feasts--stack']} aria-label="Feast days"
               style={p.feasts.west.length && p.feasts.east.length ? `--feast-cols: minmax(0, ${Math.min(p.feasts.west.length, 3)}fr) minmax(0, ${Math.min(p.feasts.east.length, 3)}fr)` : undefined}>
        <div class="feasts-h"><h3>feast days</h3>{p.feasts.west.length && p.feasts.east.length ? <p>East and West, side by side</p> : null}</div>
        <div class="feast-cols">
          {([['West', p.feasts.west], ['East', p.feasts.east]] as const).filter(([, list]) => list.length).map(([side, list]) => (
            <div class="feast-col">
              <h4>{side}</h4>
              <ul>
                {list.map(f => (
                  <li class="feast">
                    <span class="leaf"><span class="leaf-m">{monthShort(f.month)}</span><b class="leaf-d">{f.day}</b></span>
                    <p set:html={rich(f.text)} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {p.feasts.note && <p class="feast-note" set:html={rich(p.feasts.note)} />}
      </section>
    ) : null}
  </div>

  {after('glance').map(x => <SaintExtra x={x} />)}
  {p.traits?.length ? (
    <>
      <SectionHead id="like" title={title('like').toLowerCase()} />
      <section class="panel traits">
        <div class="traits-tab" aria-hidden="true">{His} character</div>
        <div class="traits-list">
          {p.traits.map(t => (
            <div class="trait">
              <h3><i>+</i>{t.title}</h3>
              <p set:html={rich(t.text)} />
              <span class="cite">{out(t.cite) ? <a href={t.cite.url} target="_blank" rel="noopener" set:html={rich(t.cite.text)} /> : <Fragment set:html={rich(t.cite.text)} />}</span>
            </div>
          ))}
        </div>
      </section>
    </>
  ) : null}

  {after('like').map(x => <SaintExtra x={x} />)}
  {p.said?.quotes.length ? (
    <>
      <SectionHead id="said" title={title('said').toLowerCase()} />
      {p.said.lede && <p class="sect-lede" set:html={rich(p.said.lede)} />}
      <div class:list={['said', p.said.quotes.length === 2 && 'said--two', p.said.quotes.length === 1 && 'said--one', pairs(p.said.quotes.length) && 'said--pairs']}>
        {p.said.quotes.map(q => (
          <figure class="panel qc">
            <blockquote>{q.q}</blockquote>
            <figcaption class="who"><Fragment set:html={rich(q.who)} /><span class="cite">{q.cite.url ? <a href={q.cite.url} target="_blank" rel="noopener" set:html={rich(q.cite.text)} /> : <Fragment set:html={rich(q.cite.text)} />}</span></figcaption>
          </figure>
        ))}
      </div>
    </>
  ) : null}

  {after('said').map(x => <SaintExtra x={x} />)}
  {moments.length ? (
    <>
      <SectionHead id="life" title={title('life').toLowerCase()} />
      <ol class="smoments">
        {moments.map(m => (
          <li class="mo"><div class="panel">
            <div class="mo-h"><p class="mo-place">{m.place}</p><span class="mo-when">{m.when}</span></div>
            <h3 set:html={rich(m.title)} />
            <p set:html={rich(m.text)} />
            <span class="cite">{m.cite.url ? <a href={m.cite.url} target="_blank" rel="noopener" set:html={rich(m.cite.text)} /> : <Fragment set:html={rich(m.cite.text)} />}</span>
          </div></li>
        ))}
      </ol>
    </>
  ) : null}

  {after('life').map(x => <SaintExtra x={x} />)}
  {p.miracles && (
    <>
      <SectionHead id="miracles" title={title('miracles').toLowerCase()} />
      <div class="mir">
        <p class="sect-lede" set:html={rich(p.miracles.lede)} />
        {p.miracles.pledge && (
          <figure class="spledge"><blockquote>{p.miracles.pledge.q}</blockquote>
            <figcaption class="cite">{p.miracles.pledge.cite.url ? <a href={p.miracles.pledge.cite.url} target="_blank" rel="noopener" set:html={rich(p.miracles.pledge.cite.text)} /> : <Fragment set:html={rich(p.miracles.pledge.cite.text)} />}</figcaption>
          </figure>
        )}
        {p.miracles.feature && (
          <section class="dark raised" aria-labelledby="raised-h">
            <div class="raised-h"><b class="raised-n" aria-hidden="true">{p.miracles.feature.n}</b><h3 id="raised-h"><span class="sr-only">{p.miracles.feature.n} </span>{p.miracles.feature.title}</h3></div>
            <ol class:list={['raised-list', p.miracles.feature.items.length !== 3 && `raised-list--${Math.min(p.miracles.feature.items.length, 4)}`]}>
              {p.miracles.feature.items.map(r => (
                <li class="rz">
                  <div class="rz-h"><p class="rz-place">{r.place}</p><span class="rz-when">{r.when}</span></div>
                  <h4>{r.title}</h4>
                  <p set:html={rich(r.text)} />
                  <blockquote>“{r.quote}”</blockquote>
                  {r.witness && <p class="rz-who" set:html={rich(r.witness)} />}
                  <span class="cite">{r.cite.url ? <a href={r.cite.url} target="_blank" rel="noopener" set:html={rich(r.cite.text)} /> : <Fragment set:html={rich(r.cite.text)} />}</span>
                </li>
              ))}
            </ol>
            {p.miracles.feature.note && (
              <p class="raised-note"><Fragment set:html={rich(p.miracles.feature.note.text) + ' '} /><span class="cite">{p.miracles.feature.note.cite.url ? <a href={p.miracles.feature.note.cite.url} target="_blank" rel="noopener" set:html={rich(p.miracles.feature.note.cite.text)} /> : <Fragment set:html={rich(p.miracles.feature.note.cite.text)} />}</span></p>
            )}
          </section>
        )}
        {p.miracles.more?.length ? (
          <div class="wonders">
            {p.miracles.more.map(w => (
              <div class="panel wonder">
                <h3>{w.title}</h3>
                <p set:html={rich(w.text)} />
                <blockquote>“{w.quote}”</blockquote>
                <span class="cite">{w.cite.url ? <a href={w.cite.url} target="_blank" rel="noopener" set:html={rich(w.cite.text)} /> : <Fragment set:html={rich(w.cite.text)} />}</span>
              </div>
            ))}
            {doubtInGrid && p.miracles.doubt && (
          <div class:list={['later doubt', doubtInGrid && 'doubt--cell']}>
            <b>{p.miracles.doubt.title}</b>
            <Fragment set:html={rich(p.miracles.doubt.text)} />
            <span class="cite">{p.miracles.doubt.cites.map((c, i) => (
              <>{i > 0 && '; '}{c.url ? <a href={c.url} target="_blank" rel="noopener" set:html={rich(c.text)} /> : <Fragment set:html={rich(c.text)} />}</>
            ))}</span>
          </div>
            )}
          </div>
        ) : null}
        {p.miracles.doubt && !doubtInGrid && (
          <div class:list={['later doubt', doubtInGrid && 'doubt--cell']}>
            <b>{p.miracles.doubt.title}</b>
            <Fragment set:html={rich(p.miracles.doubt.text)} />
            <span class="cite">{p.miracles.doubt.cites.map((c, i) => (
              <>{i > 0 && '; '}{c.url ? <a href={c.url} target="_blank" rel="noopener" set:html={rich(c.text)} /> : <Fragment set:html={rich(c.text)} />}</>
            ))}</span>
          </div>
        )}
      </div>
    </>
  )}

  {after('miracles').map(x => <SaintExtra x={x} />)}
  {p.words && (
    <>
      <SectionHead id="words" title={title('words').toLowerCase()} />
      {p.words.note && <p class="frame-note" set:html={rich(p.words.note)} />}
      <div class="words">
        {p.words.feature && (
          <figure class="dark qf">
            <span class="qf-ghost" aria-hidden="true">“</span>
            {p.words.feature.ghost && <span class="qf-word" aria-hidden="true">{p.words.feature.ghost}</span>}
            <p class="qf-k">{p.words.feature.kicker}</p>
            <blockquote>{p.words.feature.q}</blockquote>
            <figcaption>
              {p.words.feature.ctx && <p class="ctx" set:html={rich(p.words.feature.ctx)} />}
              <span class="cite">{p.words.feature.cite.url ? <a href={p.words.feature.cite.url} target="_blank" rel="noopener" set:html={rich(p.words.feature.cite.text)} /> : <Fragment set:html={rich(p.words.feature.cite.text)} />}</span>
            </figcaption>
          </figure>
        )}
        {p.words.quotes.length ? (
          <div class="words-grid">
            {p.words.quotes.map(q => (
              <figure class="panel qc">
                <blockquote>{q.q}</blockquote>
                <figcaption class="who"><Fragment set:html={rich(q.who)} /><span class="cite">{q.cite.url ? <a href={q.cite.url} target="_blank" rel="noopener" set:html={rich(q.cite.text)} /> : <Fragment set:html={rich(q.cite.text)} />}</span></figcaption>
              </figure>
            ))}
          </div>
        ) : null}
      </div>
    </>
  )}

  {after('words').map(x => <SaintExtra x={x} />)}
  {p.myths?.length ? (
    <>
      <SectionHead id="myths" title="often misquoted" />
      <div class="myths">
        {p.myths.map(m => (
