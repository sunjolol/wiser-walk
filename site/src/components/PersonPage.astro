  {after('death').map(x => <SaintExtra x={x} />)}
  <SectionHead id="saint" title={title('saint').toLowerCase()} />
  <div class="panel sprose">
    <p class="big" set:html={rich(p.saint.big)} />
    <ul class="churches">
      {p.saint.churches.map(c => <li><b style={c.spacing ? `letter-spacing: ${c.spacing}` : undefined}>{c.church}</b><span>{c.status}</span><small set:html={rich(c.note)} /></li>)}
    </ul>
    {p.saint.paras?.map(t => <p set:html={rich(t)} />)}
  </div>
  {p.saint.quotes?.length ? (
    <div class:list={['said', p.saint.quotes.length === 2 && 'said--two', p.saint.quotes.length === 1 && 'said--one', 'said--after']}>
      {p.saint.quotes.map(q => (
        <figure class="panel qc">
          <blockquote>{q.q}</blockquote>
          <figcaption class="who"><Fragment set:html={rich(q.who)} /><span class="cite">{q.cite.url ? <a href={q.cite.url} target="_blank" rel="noopener" set:html={rich(q.cite.text)} /> : <Fragment set:html={rich(q.cite.text)} />}</span></figcaption>
        </figure>
      ))}
    </div>
  ) : null}

  {after('saint').map(x => <SaintExtra x={x} />)}
  {p.prayer && (
    <>
      <SectionHead id="prayer" title={title('prayer').toLowerCase()} />
      {p.prayer.intro && <p class="sect-lede" set:html={rich(p.prayer.intro)} />}
      <figure class="dark qf qf--prayer">
        <span class="qf-ghost" aria-hidden="true">“</span>
        <blockquote>{p.prayer.q}</blockquote>
        <figcaption><span class="cite">{p.prayer.cite.url ? <a href={p.prayer.cite.url} target="_blank" rel="noopener" set:html={rich(p.prayer.cite.text)} /> : <Fragment set:html={rich(p.prayer.cite.text)} />}</span></figcaption>
      </figure>
