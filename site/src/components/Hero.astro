---
/**
 * The band: every page's header.
 *
 * Full bleed on a phone, rounded at the bottom, with the spectrum poured through the smoke
 * stencil at the strength the locked demo uses for a header (not the whisper the data
 * panels use). Behind the words sits one giant ghost word in italic display, cropped by the
 * band's edge, which is the single most recognisable move in the owner's reference skins.
 * On top: a dark chip for the eyebrow, the headline in two inks, a lede, buttons, and a row
 * of stat tiles when the page has real numbers worth leading with.
 *
 * `blue` and `orange` colour one phrase each inside the title, in the same two inks the
 * result verdict uses. The lede is the default slot (so it can carry links) or the `lede`
 * prop for computed text. Buttons go in the "actions" slot.
 */
import Icon from './Icon.astro';

export interface Props {
  title: string;
  eyebrow?: string;
  icon?: 'compass' | 'flame' | 'scroll' | 'book' | 'arrow';
  lede?: string;
  blue?: string;
  orange?: string;
  /** The ghost word behind the headline. Lowercase reads best. */
  ghost?: string;
  /** Real numbers only. */
  tiles?: Array<{ n: string | number; label: string }>;
  /** Long titles (an article, a tradition's full name) get a calmer size and a wider measure. */
  long?: boolean;
}
const { title, eyebrow, icon, lede, blue, orange, ghost, tiles = [], long = false } = Astro.props;

type Part = { text: string; tone: '' | 'left' | 'right' };
let parts: Part[] = [{ text: title, tone: '' }];
const paint = (phrase: string | undefined, tone: 'left' | 'right') => {
  if (!phrase) return;
  parts = parts.flatMap(p => {
    if (p.tone || !p.text.includes(phrase)) return [p];
    const [before, ...rest] = p.text.split(phrase);
    return [
      { text: before, tone: '' as const },
      { text: phrase, tone },
      { text: rest.join(phrase), tone: '' as const }
    ].filter(x => x.text);
  });
};
paint(blue, 'left');
paint(orange, 'right');

const hasLede = Boolean(lede) || Astro.slots.has('default');
---
<header class:list={['band', long && 'band--long']}>
  <div class="wash" aria-hidden="true"></div>
  <div class="veil" aria-hidden="true"></div>
  {ghost && <div class="band-ghost" aria-hidden="true" style={`--len:${Math.max(4, ghost.length)}`}>{ghost}</div>}
  {eyebrow && <p class="band-chip">{icon && <Icon name={icon} size={13} />}{eyebrow}</p>}
  <h1>{parts.map(p => p.tone ? <span class={`verdict-part--${p.tone}`}>{p.text}</span> : p.text)}</h1>
  {hasLede && <p class="lede">{lede ?? <slot />}</p>}
  {Astro.slots.has('actions') && <div class="btn-row"><slot name="actions" /></div>}
  {tiles.length > 0 && (
    <ul class="tiles">
      {tiles.map(t => <li class="tile"><b>{t.n}</b><span>{t.label}</span></li>)}
    </ul>
  )}
</header>
