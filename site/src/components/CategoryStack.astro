---
/**
 * The unipolar hero: categories ranked by strength.
 *
 * This is deliberately NOT the rail component with the poles hidden. A ranking has no two
 * ends, no centre, and no band in which nothing is named — so it has no spine, no diverging
 * tint and no no-claim zone. Reusing the bipolar chassis here would be the same class of
 * error as labelling one pole of two, and it is the specific mistake this file exists to
 * make impossible.
 *
 * Rows render in RANK order here (unlike the data, which keeps quiz order) because the
 * ranking is the whole result. `rank` is on the row, so nothing has to be re-derived.
 */
import type { Quiz, UnipolarView } from '../lib/engine/types';
import { groupHref } from '../lib/engine/registry';

interface Props {
  quiz: Quiz;
  view: UnipolarView;
  linked?: boolean;
}

const { quiz, view, linked = true } = Astro.props;
const rows = [...view.rows].sort((a, b) => a.rank - b.rank);

// Only the top row is emphasised, and only when the result actually supports emphasising
// one. On a tie every level category leads — two, three or four of them, however many came
// out level — and on a flat result nothing does, because nothing did. Counted from the
// view's own list of named categories rather than from the state, so a three-way tie cannot
// end up with two rows emphasised and three named in the headline.
const leading = view.named.length;
---
<div class="stack-block">
  {view.state === 'flat' && (
    <p class="stack-legend">
      Nothing here stands out far enough to name. The bars below are what the arithmetic
      returned, in order — not a verdict.
    </p>
  )}

  <ol class="stack">
    {rows.map(row => (
      <li class:list={['tier', { 'is-leading': row.rank <= leading, 'is-below': row.below }]}>
        <div class="tier-head">
          <span class="tier-rank" aria-hidden="true">{row.rank}</span>
          <span class="tier-name">
            {linked ? <a href={groupHref(quiz, row)}>{row.name}</a> : row.name}
          </span>
          <span class="tier-strength">{row.strength}</span>
        </div>
        {/*
          The bar shows the PULL, not the raw score.

          category.score() maps the answer sum onto 0..100 exactly as the bipolar scorer
          does, so 50 means "agreed as much as you disagreed" — not "half as much sloth".
          Drawing a bar from zero to 50 would tell a reader with a completely neutral sheet
          that they are halfway to every vice on the list. The honest magnitude is how far
          the score rose ABOVE that neutral mark, which is exactly the number `strength`
          already says in words, so the bar and the words cannot disagree.

          Nothing is drawn at 50 to mark it. A tick at the neutral point on every row would
          line up down the page into a centre spine, which is the bipolar hero wearing a
          disguise — and a ranking has no centre.
        */}
        <div
          class="tier-track"
          role="img"
          aria-label={`${row.name}: ${row.strength}, ranked ${row.rank} of ${rows.length}.`}
        >
          <span class="tier-fill" style={`--v:${Math.max(0, (row.value - 50) * 2)}`}></span>
        </div>
      </li>
    ))}
  </ol>

  <p class="stack-note">
    Each bar is how far your answers pushed that one above no-net-agreement. An empty bar
    means your answers pulled neither way, not that the answer was zero. These are not
    percentages of you, and they are not shares of a whole — they do not add up to anything.
  </p>
</div>
