---
import { countFact } from '../lib/quiz-count';
/**
 * What to do next, drawn as rooms.
 *
 * A finished result, a comparison and the foot of an article are the three places on this
 * site where a reader is most likely to stop. All three used to end on a flat list of
 * links. This draws the same information as a set of small rooms that match the home
 * page's own cards as closely as their size allows (the owner, 2026-09-22: "literally
 * everywhere it appears it should be standardized"), so the next thing is a place to walk
 * into rather than a line of text, and a reader meets one face per thing wherever it is.
 *
 *   a quiz     its Doré plate from lib/art.ts, printed soft sepia under a warm dark
 *              gradient, a white title lifted off the picture with no line under it, the
 *              counted facts and Start in the quiz's own ink (the home page's and
 *              /quizzes/'s; no line under a title on a picture, the owner, 2026-09-23). A
 *              picture art.ts marks `colour` (the Christian Personality Test's eight
 *              paintings) is printed as it is, never sepia
 *   Compass    no plate: it is an instrument, and it takes the night ground its shared
 *              card (CompassCard.astro) is drawn on, that card's example wheel at its top,
 *              that card's sentence, and Start in the soft blue
 *   a game     the /games/ card: a dark room with its ink in the corner and its giant
 *              faint glyph there (.corner-ghost in kit.css), Play in the game's ink
 *
 * No marks over the titles and no "Quiz" or "Game" label (the owner, 2026-09-22): the
 * picture, the ground and the button already say which is which.
 *
 * The pictures are decorative here and carry no alt text on purpose: a card is one link,
 * and a plate described in full would be read out before the title of the thing it leads
 * to. What the picture shows is written down in art.ts, and said out loud on the page the
 * link goes to, where the picture is the subject rather than the wallpaper.
 *
 * Nothing here invents a destination, a count or a description: the title, the line and
 * every fact are read off the registry and the games list, except the Compass's line, which
 * is its shared card's own sentence. Its wheel is a real result, the published, audited
 * Eastern Orthodox answer sheet scored by the live engine, as CompassCard.astro draws it.
 *
 * Drafts are left out. A quiz that has not been through its fairness audit is a poor thing
 * to push someone into at the moment they are most willing to go, and it is kept out of
 * everything that travels for the same reason.
 */
import Icon from './Icon.astro';
import CompassWheel from './CompassWheel.astro';
import type { BipolarView, Quiz } from '../lib/engine/types';
import { groupNounPlural, outcomeNounPlural } from '../lib/engine/types';
import type { Game } from '../lib/games';
import { quizHref, scoreQuiz, resultFor } from '../lib/engine/registry';
import { artFor, COLOUR_PRINT } from '../lib/art';
import { SITUATIONS } from '../lib/strategies/reading';
import audit from '../data/compass-audit.json';

export interface Props {
  /** Quizzes to offer, in order. Drafts are dropped here rather than by every caller. */
  quizzes?: Quiz[];
  games?: Game[];
  /** At most this many rooms, so the row never breaks into an orphan. */
  limit?: number;
}

const { quizzes = [], games = [], limit = 4 } = Astro.props;

/** Each quiz's ink: the home page's (home.css .room--*) and /quizzes/'s, kept the same on purpose. */
const QUIZ_INK: Record<string, string> = {
  personality: '#BFE3AE',
  'which-early-christian': '#DCC6EE',
  'which-psalm': '#BCD6F2',
  'bible-figure': '#EADFCB',
  'spiritual-gifts': '#FFC98F',
  'seven-deadly-sins': '#F2A596'
};

/**
 * Each game's glyph and ink, as its card on the home page and /games/ draws it: the
 * question mark and the orange for "is it in the Bible?", the opening quote and the blue
 * for "who said it?". A game added later without an entry here still gets its room, with
 * no glyph and the orange.
 */
const GAME_LOOK: Record<string, { glyph: string; ghost: 'ask' | 'quote'; ink: 'orange' | 'blue' }> = {
  'sounds-like-scripture': { glyph: '?', ghost: 'ask', ink: 'orange' },
  'who-said-it': { glyph: '“', ghost: 'quote', ink: 'blue' }
};

/**
 * The second fact on a quiz, after the minutes: what you come away with, counted the way
 * /quizzes/ counts it. A quiz with outcomes names them (18 traditions, 25 figures); a
 * ranking names its categories only when it has a true word for them (19 gifts). A reading
 * (the Psalm quiz) counts the situations it can name, as /quizzes/ does.
 */

/*
 * The Compass is introduced in its shared card's words (CompassCard.astro's default `say`), as
 * on the home page, /quizzes/ and /me/, so it reads as the same card wherever it is offered.
 * A quiz on a plate says nothing under its title, as on the home rail and /quizzes/ (the owner,
 * 2026-09-23): a line there pushed the title up into the brighter part of the plate, and the
 * quiz's own page says it better. A quiz with no plate would say its own tagline.
 */
const COMPASS_SAY = 'Six questions that divide Christians, and the tradition that sits nearest you.';

/*
 * And it wears its shared card's wheel at its top, found and scored exactly as CompassCard.astro
 * finds and scores it. Without it the room was a starry box with nothing in it.
 */
const EXAMPLE = 'Eastern Orthodox';
const exampleSheet = (audit.simulations as Array<Record<string, any>>).find(
  s => s.tradition === EXAMPLE && Array.isArray(s.answers)
);
const exampleFor = (q: Quiz): BipolarView | undefined =>
  q.slug === 'theology-compass' && exampleSheet
    ? (resultFor(q, scoreQuiz(q, exampleSheet.answers)) as BipolarView)
    : undefined;

/*
 * A three-word title's last two words tied, the way the home page ties its game's: broken in
 * a narrow room, balanced type splits "Sounds Like Scripture" two and one, which leaves one
 * word alone on the last line (the owner: "super sloppy"). A longer title is left to the
 * balancing, which keeps its last line full on its own and, tied, broke "What are / your
 * spiritual gifts?" off a stub. A two-word title stays free: tied, it could not wrap at all.
 */
const tie = (s: string) => (s.trim().split(/\s+/).length === 3 ? s.replace(/ (?=\S+$)/, ' ') : s);

/**
 * The first sentences of a tagline, up to a hook that can stand alone.
 *
 * A game's tagline is three sentences, which is a paragraph in a card this size, and its
 * first sentence alone can be four words ("A line appears."). So sentences are taken until
 * there is enough of one to read, and no more: the card prints the whole of what this returns.
 */
const hook = (text: string) => {
  const parts = text.split(/(?<=[.?!])\s+/);
  let out = '';
  for (const part of parts) {
    out = out ? `${out} ${part}` : part;
    if (out.length >= 40) break;
  }
  return out.trim();
};

interface Room {
  href: string;
  title: string;
  /** The line under the title; none on a quiz's plate. */
  say?: string;
  /** The minutes, drawn with the clock, then any counted facts. */
  minutes: string;
  facts: string[];
  go: string;
  /** pic: a quiz's plate; night: a quiz with no plate (the Compass); game: a game's room. */
  kind: 'pic' | 'night' | 'game';
  /** The button's colour. */
  ink: string;
  /** A game's bloom in its corner: its ink at full strength, faint. */
  glow?: string;
  image?: string;
  imagePosition?: string;
  imageLift?: number;
  /** A painting in colour (art.ts `colour`): printed as it is (COLOUR_PRINT), never sepia. */
  imageColour?: boolean;
  ghost?: { glyph: string; kind: 'ask' | 'quote' };
  /** The Compass's example wheel. */
  wheel?: BipolarView;
}

const rooms: Room[] = [
  ...quizzes
    .filter(q => q.status === 'live')
    .map((q): Room => {
      const art = artFor(q.slug);
      return {
        href: quizHref(q),
        title: tie(q.title),
        say: art ? undefined : q.slug === 'theology-compass' ? COMPASS_SAY : q.tagline,
        minutes: `${q.minutes} min`,
        facts: [countFact(q)],
        go: 'Start',
        kind: art ? 'pic' : 'night',
        ink: art ? (QUIZ_INK[q.slug] ?? '#FFD2B0') : 'var(--blue-soft)',
        image: art?.src,
        imagePosition: art?.objectPosition,
        imageLift: art?.lift,
        imageColour: art?.colour,
        wheel: exampleFor(q)
      };
    }),
  ...games.map((g): Room => {
    const look = GAME_LOOK[g.slug];
    return {
      href: g.href,
      title: tie(g.title),
      say: hook(g.tagline),
      minutes: '2 min a run',
      facts: [],
      go: 'Play',
      kind: 'game',
      ink: look?.ink === 'blue' ? 'var(--blue-soft)' : 'var(--orange-soft)',
      glow: look?.ink === 'blue' ? 'rgba(126, 186, 238, .2)' : 'rgba(240, 160, 111, .2)',
      ghost: look ? { glyph: look.glyph, kind: look.ghost } : undefined
    };
  })
].slice(0, limit);

const roomStyle = (room: Room) =>
  [
    `--room-ink:${room.ink}`,
    room.glow ? `--room-glow:${room.glow}` : '',
    room.imageLift ? `--img-lift:${room.imageLift}` : '',
    /* art.ts gives a lift under 1 to exactly the plates printed unusually light (Doré's
       Thessalonians is mostly white wall), and white type needs more shade on those: the
       fact that dims the plate also deepens its scrim, as on /quizzes/ */
    room.imageLift && room.imageLift < 1 ? '--room-dim:.38' : ''
  ].filter(Boolean).join(';');
---
{rooms.length > 0 && (
  <div class="nx-wrap">
    <ul class="nx">
      {rooms.map(room => (
        <li>
          <a class={`nx-room nx-room--${room.kind}`} href={room.href} style={roomStyle(room)}>
            {room.image && (
              <img
                class="nx-img"
                src={room.image}
                alt=""
                loading="lazy"
                decoding="async"
                width="820"
                height="1029"
                style={[
                  room.imagePosition ? `object-position:${room.imagePosition}` : '',
                  room.imageColour ? COLOUR_PRINT : ''
                ].filter(Boolean).join(';') || undefined}
              />
            )}
            {room.ghost && (
              <span class={`corner-ghost corner-ghost--${room.ghost.kind}`} aria-hidden="true">{room.ghost.glyph}</span>
            )}
            {/* Somebody else's result, so it is hidden from a screen reader, as on /me/: read
                out inside the link, six axes and their leanings would sound like the reader's. */}
            {room.wheel && <div class="nx-eg" aria-hidden="true"><CompassWheel view={room.wheel} /></div>}
            <span class="nx-body">
              <b class="nx-title">{room.title}</b>
              {room.say && <span class="nx-say">{room.say}</span>}
              <span class="nx-facts">
                <span><Icon name="clock" size={13} /> {room.minutes}</span>
                {room.facts.map(f => <span>{f}</span>)}
              </span>
              <span class="go-pill">{room.go} <Icon name="arrow" size={16} /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
