---
/**
 * Share text, and the CTA that has to work for two different readers.
 *
 * A result URL is both "my result" and "a friend's result", and the same page is served to
 * both. "Take it again" is wrong for a visitor who has never taken it; "See where you land"
 * is faintly insulting to the person who just did.
 *
 * So the SERVER renders the visitor's version, and the page upgrades itself only when it
 * can prove otherwise — a sessionStorage note the quiz runner leaves behind on the way to
 * this page. Getting it wrong for the visitor is the costlier error, and the person who
 * just took the quiz necessarily had JavaScript on, so the upgrade will reach them.
 *
 * sessionStorage, not localStorage or a cookie: it is a UI convenience scoped to the tab,
 * it never leaves the device, and it is gone when the tab closes.
 */
import type { Quiz, ResultView } from '../lib/engine/types';
import { quizHref } from '../lib/engine/registry';

interface Props {
  quiz: Quiz;
  view: ResultView;
  share: string;
}

const { quiz, view, share } = Astro.props;

/*
 * The card is DISPLAYED split and COPIED whole.
 *
 * As one <pre> it showed about 42 characters at .72rem on a 360px phone, against a hedge
 * line that runs to 164 — so the fairness caveat, the one line the card exists to carry,
 * was the part you had to scroll sideways to find. Only the bar block has earned the right
 * not to wrap, because its columns line up and that alignment is the point. The title,
 * the verdict and the URL are ordinary prose and wrap like it.
 *
 * The copy button still copies `share` verbatim, so the audited text that leaves the page
 * is byte-for-byte what the strategy produced.
 */
const isBar = (line: string) => /[●○█░]/.test(line);

const blocks: Array<{ bar: boolean; lines: string[] }> = [];
for (const line of share.split('\n')) {
  const bar = isBar(line);
  const last = blocks[blocks.length - 1];
  if (last && last.bar === bar) last.lines.push(line);
  else blocks.push({ bar, lines: [line] });
}
---
<section class="share-block" data-quiz={quiz.slug} data-code={view.code}>
  <h2 data-visitor="Their result, in text" data-mine="Share it">Their result, in text</h2>

  <div class="share-card">
    {blocks.map(b =>
      b.bar
        ? <pre class="share share-bars">{b.lines.join('\n')}</pre>
        : b.lines.map(l => <p class="share-line">{l}</p>)
    )}
  </div>

  {/* The canonical text, for the clipboard. Never shown, never re-wrapped. */}
  <pre class="sr-only" id="share-text">{share}</pre>

  <div class="btn-row">
    <button class="btn dark" id="share-copy" type="button">Copy</button>
    <a
      class="btn"
      id="share-cta"
      href={quizHref(quiz)}
      data-visitor="See where you land"
      data-mine="Take it again"
    >See where you land</a>
  </div>

  <p class="share-note" id="share-note"
     data-visitor={`Someone sent you this. ${quiz.items.length} statements, about ${quiz.minutes} minutes, scored in your own browser.`}
     data-mine="This link is your whole result. Nothing is stored on our side, so keep it if you want to come back to it."
  >Someone sent you this. {quiz.items.length} statements, about {quiz.minutes} minutes, scored in your own browser.</p>
</section>

<script>
  (function () {
    const block = document.querySelector('.share-block');
    if (!block) return;

    // Did THIS browser produce THIS result? Anything else is treated as a visitor.
    let mine = false;
    try {
      mine = sessionStorage.getItem('ww:took:' + block.dataset.quiz) === block.dataset.code;
    } catch (e) {}

    if (mine) {
      block.querySelectorAll('[data-mine]').forEach(el => {
        const text = el.getAttribute('data-mine');
        if (el.tagName === 'A' || el.tagName === 'H2' || el.tagName === 'P') el.textContent = text;
      });
    }

    const btn = document.getElementById('share-copy');
    const pre = document.getElementById('share-text');
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre?.textContent ?? '');
        btn.textContent = 'Copied';
      } catch {
        // Clipboard denied. Select the visible card so the reader can copy it themselves —
        // selecting the hidden canonical copy would look like nothing happened.
        const card = document.querySelector('.share-card');
        const range = document.createRange();
        range.selectNodeContents(card ?? pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = 'Selected — copy it';
      }
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  })();
</script>
