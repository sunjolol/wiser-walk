---
/**
 * Sharing: a picture and a link.
 *
 * The card is the point. It is drawn onto a canvas at 1080×1350 from the same numbers and
 * the same geometry the page uses, so what someone posts is the page rather than a
 * screenshot of it. Canvas rather than a DOM-to-image library: the card has a
 * gradient-filled polygon, a hatched disc and three web fonts, which is exactly the
 * material those libraries mangle.
 *
 * The card is always drawn in the LIGHT palette. A shared image is seen on a stranger's
 * timeline, not against this page, and it should look the same to everyone.
 *
 * The link comes second, in a field that selects itself, because the link IS the result:
 * the scores are encoded in it and the page is rendered from it.
 *
 * Each link sits in a box of its own: a label over the field, its caption under it, and
 * clear space before the next box. The owner, 2026-09-23: with the captions loose between
 * two links, each one read as belonging to the wrong link.
 *
 * There is no plain-text version. A row of filled and empty circles is not a standard
 * anyone reads, and the owner has said so twice; a picture and a link are the two things
 * people actually send.
 *
 * The CTA has to serve two readers, since the same URL is both "my result" and "a friend's
 * result". The server renders the visitor's version and the page upgrades itself only when
 * it can prove otherwise, from a tab-scoped note the quiz runner leaves behind. Getting it
 * wrong for a visitor is the costlier error.
 */
import type { BipolarView, Quiz, ResultView } from '../lib/engine/types';
import { groupNoteFor, isComparable, leadFor, notesFor, resultNotes } from '../lib/engine/types';
import { artForOutcome } from '../lib/art';
import { FIGURE_PAGES, FIGURE_PICTURES } from '../lib/saints/figures';
import { quizHref, inviteHref } from '../lib/engine/registry';
import { publicCodeSync } from '../lib/engine/links';

interface Props {
  quiz: Quiz;
  view: ResultView;
  origin: string;
  /**
   * A reading's card draws the verse that names the situation. The Bible text is server-only
   * data, so the page looks the verse up and hands it down; no other shape passes one.
   */
  line?: { text: string; cite: string };
  /**
   * A kindred result's card ("Which early Christian thinks like you?") draws the two people it
   * names, with a line of the kindred spirit's own. Those are server-only data too, so the page
   * looks them up and hands them down; no other shape passes this.
   */
  kindred?: {
    name: string;
    dates: string;
    who: string;
    portrait: string;
    line: { text: string; cite: string } | null;
    /** The "We agree on" chips: topics, lower case. */
    agree: string[];
    sparring: { name: string; portrait: string; on: string[] } | null;
  };
  /**
   * The code the links print: the page's own public code (engine/links.ts). The result page
   * passes the one it was opened by, so a short link stays short. Defaults to the public code.
   */
  linkCode?: string;
}

const { quiz, view, origin, line, kindred } = Astro.props;
const linkCode = Astro.props.linkCode ?? publicCodeSync(quiz, view.code);
const url = `${origin}/r/${quiz.slug}/${linkCode}/`;
/*
 * The invite carries THIS result's code, so whoever follows it is compared with the person
 * whose result this is. That is right for both readers of the same URL: a visitor who
 * follows it lands beside the friend who sent it, and the owner hands it on to someone new.
 */
const invite = `${origin}${inviteHref(quiz, linkCode)}`;
/*
 * A quiz with short links whose page was opened by its LONG code (from /me/, or because the
 * runner gave up waiting) asks for the short one once the page has loaded, and swaps it into
 * both fields and the card. Until then, and if it never comes, the long link works.
 */
const mint = Boolean(quiz.shortLinks) && linkCode === view.code;

/*
 * A quiz whose results are not set side by side (the Psalm quiz: its result is what someone
 * is going through) has no comparison to invite anyone to. Its button asks a visitor to take
 * it for themselves instead, and the owner-side invite row is not drawn at all.
 */
const comparable = isComparable(quiz);
const cta = comparable
  ? { href: invite, visitor: 'See where you land next to them' }
  : { href: quizHref(quiz), visitor: 'Take it yourself' };

/*
 * "Share your compass" was written when the Compass was the only quiz; every other quiz now
 * says "result". The Compass keeps its own word.
 */
const mineHeading = quiz.slug === 'theology-compass' ? 'Share your compass' : 'Share your result';

/*
 * The labels point at the fields by id. A page could show more than one result, so the ids
 * carry the quiz and the code rather than being fixed.
 */
const uid = `share-${quiz.slug}-${view.code}`;

/*
 * A result that leads with WHO (Quiz.resultLeadsWithOutcome: the figure quiz) draws the people,
 * not the wheel (the owner, 2026-09-25: "focus on the Biblical characters you're like rather
 * than the axis"). The nearest, big, with their picture and their line; both where two are
 * level or nothing is close; then the next ones on the page's own list, smaller; the axis
 * clauses in one line. Where nobody is named (every axis in the no-position band) it draws the
 * words alone. The picture is the figure page's own card picture (the one the Saints hub
 * shows); for Jesus, who has no page yet, the Sinai icon (FIGURE_PICTURES), never Doré's
 * crowded plate (the owner, 2026-09-25). No number, anywhere.
 */
const leadsWho = Boolean(quiz.resultLeadsWithOutcome) && view.shape === 'bipolar';
const whoCard = (() => {
  if (!leadsWho || view.shape !== 'bipolar') return undefined;
  if (view.state === 'central') return { central: true, lead: [], next: [], slugs: [] as string[] };
  const person = (slug: string, name: string) => {
    const page = FIGURE_PAGES[slug];
    const stand = page ? null : FIGURE_PICTURES[slug]?.card;
    const art = page || stand ? null : artForOutcome(quiz.slug, slug);
    const who = quiz.outcomes.find(o => o.slug === slug)?.who ?? '';
    return {
      name,
      img: page?.card.img ?? stand?.img ?? art?.src ?? null,
      focus: page ? page.card.focus ?? '50% 25%' : stand?.focus ?? art?.objectPosition ?? '50% 30%',
      line: page?.card.line ?? (who ? who.charAt(0).toUpperCase() + who.slice(1) : '')
    };
  };
  const many = view.state === 'near' ? 1 : 2;
  // four names in all: one and the next three, or two and the next two
  const shown = view.ranked.slice(0, 4);
  return {
    central: false,
    pre: view.state === 'loose' ? 'No close fit. Nearest, loosely'
      : view.state === 'tie' ? 'Jointly closest to' : 'Closest to',
    lead: shown.slice(0, many).map(r => person(r.slug, r.name)),
    next: shown.slice(many).map(r => person(r.slug, r.name)),
    slugs: shown.map(r => r.slug)
  };
})();

/** Everything the card needs, and nothing else. */
const card = {
  quiz: quiz.title,
  code: view.code,
  url: url.replace(/^https?:\/\//, '').replace(/\/$/, ''),
  shape: view.shape,
  headline: view.headlineParts,
  /*
   * Not for a reading: its summary is the situation line, and the card and the system share
   * sheet travel without the person there to say it was theirs. The card says which psalm.
   */
  summary: view.shape === 'reading' ? '' : view.summary,
  /*
   * What the system share sheet sends as its text. The summary, except where the result leads
   * with who: then the same words as the page's headline ("Closest to Peter"), so the text that
   * travels names the person the way the page does, with the sentence each named one carries
   * (Jesus's, and the canon notes on Judith and Tobit), since a note goes wherever its name goes.
   */
  say: (() => {
    const lead = leadFor(quiz, view);
    if (!lead) return view.shape === 'reading' ? '' : view.summary;
    return [`${lead.line}.`, ...notesFor(quiz, lead.names.map(n => n.slug))].join(' ');
  })(),
  /*
   * The sentence a named outcome carries, verbatim, drawn under the picture.
   *
   * The card is the part that travels furthest: it is posted where the page is not, and a
   * reader of it never sees the note printed beside the card on the result page. So the
   * name and the sentence leave together or not at all. A quiz whose outcomes carry no
   * notes — the Compass — sends an empty list, and the card is drawn exactly as before.
   *
   * A sentence that travels with a GROUP name rides the same path, for the same reason: the
   * gifts draft names six gifts Christians disagree about, and the card is the surface that
   * travels furthest from the page that explains them.
   */
  notes: [
    // every name the card draws carries its own sentence, and the figure card draws up to four
    ...(whoCard ? notesFor(quiz, whoCard.slugs) : resultNotes(quiz, view)),
    ...groupNoteFor(quiz, view.named, 'result')
  ],
  noClaimSpan: view.shape === 'bipolar' ? (view as BipolarView).noClaimSpan : null,
  rows: view.rows.map(r =>
    'left' in r
      ? {
          name: r.name, left: r.left, right: r.right, value: r.value,
          step: r.step, steps: r.steps, noClaim: r.noClaim, lean: r.lean, band: r.band
        }
      : { name: r.name, value: r.value, rank: r.rank, strength: r.strength, below: r.below }
  ),
  /*
   * A ranking's card draws its bars, and emphasises the rows the headline names, exactly as
   * many as the page does (see CategoryStack): none on a flat result, several on a tie.
   */
  ...(view.shape === 'unipolar' ? { lead: view.named.length } : {}),
  // Added only for a reading.
  ...(view.shape === 'reading'
    ? { reading: { line: line?.text ?? '', cite: line?.cite ?? '', say: quiz.shareTitle } }
    : {}),
  // Added only for kindred spirits, and only when somebody was named.
  ...(view.shape === 'kindred' && kindred ? { kindred: { ...kindred, say: quiz.shareTitle } } : {}),
  // Added only where the result leads with who (the figure quiz).
  ...(whoCard ? { who: whoCard } : {})
};
---
<section class="share-block" data-quiz={quiz.slug} data-code={view.code} data-mint={mint ? '' : undefined}>
  <h2 data-visitor="Their result" data-mine={mineHeading}>Their result</h2>

  {/* The picture first. It is the thing being shared; the buttons act on it. */}
  <figure class="card-stage" data-role="stage">
    <canvas data-role="canvas" width="1080" height="1350" aria-label="Result card"></canvas>
    <figcaption class="card-hint" data-role="hint">This is the image people see when you share it.</figcaption>
  </figure>

  <div class="share-actions">
    <button class="btn" data-role="save" type="button">Save the card</button>
    <button class="btn dark" data-role="share" type="button" hidden>Share</button>
    {/*
      Two readers, two destinations. A visitor's next step is to answer for themselves and
      land beside this result, so their link carries it; the owner's next step is just the
      quiz. The href swaps with the label, or the owner would be invited to compare with
      themselves.
    */}
    <a class="btn ghost" data-role="cta" href={cta.href} data-mine-href={quizHref(quiz)}
       data-visitor={cta.visitor} data-mine="Take it again"
       >{cta.visitor}</a>
  </div>

  <div class="share-boxes">
    {/*
      The result's own link. A visitor gets the label and the field and nothing more; the
      owner also gets the line that says what the link is for, under the field it describes.
    */}
    <div class="share-box">
      <label class="share-label" for={`${uid}-url`}
             data-visitor="This result's link" data-mine="Your result link">This result's link</label>
      <div class="share-link">
        <input id={`${uid}-url`} data-role="url" type="text" readonly value={url} spellcheck="false" />
        <button class="btn ghost" data-role="copy-link" type="button">Copy link</button>
      </div>
      <p class="share-note" data-mine-show hidden>
        Opens this result for anyone. Keep it to come back to your result.
      </p>
    </div>

    {/*
      Owner-only, revealed by the same `mine` switch as the copy above. A visitor already has
      the invitation on the button; showing them a second copy of it would be one CTA too many
      on a page that is not about them.
    */}
    {comparable && (
    <div class="share-box" data-mine-show hidden>
      <label class="share-label" for={`${uid}-invite`}>Compare with a friend</label>
      <div class="share-link">
        <input id={`${uid}-invite`} data-role="invite-url" type="text" readonly value={invite}
               spellcheck="false" />
        <button class="btn ghost" data-role="copy-invite" type="button">Copy link</button>
      </div>
      <p class="share-note">
        Send this to a friend. When they finish the quiz, you both see your answers side by side.
      </p>
    </div>
    )}
  </div>

  <script type="application/json" data-role="data" set:html={JSON.stringify(card)}></script>
</section>

<script>
  import { requestShortCode } from '../lib/engine/links';

  /*
   * Runs once per .share-block, scoped to that section.
   *
   * It used to reach for document-wide ids, which meant exactly one share block could ever
   * work on a page. That is a real constraint on a component, and it bit immediately: a
   * preview showing several results at once could not include the share section at all, so
   * it got lifted out — which read, correctly, as the feature having been deleted. Nothing
   * here touches the document outside its own section.
   */
  document.querySelectorAll('.share-block').forEach(function (block) {
    const pick = role => block.querySelector('[data-role="' + role + '"]');

    /* ---------------- who is looking ---------------- */
    let mine = false;
    try {
      mine = sessionStorage.getItem('ww:took:' + block.dataset.quiz) === block.dataset.code;
    } catch (e) {}
    if (mine) {
      block.querySelectorAll('[data-mine]').forEach(el => {
        el.textContent = el.getAttribute('data-mine');
      });
      block.querySelectorAll('[data-mine-href]').forEach(el => {
        el.setAttribute('href', el.getAttribute('data-mine-href'));
      });
      block.querySelectorAll('[data-mine-show]').forEach(el => { el.hidden = false; });
    }

    /* ---------------- copy ---------------- */
    const flash = (btn, text) => {
      const was = btn.textContent;
      btn.textContent = text;
      setTimeout(() => { btn.textContent = was; }, 1800);
    };
    const copy = async (text, btn) => {
      try { await navigator.clipboard.writeText(text); flash(btn, 'Copied'); }
      catch { flash(btn, 'Press Ctrl+C'); }
    };

    const field = pick('url');
    field?.addEventListener('focus', () => field.select());
    pick('copy-link')?.addEventListener('click', e => {
      field.select();
      copy(field.value, e.currentTarget);
    });

    const inviteField = pick('invite-url');
    inviteField?.addEventListener('focus', () => inviteField.select());
    pick('copy-invite')?.addEventListener('click', e => {
      inviteField.select();
      copy(inviteField.value, e.currentTarget);
    });

    /* ---------------- the card ---------------- */
    const data = JSON.parse(pick('data').textContent);
    const canvas = pick('canvas');
    const stage = pick('stage');
    const hint = pick('hint');

    const P = {
      page: '#E3E3E3', panel: '#EEEEEE', shell: '#E8E8E8',
      ink: '#3B3B3B', soft: '#5A6066', mute: '#7C8288',
      blue: '#7EBAEE', orange: '#F0A06F', accent: '#3E86C4', rust: '#7A4A22',
      zone: 'rgba(124,130,136,.34)', hatch: 'rgba(124,130,136,.30)',
      // an empty bar on a panel: the shell tone alone is invisible (site.css --track)
      track: '#D9D9DC',
      // the wordmark's ink, the site's own #444444
      brand: '#444444'
    };
    const W = 1080, H = 1350;
    const tone = r => (r.noClaim ? P.mute : r.value < 50 ? P.blue : P.orange);
    const ink = side => (side === 'left' ? P.accent : side === 'right' ? P.rust : P.ink);

    /* ---------------- the mark ---------------- */
    /*
     * The owner's logo heads every card, the brush W and then the words (the owner,
     * 2026-09-23: he wants the mark itself on what people share, not only the name). Sized
     * as the header sizes them (site.css .brand): the words 18.5/34 of the W's height, the
     * gap 15/34 of it.
     *
     * The W is his larger export (159×114), so it is only ever scaled DOWN. The words are
     * wordmark.svg, whose ink is currentColor. An image on a canvas has no current colour,
     * so the file is fetched as text, given the card's ink and a size, and drawn from a data
     * URL. The size matters too: Firefox will not draw an SVG that has only a viewBox.
     *
     * Both start loading at once and draw() waits for them as it waits for the fonts, since
     * a canvas never redraws when an image arrives late. A file that fails is left out
     * rather than holding the card back.
     */
    const MARK_H = 48;
    const MARK_W = MARK_H * 159 / 114;
    const WORD_H = Math.round(MARK_H * 18.5 / 34);
    const WORD_W = WORD_H * 5405 / 783;
    const MARK_GAP = Math.round(MARK_H * 15 / 34);

    const image = src => new Promise((done, fail) => {
      const img = new Image();
      img.onload = () => done(img);
      img.onerror = fail;
      img.src = src;
    });
    const mark = Promise.all([
      image('/img/logo-w-large.png').catch(() => null),
      fetch('/img/wordmark.svg')
        .then(r => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))))
        .then(svg => image('data:image/svg+xml;charset=utf-8,' + encodeURIComponent(
          svg.replace(/currentColor/g, P.brand)
             .replace('<svg ', '<svg width="' + WORD_W + '" height="' + WORD_H + '" ')
        )))
        .catch(() => null)
    ]);

    /** The W, then the words centred on it and a hair above its middle, as in the header. */
    function drawMark(g, x, top, [brush, words]) {
      let wx = x;
      if (brush) {
        g.save();
        g.imageSmoothingEnabled = true;
        g.imageSmoothingQuality = 'high';
        g.drawImage(brush, x, top, MARK_W, MARK_H);
        g.restore();
        wx += MARK_W + MARK_GAP;
      }
      if (words) {
        g.drawImage(words, wx, top + (MARK_H - WORD_H) / 2 - 1.5, WORD_W, WORD_H);
      } else {
        // the words in the headline face, so a card whose file failed still says whose it is
        g.fillStyle = P.brand;
        g.font = "34px 'Wiser Display', Philosopher, sans-serif";
        g.fillText('Wiser Walk', wx, top + MARK_H / 2 + 12);
      }
    }

    function roundRect(g, x, y, w, h, r) {
      g.beginPath();
      g.moveTo(x + r, y);
      g.arcTo(x + w, y, x + w, y + h, r);
      g.arcTo(x + w, y + h, x, y + h, r);
      g.arcTo(x, y + h, x, y, r);
      g.arcTo(x, y, x + w, y, r);
      g.closePath();
    }

    /** Diagonal hatching inside whatever path was just clipped. */
    function hatch(g, x, y, w, h, gap) {
      g.save();
      g.strokeStyle = P.hatch;
      g.lineWidth = 4;
      for (let d = -h; d < w + h; d += gap) {
        g.beginPath();
        g.moveTo(x + d, y + h);
        g.lineTo(x + d + h, y);
        g.stroke();
      }
      g.restore();
    }

    function wrapWords(g, words, max) {
      const lines = [];
      let line = [];
      for (const word of words) {
        const test = [...line, word];
        if (g.measureText(test.map(o => o.t ?? o).join(' ')).width > max && line.length) {
          lines.push(line);
          line = [word];
        } else line = test;
      }
      if (line.length) lines.push(line);
      return lines;
    }

    function drawWheel(g, cx, cy, R) {
      const rows = data.rows, n = rows.length;
      const zoneT = data.noClaimSpan ? (data.noClaimSpan[1] - 50) / 50 : 0;
      const ang = i => (-90 + i * (360 / n)) * Math.PI / 180;
      const pt = (i, t) => [cx + R * t * Math.cos(ang(i)), cy + R * t * Math.sin(ang(i))];

      g.strokeStyle = P.zone;
      g.lineWidth = 2;
      [1, 0.5].forEach(t => { g.beginPath(); g.arc(cx, cy, R * t, 0, Math.PI * 2); g.stroke(); });
      rows.forEach((_, i) => {
        const [x, y] = pt(i, 1);
        g.beginPath(); g.moveTo(cx, cy); g.lineTo(x, y); g.stroke();
      });

      if (zoneT > 0) {
        g.save();
        g.beginPath(); g.arc(cx, cy, R * zoneT, 0, Math.PI * 2); g.clip();
        hatch(g, cx - R, cy - R, R * 2, R * 2, 13);
        g.restore();
        g.strokeStyle = P.zone; g.lineWidth = 2;
        g.beginPath(); g.arc(cx, cy, R * zoneT, 0, Math.PI * 2); g.stroke();
      }

      const tips = rows.map((r, i) => pt(i, Math.abs(r.step - r.steps / 2) / (r.steps / 2)));

      g.save();
      g.globalAlpha = 0.55;
      tips.forEach((a, i) => {
        const b = tips[(i + 1) % tips.length];
        const grad = g.createLinearGradient(a[0], a[1], b[0], b[1]);
        grad.addColorStop(0, tone(rows[i]));
        grad.addColorStop(1, tone(rows[(i + 1) % rows.length]));
        g.fillStyle = grad;
        g.beginPath(); g.moveTo(cx, cy); g.lineTo(a[0], a[1]); g.lineTo(b[0], b[1]);
        g.closePath(); g.fill();
      });
      g.restore();

      g.save();
      g.globalAlpha = .55; g.strokeStyle = P.soft; g.lineWidth = 3; g.lineJoin = 'round';
      g.beginPath();
      tips.forEach((p, i) => (i ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1])));
      g.closePath(); g.stroke();
      g.restore();

      rows.forEach((r, i) => {
        const [x, y] = tips[i];
        g.strokeStyle = tone(r); g.lineWidth = 11; g.lineCap = 'round';
        g.beginPath(); g.moveTo(cx, cy); g.lineTo(x, y); g.stroke();
        g.fillStyle = tone(r);
        g.beginPath(); g.arc(x, y, 19, 0, Math.PI * 2); g.fill();
        g.strokeStyle = P.panel; g.lineWidth = 8;
        g.beginPath(); g.arc(x, y, 19, 0, Math.PI * 2); g.stroke();
      });
      g.fillStyle = P.mute;
      g.beginPath(); g.arc(cx, cy, 7, 0, Math.PI * 2); g.fill();

      rows.forEach((r, i) => {
        const a = ang(i), c = Math.cos(a), s = Math.sin(a);
        const lx = cx + (R + 46) * c, ly = cy + (R + 46) * s;
        g.textAlign = c > 0.2 ? 'left' : c < -0.2 ? 'right' : 'center';
        const dy = s < -0.2 ? -38 : s > 0.2 ? 24 : -10;
        g.fillStyle = P.mute;
        g.font = '700 21px Poppins, system-ui, sans-serif';
        g.fillText(r.name.toUpperCase(), lx, ly + dy);
        g.fillStyle = r.noClaim ? P.mute : r.value < 50 ? P.accent : P.rust;
        g.font = '600 27px Poppins, system-ui, sans-serif';
        g.fillText(r.noClaim ? 'no lean' : r.value < 50 ? r.left : r.right, lx, ly + dy + 32);
      });
      g.textAlign = 'left';
    }

    /**
     * A reading's card: the psalm's name large, the verse that names the situation, and the
     * link. Nothing about how the person answered and not the situation line, which is on the
     * page for whoever follows the link. The name is in two inks as on the page ("Psalm" in
     * ink, the number in the link blue), and both it and the verse shrink until they fit, so
     * "The Songs of Ascents" and Psalm 18's longest line land on the card as well as "Psalm 3".
     */
    /** No line ends on one stranded word (the owner's rule for the whole site): pull one down. */
    function unstrand(lines) {
      const n = lines.length;
      if (n > 1 && lines[n - 1].length === 1 && lines[n - 2].length > 2) {
        lines[n - 1].unshift(lines[n - 2].pop());
      }
      return lines;
    }

    function drawReading(g, x, y, w, footY) {
      const r = data.reading;
      const words = data.headline.map(p => p.text).join(' ').split(' ');
      const parts = words.map((t, i) => ({ t, side: i === 0 ? 'centre' : 'left' }));

      let size = 150, lines;
      do {
        g.font = size + "px 'Wiser Display', Philosopher, sans-serif";
        lines = unstrand(wrapWords(g, parts, w));
        size -= 6;
      } while ((lines.length > 2 || lines.some(l => g.measureText(l.map(o => o.t).join(' ')).width > w)) && size > 60);
      const lh = Math.round((size + 6) * 1.04);
      y += 26;
      lines.forEach(line => {
        y += lh;
        let cx = x;
        line.forEach(word => {
          g.fillStyle = ink(word.side);
          g.fillText(word.t, cx, y);
          cx += g.measureText(word.t + ' ').width;
        });
      });

      // the spectrum rule the page's section heads wear
      y += 44;
      const rule = g.createLinearGradient(x, 0, x + 96, 0);
      rule.addColorStop(0, P.blue); rule.addColorStop(1, P.orange);
      g.fillStyle = rule;
      roundRect(g, x, y, 96, 10, 5); g.fill();
      y += 10;

      // the verse, centred in what is left between the rule and the link
      const room = footY - 70 - y;
      // Large first: at 52px a one-line verse left most of the card empty.
      let vs = 78, vlines, vlh;
      do {
        g.font = 'italic ' + vs + "px 'Wiser Display', Philosopher, sans-serif";
        vlines = unstrand(wrapWords(g, (r.line || '').split(' '), w));
        vlh = Math.round(vs * 1.3);
        vs -= 2;
      } while ((vlines.length * vlh + 64 > room || vlines.length > 6) && vs > 28);
      const block = vlines.length * vlh + 64;
      let vy = y + Math.max(40, (room - block) * 0.45);
      g.fillStyle = P.ink;
      vlines.forEach(line => {
        vy += vlh;
        g.fillText(line.join(' '), x, vy);
      });
      g.fillStyle = P.mute;
      g.font = '600 26px Poppins, system-ui, sans-serif';
      g.fillText((r.cite || '').toUpperCase(), x, vy + 62);
    }

    /**
     * A ranking's card: its rows as named bars, in rank order, drawn as CategoryStack draws
     * them on the page. It used to be handed the rows and draw none, which left the middle of
     * every sins and gifts card empty.
     *
     * The bar is the PULL, not the raw score: filled from zero by how far the score rose
     * above 50, so a neutral sheet shows empty bars rather than "halfway to every vice". The
     * fill is the spectrum, at full strength on the rows the headline names and at half on
     * the rest. A row answered against on balance has its track faded and its words in
     * italic. Each bar carries its rank, its name and its strength in words.
     *
     * As many rows as fit between the summary and whatever is under the bars, and never
     * fewer than five. The gifts quiz ranks nineteen, so its card shows the top of the list.
     * Five rows in too little room are drawn smaller rather than on top of each other.
     */
    function drawBars(g, x, w, top, bottom) {
      const rows = [...data.rows].sort((a, b) => a.rank - b.rank);
      const lead = data.lead || 0;
      const PITCH = 104;                    // one row, from the top of its name to the next
      const room = bottom - top;
      const n = Math.min(rows.length, Math.max(5, Math.floor(room / PITCH)));
      const k = Math.min(1, room / (n * PITCH));
      const pitch = PITCH * k;
      const BAR = 22 * k;
      let y = top + (room - pitch * n) * 0.4;

      rows.slice(0, n).forEach(r => {
        const leading = r.rank <= lead;
        const base = y + 30 * k;            // the baseline of the row's words
        const nx = x + 38 * k;

        g.textAlign = 'left';
        g.font = '700 ' + Math.round(22 * k) + 'px Poppins, system-ui, sans-serif';
        g.fillStyle = leading ? P.accent : P.mute;
        g.fillText(String(r.rank), x, base);

        g.textAlign = 'right';
        g.font = (r.below ? 'italic ' : '') + '600 ' + Math.round(22 * k) + 'px Poppins, system-ui, sans-serif';
        g.fillStyle = P.mute;
        g.fillText(r.strength, x + w, base);
        const nameRoom = w - (nx - x) - g.measureText(r.strength).width - 28;
        g.textAlign = 'left';

        // sentence case, as the page sets it: "The gift of faith", never "The Gift Of Faith"
        const name = r.name.charAt(0).toUpperCase() + r.name.slice(1);
        let size = Math.round((leading ? 32 : 29) * k);
        do {
          g.font = '700 ' + size + 'px Poppins, system-ui, sans-serif';
          size -= 1;
        } while (g.measureText(name).width > nameRoom && size > 16);
        g.fillStyle = P.ink;
        g.fillText(name, nx, base);

        const by = base + 16 * k;
        g.save();
        if (r.below) g.globalAlpha = .55;
        g.fillStyle = P.track;
        roundRect(g, x, by, w, BAR, BAR / 2); g.fill();
        g.restore();

        const fill = w * Math.max(0, (r.value - 50) * 2) / 100;
        if (fill > 0) {
          const grad = g.createLinearGradient(x, 0, x + fill, 0);
          grad.addColorStop(0, P.blue); grad.addColorStop(1, P.orange);
          g.save();
          g.globalAlpha = leading ? 1 : .5;
          g.fillStyle = grad;
          // never narrower than its own rounded ends, or the corners fold over
          roundRect(g, x, by, Math.max(fill, BAR), BAR, BAR / 2); g.fill();
          g.restore();
        }
        y += pitch;
      });
    }

    /**
     * Kindred spirits' card: the approved preview's (design/quiz-ideas/fathers/preview/app.js,
     * drawCard), under the mark every card now wears. The kindred spirit's portrait, with their
     * name, dates and who they were beside it; the line of theirs the result chose, and whose it
     * is; what the two agree on, as chips; and, under a rule at the foot, the sparring partner
     * and what they would argue about. Nothing about how anyone answered, and no number.
     *
     * The line is the one part whose length is not known, so everything else is measured first
     * and the line is set in the room that is left, smaller until it fits. A line too long for
     * the card even then gives up the chips rather than run into them. The portraits are this
     * site's own files, so the canvas can still be saved.
     */
    async function drawKindred(g, x, top, w, footY) {
      const k = data.kindred;
      const [face, rival] = await Promise.all([
        image(k.portrait).catch(() => null),
        k.sparring ? image(k.sparring.portrait).catch(() => null) : null
      ]);
      const DISPLAY = "px 'Wiser Display', Philosopher, sans-serif";

      /** A picture cut to its box from the top, so a face is never cropped off. */
      const cover = (img, bx, by, bw, bh, r) => {
        g.save();
        roundRect(g, bx, by, bw, bh, r); g.clip();
        if (img) {
          const s = Math.max(bw / img.width, bh / img.height);
          g.drawImage(img, bx + (bw - img.width * s) / 2, by, img.width * s, img.height * s);
        } else {
          g.fillStyle = P.shell; g.fillRect(bx, by, bw, bh);
        }
        g.restore();
      };
      /** A display name that shrinks until it takes no more than so many lines. */
      const fitName = (text, max, size, min, most) => {
        let lines;
        do {
          g.font = size + DISPLAY;
          lines = unstrand(wrapWords(g, text.split(' '), max));
          if (lines.length <= most) break;
          size -= 2;
        } while (size > min);
        return { lines: lines.slice(0, most), size };
      };
      /** "laughter, war and money" */
      const listed = a => (a.length > 1 ? a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1] : a[0] || '');

      // ---- the kindred spirit: the portrait, and beside it who they were
      const PW = 256, PH = 320, py = top + 36;
      g.save();
      g.shadowColor = 'rgba(68,68,68,.16)'; g.shadowBlur = 16; g.shadowOffsetX = 4; g.shadowOffsetY = 5;
      g.fillStyle = P.shell; roundRect(g, x, py, PW, PH, 26); g.fill();
      g.restore();
      cover(face, x, py, PW, PH, 26);

      const cx = x + PW + 40, cw = x + w - cx;
      let cy = py;
      g.fillStyle = P.mute;
      g.font = '700 21px Poppins, system-ui, sans-serif';
      wrapWords(g, (k.say || '').toUpperCase().split(' '), cw).slice(0, 2).forEach(l => {
        cy += 28; g.fillText(l.join(' '), cx, cy);
      });
      const nm = fitName(k.name, cw, 66, 44, 3);
      g.fillStyle = P.ink;
      g.font = nm.size + DISPLAY;
      cy += 8;
      nm.lines.forEach(l => { cy += Math.round(nm.size * 1.04); g.fillText(l.join(' '), cx, cy); });
      g.fillStyle = P.mute;
      g.font = '600 24px Poppins, system-ui, sans-serif';
      cy += 44; g.fillText(k.dates, cx, cy);
      g.fillStyle = P.soft;
      g.font = '25px Inter, system-ui, sans-serif';
      cy += 14;
      wrapWords(g, k.who.split(' '), cw).slice(0, 4).forEach(l => { cy += 36; g.fillText(l.join(' '), cx, cy); });
      const start = Math.max(py + PH, cy) + 36;

      // ---- everything under the line, measured before the line is set
      const SPAR = 150;
      const sparTop = footY - 62 - SPAR;
      const bottom = k.sparring ? sparTop - 58 : footY - 60;
      /*
       * The chips stand in ONE row, so the room they take is known: smaller type first, down to
       * a size still easy to read, and only then the last topic left off. Three long topics
       * ("whether all are saved", "who belongs in church") are the case this is for.
       */
      let topics = (k.agree || []).slice();
      let chipSize = 25;
      const chipFont = () => '600 ' + chipSize + 'px Poppins, system-ui, sans-serif';
      const chipWidth = t => { g.font = chipFont(); return g.measureText(t).width + chipSize * 1.6; };
      const rowWidth = () => topics.reduce((sum, t) => sum + chipWidth(t), 0) + (topics.length - 1) * 14;
      while (topics.length && rowWidth() > w) {
        if (chipSize > 20) chipSize -= 1;
        else topics.pop();
      }
      const chipsH = topics.length ? 44 + 50 : 0;

      // ---- the line, in the room that is left
      let chips = topics.length > 0;
      let set = null;
      if (k.line) {
        const lineAt = (room) => {
          let size = k.sparring ? 42 : 48, lines, lh;
          do {
            g.font = 'italic 400 ' + size + 'px Philosopher, serif';
            lines = unstrand(wrapWords(g, ('“' + k.line.text + '”').split(' '), w));
            lh = Math.round(size * 1.32);
            if (lines.length * lh + 50 <= room) return { size, lines, lh };
            size -= 2;
          } while (size >= 24);
          return null;
        };
        set = lineAt(bottom - start - (chips ? chipsH + 50 : 0));
        if (!set && chips) { chips = false; set = lineAt(bottom - start); }
        if (!set) {
          // Longer than the card at its smallest: set it small and let the line's own end be the limit.
          g.font = 'italic 400 24px Philosopher, serif';
          set = { size: 24, lh: 32, lines: unstrand(wrapWords(g, ('“' + k.line.text + '”').split(' '), w)) };
        }
      }
      const lineH = set ? set.lines.length * set.lh + 50 : 0;
      const used = lineH + (chips ? (set ? 50 : 0) + chipsH : 0);
      // what is left over goes a little more above the block than below it
      let y = start + Math.max(0, (bottom - start - used) * 0.4);

      if (set) {
        g.fillStyle = P.ink;
        g.font = 'italic 400 ' + set.size + 'px Philosopher, serif';
        set.lines.forEach(l => { y += set.lh; g.fillText(l.join(' '), x, y); });
        g.fillStyle = P.mute;
        g.font = '600 22px Poppins, system-ui, sans-serif';
        y += 46; g.fillText(k.line.cite.toUpperCase(), x, y);
        y += 4;
      }

      if (chips) {
        if (set) y += 50;
        g.fillStyle = P.mute;
        g.font = '700 21px Poppins, system-ui, sans-serif';
        y += 20; g.fillText('WE AGREE ON', x, y);
        let px = x;
        const cyy = y + 22;
        topics.forEach(t => {
          const cwid = chipWidth(t);
          g.fillStyle = '#F7F7F7';
          roundRect(g, px, cyy, cwid, 50, 25); g.fill();
          g.strokeStyle = 'rgba(68,68,68,.12)'; g.lineWidth = 1.5;
          roundRect(g, px, cyy, cwid, 50, 25); g.stroke();
          g.fillStyle = P.ink; g.font = chipFont();
          g.fillText(t, px + chipSize * .8, cyy + 25 + chipSize * .36);
          px += cwid + 14;
        });
      }

      // ---- the sparring partner, at the foot
      if (k.sparring) {
        g.strokeStyle = 'rgba(68,68,68,.14)'; g.lineWidth = 2;
        g.beginPath(); g.moveTo(x, sparTop - 32); g.lineTo(x + w, sparTop - 32); g.stroke();
        const SW = 120;
        cover(rival, x, sparTop, SW, SPAR, 18);
        const sx = x + SW + 32, sw = x + w - sx;
        g.fillStyle = P.accent;
        g.font = '700 21px Poppins, system-ui, sans-serif';
        g.fillText('WOULD ARGUE WITH ME', sx, sparTop + 26);
        const sn = fitName(k.sparring.name, sw, 52, 36, 1);
        g.fillStyle = P.ink;
        g.font = sn.size + DISPLAY;
        g.fillText(sn.lines[0].join(' '), sx, sparTop + 30 + sn.size);
        if (k.sparring.on.length) {
          g.fillStyle = P.soft;
          g.font = '500 25px Poppins, system-ui, sans-serif';
          let oy = sparTop + 30 + sn.size + 42;
          wrapWords(g, ('on ' + listed(k.sparring.on)).split(' '), sw).slice(0, 2).forEach(l => {
            g.fillText(l.join(' '), sx, oy); oy += 34;
          });
        }
      }
    }

    /**
     * The figure quiz's card (data.who): the people, not the wheel. The nearest with their
     * picture, name and line (two side by side where two are level or nothing is close), the
     * axis clauses in one line in the rails' two inks, then the next ones on the page's own
     * list, smaller, each with their picture while there is room for it. The sentences the
     * names carry (Jesus's; the canon notes on Judith and Tobit) are measured first and set
     * above the link, and the pictures give way to them, never the other way round.
     */
    async function drawWho(g, x, top, w, footY) {
      const d = data.who;
      const people = [...d.lead, ...d.next];
      const faces = await Promise.all(people.map(p => (p.img ? image(p.img).catch(() => null) : null)));
      const DISPLAY = "px 'Wiser Display', Philosopher, sans-serif";
      const LABEL = '700 21px Poppins, system-ui, sans-serif';

      /** A picture cut to its box at its focus point, as object-fit: cover and object-position do. */
      const cover = (img, bx, by, bw, bh, r, focus) => {
        g.save();
        g.shadowColor = 'rgba(68,68,68,.16)'; g.shadowBlur = 16; g.shadowOffsetX = 4; g.shadowOffsetY = 5;
        g.fillStyle = P.shell; roundRect(g, bx, by, bw, bh, r); g.fill();
        g.restore();
        if (!img) return;
        g.save();
        roundRect(g, bx, by, bw, bh, r); g.clip();
        const s = Math.max(bw / img.width, bh / img.height);
        const [fx, fy] = String(focus || '50% 50%').split(' ').map(v => (parseFloat(v) || 50) / 100);
        g.imageSmoothingEnabled = true; g.imageSmoothingQuality = 'high';
        g.drawImage(img, bx + (bw - img.width * s) * fx, by + (bh - img.height * s) * (fy ?? .5),
          img.width * s, img.height * s);
        g.restore();
      };
      /** A display name that shrinks until it takes no more than so many lines. */
      const fitName = (text, max, size, min, most) => {
        let lines;
        do {
          g.font = size + DISPLAY;
          lines = unstrand(wrapWords(g, text.split(' '), max));
          if (lines.length <= most) break;
          size -= 2;
        } while (size > min);
        return { lines: lines.slice(0, most), size };
      };
      const setLines = (text, font, max, most) => {
        g.font = font;
        return unstrand(wrapWords(g, text.split(' '), max)).slice(0, most);
      };

      // ---- the sentences the names carry, measured first: they sit above the link
      const NOTE_FONT = '20px Inter, system-ui, sans-serif', NOTE_LINE = 28, NOTE_BETWEEN = 10, NOTE_GAP = 46;
      g.font = NOTE_FONT;
      const noteBlocks = (data.notes || []).map(t => wrapWords(g, t.split(' '), w));
      const noteRows = noteBlocks.reduce((n, b) => n + b.length, 0);
      const noteH = noteRows ? noteRows * NOTE_LINE + (noteBlocks.length - 1) * NOTE_BETWEEN + NOTE_GAP : 0;
      const bottom = footY - noteH;

      // ---- the nearest
      let y = top + 40;
      if (d.lead.length === 1) {
        const p = d.lead[0];
        const PW = 320, PH = 400;
        cover(faces[0], x, y, PW, PH, 28, p.focus);
        const cx = x + PW + 44, cw = x + w - cx;
        let cy = y + 26;
        g.fillStyle = P.mute; g.font = LABEL;
        g.fillText(d.pre.toUpperCase(), cx, cy);
        const nm = fitName(p.name, cw, 80, 44, 2);
        g.fillStyle = P.ink; g.font = nm.size + DISPLAY;
        cy += 6;
        nm.lines.forEach(l => { cy += Math.round(nm.size * 1.04); g.fillText(l.join(' '), cx, cy); });
        if (p.line) {
          cy += 16;
          const ls = setLines(p.line, '26px Inter, system-ui, sans-serif', cw, 6);
          g.fillStyle = P.soft;
          ls.forEach(l => { cy += 38; g.fillText(l.join(' '), cx, cy); });
        }
        y = Math.max(y + PH, cy);
      } else {
        g.fillStyle = P.mute; g.font = LABEL;
        y += 6; g.fillText(d.pre.toUpperCase(), x, y);
        y += 24;
        const GAP = 36, cw = (w - GAP) / 2, PH = 280;
        let low = y + PH;
        d.lead.forEach((p, i) => {
          const cx = x + i * (cw + GAP);
          cover(faces[i], cx, y, cw, PH, 26, p.focus);
          let cy = y + PH + 6;
          const nm = fitName(p.name, cw, 58, 36, 2);
          g.fillStyle = P.ink; g.font = nm.size + DISPLAY;
          nm.lines.forEach(l => { cy += Math.round(nm.size * 1.08); g.fillText(l.join(' '), cx, cy); });
          if (p.line) {
            cy += 4;
            const ls = setLines(p.line, '22px Inter, system-ui, sans-serif', cw, 3);
            g.fillStyle = P.soft;
            ls.forEach(l => { cy += 31; g.fillText(l.join(' '), cx, cy); });
          }
          low = Math.max(low, cy);
        });
        y = low;
      }

      // ---- the axis clauses, in one line, each in the colour of the pole it names
      if (data.headline && data.headline.length) {
        y += 66;
        g.font = "38px 'Wiser Display', Philosopher, sans-serif";
        const words = data.headline.flatMap((p, i) => {
          const text = p.text + (i < data.headline.length - 1 ? ',' : '');
          return text.split(' ').map(t => ({ t, side: p.side }));
        });
        wrapWords(g, words, w).slice(0, 2).forEach((line, n) => {
          if (n) y += 46;
          let cx = x;
          line.forEach(word => {
            g.fillStyle = ink(word.side);
            g.fillText(word.t, cx, y);
            cx += g.measureText(word.t + ' ').width;
          });
        });
      }

      // ---- the next ones, smaller, with their pictures while there is room for them
      if (d.next.length) {
        const COLS = 3, GAP = 28, colW = (w - GAP * (COLS - 1)) / COLS;
        const labelY = y + 72, picTop = labelY + 24;
        let picH = Math.min(240, bottom - 30 - picTop - 80);
        if (picH < 80) picH = 0;
        if (picTop + picH + 50 <= bottom) {
          g.fillStyle = P.mute; g.font = LABEL;
          g.fillText('NEXT CLOSEST', x, labelY);
          d.next.slice(0, COLS).forEach((p, i) => {
            const cx = x + i * (colW + GAP);
            if (picH) cover(faces[d.lead.length + i], cx, picTop, colW, picH, 20, p.focus);
            const nm = fitName(p.name, colW, 36, 26, 2);
            g.fillStyle = P.ink; g.font = nm.size + DISPLAY;
            let ny = picTop + picH + (picH ? 4 : 0);
            nm.lines.forEach(l => { ny += Math.round(nm.size * 1.12); g.fillText(l.join(' '), cx, ny); });
          });
        }
      }

      if (noteRows) {
        g.fillStyle = P.mute;
        g.font = NOTE_FONT;
        let ny = bottom + NOTE_LINE;
        noteBlocks.forEach(block => {
          block.forEach(line => { g.fillText(line.join(' '), x, ny); ny += NOTE_LINE; });
          ny += NOTE_BETWEEN;
        });
      }
    }

    let drawn = false;
    /**
     * Drawn on load, not on click.
     *
     * It used to sit behind the Save button, so the page showed two buttons and a link
     * field and no picture — which is indistinguishable from there being no card at all.
     * The demo this replaces kept its card preview on the page permanently, and it was
     * right to.
     */
    async function draw() {
      if (drawn) return;
      try { await document.fonts.ready; } catch (e) {}
      // A canvas never redraws when a face arrives late, so ask for the three it draws with
      // by name before the first stroke (the headline face is Philosopher Bold, as 'Wiser Display').
      try {
        await Promise.all(['700 23px Poppins', '25px Inter', "58px 'Wiser Display'"].map(f => document.fonts.load(f)));
        // and the italic a reading's verse is set in
        if (data.reading) await document.fonts.load("italic 52px 'Wiser Display'");
        // and the regular italic a kindred spirit's line is set in
        if (data.kindred) await document.fonts.load('italic 400 40px Philosopher');
      } catch (e) {}
      const logo = await mark;
      const g = canvas.getContext('2d');
      const pad = 52;

      g.fillStyle = P.page; g.fillRect(0, 0, W, H);
      g.fillStyle = P.panel;
      roundRect(g, pad, pad, W - pad * 2, H - pad * 2, 44); g.fill();

      const x = pad + 54, w = W - (pad + 54) * 2;

      // the mark, on the text's left edge, then the quiz's name under it
      const markTop = pad + 56;
      drawMark(g, x, markTop, logo);
      let y = markTop + MARK_H + 52;

      g.fillStyle = P.accent;
      g.font = '700 23px Poppins, system-ui, sans-serif';
      g.fillText(data.quiz.toUpperCase(), x, y);

      if (data.reading) {
        drawReading(g, x, y, w, H - pad - 44);
        g.fillStyle = P.mute;
        g.font = '600 22px Poppins, system-ui, sans-serif';
        g.fillText(data.url.toUpperCase(), x, H - pad - 44);
        drawn = true;
        return;
      }

      if (data.who && !data.who.central) {
        await drawWho(g, x, y, w, H - pad - 44);
        g.fillStyle = P.mute;
        g.font = '600 22px Poppins, system-ui, sans-serif';
        g.fillText(data.url.toUpperCase(), x, H - pad - 44);
        drawn = true;
        return;
      }

      if (data.kindred) {
        await drawKindred(g, x, y, w, H - pad - 44);
        g.fillStyle = P.mute;
        g.font = '600 22px Poppins, system-ui, sans-serif';
        g.fillText(data.url.toUpperCase(), x, H - pad - 44);
        drawn = true;
        return;
      }

      // the verdict, each clause in the colour of the pole it names
      g.font = "58px 'Wiser Display', Philosopher, sans-serif";
      const words = data.headline.flatMap((p, i) => {
        const text = p.text + (i < data.headline.length - 1 ? ',' : '');
        return text.split(' ').map(t => ({ t, side: p.side }));
      });
      wrapWords(g, words, w).forEach(line => {
        y += 68;
        let cx = x;
        line.forEach(word => {
          g.fillStyle = ink(word.side);
          g.fillText(word.t, cx, y);
          cx += g.measureText(word.t + ' ').width;
        });
      });

      y += 44;
      g.fillStyle = P.soft;
      g.font = '25px Inter, system-ui, sans-serif';
      wrapWords(g, data.summary.split(' '), w).slice(0, 2).forEach(line => {
        g.fillText(line.join(' '), x, y);
        y += 35;
      });

      /*
       * The card is a POSTER, not the page. It carries the verdict and the picture; the
       * page carries the precision. Trying to fit the six rails under the wheel on a 4:5
       * card left both cramped — the rim labels ran into the first rail and the last rail
       * ran off the bottom — and the rails were only restating what the wheel already says.
       *
       * The wheel therefore takes everything between the summary and the footer, computed
       * rather than fixed: the verdict is one line for some readers and three for others,
       * so the space above it is not a constant.
       */
      const footY = H - pad - 44;

      /*
       * A named outcome's own sentence, between the picture and the link.
       *
       * Measured BEFORE the wheel is drawn and subtracted from the space the wheel is given,
       * rather than written into whatever gap happens to be left: the verdict above runs to
       * one line for some readers and three for others, and a sentence that came out of the
       * data is not a fixed height either. Small type, and the muted ink, because it is a
       * qualification of the name above it and not a second headline.
       */
      const NOTE_FONT = '20px Inter, system-ui, sans-serif';
      const NOTE_LINE = 28;
      const NOTE_BETWEEN = 10;              // two notes are two sentences, not one paragraph
      const NOTE_GAP = 46;                  // clear of the link's cap height underneath
      g.font = NOTE_FONT;
      const noteBlocks = (data.notes || []).map(t => wrapWords(g, t.split(' '), w));
      const noteRows = noteBlocks.reduce((n, b) => n + b.length, 0);
      const noteH = noteRows
        ? noteRows * NOTE_LINE + (noteBlocks.length - 1) * NOTE_BETWEEN + NOTE_GAP
        : 0;
      const bottom = footY - noteH;

      // not on the figure quiz's card, whose one wordless case (nobody named) is the words alone
      if (data.shape === 'bipolar' && !data.who) {
        const top = y + 10;
        const LABELS = 104;                 // room for a two-line rim label, top and bottom
        const R = Math.max(120, Math.min(248, (bottom - 58 - top - LABELS * 2) / 2));
        drawWheel(g, W / 2, top + LABELS + R, R);
      }

      // clear of the summary above, and of the notes or the link below
      if (data.shape === 'unipolar') drawBars(g, x, w, y + 10, bottom - 50);

      if (noteRows) {
        g.fillStyle = P.mute;
        g.font = NOTE_FONT;
        let ny = bottom + NOTE_LINE;
        noteBlocks.forEach(block => {
          block.forEach(line => {
            g.fillText(line.join(' '), x, ny);
            ny += NOTE_LINE;
          });
          ny += NOTE_BETWEEN;
        });
      }

      g.fillStyle = P.mute;
      g.font = '600 22px Poppins, system-ui, sans-serif';
      g.fillText(data.url.toUpperCase(), x, footY);

      drawn = true;
    }

    if ('requestIdleCallback' in window) requestIdleCallback(() => draw(), { timeout: 1200 });
    else setTimeout(draw, 200);

    /* ---------------- the short link ---------------- */
    /*
     * Only where the page was opened by a long code that has a short one (see `mint` above).
     * The long code is swapped out wherever this block printed it: the result link, the
     * invite, the visitor's button and the card's last line. The card is drawn again if it
     * was already drawn. No answer in time means the long link stays, and it works.
     */
    if (block.hasAttribute('data-mint')) {
      const long = block.dataset.code;
      requestShortCode(block.dataset.quiz, long, 4000).then(short => {
        if (!short) return;
        const swap = s => String(s || '').split(long).join(short);
        if (field) field.value = swap(field.value);
        if (inviteField) inviteField.value = swap(inviteField.value);
        const cta = pick('cta');
        if (cta) cta.setAttribute('href', swap(cta.getAttribute('href')));
        data.url = swap(data.url);
        if (drawn) { drawn = false; draw(); }
      });
    }

    const filename = 'wiser-walk-' + data.code + '.png';
    const blob = () => new Promise(res => canvas.toBlob(res, 'image/png'));

    pick('save')?.addEventListener('click', async e => {
      const btn = e.currentTarget;
      btn.disabled = true;
      await draw();
      const b = await blob();
      const href = URL.createObjectURL(b);
      const a = document.createElement('a');
      a.href = href;
      a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(href), 4000);
      btn.disabled = false;
      hint.textContent = 'Saved as ' + filename + '.';
    });

    // Offered only where it can actually send a file. A Share button that silently does
    // nothing is worse than no Share button. Desktop browsers answer yes to canShare and
    // then open nothing, so it is also offered only on a touch screen: phones and tablets.
    const shareBtn = pick('share');
    try {
      const probe = new File([new Blob([''], { type: 'image/png' })], 'x.png', { type: 'image/png' });
      const touch = matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (touch && navigator.canShare && navigator.canShare({ files: [probe] })) shareBtn.hidden = false;
    } catch (e) {}

    shareBtn?.addEventListener('click', async e => {
      const btn = e.currentTarget;
      btn.disabled = true;
      await draw();
      const b = await blob();
      try {
        await navigator.share({
          files: [new File([b], filename, { type: 'image/png' })],
          title: data.quiz,
          // a reading's summary is the situation, which does not travel (see the card data)
          text: data.reading ? data.reading.say : data.say
        });
      } catch (err) {
        if (err && err.name !== 'AbortError') {
          hint.textContent = 'Sharing was not available here. The card is above — save it instead.';
        }
      }
      btn.disabled = false;
    });
  });
</script>
