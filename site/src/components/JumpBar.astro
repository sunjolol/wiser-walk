---
/**
 * A row of in-page anchors, sitting directly under the band on a long page.
 *
 * The method page runs to eighty-nine changelog entries and eight sections; an article
 * runs to five or six headings. Both need a way to see the shape of the page before
 * reading it, which on a phone is a strip that scrolls sideways rather than a wall of
 * pills. The numbers are the real order of the sections, so numbering them is honest.
 */
export interface Props {
  label?: string;
  items: Array<{ id: string; label: string }>;
  /** Number the items. Only true when the order on the page is the order here. */
  numbered?: boolean;
  class?: string;
}
const { label = 'On this page', items, numbered = false, class: cls = '' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
{items.length > 0 && (
  <nav class:list={['jump', cls]} aria-label={label}>
    <p class="jump-label">{label}</p>
    <ul>
      {items.map((it, i) => (
        <li>
          <a href={`#${it.id}`}>
            {numbered && <i aria-hidden="true">{pad(i + 1)}</i>}
            {it.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
