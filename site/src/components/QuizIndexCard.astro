---
/**
 * One quiz in the hub's index: the kit's stripe card, cut to a height a phone can afford
 * four of above the fold.
 *
 * Every quiz gets the same card, whatever its status, because the rule for that index is
 * that no quiz is harder to find than another. The counted facts take the place the card
 * usually gives to "Take it →": somebody choosing between four quizzes wants to know the
 * length of each, and the whole card is already the link.
 *
 * Card.astro is left alone rather than given another flag — it is the site's general stripe
 * card, used by articles and games too, and this one exists only for the index row.
 */
import Icon from './Icon.astro';

export interface Props {
  href: string;
  title: string;
  text: string;
  /** The rotated tag standing on the stripe. Two words at most: "6 axes". */
  meta?: string;
  /** The corner tab: "Quiz" or "Draft". */
  tab?: string;
  /** The counted facts, already joined: "18 statements · about 3 minutes". */
  facts: string;
  icon?: 'compass' | 'flame' | 'scroll' | 'book' | 'arrow';
}
const { href, title, text, meta, tab, facts, icon = 'book' } = Astro.props;
---
<a class="scard qzx" href={href}>
  <span class="scard-stripe" aria-hidden="true">{meta && <span class="scard-tag">{meta}</span>}</span>
  <span class="scard-medal" aria-hidden="true"><Icon name={icon} size={19} /></span>
  {tab && <span class="scard-tab">{tab}</span>}
  <h3>{title}</h3>
  <p>{text}</p>
  <span class="scard-go qzx-facts">{facts} <Icon name="arrow" size={14} /></span>
  {meta && <span class="sr-only"> ({meta})</span>}
</a>
