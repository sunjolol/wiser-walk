---
/**
 * One quiz, the way the hub features it: the words and the counted facts on one half, the
 * instrument's own preview on the other.
 *
 * EVERY quiz gets this block, the flagship's block. A draft carries a chip saying so and
 * nothing else is different, so a quiz that leaves draft status becomes as prominent as the
 * Compass by one field changing in its data file — no edit here and none on the page.
 *
 * The facts arrive already counted, because the page counts them for the index as well and
 * two counts of the same thing drift. Nothing in this file may claim an audit: a quiz that
 * has had one says so through a spec row the page passes in.
 */
import Icon from './Icon.astro';
import QuizPreview from './QuizPreview.astro';
import type { Quiz } from '../lib/engine/types';

export interface Props {
  quiz: Quiz;
  /** The small-caps line above the title, counted from the quiz by the page. */
  kicker: string;
  /** Label and value pairs, likewise counted. */
  spec: Array<{ dt: string; dd: string }>;
  href: string;
}
const { quiz, kicker, spec, href } = Astro.props;
const draft = quiz.status === 'draft';
---
<section class="qz-flag">
  <div class="qz-flag-body">
    <p class="feature-kicker">
      {draft && <span class="qz-chip">Draft</span>}
      <Icon name={quiz.icon} size={13} /> {kicker}
    </p>
    <h3>{quiz.title}</h3>
    <p>{quiz.description}</p>
    <dl class="spec">
      {spec.map(s => <div><dt>{s.dt}</dt><dd>{s.dd}</dd></div>)}
    </dl>
    {/*
      No scope note here. The figure quiz's is five sentences about what nearness is and is
      not, which belongs beside a result that has named somebody — where the result page
      prints it, verbatim — and not in front of a reader still deciding whether to start.
    */}
    <div class="btn-row">
      <a class="btn" href={href}>Start the quiz</a>
      <slot name="more" />
    </div>
  </div>
  <QuizPreview quiz={quiz} />
</section>
