---
/**
 * An article as a painting first and words second. The picture, its alt text and the crop
 * come from the article's own front matter.
 *
 * An article with no picture yet shows no picture. It used to fall back to the walker at
 * dawn, which is the photograph in the footer of every page on the site: a card wearing it
 * would have put the same picture twice on the page it sat on, which is a thing the owner
 * has already rejected once. Every article has its own painting today, so nothing changes
 * on any page now; this is here so the eleventh-hour article without one cannot bring the
 * mistake back.
 */
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  minutes: number;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
}
const { id, title, description, minutes, image, imageAlt, imagePosition } = Astro.props;
/*
 * A card is about 330px wide, and the paintings are 1200. Eleven of them at full size made
 * /articles/ a 2.3 MB page on a phone. Every painting under /img/articles/ has a 560px
 * "-card" copy beside it (made when the painting is added; see CREDITS.md), and the card asks
 * for that one. A picture from anywhere else is used as it is.
 */
const cardImage = image && image.startsWith('/img/articles/') && image.endsWith('.jpg')
  ? image.replace(/\.jpg$/, '-card.jpg')
  : image;
---
<a class="read" href={`/articles/${id}/`}>
  <span class={image ? 'read-pic' : 'read-pic read-pic--none'}>
    {image && (
      <img src={cardImage} alt={imageAlt ?? ''} loading="lazy" decoding="async"
           style={imagePosition ? `object-position:${imagePosition}` : undefined} />
    )}
    <span class="read-time"><Icon name="clock" size={12} /> {minutes} min</span>
  </span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="read-go">Read <Icon name="arrow" size={14} /></span>
</a>
