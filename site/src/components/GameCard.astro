---
/**
 * One game, the way the hub shows it: a dark card carrying the words, the counted facts and
 * a small drawing of the game itself.
 *
 * Redrawn for the dawn pass (2026-09-21). It used to be a light panel with a dotted spec
 * list beside a dark art half — a form, not a room. Now the whole card is the game's own
 * night, with its mark and its ink, and the drawing sits beside the words rather than under
 * a rule: what a player actually meets when they tap Play, at a glance.
 *
 * TWO DRAWINGS, and which one a game gets is a matter of honesty, not taste.
 *
 *   binary  the two answers are the same for every line ("in the Bible" / "not in the
 *           Bible"), so a REAL line out of the pool can be shown above them without
 *           telling anyone the answer. Nothing is spoiled and the card stops reading as
 *           three grey bars that never loaded.
 *   names   four names under a line would say one of those four said it. We do not know
 *           that of any particular line here, so this drawing shows no real line: the card
 *           carries the shape of the question and the names, and the game keeps its own.
 */
import Icon from './Icon.astro';
import type { Game } from '../lib/games';
import type { IconName } from '../lib/icons';

export interface Props {
  game: Game;
  /** The mark and the ink, so no two cards read alike. */
  icon: IconName;
  ink: 'orange' | 'blue';
  /** Short, counted facts. Each one comes off the built game's own metadata. */
  facts?: string[];
  /** How long a run takes, in the game's own words: "2 min a run". */
  clock?: string;
  /**
   * The drawing: the two fixed answers, or four names under a line we do not quote.
   *
   * Optional, and on purpose. A game added to lib/games.ts before anyone has drawn it still
   * gets its room here — its words, its mark and its way in — rather than disappearing off
   * the hub because a page-side map has no entry for it.
   */
  preview?:
    | { kind: 'binary'; answers: [string, string]; line?: string | null }
    | { kind: 'names'; names: string[] };
}
const { game, icon, ink, facts = [], clock, preview } = Astro.props;
---
<a class={`gcard gcard--${ink}`} href={game.href}>
  <div class="gcard-say">
    <span class="gcard-mark"><Icon name={icon} size={20} /></span>
    {/* h2: with no section head over them, each game IS a section of this page, and a page
        that runs h1 straight to h3 reads as a level missing to a screen reader. */}
    <h2>{game.title}</h2>
    <p>{game.tagline}</p>
    {(clock || facts.length > 0) && (
      <ul class="gcard-facts">
        {clock && <li><Icon name="clock" size={13} /> {clock}</li>}
        {facts.map(f => <li>{f}</li>)}
      </ul>
    )}
    <span class="gcard-go">Play <Icon name="arrow" size={14} /></span>
  </div>

  {preview && (
    <div class="mock" aria-hidden="true">
      <div class="mock-fuse"><i></i></div>
      {preview.kind === 'binary' && preview.line ? (
        <div class="mock-card mock-card--line"><span class="mock-q">“</span><q>{preview.line}</q></div>
      ) : (
        <div class="mock-card"><span class="mock-q">“</span><i></i><i></i>{preview.kind === 'binary' && <i></i>}</div>
      )}
      {preview.kind === 'binary' ? (
        <div class="mock-btns"><span>{preview.answers[0]}</span><span>{preview.answers[1]}</span></div>
      ) : (
        <div class="gcard-names">{preview.names.map(n => <span>{n}</span>)}</div>
      )}
    </div>
  )}
</a>
