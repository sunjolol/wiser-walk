---
/**
 * The stripe card, for a quiz, a game or an article in a list.
 *
 * From the Epitaph reference: a vertical stripe with the spectrum poured through smoke, a
 * rotated tag standing on it, a medallion overlapping its edge, and a dark tab in the top
 * corner saying what kind of thing this is. The whole card is the link.
 */
import Icon from './Icon.astro';

export interface Props {
  href: string;
  title: string;
  text: string;
  /** The rotated tag on the stripe: "3 min", "18 statements". Keep it short. */
  meta?: string;
  /** The corner tab: "Quiz", "Game", "Article", "Draft". */
  tab?: string;
  /** The words beside the arrow. */
  go?: string;
  icon?: 'compass' | 'flame' | 'scroll' | 'book' | 'arrow';
  feature?: boolean;
}
const { href, title, text, meta, tab, go = 'Open', icon = 'book' } = Astro.props;
---
<a class="scard" href={href}>
  <span class="scard-stripe" aria-hidden="true">{meta && <span class="scard-tag">{meta}</span>}</span>
  <span class="scard-medal" aria-hidden="true"><Icon name={icon} size={20} /></span>
  {tab && <span class="scard-tab">{tab}</span>}
  <h3>{title}</h3>
  <p>{text}</p>
  <span class="scard-go">{go} <Icon name="arrow" size={14} /></span>
  {meta && <span class="sr-only"> ({meta})</span>}
</a>
