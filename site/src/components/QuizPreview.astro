---
/**
 * What a quiz will show you, drawn from the quiz's own data before a single answer.
 *
 * The shape is READ from the strategy, never guessed: a bipolar quiz previews its axes as
 * rails on the charcoal panel the result page draws its instruments on, and BOTH pole
 * names print on every one of them — a pole encoded by omission is the failure this site
 * refuses to ship. A unipolar quiz has no poles and no centre, so it previews its
 * categories as a flat grid; giving it rails would be the same class of error in the other
 * direction.
 */
import Icon from './Icon.astro';
import type { Quiz } from '../lib/engine/types';
import { groupHref } from '../lib/engine/registry';
import { paragraphs } from '../lib/prose';

export interface Props {
  quiz: Quiz;
  /**
   * The hub shows one of these beside every quiz on the page, so a unipolar quiz's
   * categories are drawn as the kit's chips with one shared ruler under them rather than as
   * a row apiece carrying its own definition. Thirteen definitions belong on the quiz's own
   * page, where a reader has chosen that quiz; in a stack of feature blocks they bury the
   * next quiz down. A bipolar quiz previews the same way either side of this flag: six rails
   * with both pole names is already the compact form.
   */
  compact?: boolean;
}
const { quiz, compact = false } = Astro.props;
const bipolar = quiz.strategy.shape === 'bipolar';

/**
 * How many scores a single category can actually reach — the instrument's own granularity,
 * read from the quiz's config rather than drawn as a smooth bar it cannot deliver. The
 * ruler under each category is cut into exactly that many notches and left empty, because
 * nothing has been answered yet and a filled one would be a number we do not have.
 */
const slots = Math.max(2, quiz.config.radix);
---
<div class="axpv-panel dark">
  <div class="dark-ghost" aria-hidden="true">{bipolar ? 'axes' : 'each one'}</div>

  {bipolar ? (
    <div class="axpv">
      {quiz.groups.map(g => (
        <a class="axpv-row" href={groupHref(quiz, g)}>
          <span class="axpv-name">{g.name}</span>
          <span class="axpv-go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
          <span class="axpv-bar" aria-hidden="true"></span>
          <span class="axpv-poles">
            <span class="axpv-l">{g.left}</span>
            <span class="axpv-r">{g.right}</span>
          </span>
        </a>
      ))}
    </div>
  ) : compact ? (
    <div class="rankpv-brief">
      <ul class="chips">
        {quiz.groups.map(g => (
          <li><a class="chip-link" href={groupHref(quiz, g)}>{g.name}</a></li>
        ))}
      </ul>
      {/* The ruler every one of them is measured on, empty because nothing is answered yet,
          cut into the number of scores this instrument can actually reach. */}
      <span class="rankpv-scale" style={`--slots:${slots}`} aria-hidden="true">
        <span class="rankpv-end">None</span>
        <span class="rankpv-tick"></span>
        <span class="rankpv-end">Strongest</span>
      </span>
    </div>
  ) : (
    <div class="rankpv">
      {quiz.groups.map(g => (
        <a class="rankpv-row" href={groupHref(quiz, g)}>
          <span class="rankpv-name">{g.name}</span>
          <span class="rankpv-go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
          {/*
            Whole, in paragraphs, never cut. Six of the gifts draft's nineteen definitions
            run to a dozen sentences, and a dozen sentences in one block is a paragraph a
            reader skips — which on THIS page means skipping the sentence saying the
            statements cannot see what an event was. Broken at sentence ends, three to a
            paragraph; a one-sentence definition comes out exactly as it did.
          */}
          {g.summary && (
            <span class="rankpv-note">
              {paragraphs(g.summary).map(p => <span class="rankpv-para">{p}</span>)}
            </span>
          )}
          <span class="rankpv-scale" style={`--slots:${slots}`} aria-hidden="true">
            <span class="rankpv-end">None</span>
            <span class="rankpv-tick"></span>
            <span class="rankpv-end">Strongest</span>
          </span>
        </a>
      ))}
    </div>
  )}

  <p class="axpv-note">
    {bipolar
      ? 'Neither end of an axis is the better one. Blue and orange only mark which end is which; read either name for what it says.'
      : 'A ranking has no opposite end and no middle: each one is measured on its own, on the ruler drawn under it. The strongest is the one you are told; if a few come out level they are all named, and if nothing rises far enough above the rest, none is.'}
  </p>
</div>
