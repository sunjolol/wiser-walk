---
/**
 * What a quiz will show you, drawn from the quiz's own data before a single answer.
 *
 * The shape is READ from the strategy, never guessed: a bipolar quiz previews its axes as
 * rails on the charcoal panel the result page draws its instruments on, and BOTH pole
 * names print on every one of them — a pole encoded by omission is the failure this site
 * refuses to ship. A unipolar quiz has no poles and no centre, so it previews its
 * categories as a flat grid; giving it rails would be the same class of error in the other
 * direction.
 *
 * The ranking grid, rewritten 2026-09-20. It used to be wrapped pills sized to their own
 * words, which at nineteen gifts came out ragged, half of them two lines tall, and one
 * running over the pill beside it. Now it is a plain grid of equal cells — equal width and
 * equal height on a row — so a long name wraps inside its cell and nothing moves. No
 * number is printed beside a name: the grid is in quiz order, the result is a ranking, and
 * a "01" against the first gift would read as a rank before a single statement is answered.
 */
import Icon from './Icon.astro';
import type { Quiz } from '../lib/engine/types';
import { groupHref } from '../lib/engine/registry';

export interface Props {
  quiz: Quiz;
}
const { quiz } = Astro.props;
const bipolar = quiz.strategy.shape === 'bipolar';
/* A name of three words or more keeps its last two together, so a narrow cell breaks "the word /
   of knowledge" and never leaves one word alone on the last line ("the word of / knowledge"). */
const tie = (name: string) => name.replace(/ (\S+)$/, (_, last) => (name.trim().split(/\s+/).length >= 3 ? '\u00A0' : ' ') + last);
---
<div class="axpv-panel dark">
  <div class="dark-ghost" aria-hidden="true">{bipolar ? 'axes' : 'each one'}</div>

  {bipolar ? (
    <div class="axpv">
      {quiz.groups.map(g => (
        <a class="axpv-row" href={groupHref(quiz, g)}>
          <span class="axpv-name">{g.name}</span>
          <span class="axpv-go" aria-hidden="true"><Icon name="arrow" size={14} /></span>
          <span class="axpv-bar" aria-hidden="true"></span>
          <span class="axpv-poles">
            <span class="axpv-l">{g.left}</span>
            <span class="axpv-r">{g.right}</span>
          </span>
        </a>
      ))}
    </div>
  ) : (
    <ul class="rankgrid">
      {quiz.groups.map(g => (
        <li>
          {/* The name is a block of its own inside the cell: ::first-letter, which is what
              capitalises these lowercase names, does not apply to a flex container. */}
          <a class="rankgrid-cell" href={groupHref(quiz, g)}>
            <span class="rankgrid-name">{tie(g.name)}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  <p class="axpv-note">
    {bipolar
      ? 'Neither end of an axis is the better one. Blue and orange only mark which end is which; read either name for what it says.'
      : 'Each one is measured on its own. Open any name to read what it means.'}
  </p>
</div>
