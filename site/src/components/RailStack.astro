---
/**
 * The bipolar hero. There is no separate compass wheel: the hero visual and the axis rows
 * are ONE component — full-width diverging rails on a shared centre spine.
 *
 * A circle cannot fit twelve pole labels, so something always gets dropped, which is how
 * the previous version shipped a named pole facing an anonymous blank sector. Stacked
 * rails make that failure structurally impossible: every rail prints both of its pole
 * names, every time, from a type where they are required rather than optional.
 */
import type { BipolarView, Quiz } from '../lib/engine/types';
import { groupHref } from '../lib/engine/registry';

interface Props {
  quiz: Quiz;
  view: BipolarView;
  /** Link each rail's name to its axis page. Off for a preview or a share card. */
  linked?: boolean;
}

const { quiz, view, linked = true } = Astro.props;

/**
 * The zone bounds come from the scoring rules — snapped to the reachable positions the band
 * actually contains — not from a number typed into the CSS. A quiz that moved its band
 * edges, or that runs a longer instrument, cannot ship a visual that disagrees with its own
 * arithmetic.
 */
const [zoneLo, zoneHi] = view.noClaimSpan;
const zoneStyle = `--zone-lo:${zoneLo};--zone-hi:${zoneHi}`;
---
<div class="rails-block" style={zoneStyle}>
  <p class="rails-legend">
    <span class="legend-swatch" aria-hidden="true"></span>
    In the hatched middle the quiz names neither pole.
  </p>

  <div class="rails">
    {view.rows.map(row => {
      // Diverge FROM the centre: the tint grows outward toward whichever pole was chosen,
      // so its length reads as conviction rather than as a score out of a hundred.
      // Geometry from the integer step, so the knob lands exactly on the position the
      // instrument can produce rather than on a rounded percentage of it.
      const at = (row.step / row.steps) * 100;
      const from = Math.min(at, 50);
      const span = Math.abs(at - 50);
      const side = row.value < 50 ? 'left' : row.value > 50 ? 'right' : 'centre';
      const reading = row.noClaim ? row.band : row.lean;
      const href = groupHref(quiz, row);

      return (
        <div
          class:list={['rail', `rail--${side}`, { 'is-centred': row.noClaim }]}
          style={`--pos:${at};--from:${from};--span:${span}`}
        >
          <div class="rail-head">
            <span class="rail-name">
              {linked ? <a href={href}>{row.name}</a> : row.name}
            </span>
            <span class="rail-read">{reading}</span>
          </div>

          {/*
            The geometry gets one label rather than four decorative spans a screen reader
            has to assemble. It does NOT restate the pole names: those are real text in
            .rail-poles below, which is not aria-hidden. "Both pole names print on every
            rail" has to be true of what a screen reader reads, not only of what is drawn,
            and text in an aria-label is not text — it cannot be selected, translated,
            searched or found by a reader who zooms.
          */}
          <div
            class="rail-track"
            role="img"
            aria-label={`${row.name}: ${row.noClaim ? `${row.band}, naming neither pole` : row.lean}`}
          >
            <span class="rail-zone" aria-hidden="true"></span>
            <span class="rail-spine" aria-hidden="true"></span>
            {!row.noClaim && <span class="rail-tint" aria-hidden="true"></span>}
            <span class="rail-knob" aria-hidden="true"></span>
          </div>

          <p class="rail-poles">
            <span>{row.left}</span><span>{row.right}</span>
          </p>
        </div>
      );
    })}
  </div>
</div>
