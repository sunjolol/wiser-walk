---
/**
 * Every outcome of a quiz, as a list of ways in to their own pages.
 *
 * It stood on the home page as "18 traditions, each in its own words", with a button that
 * went to the quiz. The owner moved it to the foot of the quiz's own page (2026-09-21), under
 * the last call to start, and asked for the button to give way to a plain line saying that
 * each name can be opened, because on a phone a list of names does not look tappable. So each
 * row carries an arrow, and the line above says what a tap does.
 *
 * Generic: the nouns, the counts and the links come from the quiz. No icon tile over the
 * heading (the owner, 2026-09-22: no mark over any card's or panel's title).
 *
 * TWO KINDS OF OUTCOME, told apart by the data and never by the quiz's name. An Outcome may
 * carry `who` — "One line identifying who or what this is, under the name", which is how the
 * figure pages print it under their own heading. Where the outcomes carry one, the row prints
 * it too, because a list of twenty-five bare first names asks a reader to already know them;
 * and the sentence above the list says what is in the rows rather than making the Compass's
 * promise about describing a people in their own words, which is true of a tradition's page
 * and would be false of a person's. Where they carry none, this block is word for word what
 * it was.
 */
import Icon from './Icon.astro';
import { outcomeHref } from '../lib/engine/registry';
import { outcomeNounPlural } from '../lib/engine/types';
import type { Quiz } from '../lib/engine/types';

interface Props { quiz: Quiz; }
const { quiz } = Astro.props;
const nouns = outcomeNounPlural(quiz);
const identified = quiz.outcomes.some(o => o.who);
const groupCount =
  ['zero','one','two','three','four','five','six','seven','eight','nine','ten'][quiz.groups.length]
  ?? quiz.groups.length;
---
<section class:list={['oidx', identified && 'oidx--who']} aria-labelledby="oidx-h">
  <div class="oidx-say">
    {identified
      ? <h2 id="oidx-h">{quiz.outcomes.length} {nouns}, one page each</h2>
      : <h2 id="oidx-h">{quiz.outcomes.length} {nouns}, each in its own words</h2>}
    {identified
      ? <p>One line on each, and where they stand on the {groupCount} axes.</p>
      : <p>Where each one stands on the {groupCount} questions, described the way its own people would.</p>}
    <p class="oidx-hint"><Icon name="arrow" size={14} /> <span>Open any of them to read more.</span></p>{/*
      The Compass's traditions also exist as one table with a file behind it. Only that quiz has
      one, so the line is keyed to its slug rather than to a field every other quiz would carry empty.
    */}{quiz.slug === 'theology-compass' && (
      <p class="oidx-hint"><Icon name="arrow" size={14} /> <span>Or <a href="/data/theology-compass/">see all {quiz.outcomes.length} as one table</a>.</span></p>
    )}
  </div>
  <ul class="oidx-list">
    {quiz.outcomes.map(o => (
      <li>
        <a href={outcomeHref(quiz, o)}>
          <span class="oidx-name">{o.name}{o.who && <small>{o.who}</small>}</span>
          <Icon name="arrow" size={14} />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* 3rem above, the air every section on a quiz page takes (.sect in kit.css) */
  .oidx {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr; gap: 1.2rem;
    margin: 3rem 0 0; padding: 1.7rem 1.4rem 1.3rem; border-radius: 24px;
    background: var(--panel); box-shadow: var(--lift);
  }
  .oidx::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 6px; background-image: linear-gradient(180deg, var(--blue), var(--orange)); }
  .oidx h2 { margin: 0; font-family: var(--display); font-weight: 400; font-size: clamp(1.6rem, 6vw, 2.1rem); line-height: 1.1; color: var(--ink); text-wrap: balance; }
  .oidx-say p { margin: .6rem 0 0; color: var(--ink-soft); max-width: 24rem; text-wrap: balance; }
  .oidx-say .oidx-hint {
    display: inline-flex; align-items: center; gap: .5rem; margin-top: 1rem; padding: .5rem .9rem; border-radius: 999px;
    font-family: var(--ui); font-size: var(--fs-label); font-weight: var(--fw-label); letter-spacing: .1em; text-transform: uppercase;
    color: var(--accent); background: var(--accent-soft);
  }
  /* the words are ONE flex item beside the arrow: left loose, the link inside them made three
     items of their own and the line broke into columns on a wide screen */
  .oidx-say .oidx-hint :global(.icon) { flex: none; }
  .oidx-list { margin: 0; padding: 0; list-style: none; }
  .oidx-list li + li { border-top: 1px solid var(--rule); }
  .oidx-list a {
    display: flex; align-items: center; justify-content: space-between; gap: .8rem; min-height: 48px; padding: .55rem .2rem;
    text-decoration: none; font-size: .96rem; line-height: 1.35; color: var(--ink);
  }
  .oidx-list a :global(.icon) { flex: none; color: var(--accent); transition: transform .18s ease; }
  .oidx-list a:hover { color: var(--accent); }
  .oidx-list a:hover :global(.icon) { transform: translateX(3px); }

  /*
   * The one-line identifier, where an outcome carries one. It is written to follow the name
   * ("Paul" then "Pharisee of Tarsus, tentmaker, apostle to the nations"), which is how the
   * outcome's own band prints it, so it sets as a second line under the name and in the
   * quiet ink. The row then grows to two or three lines, so the arrow rides at the top of it
   * rather than floating beside the middle of a paragraph.
   */
  .oidx-name { display: block; min-width: 0; }
  .oidx-name small {
    display: block; margin-top: .14rem; font-size: .78rem; line-height: 1.38;
    color: var(--ink-mute); text-wrap: pretty;
  }
  .oidx--who .oidx-list a { align-items: flex-start; padding: .75rem .2rem; }
  .oidx--who .oidx-list a :global(.icon) { margin-top: .3rem; }

  @media (min-width: 40rem) {
    .oidx-list { columns: 2; column-gap: 2rem; }
    .oidx-list li { break-inside: avoid; }
    .oidx-list li + li { border-top: 0; }
    .oidx-list li { border-bottom: 1px solid var(--rule); }
    /* A name with a line under it needs the whole column at this width; two columns of
       three-line rows read as a wall. It splits one breakpoint later instead. */
    .oidx--who .oidx-list { columns: 1; }
  }
  @media (min-width: 58rem) {
    .oidx--who .oidx-list { columns: 2; column-gap: 2.4rem; }
  }
  @media (min-width: 58rem) {
    .oidx { grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); gap: 2.6rem; padding: 2.3rem 2.4rem 2rem 2.6rem; align-items: start; }
  }
  @media (prefers-reduced-motion: reduce) { .oidx-list a :global(.icon) { transition: none; } }
</style>
