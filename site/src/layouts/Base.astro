---
import '../styles/site.css';
import '../styles/kit.css';
import '../styles/pages/quiz.css';
import '../styles/pages/reference.css';
import '../styles/pages/prose.css';
import '../styles/pages/play.css';
import '../styles/touch.css';
import { QUIZZES, quizHref } from '../lib/engine/registry';
import { liveGames } from '../lib/games';
import { SEO, ogImageFor } from '../lib/seo';
import { ACCOUNTS_READY, ACCOUNTS_VISIBLE } from '../lib/account/config';
import Icon from '../components/Icon.astro';

export interface Props {
  title: string;
  description: string;
  /** Result pages and unaudited drafts stay out of the index; content pages do not. */
  noindex?: boolean;
  /**
   * The page's referrer policy, where the default is not safe enough.
   *
   * /account/password/ is opened from an email with a one-time token in its address. Its
   * own inline script cleans the address bar before anything in the body runs, but the
   * stylesheet request in the head is issued during head parse, before that script, and
   * would carry the token in its Referer header. This closes that one gap, and it has to
   * live here because it is a head tag and pages cannot add those.
   */
  referrer?: string | null;
  /** JSON-LD for this page, serialised into a script tag. */
  jsonLd?: Record<string, unknown> | null;
  /**
   * The trail from the home page to this one, innermost last. Paths are fine; they are
   * resolved against the site origin here, because a BreadcrumbList with relative items is
   * ignored. Built in one place so a page cannot publish a trail that does not match its
   * own URL scheme.
   */
  breadcrumbs?: Array<{ name: string; url: string }> | null;
  ogType?: string;
}

const {
  title, description, noindex = false, jsonLd = null, breadcrumbs = null, ogType = 'website',
  referrer = null
} = Astro.props;

const breadcrumbLd =
  breadcrumbs && breadcrumbs.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(b.url, Astro.site).href
        }))
      }
    : null;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteName = 'Wiser Walk';
const seo = SEO[Astro.url.pathname];
/*
 * The brand suffix, now conditional.
 *
 * " — Wiser Walk" was appended to every title that seo.ts did not override, which cost 13
 * characters on 80 pages and pushed most of them past the width a result is rendered at:
 * the National Baptist tradition page shipped a 118-character title. Nobody is searching
 * the brand yet, so on a long title the suffix is pure cost and the distinguishing words
 * are the ones that have to survive. It is kept wherever there is room for it, which is
 * where it does the small job it was added for.
 */
const withBrand = title === siteName ? title : `${title} — ${siteName}`;
const fullTitle = seo ? seo.title : withBrand.length <= 60 ? withBrand : title;
const metaDescription = seo ? seo.description : description;
/* What a feed shows: the search title where there is one (it is the inviting one), and the
   page's own card. Absolute URLs, because a crawler does not resolve a relative image. */
const socialTitle = seo ? seo.title : title;
const ogImage = new URL(ogImageFor(Astro.url.pathname), Astro.site).href;

const here = Astro.url.pathname;
// Finished quizzes before drafts, here as on the home page.
const footQuizzes = [...QUIZZES].sort((a, b) => Number(a.status === 'draft') - Number(b.status === 'draft'));
const footGames = liveGames();
const FOOT_SHORT: Record<string, string> = {
  'seven-deadly-sins': 'Which of the 7 deadly sins are…',
  'which-psalm': 'Which Psalm are you living?'
};
const isCurrent = (href: string) => here === href || here.startsWith(href.replace(/\/$/, '') + '/');
/** Computed at build, so the footer cannot be caught printing last year. */
const year = new Date().getFullYear();

/**
 * The nav.
 *
 * Quizzes and Games carry a menu of everything they hold, so that one tap from any page
 * reaches any quiz — the owner found the others buried behind the flagship. The list is
 * built from the registry, so a new quiz appears in the nav of every page on the site
 * without this file changing, and a draft says it is one.
 *
 * "All quizzes" is deliberately the first item: the menu replaces a link to the hub, and a
 * reader who wanted the hub must not have to hunt for it at the bottom of a list.
 */
const NAV: Array<{
  href: string;
  label: string;
  /** A mark instead of the word, where the row is too tight for both. See "My results". */
  icon?: 'users';
  items?: Array<{ href: string; label: string; tag?: string }>;
}> = [
  {
    href: '/quizzes/',
    label: 'Quizzes',
    items: [
      { href: '/quizzes/', label: 'All quizzes' },
      // Finished quizzes before drafts, as on the home page, /quizzes/, /me/ and the footer.
      // The menu was the one place a draft sat in the middle of the live ones.
      ...footQuizzes.map(q => ({
        href: quizHref(q),
        label: q.title,
        tag: q.status === 'draft' ? 'Draft' : undefined
      }))
    ]
  },
  {
    href: '/games/',
    label: 'Games',
    items: [
      { href: '/games/', label: 'All games' },
      ...footGames.map(g => ({ href: g.href, label: g.title, tag: undefined }))
    ]
  },
  /*
   * Articles opens a menu for the same reason Quizzes and Games do: the comparison pages
   * ("Lutheran vs Reformed") are writing, they are the only part of the site with no home
   * in the row, and a reader who wanted them had no way to learn they existed. Two items,
   * built exactly like the other two menus, so the phone's scroller, the keyboard and the
   * close-on-open script all already handle it.
   */
  {
    href: '/articles/',
    label: 'Articles',
    items: [
      { href: '/articles/', label: 'All articles' },
      { href: '/compare/', label: 'Compare traditions' }
    ]
  },
  // No Method. It is a page about how the work was done, and the nav is for the things a
  // reader came for; /about/ links to it in one sentence, so it stays reachable and crawlable.
  // The owner's call (2026-09-21): the header's last word is the way to give. About stays in the footer.
  { href: '/support/', label: 'Donate' },
  /*
   * Last, and the only item with a mark: the row already holds four items and two carets,
   * and until 46rem "My results" is two words more than it can take. Below that the mark
   * stands alone — the link keeps an aria-label at every width, so its name never depends
   * on what is currently on screen. The widths are measured in kit.css, under "my results".
   */
  { href: '/me/', label: 'My results', icon: 'users' }
];

/*
 * Once the public can see accounts, "My results" leaves the nav: the account pair beside the
 * bulb takes over the job, "Log in" and "Sign up" for a guest and "My profile" (the same
 * /me/) for somebody logged in. Until then the nav is the list above, untouched, so a build
 * with the doors shut comes out exactly as it did.
 *
 * With no "My results" item the dot script at the foot of the page finds nothing and stops.
 * That is deliberate: "My profile" says in words where it goes, and a logged-in reader always
 * has something behind it, so a dot there would be lit on every page and say nothing. (Its
 * note is not edited to say so, because that script is printed into every page as written.)
 */
const navItems = ACCOUNTS_VISIBLE ? NAV.filter(n => n.href !== '/me/') : NAV;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* As early as head allows: it has to be read before the first request this page makes. */}
    {referrer && <meta name="referrer" content={referrer} />}
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {/*
      A page that may be indexed also says its picture may be shown large. Without this a search
      engine keeps to a thumbnail, or to nothing; with it the painting on an article or the card
      on a quiz can appear beside the result and in Discover.
    */}
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="max-image-preview:large" />}
    {/*
      The site icon (design/icon/render.mjs draws it). Google only shows a favicon whose side is
      a multiple of 48 px, which is why 48, 96 and 192 are all offered and the .ico leads with 48.
      No web manifest: this is a website, not an app (see CLAUDE.md).
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/*
      Feed autodiscovery, on every page rather than on the articles alone: a reader who
      wants to follow the writing is as likely to be standing on a quiz as on the hub, and
      a browser or a reader app looks for this tag wherever it lands.
    */}
    <link rel="alternate" type="application/rss+xml" title="Wiser Walk articles" href="/articles/feed.xml" />

    {/*
      Applied before first paint, so a reader who chose a theme never sees the other one
      flash. The stylesheet still follows the system setting when nothing is stored, which
      is why this only ever writes an explicit value.
    */}
    <script is:inline>
      try {
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'light' || q === 'dark') localStorage.setItem('ww-theme', q);
        var t = q === 'light' || q === 'dark' ? q : localStorage.getItem('ww-theme');
        if (t === 'dark') document.documentElement.dataset.theme = 'dark';
        else document.documentElement.dataset.theme = 'light';
      } catch (e) { document.documentElement.dataset.theme = 'light'; }
    </script>

    {ACCOUNTS_READY && (
      /*
        Whether there is an account behind this browser, read here for the same reason the
        theme is: the pages that show it must be right on the first paint rather than flick
        from one state to the other. It is one small key holding an address and an expiry,
        written when somebody signs in; no network, no library, and a storage that refuses
        to be read simply leaves the attribute off.

        Its own tag, and not a second try inside the theme's: with no project behind the
        build there is no account to be in, and then this is not on the page at all rather
        than on it doing nothing. It also answers a different question from the links
        switch. A browser that IS signed in must see its account whatever the public can
        see, so everything signed-in asks ACCOUNTS_READY and this attribute, and only what
        a signed-OUT reader is shown waits for ACCOUNTS_VISIBLE.
      */
      <script is:inline>
        try {
          var acct = JSON.parse(localStorage.getItem('ww.acct.v1'));
          if (acct && acct.e) document.documentElement.dataset.account = 'in';
        } catch (e) {}
      </script>
    )}

    {import.meta.env.DEV && (
      /*
        Development only, and compiled out of anything that is ever served: ?as=in puts the
        browser into the signed-in chrome without a real account, and ?as=out takes it back
        out again. It exists so the two states can be looked at side by side while they are
        being designed, which is the only way to be sure neither of them jumps.
      */
      <script is:inline>
        try {
          var as = new URLSearchParams(location.search).get('as');
          if (as === 'in') {
            localStorage.setItem('ww.acct.v1', JSON.stringify({ e: 'you@example.com', x: 0 }));
            localStorage.setItem('ww.acct.synced', new Date().toISOString());
            document.documentElement.dataset.account = 'in';
          } else if (as === 'out') {
            localStorage.removeItem('ww.acct.v1');
            localStorage.removeItem('ww.acct.synced');
            delete document.documentElement.dataset.account;
          }
        } catch (e) {}
      </script>
    )}

    {/*
      The faces are served from /fonts/ (see public/fonts/fonts.css) rather than from Google:
      one origin, no third-party connection, and the files cache for a week. The two preloads
      are the faces every first paint needs, body text and the headline (Philosopher Bold, which
      'Wiser Display' is); the rest load as the stylesheet asks for them. The stylesheet carries
      a version because it caches for a week: when the files it names change, the number goes up,
      or a phone that visited keeps asking for the old ones (2026-09-23, the Philosopher swap).
    */}
    <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/philosopher-700-latin-unhinted.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css?v=2" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialTitle} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={metaDescription} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}

    <script is:inline>
      // A result page's address is its result code, and a comparison page's address is two
      // of them. Strip the codes before analytics sees the view, so /r/<quiz>/<code>/ is
      // counted as /r/<quiz>/ and /c/<quiz>/<a>.<b>/ as /c/<quiz>/. No code is ever
      // recorded, and a pair of codes is not recorded either: two people who compared
      // results would otherwise be joined up in a log, which is exactly what a page that
      // stores nothing must not do by the back door.
      // An account page's address can carry a one-time token, because it is opened from an
      // email and an email client is not to be trusted with a fragment. The path is all that
      // is ever counted for those, so the query and the hash go before the view is sent.
      // The queue stub is the same one the Vercel adapter injects; defining it again is a no-op.
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
      window.va('beforeSend', function (event) {
        try {
          var u = new URL(event.url);
          if (u.pathname.indexOf('/account/') === 0) {
            u.search = '';
            u.hash = '';
            return Object.assign({}, event, { url: u.toString() });
          }
          var m = u.pathname.match(/^\/(r|c)\/([^/]+)\/[^/]+\/?$/);
          if (m) {
            u.pathname = '/' + m[1] + '/' + m[2] + '/';
            u.search = '';
            u.hash = '';
            return Object.assign({}, event, { url: u.toString() });
          }
        } catch (e) {}
        return event;
      });
    </script>
  </head>
  <body>
    <div class="sheet">
    <header class:list={['site-head', ACCOUNTS_VISIBLE && 'site-head--acct']}>
      <div class="wrap">
        {/* The owner's logo (2026-09-22): his brush-stroke W, and the two words drawn from his
            Amatry font as outlines (design/tools/wordmark.py), so the font file itself is
            never served. The words are a mask filled with the text colour; the link's own
            label is what a screen reader hears. */}
        <a class="brand" href="/" aria-label="Wiser Walk, home">
          <img class="brand-mark" src="/img/logo-w.png" width="47" height="34" alt="" />
          <span class="brand-word" aria-hidden="true"></span>
        </a>
        {/*
          The menus are <details>, so they open with JavaScript off and the keyboard already
          works; `name` makes the two of them mutually exclusive where the browser supports
          it, and the script at the foot of the page does the rest. aria-current stays on the
          LINKS, which is where it means something; the summary of a menu holding the current
          page is only marked visually.
        */}
        <nav>
          {navItems.map(n => n.items ? (
            <details class:list={['navmenu', n.items.some(i => isCurrent(i.href)) && 'here']} name="sitenav">
              <summary>
                {n.label}
                <svg class="navmenu-caret" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                     stroke-linejoin="round"><path d="M6 9.5l6 6 6-6"/></svg>
              </summary>
              <div class="navmenu-panel">
                <ul>
                  {n.items.map(i => (
                    <li>
                      <a href={i.href} aria-current={here === i.href ? 'page' : undefined}>
                        <span>{i.label}</span>
                        {i.tag && <span class="navmenu-tag">{i.tag}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ) : n.icon ? (
            <a class="nav-me" href={n.href} aria-label={n.label}
               aria-current={isCurrent(n.href) ? 'page' : undefined}>
              <Icon name={n.icon} size={16} />
              <span class="nav-me-word">{n.label}</span>
              <span class="nav-me-dot" aria-hidden="true"></span>
            </a>
          ) : (
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>{ACCOUNTS_VISIBLE && (
          /*
            The account pair (the owner, 2026-09-22): "Log In" as text and "Sign Up" on a wash
            of the brand's colours for a guest, "My Profile" for somebody logged in. Title case
            here, as the owner asked; the pages themselves keep "Log in" and "Sign up" in their
            own sentences. It sits outside <nav>
            because on a phone it is not in the nav's row: it takes the bulb's place at the top
            right, where people look for it, and the bulb moves down to the end of the nav row.

            Both states are in the page and the attribute the head script writes before first
            paint says which one shows, so nobody sees the wrong one flash. They share one grid
            cell, so the slot is as wide as the wider of the two whichever is showing, and
            nothing beside it moves if the state changes while the page is open (/me/ drops
            the attribute when the account turns out to be gone).

            Hung off </nav> with no whitespace, so a build with the doors shut is unchanged
            down to the byte.
          */
          <div class="head-acct">
            <span class="head-acct-out">
              <a class="head-login" id="head-login" href="/account/sign-in/"
                 aria-current={isCurrent('/account/sign-in/') ? 'page' : undefined}>Log In</a>
              <a class="head-join" href="/account/sign-up/"
                 aria-current={isCurrent('/account/sign-up/') ? 'page' : undefined}>Sign Up</a>
            </span>
            <a class="head-me" href="/me/" aria-current={isCurrent('/me/') ? 'page' : undefined}>
              <span class="head-me-mark" aria-hidden="true"><Icon name="users" size={16} /></span>
              <span>My Profile</span>
            </a>
            {/*
              After logging in, back to the page they were reading rather than to the profile.
              Added in the browser rather than printed into the page, so every built page
              carries the same plain address for the way in (switch-test.mjs looks for it);
              without the script the link still works and lands on the profile. The log-in
              page runs whatever it is given through safeNext(), which refuses anything that
              is not a plain path on this site. Nothing is added where the profile is the
              better landing anyway: the home page, /me/ itself, and the account pages.
            */}
            <script is:inline>
              (function () {
                var a = document.getElementById('head-login');
                var p = location.pathname;
                if (!a || p === '/' || p === '/me/' || p.indexOf('/account/') === 0) return;
                a.href = '/account/sign-in/?next=' + encodeURIComponent(p);
              })();
            </script>
          </div>
        )}
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme">
          <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" fill="none"
               stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <g class="rays">
              <path d="M12 1.3v1.8"/><path d="M4.4 4.4l1.3 1.3"/><path d="M19.6 4.4l-1.3 1.3"/>
              <path d="M1.4 12.2h1.8"/><path d="M20.8 12.2h1.8"/>
            </g>
            <path class="glass" d="M12 5a5.3 5.3 0 0 0-3.5 9.3c.6.55.95 1.3.95 2.1v.4h5.1v-.4c0-.8.35-1.55.95-2.1A5.3 5.3 0 0 0 12 5z"/>
            <path d="M9.7 18.6h4.6"/><path d="M10.5 20.8h3"/>
          </svg>
        </button>
      </div>
    </header>

    <main class="wrap page"><slot /></main>

    {/*
      The footer, rebuilt 2026-09-20.
      It was a wall of eleven links under two paragraphs, half of them about how the site was
      made. What a footer is for is the way back into the things a reader came for, so it now
      holds three groups and nothing else: every quiz, every game, and the two pages that are
      neither. The Quizzes group is the wide one because quiz titles are sentences, and none
      of them is allowed to wrap.
    */}
    <footer class="site-foot">
      {/*
        The footer opens on the walk itself: a figure on a hill at first light, which is the
        site's name as a picture and the one place its colour is allowed to be a photograph.
        The sign-up stands on it, because "keep walking" is the honest thing to say to someone
        who has reached the foot of a page. Below it, three groups and nothing else.
      */}
      <div class="foot-dawn">
        <img src="/img/hero-dawn.jpg" alt="" loading="lazy" decoding="async" width="2000" height="1335" />
        <div class="wrap foot-dawn-in">
          <div class="foot-dawn-say">
            <h2>Keep walking.</h2>
            <p>{ACCOUNTS_VISIBLE
              ? 'Make a free profile. Save every result and see what they add up to.'
              : 'New quizzes and games as they are made.'}</p>
          </div>
          {/*
            A free profile (the owner, 2026-09-23). This box used to put an address on a mailing
            list and start nothing; it starts the same account sign-up as /me/ and the foot of
            a result page now, so "Sign up" means one thing wherever it is printed. Hidden when
            signed in, with the rest of the band's words (kit.css). With no way in for the
            public there is nothing for it to start, so there is no box.

            A GET to the sign-up page, as on /me/, so it still does something with the script
            blocked: that page opens with the address already typed. The script that sends the
            email is the processed one at the foot of this file. The small line is the status
            line's resting text: an answer is printed in its place, and the line comes back
            when the field is touched again.
          */}
          {ACCOUNTS_VISIBLE && (
            <form class="foot-signup" id="foot-signup" method="get" action="/account/sign-up/" novalidate>
              <div class="foot-signup-row">
                <label class="sr-only" for="foot-email">Your email address</label>
                <input id="foot-email" type="email" name="email" required autocomplete="email"
                       inputmode="email" spellcheck="false" autocapitalize="none"
                       placeholder="you@example.com" aria-describedby="foot-signup-status" />
                {/* After the field, not before it: the field's backdrop-filter gives it a
                    stacking context of its own, which painted over the mark when the mark
                    came first, and the envelope was never seen. */}
                <span class="foot-signup-icon" aria-hidden="true"><Icon name="mail" size={17} /></span>
                <button class="btn" type="submit">Sign up</button>
              </div>
              <p class="foot-signup-status" id="foot-signup-status" role="status" aria-live="polite"
                 data-rest="We'll email you a link to choose a password, and a note when something new is made.">We'll email you a link to choose a password, and a note when something new is made.</p>
            </form>
          )}
        </div>
      </div>

      <div class="foot-ghost" aria-hidden="true">wiser walk</div>
      <div class="wrap foot-main">
        <div class="foot-say">
          <p class="foot-brand">
            <img class="brand-mark" src="/img/logo-w.png" width="47" height="34" alt="" loading="lazy" />
            <span class="brand-word" role="img" aria-label="Wiser Walk"></span>
          </p>
          <p class="foot-line">
            Quizzes, games and articles for understanding yourself, and your walk with God,
            a little better.
          </p>
          {/*
            One quiet pill, not a second call to action: the sign-up above it is the footer's
            loud thing, and two gradients in one footer would leave a reader choosing between
            them instead of reading either.
          */}
          <a class="foot-support" href="/support/"><Icon name="sparkle" size={14} /> Support Wiser Walk</a>
        </div>

        <nav class="foot-cols" aria-label="Site">
          <div class="foot-col foot-col--blue">
            <h4>Quizzes</h4>
            <ul>
              {/*
                ONE title is cut short here BY HAND, by the owner's instruction (2026-09-21): at full
                length it ran into the Games column. It is a stopgap, not a rule: he plans to replace
                that quiz's title with a shorter one, and then this map goes. Do not add to it.
              */}
              {footQuizzes.map(q => (
                <li><a href={`/q/${q.slug}/`} title={FOOT_SHORT[q.slug] ? q.title : undefined}>{FOOT_SHORT[q.slug] ?? q.title}</a></li>
              ))}
              <li><a class="foot-all" href="/quizzes/">All quizzes <Icon name="arrow" size={12} /></a></li>
            </ul>
          </div>
          <div class="foot-col foot-col--orange">
            <h4>Games</h4>
            <ul>
              {footGames.map(g => <li><a href={g.href}>{g.title}</a></li>)}
              <li><a class="foot-all" href="/games/">All games <Icon name="arrow" size={12} /></a></li>
            </ul>
          </div>
          <div class="foot-col foot-col--blue">
            <h4>More</h4>
            <ul>
              <li><a href="/articles/">Articles</a></li>
              {/* The comparison pages are writing, and this is where the writing lives. */}
              <li><a href="/compare/">Compare traditions</a></li>
              <li><a href="/about/">About</a></li>{ACCOUNTS_VISIBLE && (
                /* The header's way to /me/ is the account pair, which a guest reads as "make an
                   account". Results kept on this device are on that same page, so a guest who
                   took a quiz before accounts existed still has a plain way back to them. */
                <li><a href="/me/">My profile</a></li>
              )}
            </ul>
          </div>
        </nav>
      </div>
      <div class="wrap foot-bar">
        {/*
          One line, in the row that already exists (2026-09-21). What people may do with the
          site belongs where a reader instinctively looks for the small print; the licence,
          and the two things here that were never ours to license, are on /about/ under the
          heading this points at.

          It shares the copyright's paragraph on purpose: a second <p> would stack a second
          stamp of uppercase micro-type under the first, and this is a footnote, not an
          announcement. And it is four words because the row is uppercase micro-type with
          .14em of tracking, which gives a phone about fifty characters a line: "Free to
          print, quote and share, with credit" wrapped and left "with credit" hanging on a
          line of its own, which is the kind of orphan the owner has thrown out before.
        */}
        <p>© {year} Wiser Walk · <a href="/about/#use">Free to use, with credit</a></p>
      </div>
    </footer>
    </div>

    <script is:inline>
      /*
       * The nav menus already open, close and take the keyboard on their own: they are
       * <details>. This adds only the three things a <details> cannot do for itself —
       * close when another opens (where the browser does not honour the shared `name`),
       * close on a click outside, and close on Escape, putting the focus back where the
       * reader left it. With this script blocked the menus still work.
       */
      (function () {
        var menus = [].slice.call(document.querySelectorAll('.site-head .navmenu'));
        if (!menus.length) return;
        var closeAll = function (except) {
          menus.forEach(function (d) { if (d !== except) d.open = false; });
        };
        menus.forEach(function (d) {
          d.addEventListener('toggle', function () { if (d.open) closeAll(d); });
        });
        document.addEventListener('click', function (e) {
          if (!e.target.closest || !e.target.closest('.site-head .navmenu')) closeAll(null);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          var open = document.querySelector('.site-head .navmenu[open]');
          if (!open) return;
          open.open = false;
          var s = open.querySelector('summary');
          if (s) s.focus();
        });
      })();

      /*
       * A dot on "My results" when there is something behind it.
       *
       * The key is read raw rather than through lib/shelf, because this runs inline on every
       * page and importing the engine to count a list would be a module for a dot. It reads
       * and never writes; with this script blocked the item is a plain link, which is what it
       * already is.
       *
       * Signed in, there is something behind it whatever this particular browser has stored,
       * so the mark carries the SAME dot: one mark, one size, one fill. A second badge, or a
       * ring here and a fill there, is the row of mismatched state marks the owner threw out.
       * The link itself does not change either. /me/ is where an account lives as well as
       * where the device's own results do, so the door is the same door in both states.
       *
       * The attribute is the whole test, and no build flag is needed beside it: it is only
       * ever written by the head script above, which is only on the page when there is a
       * project behind the build. Signed in is signed in whether or not the public can see
       * the way in yet.
       */
      (function () {
        var item = document.querySelector('.site-head .nav-me');
        if (!item) return;
        if (document.documentElement.dataset.account === 'in') {
          item.classList.add('has-saved');
          return;
        }
        try {
          var saved = JSON.parse(localStorage.getItem('ww.shelf.v1'));
          if (Array.isArray(saved) && saved.length) item.classList.add('has-saved');
        } catch (e) {}
      })();

      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;

        var media = window.matchMedia('(prefers-color-scheme: dark)');
        // With nothing stored the page follows the system, so "what is showing" is not the
        // same question as "what was chosen".
        var showing = function () {
          return root.dataset.theme === 'dark' ? 'dark' : 'light';
        };
        var paint = function () {
          var light = showing() === 'light';
          btn.classList.toggle('lit', light);
          btn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
          btn.setAttribute('aria-pressed', String(!light));
        };
        btn.addEventListener('click', function () {
          var next = showing() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('ww-theme', next); } catch (e) {}
          paint();
        });
        // Keep following the system until the reader has actually chosen.
        paint();
      })();
    </script>{ACCOUNTS_READY && (
    /*
      Results finished on this device, handed on to the account.

      The quiz runner saves to the shelf and sends the reader to their result in the same
      breath, so the upload cannot happen there: a request started on the way out of a page
      is cancelled with the page. The runner says "ww:finished" instead; this puts the finish
      on a short queue, and the next page load empties it.

      It is here for a browser that is SIGNED IN, which is a different question from whether
      the public can see the way in, so it is gated on there being a project at all and on
      the hint key this browser holds. The owner has to be able to finish a quiz on the live
      domain and watch it reach his account while the entry points are still switched off.

      TWO THINGS ABOUT THIS BLOCK, both learned the hard way on 2026-09-21.

      It is the ONLY processed script tag in this file, and it has to stay the only one. Astro
      hoists every processed script in a component and renders a marker for each; with more
      than one, and one of them inside a conditional as this is, the markers cross and a page
      loads the wrong script. It was watched happening on the quiz page, which shipped the
      account listener in place of the runner. Everything else here is is:inline, which is
      not hoisted and not affected. If a second processed script is ever wanted in this
      layout, take the conditional off this one first and check what each page actually
      loads.

      And it imports nothing at the top. The first version did, and put the whole 141 KB quiz
      engine on every page on the site: lib/account/session used to import a runtime value
      from shelf.ts, which imports the registry. session.ts is pure now, so that particular
      trap is gone, but the two key names are still written out here rather than imported,
      because this chunk is loaded by every page that a signed-in reader opens and the right
      size for it is as close to nothing as it can be. The keys are defined in
      lib/account/session and must not diverge from it, exactly as the dot on "My results"
      above reads ww.shelf.v1 raw.

      Finally, it is hung off the script above with no whitespace between them, and this
      note is INSIDE the expression rather than beside it. An expression that renders
      nothing still leaves the whitespace on each side of it, and with no project behind
      the build every page on the site has to come out of this change exactly as it went
      in, down to the byte.

      THE FOOTER'S SIGN-UP lives here too (2026-09-23), for the same first reason: it has to
      load the account client, which only a processed script can import, and this is the one
      processed script this file may have. It is the signed-OUT half of the block. The form
      is printed only where the public can see accounts, which is never without a project,
      so it is always inside this gate. The client, and the Supabase SDK behind it, load when
      the button is pressed and not before.
    */
    <script>
      const HINT = 'ww.acct.v1';
      const QUEUE = 'ww.acct.queue';
      const read = key => {
        try { return localStorage.getItem(key); } catch (e) { return null; }
      };

      if (read(HINT)) {
        let waiting = 0;
        try {
          const queued = JSON.parse(read(QUEUE) || '[]');
          waiting = Array.isArray(queued) ? queued.length : 0;
        } catch (e) {
          /* blocked or hand-edited storage has nothing to send */
        }
        // The runner's own element, so the listener is attached on the page a quiz is taken
        // on and nowhere else. Loading happens now; the reader is eighteen statements away
        // from needing it, and the write itself has to be there the instant they finish.
        const running = document.getElementById('runner');

        if (waiting || running) {
          import('../lib/account/sync')
            .then(m => {
              if (running) {
                document.addEventListener('ww:finished', event => {
                  const e = event.detail;
                  if (e && e.quiz && e.code && e.at) m.queueResult(e);
                });
              }
              if (waiting) m.flushQueue();
            })
            .catch(() => {
              /* Silent by design: the queue keeps its entries and the next page load tries
                 again. Nothing a reader is doing depends on this having happened. */
            });
        }
      }

      /*
       * The footer's sign-up, exactly as /me/ starts one. The answer is printed where the
       * small line is, and the small line comes back when the field is touched again.
       */
      const foot = document.getElementById('foot-signup') as HTMLFormElement | null;
      const footField = document.getElementById('foot-email') as HTMLInputElement | null;
      const footStatus = document.getElementById('foot-signup-status');
      const footButton = foot?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      if (foot && footField && footStatus && footButton) {
        const rest = footStatus.dataset.rest || '';
        const say = (text: string, kind?: string) => {
          footStatus.textContent = text || rest;
          footStatus.classList.remove('is-busy', 'is-bad');
          if (kind) footStatus.classList.add('is-' + kind);
        };

        footField.addEventListener('input', () => {
          if (footStatus.textContent !== rest) say('');
        });

        foot.addEventListener('submit', async event => {
          event.preventDefault();
          if (footButton.disabled) return;

          const email = footField.value.trim();
          if (!email) {
            say('Enter your email address.', 'bad');
            footField.focus();
            return;
          }

          footButton.disabled = true;
          say('Sending…', 'busy');

          let done: { ok: boolean; code?: string; say?: string } = { ok: false };
          try {
            const { requestLink } = await import('../lib/account/client');
            done = await requestLink(email);
          } catch (e) {
            /* the sentence below covers it */
          }

          if (done.ok) {
            // The page that prints the address back reads it from this tab's own storage.
            // Never in the URL, where it would sit in history and in a server's log.
            try { sessionStorage.setItem('ww.acct.to', email); } catch (e) { /* that page manages without it */ }
            location.href = '/account/check-email/';
            return;
          }

          footButton.disabled = false;
          say(done.say || 'That did not go through. Try again in a moment.', 'bad');
          if (done.code === 'address') footField.focus();
        });
      }
    </script>
    )}
  </body>
</html>
