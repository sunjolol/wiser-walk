---
/**
 * A quiz: its intro, and the runner it turns into.
 *
 * The intro is composed from the quiz's own data — counts, axes or categories, both pole
 * names on every axis — so adding a quiz still means adding a data file. Everything
 * introductory lives INSIDE #intro, which the runner already hides when play starts, so
 * the question screen is the whole page without the script having to learn a new rule.
 */
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import QuizPreview from '../../components/QuizPreview.astro';
import { QUIZZES, getQuiz } from '../../lib/engine/registry';
import { capitalise, groupNounPlural, outcomeNounPlural } from '../../lib/engine/types';

export function getStaticPaths() {
  return QUIZZES.map(q => ({ params: { quiz: q.slug } }));
}

const quiz = getQuiz(Astro.params.quiz)!;
const isDraft = quiz.status === 'draft';
const bipolar = quiz.strategy.shape === 'bipolar';

/**
 * A quiz long enough to need a one-sentence way in (notes.introShort) is a quiz whose frame
 * is long enough to fold: its three notes go into one <details> under the quick start
 * instead of standing open between the reader and the start button. A quiz with one short
 * note — the Compass has exactly one — prints it as it always did.
 */
const folded = Boolean(quiz.notes?.introShort);

/**
 * The ghost word behind the band is taken from the quiz's own title — the last word long
 * enough to read at 40vw — so a new quiz brings its own and none is ever invented here.
 */
const words = quiz.title.toLowerCase().replace(/[^a-z\s]/g, ' ').split(/\s+/).filter(Boolean);
const ghost = [...words].reverse().find(w => w.length >= 5) ?? words[words.length - 1] ?? quiz.slug;
const painted = quiz.title
  .split(/\s+/)
  .find(w => w.toLowerCase().replace(/[^a-z]/g, '') === ghost);

/**
 * A draft says so in the hero chip, where the facts about the instrument are, rather than
 * only two thousand pixels further down: the hub's card already marks it DRAFT on its face,
 * and a reader who starts here should not learn it later than a reader who starts there.
 */
const eyebrow = [
  isDraft ? 'Unaudited draft' : null,
  `${quiz.items.length} statements`,
  `about ${quiz.minutes} minutes`
].filter(Boolean).join(' · ');

const tiles = [
  { n: quiz.items.length, label: 'Statements' },
  { n: quiz.groups.length, label: bipolar ? 'Axes' : capitalise(groupNounPlural(quiz)) },
  ...(quiz.outcomes.length
    ? [{ n: quiz.outcomes.length, label: capitalise(outcomeNounPlural(quiz)) }]
    : []),
  { n: `${quiz.minutes}m`, label: 'To take' }
];

const jsonLd = isDraft
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'Quiz',
      name: quiz.title,
      description: quiz.description,
      url: new URL(`/q/${quiz.slug}/`, Astro.site).href,
      numberOfQuestions: quiz.items.length,
      educationalLevel: 'general',
      about: { '@type': 'Thing', name: 'Christian belief and self-understanding' }
    };

// A draft is noindex, so it publishes no trail either: a breadcrumb is a statement about
// where a page sits in a site that search engines are invited to read.
const breadcrumbs = isDraft
  ? null
  : [
      { name: 'Home', url: '/' },
      { name: 'Quizzes', url: '/quizzes/' },
      { name: quiz.title, url: `/q/${quiz.slug}/` }
    ];
---
<Base
  title={quiz.title}
  description={quiz.description}
  noindex={isDraft}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title={quiz.title}
    blue={painted}
    ghost={ghost}
    eyebrow={eyebrow}
    icon={quiz.icon}
    lede={quiz.description}
    tiles={tiles}
    long={quiz.title.length > 24}
  />

  <div class="runner" id="runner" data-quiz={quiz.slug}>
    <noscript>
      <div class="note">
        <p>This quiz needs JavaScript enabled.</p>
      </div>
    </noscript>

    <div id="intro">
      {/*
        Shown only once a ?with= code has proved it decodes for THIS quiz. It says what is
        about to happen before a single statement is answered, because a reader who finds
        out afterwards that their answers were going somewhere they did not expect has been
        surprised by us, which is the one thing this site cannot afford to do.
      */}
      <div class="note" id="with-note" hidden>
        <p>
          Someone wants to see where you land next to them. Answer for yourself; the
          comparison comes after.
        </p>
      </div>

      {/* Before anything else it is honest about what this is — not after the reader has
          already read the instrument's description and decided to take it. */}
      {isDraft && (
        <div class="note draft">
          <p><strong>Unaudited draft.</strong>{" " + quiz.draftNote}</p>
        </div>
      )}{/*
        Hung off the end of the draft block with no whitespace between them, and the same
        between the two. An expression that renders nothing still leaves the newline on
        each side of it, and those newlines come out as stray spaces in every built page —
        including the Compass's, which must come out of this change unchanged.

        A quiz may say what it can and cannot see BEFORE the reader starts, not after they
        have answered. The gifts draft's frame is the clearest case: Scripture lists gifts
        and gives no test for them, so the page says so first and the result repeats it.
      */}{folded ? (
        <>
          <section class="quickstart panel">
            <p>{quiz.notes!.introShort}</p>
            <div class="btn-row">
              <button class="btn" type="button" data-start>Start the quiz</button>
              <a class="btn ghost" href="#before-you-start" data-open-frame>Read this first</a>
            </div>
          </section>

          {/*
            THE FRAME, FOLDED. Three notes — what the quiz can see, the disagreement it
            describes and does not settle, and what it leaves out — used to stand open above
            the preview, which on the gifts quiz was four screens of qualification between a
            reader and the start button. They are all still here, word for word and in the
            DOM whether it is open or shut; the reader decides when to read them. "Read this
            first" above opens it.
          */}
          <details class="frame-fold" id="before-you-start">
            <summary>
              <span>Before you start: what this quiz can and cannot tell you</span>
              <span class="frame-fold-caret" aria-hidden="true"></span>
            </summary>
            <div class="frame-fold-body">
              {quiz.notes!.intro && <p>{quiz.notes!.intro}</p>}
              {quiz.notes!.disputed && (
                <p>
                  {quiz.notes!.disputed.text}
                  {/* {' '}, not a literal space: inside an expression the compiler follows JSX
                      whitespace rules, and the result page drops it — see the note there. */}
                  {quiz.notes!.disputed.href && quiz.notes!.disputed.linkText && (
                    <>{' '}<a href={quiz.notes!.disputed.href}>{quiz.notes!.disputed.linkText}</a></>
                  )}
                </p>
              )}
              {quiz.notes!.omitted && (
                <p>
                  {quiz.notes!.omitted.text}
                  {quiz.notes!.omitted.href && quiz.notes!.omitted.linkText && (
                    <>{' '}<a href={quiz.notes!.omitted.href}>{quiz.notes!.omitted.linkText}</a></>
                  )}
                </p>
              )}
            </div>
          </details>
        </>
      ) : null}{!folded && quiz.notes?.intro && (
        <div class="note quiz-frame" id="before-you-start"><p>{quiz.notes.intro}</p></div>
      )}{/*
        A disagreement the quiz describes and does not settle, before what it leaves out:
        two different admissions, and running them together would read as the first being
        the reason for the second. It says the same thing here and on the result, so a
        reader who starts here and a reader who arrives at a shared link read it once each.
      */}{!folded && quiz.notes?.disputed && (
        <div class="note quiz-frame">
          <p>
            {quiz.notes.disputed.text}
            {quiz.notes.disputed.href && quiz.notes.disputed.linkText && (
              <>{' '}<a href={quiz.notes.disputed.href}>{quiz.notes.disputed.linkText}</a></>
            )}
          </p>
        </div>
      )}{!folded && quiz.notes?.omitted && (
        <div class="note quiz-frame">
          <p>
            {quiz.notes.omitted.text}
            {quiz.notes.omitted.href && quiz.notes.omitted.linkText && (
              <> <a href={quiz.notes.omitted.href}>{quiz.notes.omitted.linkText}</a></>
            )}
          </p>
        </div>
      )}

      <SectionHead
        title="What you will see"
        kicker={bipolar
          ? `${quiz.groups.length} axes · both ends named`
          : `${quiz.groups.length} ${groupNounPlural(quiz)} · ranked by strength`}
      />
      <QuizPreview quiz={quiz} />

      <SectionHead title="How to answer" kicker="Five answers, none of them right" />
      <section class="howto panel layered">
        <div class="wash" aria-hidden="true"></div>
        <div class="veil" aria-hidden="true"></div>
        <p class="howto-lede">
          <b>Answer honestly rather than correctly</b> — there is no score to win. If a
          statement does not land either way, say so; “Unsure” is a real answer and is
          counted as one.
        </p>
        <dl class="spec">
          <div><dt>Scale</dt><dd>Five, strongly disagree to strongly agree</dd></div>
          <div><dt>Going back</dt><dd>Any time, one statement at a time</dd></div>
          <div><dt>Keyboard</dt><dd>Keys 1 to 5, if you have one</dd></div>
        </dl>
      </section>

      <section class="dark startbox">
        <div class="dark-ghost" aria-hidden="true">begin</div>
        <div class="startbox-text">
          <p class="feature-kicker">When you are ready</p>
          <h2>{quiz.items.length} statements, about {quiz.minutes} minutes.</h2>
          <p>
            You can stop at any point, and go back at any point.
          </p>
        </div>
        <div class="btn-row">
          <button class="btn" id="start" type="button">Start the quiz</button>
        </div>
      </section>
    </div>

    <div id="play" hidden>
      <div class="ask-top">
        <div class="ask-meta">
          <p class="count" id="count"></p>
          <span class="ask-quiz">{quiz.title}</span>
        </div>
        <div class="progress" style={`--pips:${quiz.items.length}`}>
          <i id="prog" style="width:0%"></i>
        </div>
      </div>

      <div class="ask layered">
        <div class="wash" aria-hidden="true"></div>
        <div class="veil" aria-hidden="true"></div>
        {/* A flourish, not a citation: the statement is ours, and it opens the way the
            reference sheets open a line — in the warm ink, in the display face. */}
        <span class="ask-quote" aria-hidden="true">“</span>
        <p class="statement" id="statement" tabindex="-1"></p>
      </div>

      {/*
        One line about how to READ the statements, above the answers rather than below them:
        it is a rule for choosing, so a reader who meets it after choosing has met it too
        late. Hung with no whitespace on either side, so a quiz that sets nothing leaves this
        page byte for byte what it was.
      */}{quiz.notes?.scale && <p class="scale-note">{quiz.notes.scale}</p>}<div class="scale" id="scale"></div>

      <div class="runner-foot">
        <div class="runner-nav">
          <button class="btn ghost" id="back" type="button">← Back</button>
        </div>
        <p class="scale-hint">
          The scale runs from strongly disagree to strongly agree. Unsure sits in the middle
          and does not push you either way.
        </p>
      </div>
    </div>

    {/*
      Shown at the end, and only to a reader who gave the same answer to all of them, on a
      quiz that asks for it (Quiz.uniformSheet). It is a question rather than a refusal: the
      reader decides, and either way nobody is named on a sheet that says nothing.
    */}
    {quiz.uniformSheet === 'centre' && (
      <div id="uniform" hidden>
        <div class="uniform-box">
          <p class="uniform-lede" tabindex="-1">
            You gave the same answer to every statement. Half of these statements pull one
            way and half the other, so the same answer to all of them cancels out and there
            is nothing to place.
          </p>
          <div class="btn-row">
            <button class="btn" id="uniform-again" type="button">Go back through them</button>
            <button class="btn ghost" id="uniform-anyway" type="button">See the result anyway</button>
          </div>
        </div>
      </div>
    )}
  </div>

  <script>
    import { getQuiz, scoreQuiz, encodeFor, decodeFor } from '../../lib/engine/registry';
    // Straight from the contracts, not through the registry: the rule about a sheet with no
    // variation in it belongs beside the field that switches it on, and the runner is the
    // only place that can act on it, because a result page is rendered from the code alone.
    import { centresUniformSheets, isUniformSheet } from '../../lib/engine/types';

    const root = document.getElementById('runner');
    const quiz = getQuiz(root?.dataset.quiz);
    if (root && quiz) {
      const SCALE = [
        { v: -2, label: 'Strongly disagree' },
        { v: -1, label: 'Disagree' },
        { v: 0, label: 'Unsure / neither' },
        { v: 1, label: 'Agree' },
        { v: 2, label: 'Strongly agree' }
      ];

      const $ = (id) => document.getElementById(id);
      const intro = $('intro'), play = $('play'), scaleEl = $('scale');
      const sheet = new Array(quiz.items.length).fill(null);
      let at = 0;
      let timer = 0;

      /*
       * An invitation: ?with=<their code>.
       *
       * It is only honoured if it actually DECODES for this quiz, so a mangled or foreign
       * code drops the invitation and the reader takes the quiz normally, rather than
       * finishing into a comparison page that 404s. The code is a set of scores and
       * nothing else; it is kept tab-scoped and never sent anywhere.
       */
      const WITH_KEY = 'ww:with:' + quiz.slug;
      const invited = new URLSearchParams(location.search).get('with');
      if (invited) {
        const code = invited.trim().toUpperCase();
        if (decodeFor(quiz, code)) {
          try { sessionStorage.setItem(WITH_KEY, code); } catch (e) {}
          const note = $('with-note');
          if (note) note.hidden = false;
        }
      }

      SCALE.forEach(s => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = s.label;
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => answer(s.v));
        scaleEl.appendChild(b);
      });

      function render() {
        const item = quiz.items[at];
        $('statement').textContent = item.text;
        $('count').textContent = `Statement ${at + 1} of ${quiz.items.length}`;
        $('prog').style.width = `${(at / quiz.items.length) * 100}%`;
        [...scaleEl.children].forEach((b, i) => {
          b.setAttribute('aria-pressed', String(sheet[at] === SCALE[i].v));
        });
        // On the first statement Back leaves the quiz rather than sitting there dead.
        $('back').textContent = at === 0 ? '← Leave the quiz' : '← Back';
      }

      function answer(v) {
        sheet[at] = v;
        render();
        // A short beat so the selection is visible, but never a dead control:
        // any later click cancels the pending advance.
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (at < quiz.items.length - 1) { at++; render(); }
          else finish();
        }, 180);
      }

      function goToResult(values) {
        const code = encodeFor(quiz, values);
        // A note for the result page, which is served identically to the person who just
        // took the quiz and to anyone they send the link to. Tab-scoped, never sent.
        try { sessionStorage.setItem('ww:took:' + quiz.slug, code); } catch (e) {}

        // An invitation sends you to the two-person page instead, with the inviter first.
        // Cleared on the way out so a second run of the quiz in the same tab is just a
        // result again, and an identical code is treated as no comparison at all.
        let other = null;
        try { other = sessionStorage.getItem(WITH_KEY); } catch (e) {}
        if (other && other !== code) {
          try { sessionStorage.removeItem(WITH_KEY); } catch (e) {}
          window.location.href = `/c/${quiz.slug}/${other}.${code}/`;
          return;
        }
        window.location.href = `/r/${quiz.slug}/${code}/`;
      }

      /*
       * The end of a run.
       *
       * A sheet with the same answer on every statement is the one case where the
       * arithmetic would name somebody on no information at all: on a quiz with two
       * statements keyed one way and one the other on each axis, agreeing eighteen times
       * lands on the same score on every axis and hands the reader a name that describes
       * the keying rather than them. Where a quiz asks for it, the reader is told that and
       * chooses. Everything else finishes exactly as it did.
       */
      function finish() {
        if (centresUniformSheets(quiz) && isUniformSheet(sheet)) {
          const box = $('uniform');
          if (box) {
            play.hidden = true;
            box.hidden = false;
            box.querySelector('.uniform-lede')?.focus?.();
            return;
          }
        }
        goToResult(scoreQuiz(quiz, sheet));
      }

      /*
       * "See the result anyway": the middle of every group, which is the honest reading of
       * a sheet with no variation in it, and the score at which this instrument already
       * names nobody. The code is a real one, so the link, the invitation and the
       * two-person page all work from here exactly as they do from any other result.
       */
      $('uniform-anyway')?.addEventListener('click', () => {
        goToResult(quiz.groups.map(() => 50));
      });

      // Back through them, with every answer kept, from the first statement.
      $('uniform-again')?.addEventListener('click', () => {
        $('uniform').hidden = true;
        play.hidden = false;
        at = 0;
        render();
        $('statement').focus?.();
      });

      // The button at the foot of the intro, and the one a quiz with `introShort` puts near
      // the top: the same way in.
      const begin = () => {
        intro.hidden = true;
        play.hidden = false;
        render();
        $('statement').focus?.();
      };
      $('start').addEventListener('click', begin);
      document.querySelectorAll('[data-start]').forEach(b => b.addEventListener('click', begin));

      /*
       * "Read this first" opens the fold under it and moves the reader to it. Without this
       * script the link is still an anchor to the <details>, so the reader lands on a
       * closed summary and one tap opens it — which is why the summary says what is inside.
       */
      const fold = $('before-you-start');
      document.querySelectorAll('[data-open-frame]').forEach(a => {
        a.addEventListener('click', e => {
          if (!fold) return;
          e.preventDefault();
          fold.open = true;
          fold.scrollIntoView({ block: 'start', behavior: 'smooth' });
          fold.querySelector('summary')?.focus?.();
        });
      });

      $('back').addEventListener('click', () => {
        clearTimeout(timer);
        if (at === 0) { play.hidden = true; intro.hidden = false; return; }
        at--;
        render();
      });

      document.addEventListener('keydown', e => {
        if (play.hidden) return;
        const n = Number(e.key);
        if (n >= 1 && n <= 5) { answer(SCALE[n - 1].v); e.preventDefault(); }
      });
    }
  </script>


</Base>
