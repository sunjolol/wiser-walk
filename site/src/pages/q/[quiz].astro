---
/**
 * A quiz: its intro, and the runner it turns into.
 *
 * The intro is composed from the quiz's own data — counts, axes or categories, both pole
 * names on every axis — so adding a quiz still means adding a data file. Everything
 * introductory lives INSIDE #intro, which the runner already hides when play starts, so
 * the question screen is the whole page without the script having to learn a new rule.
 */
import Hero from '../../components/Hero.astro';
import { artFor } from '../../lib/art';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import QuizPreview from '../../components/QuizPreview.astro';
import OutcomeIndex from '../../components/OutcomeIndex.astro';
import PsalmIndex from '../../components/PsalmIndex.astro';
import CompareRoom from '../../components/CompareRoom.astro';
import ReadCard from '../../components/ReadCard.astro';
import ReadingRunner from '../../components/ReadingRunner.astro';
import { READING, SITUATIONS } from '../../lib/strategies/reading';
import type { KindredData } from '../../lib/strategies/kindred';
import { getCollection } from 'astro:content';
import { COMPARE_QUIZ } from '../../lib/comparisons';
import { QUIZZES, getQuiz, outcomeHref } from '../../lib/engine/registry';
import { capitalise, groupNounPlural, outcomeNounPlural } from '../../lib/engine/types';
// Server only: the early Christians' portraits and names, for the strip on that quiz's page.
import earlyChristians from '../../data/which-early-christian.json';
import '../../styles/pages/reads.css';
import '../../styles/pages/kindred.css';

export function getStaticPaths() {
  return QUIZZES.map(q => ({ params: { quiz: q.slug } }));
}

const quiz = getQuiz(Astro.params.quiz)!;

/*
 * THE OTHER HALF OF THE LOOP.
 *
 * An article names the quizzes it belongs beside in its own front matter, and the article
 * template has always read that list to draw its "Keep going" block. Nothing read it the
 * other way, so every link between the two ran one way: eleven articles pointed at the
 * quizzes and not one quiz pointed back at an article on its own subject.
 *
 * So this is the same list, read backwards. No second list to keep in step: an article that
 * names this quiz appears here the day it is written, and one that does not, does not.
 * Three at most, and sorted by date and then by slug so that two articles published on the
 * same day come out in the same order on every machine that builds the site.
 */
const readNext = (await getCollection('articles'))
  .filter(a => !a.data.draft && a.data.quizzes.includes(quiz.slug))
  .sort((a, b) =>
    b.data.published.valueOf() - a.data.published.valueOf() || a.id.localeCompare(b.id))
  .slice(0, 3);
const isDraft = quiz.status === 'draft';
const bipolar = quiz.strategy.shape === 'bipolar';
/*
 * A reading ("Which Psalm are you living right now?") has no statements to agree with and
 * nothing to rank, so none of the statement runner's intro describes it. It gets its own
 * runner and its own three points; the band and the articles are the same as every quiz's.
 */
const reading = quiz.strategy.shape === 'reading';
/*
 * KINDRED SPIRITS ("Which early Christian thinks like you?") uses the statement runner as it is,
 * five answers and all, but its result is two people, not axes or a ranking. So what this page
 * says about the result is its own: the subtitle under the title (the owner's ruling), faces
 * from the early Church where the preview of axes or categories would stand, and "Not sure" for
 * the middle answer, the word its result prints.
 */
const kindred = quiz.strategy.shape === 'kindred';
/* The comparison pages are drawn on the Compass's own rails, so they belong to the Compass
   and to no other quiz. Asked of the data rather than of the slug typed here twice. */
const comparable = quiz.slug === COMPARE_QUIZ.slug;

/**
 * A quiz long enough to need a one-sentence way in (notes.introShort) is a quiz whose frame
 * is long enough to fold: its three notes go into one <details> under the quick start
 * instead of standing open between the reader and the start button. A quiz with one short
 * note — the Compass has exactly one — prints it as it always did.
 *
 * The fold also needs something to hold. The seven deadly sins quiz went live (2026-09-21)
 * with its one-sentence way in and none of the three notes, and the page drew a panel
 * promising "what this quiz can and cannot tell you" that opened on nothing. Now the sentence
 * prints whenever a quiz has one, and the panel only when there is a note to put in it.
 */
const hasFrame = Boolean(quiz.notes?.intro || quiz.notes?.disputed || quiz.notes?.omitted);
const folded = Boolean(quiz.notes?.introShort) && hasFrame;

/**
 * One word of the quiz's own title is painted in the band's second ink — the last word long
 * enough to carry it — so a new quiz brings its own and none is ever invented here.
 */
const words = quiz.title.toLowerCase().replace(/[^a-z\s]/g, ' ').split(/\s+/).filter(Boolean);
const ghost = [...words].reverse().find(w => w.length >= 5) ?? words[words.length - 1] ?? quiz.slug;
/*
 * A reading paints the word for what it gives you instead ("Psalm", in "Which Psalm are you
 * living right now?"), which is the word the owner saw painted in the preview he approved.
 * By the rule above it would have been "right", which says nothing. Still the quiz's own
 * noun, from its data; every other quiz is painted exactly as before.
 */
const nounWord = reading
  ? quiz.title.split(/\s+/).find(w => w.toLowerCase().replace(/[^a-z]/g, '') === quiz.outcomeNoun)
  : kindred && quiz.outcomeNoun && quiz.title.includes(quiz.outcomeNoun)
    ? quiz.outcomeNoun   // "early Christian": two words, and the thing the result gives you
    : undefined;
const painted = nounWord ?? quiz.title
  .split(/\s+/)
  .find(w => w.toLowerCase().replace(/[^a-z]/g, '') === ghost);

/** The quiz's own plate. Null for the Compass, which is drawn as an instrument, not a scene. */
const art = artFor(quiz.slug);

/**
 * A draft says so in the hero chip, where the facts about the instrument are, rather than
 * only two thousand pixels further down: the hub's card already marks it DRAFT on its face,
 * and a reader who starts here should not learn it later than a reader who starts there.
 * That is the ONLY chip this band carries. A live quiz's said "Self-assessment", a label with
 * no job, and the owner had every such chip taken off the site (2026-09-22).
 */
const eyebrow = isDraft ? 'Unaudited draft' : undefined;

/*
 * A reading's honest numbers: the questions everyone is asked (the follow-ups come only when
 * an answer calls for them, so they are not counted as if everyone meets them), and the
 * situations a result can be, each one Athanasius's own.
 */
const tiles = reading ? [
  { n: READING.core.length, label: 'Questions' },
  { n: SITUATIONS.length, label: 'Situations' },
  { n: `${quiz.minutes}m`, label: 'To take' }
] : kindred ? [
  // One statement per question, so "23 statements" and "23 questions" would be one number twice.
  { n: quiz.items.length, label: 'Statements' },
  { n: quiz.outcomes.length, label: capitalise(outcomeNounPlural(quiz)) },
  { n: `${quiz.minutes}m`, label: 'To take' }
] : [
  { n: quiz.items.length, label: 'Statements' },
  { n: quiz.groups.length, label: bipolar ? 'Axes' : capitalise(groupNounPlural(quiz)) },
  ...(quiz.outcomes.length
    ? [{ n: quiz.outcomes.length, label: capitalise(outcomeNounPlural(quiz)) }]
    : []),
  { n: `${quiz.minutes}m`, label: 'To take' }
];

const jsonLd = isDraft
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'Quiz',
      name: quiz.title,
      description: quiz.description,
      url: new URL(`/q/${quiz.slug}/`, Astro.site).href,
      // `numberOfQuestions` is not a schema.org property at all: the term 404s, so this block
      // was publishing one invalid predicate. The count is on the page as a tile anyway.
      educationalLevel: 'general',
      about: { '@type': 'Thing', name: 'Christian belief and self-understanding' }
    };

// A draft is noindex, so it publishes no trail either: a breadcrumb is a statement about
// where a page sits in a site that search engines are invited to read.
const breadcrumbs = isDraft
  ? null
  : [
      { name: 'Home', url: '/' },
      { name: 'Quizzes', url: '/quizzes/' },
      { name: quiz.title, url: `/q/${quiz.slug}/` }
    ];

/*
 * The strip of faces on the kindred quiz's page: the ten the approved preview chose, in its
 * order (East and West, men and a woman, bishops, monks and scholars), each a way in to their
 * own page. "Meet all 22" goes to the page that lists everyone.
 */
const EC = earlyChristians as unknown as KindredData;
const STRIP = ['augustine', 'macrina', 'chrysostom', 'antony', 'jerome', 'basil', 'origen', 'martin', 'isaac', 'benedict'];
const strip = kindred
  ? STRIP.filter(k => EC.people[k]).map(k => {
      const p = EC.people[k]!;
      return { key: k, name: p.name, short: p.short, portrait: p.portrait, href: outcomeHref(quiz, { name: p.name, slug: p.slug }) };
    })
  : [];
---
<Base
  title={quiz.title}
  description={quiz.description}
  noindex={isDraft}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  {/* The quiz's own Doré plate, printed soft. The Compass has none: it is an instrument,
      so it wears the dark starry ground every page draws it on. */}
  <Hero
    title={quiz.title}
    blue={painted}
    eyebrow={eyebrow}
    icon={eyebrow ? quiz.icon : undefined}
    kind={art ? 'engraving' : 'night'}
    image={art?.src}
    imageAlt={art?.alt}
    imagePosition={art?.objectPosition}
    imageLift={art?.lift}
    lede={kindred ? undefined : quiz.intro ?? quiz.description}
    tiles={tiles}
    long={quiz.title.length > 24}
  >{/*
      The kindred quiz's subtitle, "And which would argue with you?", printed directly under the
      title (the owner's ruling, 2026-09-23), then its way in. It is the band's lede, so it is
      hidden with the band the moment play begins. Every other quiz passes its lede above.
    */}{kindred && (
      <><span class="kr-sub">{quiz.tagline}</span> {quiz.intro ?? quiz.description}</>
    )}
    {/*
      THE START BUTTON, IN THE BAND. "making the user scroll to get to the [main] button is
      bad design", and on a phone every other place is below the fold. It is a plain
      [data-start] control, which the runner's script already binds alongside the one at the
      foot, and the band is hidden the moment play begins, so it cannot linger over a
      statement. Without JavaScript the noscript note below says so, as it always has.
    */}
    <button class="btn" type="button" data-start slot="actions">Start the quiz</button>{/*
      The gifts test also exists on paper (/q/spiritual-gifts/print/), for a class or a small
      group. It is the one quiz with a print page, so the link is keyed to its slug here rather
      than to a field every other quiz would carry empty.
    */}{quiz.slug === 'spiritual-gifts' && (
      <a class="btn glass" href="/q/spiritual-gifts/print/" slot="actions">Print it for a group</a>
    )}
  </Hero>

  {/*
    A READING: its own runner, with the intro as the runner's slot so it is hidden the moment
    play begins. No #runner is drawn, so the statement script at the foot of this page finds
    nothing to bind; ReadingRunner binds the band's [data-start] itself. PsalmIndex stands where
    OutcomeIndex would: OutcomeIndex's sentences are about axes and traditions, untrue of psalms.
  */}{reading ? (
  <ReadingRunner quiz={quiz}>
    <SectionHead title="How it works" kicker="Three steps, no wrong answers" />
    <ul class="steps">
      <li class="step">
        <span class="step-mark rd-mark--tap" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="step-say">
          <b>Answer quickly and honestly</b>
          <p>{READING.core.length} short questions about your life right now, and a few more only if an answer needs them.</p>
        </div>
      </li>
      <li class="step">
        <span class="step-mark rd-mark--yes" aria-hidden="true"></span>
        <div class="step-say">
          <b>Say if it's you</b>
          <p>You'll see your situation in plain words. It's yours only if you say so, and "Not quite" shows the next.</p>
        </div>
      </li>
      <li class="step">
        <span class="step-mark rd-mark--lines" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="step-say">
          <b>Read your psalm, in full</b>
          <p>The psalm St Athanasius gave for exactly that, in the 300s, and why he gave it.</p>
        </div>
      </li>
    </ul>

    <section class="wayin wayin--night qway">
      <div class="wayin-ghost" aria-hidden="true">begin</div>
      <div class="wayin-in">
        <p class="wayin-kicker">When you are ready</p>
        {/* two lines, as the statement quizzes' longer heading wraps on its own */}
        <h2>{READING.core.length} questions,<br /> about {quiz.minutes} minutes.</h2>
        <p class="wayin-say">You can go back at any point, and nothing is yours until you say it is.</p>
        <div class="btn-row">
          <button class="btn" type="button" data-start>Start the quiz</button>
        </div>
      </div>
    </section>

    {/* Every situation, each a way in to its psalm's page: this quiz's "one page each". */}
    <PsalmIndex />

    {readNext.length > 0 && (
      <section class="qreads">
        <SectionHead
          title="Read next"
          kicker="Alongside this quiz"
          href="/articles/"
          more="All articles"
        />
        <div class="hm-reads reads-foot">
          {readNext.map(a => (
            <ReadCard id={a.id} title={a.data.title} description={a.data.description}
                      minutes={a.data.minutes} image={a.data.image} imageAlt={a.data.imageAlt}
                      imagePosition={a.data.imagePosition} />
          ))}
        </div>
      </section>
    )}
  </ReadingRunner>
  ) : (
  <div class="runner" id="runner" data-quiz={quiz.slug}>
    <noscript>
      <div class="note">
        <p>This quiz needs JavaScript enabled.</p>
      </div>
    </noscript>

    <div id="intro">
      {/*
        Shown only once a ?with= code has proved it decodes for THIS quiz. It says what is
        about to happen before a single statement is answered, because a reader who finds
        out afterwards that their answers were going somewhere they did not expect has been
        surprised by us, which is the one thing this site cannot afford to do.
      */}
      <div class="note" id="with-note" hidden>
        <p>
          Someone wants to see where you land next to them. Answer for yourself; the
          comparison comes after.
        </p>
      </div>

      {/* Before anything else it is honest about what this is — not after the reader has
          already read the instrument's description and decided to take it. */}
      {isDraft && (
        <div class="note draft">
          {/* No bold "Unaudited draft." lead any more. The chip in the band says it, and
              the note's own first sentence says it again; a third printing of the same two
              words inside forty pixels reads as a stammer. */}
          <p>{quiz.draftNote}</p>
        </div>
      )}{/*
        Hung off the end of the draft block with no whitespace between them, and the same
        between the two. An expression that renders nothing still leaves the newline on
        each side of it, and those newlines come out as stray spaces in every built page —
        including the Compass's, which must come out of this change unchanged.

        A quiz may say what it can and cannot see BEFORE the reader starts, not after they
        have answered. The gifts draft's frame is the clearest case: Scripture lists gifts
        and gives no test for them, so the page says so first and the result repeats it.
      */}{/*
        A quiz with a long frame says one sentence of it here, under the band. The start
        button is in the band above, and the rest of the frame is the panel directly below
        this line, which says on its face what is inside it — so the "Read this first"
        button that used to stand between the two is gone: it opened the thing under it.
      */}{quiz.notes?.introShort && <p class="qgo-say">{quiz.notes.introShort}</p>}{folded ? (
        <>
          {/*
            THE FRAME, FOLDED. Three notes — what the quiz can see, the disagreement it
            describes and does not settle, and what it leaves out — used to stand open above
            the preview, which on the gifts quiz was four screens of qualification between a
            reader and the start button. They are all still here, word for word and in the
            DOM whether it is open or shut; the reader decides when to read them. "Read this
            first" above opens it.
          */}
          <details class="frame-fold" id="before-you-start">
            <summary>
              <span>Before you start: what this quiz can and cannot tell you</span>
              <span class="frame-fold-caret" aria-hidden="true"></span>
            </summary>
            <div class="frame-fold-body">
              {quiz.notes!.intro && <p>{quiz.notes!.intro}</p>}
              {quiz.notes!.disputed && (
                <p>
                  {quiz.notes!.disputed.text}
                  {/* {' '}, not a literal space: inside an expression the compiler follows JSX
                      whitespace rules, and the result page drops it — see the note there. */}
                  {quiz.notes!.disputed.href && quiz.notes!.disputed.linkText && (
                    <>{' '}<a href={quiz.notes!.disputed.href}>{quiz.notes!.disputed.linkText}</a></>
                  )}
                </p>
              )}
              {quiz.notes!.omitted && (
                <p>
                  {quiz.notes!.omitted.text}
                  {quiz.notes!.omitted.href && quiz.notes!.omitted.linkText && (
                    <>{' '}<a href={quiz.notes!.omitted.href}>{quiz.notes!.omitted.linkText}</a></>
                  )}
                </p>
              )}
            </div>
          </details>
        </>
      ) : null}{!folded && quiz.notes?.intro && (
        <div class="note quiz-frame" id="before-you-start"><p>{quiz.notes.intro}</p></div>
      )}{/*
        A disagreement the quiz describes and does not settle, before what it leaves out:
        two different admissions, and running them together would read as the first being
        the reason for the second. It says the same thing here and on the result, so a
        reader who starts here and a reader who arrives at a shared link read it once each.
      */}{!folded && quiz.notes?.disputed && (
        <div class="note quiz-frame">
          <p>
            {quiz.notes.disputed.text}
            {quiz.notes.disputed.href && quiz.notes.disputed.linkText && (
              <>{' '}<a href={quiz.notes.disputed.href}>{quiz.notes.disputed.linkText}</a></>
            )}
          </p>
        </div>
      )}{!folded && quiz.notes?.omitted && (
        <div class="note quiz-frame">
          <p>
            {quiz.notes.omitted.text}
            {quiz.notes.omitted.href && quiz.notes.omitted.linkText && (
              <> <a href={quiz.notes.omitted.href}>{quiz.notes.omitted.linkText}</a></>
            )}
          </p>
        </div>
      )}

      {kindred ? (
        /*
          Where another quiz previews its axes or categories: the people a result can name. Ten
          faces, as the approved preview printed them, then everyone on the page that lists all
          twenty-two. No caption under the strip: the owner found it loose, undesigned text
          (2026-09-23). All the pictures are public domain; their credits stay one tap away.
        */
        <section class="kr-meet">
          <SectionHead title="Who you might meet" kicker={`${strip.length} of the ${quiz.outcomes.length}`}
                       href="/early-christian/" more={`Meet all ${quiz.outcomes.length}`} />
          <ul class="kr-strip">
            {strip.map(p => (
              <li>
                <a href={p.href}>
                  <img src={p.portrait.thumb} width={p.portrait.width} height={p.portrait.height} alt=""
                       loading="lazy" decoding="async" />
                  <span>{p.short}</span>
                </a>
              </li>
            ))}
          </ul>
          <details class="kr-credits">
            <summary>Picture credits</summary>
            <ul>
              {strip.map(p => <li><a href={p.portrait.page}>{p.name}</a>: {p.portrait.credit}</li>)}
            </ul>
          </details>
        </section>
      ) : (
      <SectionHead
        title="What you will see"
        kicker={bipolar
          ? `${quiz.groups.length} axes · both ends named`
          : `${quiz.groups.length} ${groupNounPlural(quiz)} · ranked by strength`}
      />
      )}
      {!kindred && <QuizPreview quiz={quiz} />}

      {/*
        HOW TO ANSWER, as three marked points rather than a panel of prose over a dotted
        spec list. Each mark is drawn from the thing it stands for: the five-step scale, the
        quiet middle, the way back. Nothing here is decoration standing in for a sentence.
      */}
      <SectionHead title="How to answer" kicker="Five answers, none of them right" />
      <p class="howto-line">Answer honestly rather than correctly. There is no score to win.</p>
      <ul class="steps">
        <li class="step">
          <span class="step-mark step-mark--scale" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i>
          </span>
          <div class="step-say">
            <b>Five answers</b>
            <p>Strongly disagree through to strongly agree.</p>
          </div>
        </li>
        <li class="step">
          <span class="step-mark step-mark--middle" aria-hidden="true"></span>
          <div class="step-say">
            <b>{kindred ? 'Not sure is one of them' : 'Unsure is one of them'}</b>
            <p>{kindred
              ? "Use it when you can't lean either way. No one is matched to you on it."
              : 'It counts as an answer and pushes you neither way.'}</p>
          </div>
        </li>
        <li class="step">
          <span class="step-mark step-mark--back" aria-hidden="true"><Icon name="arrow" size={16} /></span>
          <div class="step-say">
            <b>Go back any time</b>
            <p>One statement at a time. Keys 1 to 5 work as well.</p>
          </div>
        </li>
      </ul>

      {/* The way in again at the foot, as a room on the night ground. Not the quiz's own
          plate, which is already in the band at the top of this page, and not a dawn sky,
          which is what the footer under this block is a photograph of. No icon tile over
          the words (the owner, 2026-09-22); the ghost word says what the room is for. */}
      <section class="wayin wayin--night qway">
        <div class="wayin-ghost" aria-hidden="true">begin</div>
        <div class="wayin-in">
          <p class="wayin-kicker">When you are ready</p>
          <h2>{quiz.items.length} statements, about {quiz.minutes} minutes.</h2>
          <p class="wayin-say">You can stop at any point, and go back at any point.</p>
          <div class="btn-row">
            <button class="btn" id="start" type="button">Start the quiz</button>
          </div>
        </div>
      </section>

      {/*
        Every outcome, each a way in to its own page.

        This used to be the Compass's alone: the figures were said to have their own index on
        this quiz's axis pages, which was true and was not enough. Those six axis pages are the
        ONLY route to the twenty-five figure pages, so the site's longest, most cited family sat
        three taps from the home page while the Compass's traditions sat two. The test is the
        data — a quiz with outcomes has pages for them — not which quiz this is. A quiz whose
        strategy reads no outcomes prints nothing here, as it always did.
      */}
      {quiz.outcomes.length > 0 && !kindred && <OutcomeIndex quiz={quiz} />}{/*
        Under that index, because it answers the question the index provokes: a reader
        looking down eighteen names is usually holding two of them in mind. Hung with no
        whitespace on either side, so the three quizzes that have no comparison pages come
        out of this change byte for byte as they went in.
      */}{comparable && <CompareRoom />}

      {/* The articles written alongside this quiz, as the paintings they are — the same
          cards, in the same grid, that the foot of an article and of a result already use.
          Below the last way in, so nothing to read stands between a reader and the start
          button. A quiz no article has named yet prints nothing. */}
      {readNext.length > 0 && (
        <section class="qreads">
          <SectionHead
            title="Read next"
            kicker="Alongside this quiz"
            href="/articles/"
            more="All articles"
          />
          <div class="hm-reads reads-foot">
            {readNext.map(a => (
              <ReadCard id={a.id} title={a.data.title} description={a.data.description}
                        minutes={a.data.minutes} image={a.data.image} imageAlt={a.data.imageAlt}
                        imagePosition={a.data.imagePosition} />
            ))}
          </div>
        </section>
      )}
    </div>

    <div id="play" hidden>
      <div class="ask-top">
        <div class="ask-meta">
          <p class="count" id="count"></p>
          <span class="ask-quiz">{quiz.title}</span>
        </div>
        <div class="progress" style={`--pips:${quiz.items.length}`}>
          <i id="prog" style="width:0%"></i>
        </div>
      </div>

      <div class="ask layered">
        <div class="wash" aria-hidden="true"></div>
        <div class="veil" aria-hidden="true"></div>
        {/* A flourish, not a citation: the statement is ours, and it opens the way the
            reference sheets open a line — in the warm ink, in the display face. */}
        <span class="ask-quote" aria-hidden="true">“</span>
        <p class="statement" id="statement" tabindex="-1"></p>
      </div>

      {/*
        One line about how to READ the statements, above the answers rather than below them:
        it is a rule for choosing, so a reader who meets it after choosing has met it too
        late. Hung with no whitespace on either side, so a quiz that sets nothing leaves this
        page byte for byte what it was.
      */}{quiz.notes?.scale && <p class="scale-note">{quiz.notes.scale}</p>}<div class="scale" id="scale"></div>

      <div class="runner-foot">
        <div class="runner-nav">
          <button class="btn ghost" id="back" type="button">← Back</button>
        </div>
        <p class="scale-hint" hidden={kindred}>
          The scale runs from strongly disagree to strongly agree. Unsure sits in the middle
          and does not push you either way.
        </p>{/*
          The kindred quiz's own hint, in its word for the middle answer. Hung with no whitespace
          on either side, so every other quiz's page is byte for byte what it was.
        */}{kindred && (
          <p class="scale-hint">
            The scale runs from strongly disagree to strongly agree. Not sure sits in the middle,
            and no one is matched to you on it.
          </p>
        )}
      </div>
    </div>

    {/*
      Shown at the end, and only to a reader who gave the same answer to all of them, on a
      quiz that asks for it (Quiz.uniformSheet). It is a question rather than a refusal: the
      reader decides, and either way nobody is named on a sheet that says nothing.
    */}
    {quiz.uniformSheet === 'centre' && (
      <div id="uniform" hidden>
        <div class="uniform-box">
          <p class="uniform-lede" tabindex="-1">
            You gave the same answer to every statement. Half of these statements pull one
            way and half the other, so the same answer to all of them cancels out and there
            is nothing to place.
          </p>
          <div class="btn-row">
            <button class="btn" id="uniform-again" type="button">Go back through them</button>
            <button class="btn ghost" id="uniform-anyway" type="button">See the result anyway</button>
          </div>
        </div>
      </div>
    )}
  </div>
  )}

  <script>
    import { getQuiz, scoreQuiz, encodeFor, decodeFor } from '../../lib/engine/registry';
    // The code a person sees in a link, which can be shorter than the one the site keeps.
    import {
      SHORT_RE, publicCodeSync, requestFullCode, requestShortCode, resolveCodeSync
    } from '../../lib/engine/links';
    // Straight from the contracts, not through the registry: the rule about a sheet with no
    // variation in it belongs beside the field that switches it on, and the runner is the
    // only place that can act on it, because a result page is rendered from the code alone.
    import { centresUniformSheets, isUniformSheet } from '../../lib/engine/types';
    // A finished result is kept on this device, so it can be found again on /me/. A blocked
    // or full storage is a no-op rather than an error.
    import { addResult } from '../../lib/shelf';

    const root = document.getElementById('runner');
    const quiz = getQuiz(root?.dataset.quiz);
    if (root && quiz) {
      const SCALE = [
        { v: -2, label: 'Strongly disagree' },
        { v: -1, label: 'Disagree' },
        // "Not sure" on the kindred quiz, the word its result prints beside every answer.
        { v: 0, label: quiz.strategy.shape === 'kindred' ? 'Not sure' : 'Unsure / neither' },
        { v: 1, label: 'Agree' },
        { v: 2, label: 'Strongly agree' }
      ];

      const $ = (id) => document.getElementById(id);
      const intro = $('intro'), play = $('play'), scaleEl = $('scale');
      const sheet = new Array(quiz.items.length).fill(null);
      let at = 0;
      let timer = 0;

      /*
       * An invitation: ?with=<their code>.
       *
       * It is only honoured if it actually DECODES for this quiz, so a mangled or foreign
       * code drops the invitation and the reader takes the quiz normally, rather than
       * finishing into a comparison page that 404s. The code is a set of scores and
       * nothing else; it is kept tab-scoped.
       *
       * It may arrive in any of its public forms (engine/links.ts). What is kept is the
       * canonical code, so the "same result" test below still compares like with like. A
       * six-character short link is the one form this page cannot read by itself: the site
       * is asked what it points at, and until it answers there is no invitation.
       */
      const WITH_KEY = 'ww:with:' + quiz.slug;
      /** The inviter's code as their link printed it, for the comparison's URL. */
      let withLink = null;
      const invited = new URLSearchParams(location.search).get('with');
      const accept = (code, link) => {
        try { sessionStorage.setItem(WITH_KEY, code); } catch (e) {}
        withLink = link;
        const note = $('with-note');
        if (note) note.hidden = false;
      };
      if (invited) {
        const raw = invited.trim().toUpperCase();
        const code = resolveCodeSync(quiz, raw);
        if (code) accept(code, publicCodeSync(quiz, code));
        else if (quiz.shortLinks && SHORT_RE.test(raw)) {
          requestFullCode(quiz.slug, raw).then(full => {
            if (full && decodeFor(quiz, full)) accept(full, raw);
          });
        }
      }

      /**
       * The code for the result's URL. Shorter where the quiz allows it; for a quiz with
       * short links, the site is asked for one and given a second and a half to answer.
       * Either way the long code works, so the reader never waits on it for longer.
       */
      const linkFor = (code) =>
        quiz.shortLinks
          ? requestShortCode(quiz.slug, code).then(short => short || code)
          : Promise.resolve(publicCodeSync(quiz, code));

      SCALE.forEach(s => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = s.label;
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => answer(s.v));
        scaleEl.appendChild(b);
      });

      function render() {
        const item = quiz.items[at];
        $('statement').textContent = item.text;
        $('count').textContent = `Statement ${at + 1} of ${quiz.items.length}`;
        $('prog').style.width = `${(at / quiz.items.length) * 100}%`;
        [...scaleEl.children].forEach((b, i) => {
          b.setAttribute('aria-pressed', String(sheet[at] === SCALE[i].v));
        });
        // On the first statement Back leaves the quiz rather than sitting there dead.
        $('back').textContent = at === 0 ? '← Leave the quiz' : '← Back';
      }

      function answer(v) {
        sheet[at] = v;
        render();
        // A short beat so the selection is visible, but never a dead control:
        // any later click cancels the pending advance.
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (at < quiz.items.length - 1) { at++; render(); }
          else finish();
        }, 180);
      }

      /**
       * Set once the way to the result has begun, so a second tap cannot finish twice while
       * a short link is asked for. Cleared when Back brings this page out of the browser's
       * cache as it was, or the last statement could never be finished again.
       */
      let leaving = false;
      window.addEventListener('pageshow', e => { if (e.persisted) leaving = false; });

      async function goToResult(values) {
        if (leaving) return;
        leaving = true;
        const code = encodeFor(quiz, values);
        // A note for the result page, which is served identically to the person who just
        // took the quiz and to anyone they send the link to. Tab-scoped, never sent.
        try { sessionStorage.setItem('ww:took:' + quiz.slug, code); } catch (e) {}

        // The shelf, so this result can be found again long after the tab is closed. Saved
        // before either branch below: a reader who finishes into a comparison has still
        // finished, and their own result belongs to them either way.
        //
        // One instant, used twice. The device's copy of a finish and the account's have to
        // carry the same moment, and two calls to new Date() a breath apart are two separate
        // finishes to anything that later compares them.
        const at = new Date().toISOString();
        addResult(quiz.slug, code, at);
        // Said out loud rather than done here. An account, where there is one, listens for
        // this and puts the finish on its queue; with accounts switched off nothing is
        // listening and this page carries none of that code at all. The event is dispatched
        // synchronously, so the queue is written before the navigation below.
        document.dispatchEvent(
          new CustomEvent('ww:finished', { detail: { quiz: quiz.slug, code, at } })
        );

        // An invitation sends you to the two-person page instead, with the inviter first.
        // Cleared on the way out so a second run of the quiz in the same tab is just a
        // result again, and an identical code is treated as no comparison at all.
        let other = null;
        try { other = sessionStorage.getItem(WITH_KEY); } catch (e) {}
        // The URL carries the public codes; everything above keeps the canonical one.
        const link = await linkFor(code);
        if (other && other !== code) {
          try { sessionStorage.removeItem(WITH_KEY); } catch (e) {}
          window.location.href = `/c/${quiz.slug}/${withLink || publicCodeSync(quiz, other)}.${link}/`;
          return;
        }
        window.location.href = `/r/${quiz.slug}/${link}/`;
      }

      /*
       * The end of a run.
       *
       * A sheet with the same answer on every statement is the one case where the
       * arithmetic would name somebody on no information at all: on a quiz with two
       * statements keyed one way and one the other on each axis, agreeing eighteen times
       * lands on the same score on every axis and hands the reader a name that describes
       * the keying rather than them. Where a quiz asks for it, the reader is told that and
       * chooses. Everything else finishes exactly as it did.
       */
      function finish() {
        if (centresUniformSheets(quiz) && isUniformSheet(sheet)) {
          const box = $('uniform');
          if (box) {
            play.hidden = true;
            box.hidden = false;
            box.querySelector('.uniform-lede')?.focus?.();
            return;
          }
        }
        goToResult(scoreQuiz(quiz, sheet));
      }

      /*
       * "See the result anyway": the middle of every group, which is the honest reading of
       * a sheet with no variation in it, and the score at which this instrument already
       * names nobody. The code is a real one, so the link, the invitation and the
       * two-person page all work from here exactly as they do from any other result.
       */
      $('uniform-anyway')?.addEventListener('click', () => {
        goToResult(quiz.groups.map(() => 50));
      });

      // Back through them, with every answer kept, from the first statement.
      $('uniform-again')?.addEventListener('click', () => {
        $('uniform').hidden = true;
        play.hidden = false;
        at = 0;
        render();
        $('statement').focus?.();
      });

      // The button at the foot of the intro, and the one a quiz with `introShort` puts near
      // the top: the same way in.
      const begin = () => {
        intro.hidden = true;
        play.hidden = false;
        render();
        $('statement').focus?.();
      };
      $('start').addEventListener('click', begin);
      document.querySelectorAll('[data-start]').forEach(b => b.addEventListener('click', begin));

      /*
       * "Read this first" opens the fold under it and moves the reader to it. Without this
       * script the link is still an anchor to the <details>, so the reader lands on a
       * closed summary and one tap opens it — which is why the summary says what is inside.
       */
      const fold = $('before-you-start');
      document.querySelectorAll('[data-open-frame]').forEach(a => {
        a.addEventListener('click', e => {
          if (!fold) return;
          e.preventDefault();
          fold.open = true;
          fold.scrollIntoView({ block: 'start', behavior: 'smooth' });
          fold.querySelector('summary')?.focus?.();
        });
      });

      $('back').addEventListener('click', () => {
        clearTimeout(timer);
        if (at === 0) { play.hidden = true; intro.hidden = false; return; }
        at--;
        render();
      });

      document.addEventListener('keydown', e => {
        if (play.hidden) return;
        const n = Number(e.key);
        if (n >= 1 && n <= 5) { answer(SCALE[n - 1].v); e.preventDefault(); }
      });
    }
  </script>


</Base>
