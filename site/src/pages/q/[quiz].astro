---
/**
 * A quiz: its intro, and the runner it turns into.
 *
 * The intro is composed from the quiz's own data — counts, axes or categories, both pole
 * names on every axis — so adding a quiz still means adding a data file. Everything
 * introductory lives INSIDE #intro, which the runner already hides when play starts, so
 * the question screen is the whole page without the script having to learn a new rule.
 */
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import QuizPreview from '../../components/QuizPreview.astro';
import { QUIZZES, getQuiz } from '../../lib/engine/registry';

export function getStaticPaths() {
  return QUIZZES.map(q => ({ params: { quiz: q.slug } }));
}

const quiz = getQuiz(Astro.params.quiz)!;
const isDraft = quiz.status === 'draft';
const bipolar = quiz.strategy.shape === 'bipolar';

/**
 * The ghost word behind the band is taken from the quiz's own title — the last word long
 * enough to read at 40vw — so a new quiz brings its own and none is ever invented here.
 */
const words = quiz.title.toLowerCase().replace(/[^a-z\s]/g, ' ').split(/\s+/).filter(Boolean);
const ghost = [...words].reverse().find(w => w.length >= 5) ?? words[words.length - 1] ?? quiz.slug;
const painted = quiz.title
  .split(/\s+/)
  .find(w => w.toLowerCase().replace(/[^a-z]/g, '') === ghost);

const tiles = [
  { n: quiz.items.length, label: 'Statements' },
  { n: quiz.groups.length, label: bipolar ? 'Axes' : 'Categories' },
  ...(quiz.outcomes.length ? [{ n: quiz.outcomes.length, label: 'Traditions' }] : []),
  { n: `${quiz.minutes}m`, label: 'To take' }
];

const jsonLd = isDraft
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'Quiz',
      name: quiz.title,
      description: quiz.description,
      url: new URL(`/q/${quiz.slug}/`, Astro.site).href,
      numberOfQuestions: quiz.items.length,
      educationalLevel: 'general',
      about: { '@type': 'Thing', name: 'Christian belief and self-understanding' }
    };

// A draft is noindex, so it publishes no trail either: a breadcrumb is a statement about
// where a page sits in a site that search engines are invited to read.
const breadcrumbs = isDraft
  ? null
  : [
      { name: 'Home', url: '/' },
      { name: 'Quizzes', url: '/quizzes/' },
      { name: quiz.title, url: `/q/${quiz.slug}/` }
    ];
---
<Base
  title={quiz.title}
  description={quiz.description}
  noindex={isDraft}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title={quiz.title}
    blue={painted}
    ghost={ghost}
    eyebrow={`${quiz.items.length} statements · about ${quiz.minutes} minutes`}
    icon={quiz.icon}
    lede={quiz.description}
    tiles={tiles}
    long={quiz.title.length > 24}
  />

  <div class="runner" id="runner" data-quiz={quiz.slug}>
    <noscript>
      <div class="note">
        <p>This quiz is scored in your browser, so it needs JavaScript enabled. That is also
        why none of your answers are ever sent anywhere.</p>
      </div>
    </noscript>

    <div id="intro">
      {/*
        Shown only once a ?with= code has proved it decodes for THIS quiz. It says what is
        about to happen before a single statement is answered, because a reader who finds
        out afterwards that their answers were going somewhere they did not expect has been
        surprised by us, which is the one thing this site cannot afford to do.
      */}
      <div class="note" id="with-note" hidden>
        <p>
          Someone wants to see where you land next to them. Answer for yourself; the
          comparison comes after.
        </p>
      </div>

      <SectionHead
        title="What you will see"
        kicker={bipolar
          ? `${quiz.groups.length} axes · both ends named`
          : `${quiz.groups.length} categories · ranked by strength`}
      />
      <QuizPreview quiz={quiz} />

      <SectionHead title="How to answer" kicker="Five answers, none of them right" />
      <section class="howto panel layered">
        <div class="wash" aria-hidden="true"></div>
        <div class="veil" aria-hidden="true"></div>
        <p class="howto-lede">
          <b>Answer honestly rather than correctly</b> — there is no score to win. If a
          statement does not land either way, say so; “Unsure” is a real answer and is
          counted as one.
        </p>
        <dl class="spec">
          <div><dt>Scale</dt><dd>Five, strongly disagree to strongly agree</dd></div>
          <div><dt>Going back</dt><dd>Any time, one statement at a time</dd></div>
          <div><dt>Keyboard</dt><dd>Keys 1 to 5, if you have one</dd></div>
          <div><dt>Scored</dt><dd>On your device; nothing is sent</dd></div>
        </dl>
      </section>

      {isDraft && (
        <div class="note draft">
          <p><strong>Unaudited draft.</strong>{" " + quiz.draftNote}</p>
        </div>
      )}

      <section class="dark startbox">
        <div class="dark-ghost" aria-hidden="true">begin</div>
        <div class="startbox-text">
          <p class="feature-kicker">When you are ready</p>
          <h2>{quiz.items.length} statements, about {quiz.minutes} minutes.</h2>
          <p>
            You can stop at any point, and go back at any point. Nothing is kept either way.
          </p>
        </div>
        <div class="btn-row">
          <button class="btn" id="start" type="button">Start the quiz</button>
        </div>
      </section>
    </div>

    <div id="play" hidden>
      <div class="ask-top">
        <div class="ask-meta">
          <p class="count" id="count"></p>
          <span class="ask-quiz">{quiz.title}</span>
        </div>
        <div class="progress" style={`--pips:${quiz.items.length}`}>
          <i id="prog" style="width:0%"></i>
        </div>
      </div>

      <div class="ask layered">
        <div class="wash" aria-hidden="true"></div>
        <div class="veil" aria-hidden="true"></div>
        <p class="statement" id="statement" tabindex="-1"></p>
      </div>

      <div class="scale" id="scale"></div>

      <div class="runner-foot">
        <div class="runner-nav">
          <button class="btn ghost" id="back" type="button">← Back</button>
        </div>
        <p class="scale-hint">
          The scale runs from strongly disagree to strongly agree. Unsure sits in the middle
          and does not push you either way.
        </p>
      </div>
    </div>
  </div>

  <script>
    import { getQuiz, scoreQuiz, encodeFor, decodeFor } from '../../lib/engine/registry';

    const root = document.getElementById('runner');
    const quiz = getQuiz(root?.dataset.quiz);
    if (root && quiz) {
      const SCALE = [
        { v: -2, label: 'Strongly disagree' },
        { v: -1, label: 'Disagree' },
        { v: 0, label: 'Unsure / neither' },
        { v: 1, label: 'Agree' },
        { v: 2, label: 'Strongly agree' }
      ];

      const $ = (id) => document.getElementById(id);
      const intro = $('intro'), play = $('play'), scaleEl = $('scale');
      const sheet = new Array(quiz.items.length).fill(null);
      let at = 0;
      let timer = 0;

      /*
       * An invitation: ?with=<their code>.
       *
       * It is only honoured if it actually DECODES for this quiz, so a mangled or foreign
       * code drops the invitation and the reader takes the quiz normally, rather than
       * finishing into a comparison page that 404s. The code is a set of scores and
       * nothing else; it is kept tab-scoped and never sent anywhere.
       */
      const WITH_KEY = 'ww:with:' + quiz.slug;
      const invited = new URLSearchParams(location.search).get('with');
      if (invited) {
        const code = invited.trim().toUpperCase();
        if (decodeFor(quiz, code)) {
          try { sessionStorage.setItem(WITH_KEY, code); } catch (e) {}
          const note = $('with-note');
          if (note) note.hidden = false;
        }
      }

      SCALE.forEach(s => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = s.label;
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => answer(s.v));
        scaleEl.appendChild(b);
      });

      function render() {
        const item = quiz.items[at];
        $('statement').textContent = item.text;
        $('count').textContent = `Statement ${at + 1} of ${quiz.items.length}`;
        $('prog').style.width = `${(at / quiz.items.length) * 100}%`;
        [...scaleEl.children].forEach((b, i) => {
          b.setAttribute('aria-pressed', String(sheet[at] === SCALE[i].v));
        });
        // On the first statement Back leaves the quiz rather than sitting there dead.
        $('back').textContent = at === 0 ? '← Leave the quiz' : '← Back';
      }

      function answer(v) {
        sheet[at] = v;
        render();
        // A short beat so the selection is visible, but never a dead control:
        // any later click cancels the pending advance.
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (at < quiz.items.length - 1) { at++; render(); }
          else finish();
        }, 180);
      }

      function finish() {
        const values = scoreQuiz(quiz, sheet);
        const code = encodeFor(quiz, values);
        // A note for the result page, which is served identically to the person who just
        // took the quiz and to anyone they send the link to. Tab-scoped, never sent.
        try { sessionStorage.setItem('ww:took:' + quiz.slug, code); } catch (e) {}

        // An invitation sends you to the two-person page instead, with the inviter first.
        // Cleared on the way out so a second run of the quiz in the same tab is just a
        // result again, and an identical code is treated as no comparison at all.
        let other = null;
        try { other = sessionStorage.getItem(WITH_KEY); } catch (e) {}
        if (other && other !== code) {
          try { sessionStorage.removeItem(WITH_KEY); } catch (e) {}
          window.location.href = `/c/${quiz.slug}/${other}.${code}/`;
          return;
        }
        window.location.href = `/r/${quiz.slug}/${code}/`;
      }

      $('start').addEventListener('click', () => {
        intro.hidden = true;
        play.hidden = false;
        render();
        $('statement').focus?.();
      });

      $('back').addEventListener('click', () => {
        clearTimeout(timer);
        if (at === 0) { play.hidden = true; intro.hidden = false; return; }
        at--;
        render();
      });

      document.addEventListener('keydown', e => {
        if (play.hidden) return;
        const n = Number(e.key);
        if (n >= 1 && n <= 5) { answer(SCALE[n - 1].v); e.preventDefault(); }
      });
    }
  </script>


</Base>
