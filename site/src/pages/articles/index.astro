---
import Hero from '../../components/Hero.astro';
import Card from '../../components/Card.astro';
import SectionHead from '../../components/SectionHead.astro';
import KeepGoing from '../../components/KeepGoing.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getQuiz, quizHref } from '../../lib/engine/registry';
import { liveGames } from '../../lib/games';

/*
 * Newest first, and then by title. Seven of the eleven articles share a publication date, and
 * a sort with no tie-break leaves those seven in whatever order the file system handed them
 * over — which is not the same order on Windows as on Vercel's Linux builder. The hub and the
 * "More to read" block were shuffling between the two. The home page already sorted this way;
 * the other call sites simply never copied the second clause.
 */
const articles = (await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()
    || a.data.title.localeCompare(b.data.title));

/* Every number on this page is counted off the collection, never typed in. */
const minutes = articles.reduce((n, a) => n + a.data.minutes, 0);
const topics = [...new Set(articles.flatMap(a => a.data.tags))].sort();

const compass = getQuiz('theology-compass');
const game = liveGames()[0];
const next = [
  compass && {
    href: quizHref(compass),
    title: compass.title,
    meta: `Quiz · ${compass.items.length} statements · about ${compass.minutes} minutes`,
    text: compass.tagline,
    icon: compass.icon
  },
  game && {
    href: game.href,
    title: game.title,
    meta: 'Game · against the clock',
    text: game.tagline,
    icon: game.icon
  }
].filter(Boolean) as Array<{ href: string; title: string; meta?: string; text?: string; icon?: any }>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Articles',
  url: new URL('/articles/', Astro.site).href,
  hasPart: articles.map(a => ({
    '@type': 'Article',
    headline: a.data.title,
    url: new URL(`/articles/${a.id}/`, Astro.site).href,
    datePublished: a.data.published.toISOString().slice(0, 10)
  }))
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles/' }
];
import '../../styles/pages/reads.css';
import ReadCard from '../../components/ReadCard.astro';
const filterTopics = topics.filter(t => articles.filter(x => x.data.tags.includes(t)).length < articles.length * 0.6);
---
<Base
  title="Articles"
  description="Plain, practical writing on Christian formation: gratitude, joy, and what it actually means to be Christ-like."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="Articles"
    eyebrow="Formation"
    icon="book"
    kind="photo"
    image="/img/reads-sower.jpg"
    imageAlt=""
    imagePosition="62% 9%"
    tiles={[
      { n: articles.length, label: articles.length === 1 ? 'Article' : 'Articles' },
      { n: minutes, label: 'Minutes in all' },
      { n: topics.length, label: 'Topics' }
    ]}
  >
      Short, practical reads on becoming someone different, a little at a time.
  </Hero>

  <SectionHead title="Everything here" kicker="The slow work of formation" />

  {/*
    The topic chips FILTER the list (the owner, 2026-09-21: on a phone nobody should have to
    scroll eleven cards to find the one about worry). Tap one or several; a card stays if it
    has ANY of the chosen topics; "All" clears. Without JavaScript the chips do nothing and
    every article shows, which is the page as it was. "formation" is left out: nearly every
    piece carries it, so it filters nothing.
  */}
  {filterTopics.length > 0 && (
    <div class="topicline" data-topic-filter>
      <p class="jump-label" id="topic-label">Show articles about</p>
      <ul class="topic-chips" role="group" aria-labelledby="topic-label">
        <li><button type="button" class="topic-chip is-on" data-topic="" aria-pressed="true">All</button></li>
        {filterTopics.map(t => (
          <li><button type="button" class="topic-chip" data-topic={t} aria-pressed="false">{t}</button></li>
        ))}
      </ul>
      <p class="topic-count" role="status" aria-live="polite" data-topic-count></p>
    </div>
  )}

  <div class="hm-reads">
    {articles.map(a => (
      <ReadCard id={a.id} title={a.data.title} description={a.data.description} minutes={a.data.minutes}
                image={a.data.image} imageAlt={a.data.imageAlt} imagePosition={a.data.imagePosition} tags={a.data.tags} />
    ))}
  </div>

  {next.length > 0 && (
    <KeepGoing
      title="Or see where you stand."
      kicker="The other half of the site"
      ghost="try"
      lede="Reading about yourself and being shown where you actually land are two different things."
      links={next}
    />
  )}
  <script>
    const box = document.querySelector('[data-topic-filter]');
    if (box) {
      const chips = [...box.querySelectorAll('.topic-chip')];
      const cards = [...document.querySelectorAll('.hm-reads .read')];
      const count = box.querySelector('[data-topic-count]');
      const chosen = new Set();
      const paint = () => {
        chips.forEach(c => {
          const on = c.dataset.topic ? chosen.has(c.dataset.topic) : chosen.size === 0;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        let shown = 0;
        cards.forEach(card => {
          const tags = (card.dataset.tags || '').split('|');
          const keep = chosen.size === 0 || tags.some(t => chosen.has(t));
          card.hidden = !keep;
          if (keep) shown++;
        });
        if (count) count.textContent = chosen.size === 0 ? '' : `Showing ${shown} of ${cards.length}`;
        const hash = chosen.size ? '#topic=' + [...chosen].map(encodeURIComponent).join(',') : '';
        history.replaceState(null, '', location.pathname + location.search + hash);
      };
      chips.forEach(c => c.addEventListener('click', () => {
        const t = c.dataset.topic;
        if (!t) chosen.clear();
        else if (chosen.has(t)) chosen.delete(t);
        else chosen.add(t);
        paint();
      }));
      // a link such as /articles/#topic=worry,patience opens already filtered
      const m = /^#topic=(.+)$/.exec(location.hash);
      if (m) m[1].split(',').map(decodeURIComponent).forEach(t => { if (chips.some(c => c.dataset.topic === t)) chosen.add(t); });
      paint();
    }
  </script>
</Base>
