---
import Hero from '../../components/Hero.astro';
import Card from '../../components/Card.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Articles',
  url: new URL('/articles/', Astro.site).href,
  hasPart: articles.map(a => ({
    '@type': 'Article',
    headline: a.data.title,
    url: new URL(`/articles/${a.id}/`, Astro.site).href,
    datePublished: a.data.published.toISOString().slice(0, 10)
  }))
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles/' }
];
---
<Base
  title="Articles"
  description="Plain, practical writing on Christian formation: gratitude, joy, and what it actually means to be Christ-like."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero title="Articles" eyebrow="Formation" icon="book">
      Practical writing on formation — the slow business of becoming someone different.
      Every claim is tied to a text you can check.
  </Hero>

  <div class="cards">
    {articles.map(a => (
      <Card href={`/articles/${a.id}/`} icon="book" title={a.data.title} text={a.data.description} meta={`${a.data.minutes} min read`} />
    ))}
  </div>
</Base>
