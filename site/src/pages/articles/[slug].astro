---
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import KeepGoing from '../../components/KeepGoing.astro';
import { getCollection, render } from 'astro:content';
import { getQuiz, quizHref } from '../../lib/engine/registry';
import { liveGames } from '../../lib/games';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(a => !a.data.draft)
    .map(a => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

/*
 * The ghost word behind the band is the article's own subject, read off its slug rather
 * than written by hand, so a new article arrives with one already: the last segment
 * ("grateful", "joyful", "christlike"), falling back to the longest segment when that one
 * is too short to carry display type.
 */
const segments = article.id.split('-').filter(Boolean);
const last = segments[segments.length - 1] ?? '';
const ghost =
  last.length >= 4 ? last : segments.reduce((a, b) => (b.length > a.length ? b : a), '');

/* Contents from the rendered headings — the article's own h2s, in the order they appear. */
const contents = headings.filter(h => h.depth === 2).map(h => ({ id: h.slug, label: h.text }));

const published = article.data.published.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});

/*
 * Where to go next. Articles and quizzes cross-link in both directions, so the quizzes
 * this article names in its front matter come first, then the flagship and the game, with
 * anything already listed dropped rather than printed twice.
 */
const related = article.data.quizzes.map(getQuiz).filter(Boolean);
const compass = getQuiz('theology-compass');
const game = liveGames()[0];

type Go = { href: string; title: string; meta?: string; text?: string; icon?: any };
const next: Go[] = [];
const add = (g: Go) => { if (!next.some(x => x.href === g.href)) next.push(g); };

[...related, compass].forEach(q => {
  if (!q) return;
  add({
    href: quizHref(q),
    title: q.title,
    meta: q.status === 'draft'
      ? `Quiz · ${q.items.length} statements · unaudited draft`
      : `Quiz · ${q.items.length} statements · about ${q.minutes} minutes`,
    text: q.tagline,
    icon: q.icon
  });
});
if (game) add({ href: game.href, title: game.title, meta: 'Game · against the clock', text: game.tagline, icon: game.icon });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.published.toISOString().slice(0, 10),
  url: new URL(`/articles/${article.id}/`, Astro.site).href,
  publisher: { '@type': 'Organization', name: 'Wiser Walk' }
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles/' },
  { name: article.data.title, url: `/articles/${article.id}/` }
];
---
<Base
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title={article.data.title}
    eyebrow="Article"
    icon="book"
    ghost={ghost}
    lede={article.data.description}
    tiles={[
      { n: article.data.minutes, label: 'Minutes' },
      { n: contents.length, label: contents.length === 1 ? 'Section' : 'Sections' },
      { n: article.data.tags.length, label: article.data.tags.length === 1 ? 'Topic' : 'Topics' }
    ]}
    long
  />

  <div class="doc-layout">
    <aside class="doc-rail dark">
      <div class="dark-ghost" aria-hidden="true">{ghost}</div>
      <div class="rail-stick">
        <p class="rail-tag">Article</p>
        <dl class="spec spec--rail">
          <div><dt>Published</dt><dd>{published}</dd></div>
          <div><dt>Reading time</dt><dd>{article.data.minutes} min</dd></div>
          {article.data.tags.length > 0 && (
            <div><dt>Topics</dt><dd>{article.data.tags.join(', ')}</dd></div>
          )}
        </dl>
        <nav aria-label="Contents">
          <p class="toc-head">In this article</p>
          <ol class="toc-list">
            {contents.map(c => <li><a href={`#${c.id}`}>{c.label}</a></li>)}
          </ol>
        </nav>
        <div class="rail-foot">
          <a class="btn ghost" href="/articles/">All articles</a>
        </div>
      </div>
    </aside>

    <div class="pnl">
      <article class="doc doc--lead">
        <Content />
      </article>
    </div>
  </div>

  {next.length > 0 && (
    <KeepGoing
      title="Keep going."
      kicker="Where this leads"
      ghost="next"
      lede="Reading about yourself and seeing where you actually stand are two different things. These take a few minutes each."
      links={next}
    />
  )}
</Base>

{/*
 * The contents list marks the section the reader is in. It is an enhancement and nothing
 * depends on it: without JavaScript every link still jumps, and the list simply carries no
 * mark. The band of the viewport it watches is the top third, so a heading counts as
 * "current" from the moment it settles near the top rather than when it leaves.
 */}
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list a[href^="#"]'));
  if (links.length && 'IntersectionObserver' in window) {
    const sections = new Map<Element, HTMLAnchorElement>();
    for (const a of links) {
      const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (el) sections.set(el, a);
    }
    const order = Array.from(sections.keys());
    const visible = new Set<Element>();
    let current: HTMLAnchorElement | null = null;
    const mark = (a: HTMLAnchorElement) => {
      if (current === a) return;
      if (current) current.removeAttribute('aria-current');
      current = a;
      a.setAttribute('aria-current', 'true');
    };
    const io = new IntersectionObserver(
      entries => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target);
          else visible.delete(e.target);
        }
        const first = order.find(el => visible.has(el));
        if (first) mark(sections.get(first)!);
      },
      { rootMargin: '0px 0px -66% 0px', threshold: 0 }
    );
    sections.forEach((_, el) => io.observe(el));
  }
</script>
