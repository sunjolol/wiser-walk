---
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import NextUp from '../../components/NextUp.astro';
import ReadCard from '../../components/ReadCard.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import { getQuiz } from '../../lib/engine/registry';
import { liveGames } from '../../lib/games';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(a => !a.data.draft)
    .map(a => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

/*
 * The ghost word behind the band is the article's own subject, read off its slug rather
 * than written by hand, so a new article arrives with one already: the last segment
 * ("grateful", "joyful", "christlike"), falling back to the longest segment when that one
 * is too short to carry display type.
 */
const segments = article.id.split('-').filter(Boolean);
const last = segments[segments.length - 1] ?? '';
const ghost =
  last.length >= 4 ? last : segments.reduce((a, b) => (b.length > a.length ? b : a), '');

/* Contents from the rendered headings — the article's own h2s, in the order they appear. */
const contents = headings.filter(h => h.depth === 2).map(h => ({ id: h.slug, label: h.text }));

/*
 * The date, printed and marked up, and both read off the same instant.
 *
 * `published: 2026-09-20` in the front matter is midnight UTC, and rendering it in the build
 * machine's own zone turned it into "19 September" on any machine west of Greenwich. Nobody
 * noticed while it was only words on a page; the moment the same date is also published as a
 * <time datetime>, a visible date and a structured one that disagree is exactly what Google
 * asks a page not to do. So the rail is pinned to UTC, which is the zone the front matter is
 * written in. Vercel builds in UTC, so nothing on the live site moves.
 */
const published = article.data.published.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
});
const publishedISO = article.data.published.toISOString().slice(0, 10);

/*
 * Where to go next. Articles and quizzes cross-link in both directions, so the quizzes
 * this article names in its front matter come first, then the flagship, with anything
 * already listed dropped rather than printed twice, and the games after them.
 *
 * They are drawn as rooms wearing their own pictures (the dawn pass, 2026-09-21). They
 * used to be a list of dark boxes carrying three lines of text each, which is the shape
 * the owner has called "a soup of dullness" — and the foot of an article is the one place
 * on the page where a reader has finished and is deciding whether to stay.
 */
const named = article.data.quizzes.map(getQuiz).filter(Boolean);
const compass = getQuiz('theology-compass');
const seen = new Set<string>();
const nextQuizzes = [...named, compass].filter(q => {
  if (!q || seen.has(q.slug)) return false;
  seen.add(q.slug);
  return true;
}) as NonNullable<ReturnType<typeof getQuiz>>[];
const nextGames = liveGames();

/*
 * And the other articles. Ones sharing a topic with this piece first, then the rest by
 * date, so a short list is never padded with something unrelated but is never empty
 * either. Three, because they are printed as the paintings they are.
 */
const everything = (await getCollection('articles'))
  .filter(a => !a.data.draft && a.id !== article.id)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()
    || a.data.title.localeCompare(b.data.title));
const shares = (a: (typeof everything)[number]) =>
  a.data.tags.some(t => article.data.tags.includes(t));
const moreReads = [...everything.filter(shares), ...everything.filter(a => !shares(a))].slice(0, 3);

/*
 * The painting's real pixel size, read out of the file's own JPEG header rather than typed
 * anywhere, so the markup can never describe a picture that has since been re-exported. This
 * page is prerendered, so the read happens at build time; a file that cannot be parsed, or
 * cannot be found, simply gives the image no dimensions, which is what "if known" means.
 *
 * Anchored on the working directory rather than on `import.meta.url`: the dev server patches
 * node's fs and a read resolved against the module's own URL fails there with an opaque
 * filesystem error. `astro dev` and `astro build` both run from site/, which is also Vercel's
 * root directory, so the same path is right in both.
 */
function jpegSize(publicPath: string): { width: number; height: number } | null {
  try {
    const b = readFileSync(join(process.cwd(), 'public', publicPath));
    if (b.readUInt16BE(0) !== 0xffd8) return null;
    let i = 2;
    // Written as "length >" rather than "< b.length": a `<` followed by an identifier in an
    // Astro frontmatter is read as the start of a tag, and the page compiles into nonsense.
    while (b.length > i + 9) {
      if (b[i] !== 0xff) { i++; continue; }
      const marker = b[i + 1];
      if (marker === 0xff) { i++; continue; }
      // A start-of-frame marker carries the size. The four in that range that are not frame
      // headers (DHT, JPG, DAC, DNL) are stepped over like any other segment.
      if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
        return { width: b.readUInt16BE(i + 7), height: b.readUInt16BE(i + 5) };
      }
      if (marker === 0x01 || (marker >= 0xd0 && marker <= 0xd9)) { i += 2; continue; }
      i += 2 + b.readUInt16BE(i + 2);
    }
  } catch {}
  return null;
}

const url = new URL(`/articles/${article.id}/`, Astro.site).href;

/*
 * One Organization, named once and pointed at twice. The home page publishes the full node
 * under the same @id, so an engine that has read both pages holds one entity rather than two
 * that happen to share a name. The owner stays faceless: the author here is the site, which
 * is a type Google names explicitly for organisations, not a stand-in for a person.
 */
const ORGANISATION = {
  '@type': 'Organization',
  '@id': 'https://wiserwalk.com/#organization',
  name: 'Wiser Walk',
  url: 'https://wiserwalk.com/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://wiserwalk.com/icon-512.png',
    width: 512,
    height: 512
  }
};

const painting = article.data.image;
const paintingSize = painting ? jpegSize(painting) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(painting
    ? {
        image: {
          '@type': 'ImageObject',
          url: new URL(painting, Astro.site).href,
          ...(paintingSize ?? {}),
          ...(article.data.imageAlt ? { caption: article.data.imageAlt } : {})
        }
      }
    : {}),
  datePublished: article.data.published.toISOString().slice(0, 10),
  /* Only a real rewrite gets a dateModified. A deploy is not an edit, and there is no field
     here that a build timestamp could fill. */
  ...(article.data.updated
    ? { dateModified: article.data.updated.toISOString().slice(0, 10) }
    : {}),
  author: ORGANISATION,
  publisher: { '@id': ORGANISATION['@id'] },
  isPartOf: { '@id': 'https://wiserwalk.com/#website' },
  inLanguage: 'en'
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles/' },
  { name: article.data.title, url: `/articles/${article.id}/` }
];
import '../../styles/pages/reads.css';
---
<Base
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title={article.data.title}
    eyebrow="Article"
    icon="book"
    kind={article.data.image ? 'photo' : 'night'}
    image={article.data.image}
    imageAlt={article.data.imageAlt}
    imagePosition={article.data.imagePosition}
    credit={article.data.imageCredit}
    lede={article.data.description}
    tiles={[
      { n: article.data.minutes, label: 'Minutes' },
      { n: contents.length, label: contents.length === 1 ? 'Section' : 'Sections' },
      { n: article.data.tags.length, label: article.data.tags.length === 1 ? 'Topic' : 'Topics' }
    ]}
    long
  />

  <div class="doc-layout">
    <aside class="doc-rail dark">
      <div class="dark-ghost" aria-hidden="true">{ghost}</div>
      <div class="rail-stick">
        <p class="rail-tag">Article</p>
        {/*
          The reading time and the topics used to be repeated here as a spec list, directly
          under a band that had just printed both as tiles. What a reader wants beside a
          long piece is the way through it, so the rail is the date, the contents and the
          way back, and the repeat is gone (the dawn pass, 2026-09-21).
        */}
        <p class="rail-when">Published <time datetime={publishedISO}>{published}</time></p>
        <nav aria-label="Contents">
          <p class="toc-head">In this article</p>
          <ol class="toc-list">
            {contents.map(c => <li><a href={`#${c.id}`}>{c.label}</a></li>)}
          </ol>
        </nav>
        <div class="rail-foot">
          <a class="btn ghost" href="/articles/">All articles</a>
        </div>
      </div>
    </aside>

    <div class="pnl">
      {/* The painting moved into the band on 2026-09-21 (the dawn pass), with its credit.
          Drawing it here as well put the same picture on the page twice. */}
      <article class="doc doc--lead">
        <Content />
      </article>
    </div>
  </div>

  {(nextQuizzes.length > 0 || nextGames.length > 0) && (
    <section class="doc-next">
      <SectionHead title="Keep going" kicker="Where this leads" />
      <NextUp quizzes={nextQuizzes} games={nextGames} />
    </section>
  )}

  {moreReads.length > 0 && (
    <section>
      <SectionHead title="More to read" kicker="From the same shelf" href="/articles/" more="All articles" />
      <div class="hm-reads reads-foot">
        {moreReads.map(a => (
          <ReadCard id={a.id} title={a.data.title} description={a.data.description}
                    minutes={a.data.minutes} image={a.data.image} imageAlt={a.data.imageAlt}
                    imagePosition={a.data.imagePosition} />
        ))}
      </div>
    </section>
  )}
</Base>

{/*
 * The contents list marks the section the reader is in. It is an enhancement and nothing
 * depends on it: without JavaScript every link still jumps, and the list simply carries no
 * mark. The band of the viewport it watches is the top third, so a heading counts as
 * "current" from the moment it settles near the top rather than when it leaves.
 */}
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list a[href^="#"]'));
  if (links.length && 'IntersectionObserver' in window) {
    const sections = new Map<Element, HTMLAnchorElement>();
    for (const a of links) {
      const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (el) sections.set(el, a);
    }
    const order = Array.from(sections.keys());
    const visible = new Set<Element>();
    let current: HTMLAnchorElement | null = null;
    const mark = (a: HTMLAnchorElement) => {
      if (current === a) return;
      if (current) current.removeAttribute('aria-current');
      current = a;
      a.setAttribute('aria-current', 'true');
    };
    const io = new IntersectionObserver(
      entries => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target);
          else visible.delete(e.target);
        }
        const first = order.find(el => visible.has(el));
        if (first) mark(sections.get(first)!);
      },
      { rootMargin: '0px 0px -66% 0px', threshold: 0 }
    );
    sections.forEach((_, el) => io.observe(el));
  }
</script>
