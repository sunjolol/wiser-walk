---
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import NextUp from '../../components/NextUp.astro';
import ReadCard from '../../components/ReadCard.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Icon from '../../components/Icon.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import { getQuiz } from '../../lib/engine/registry';
import { liveGames } from '../../lib/games';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(a => !a.data.draft)
    .map(a => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

/*
 * The ghost word behind the rail is the article's own subject, read off its slug rather
 * than written by hand, so a new article arrives with one already: the last segment
 * ("grateful", "joyful", "christlike"), falling back to the longest segment when that one
 * is too short to carry display type.
 */
const segments = article.id.split('-').filter(Boolean);
const last = segments[segments.length - 1] ?? '';
const ghost =
  last.length >= 4 ? last : segments.reduce((a, b) => (b.length > a.length ? b : a), '');

/*
 * Contents from the rendered headings — the article's own h2s, in the order they appear.
 * The number is written out here rather than drawn by a CSS counter, because the reading
 * bar clones this list into itself and a counter would restart inside the copy.
 */
const contents = headings
  .filter(h => h.depth === 2)
  .map((h, i) => ({ id: h.slug, label: h.text, n: String(i + 1).padStart(2, '0') }));

/*
 * The date, printed and marked up, and both read off the same instant.
 *
 * `published: 2026-09-20` in the front matter is midnight UTC, and rendering it in the build
 * machine's own zone turned it into "19 September" on any machine west of Greenwich. Nobody
 * noticed while it was only words on a page; the moment the same date is also published as a
 * <time datetime>, a visible date and a structured one that disagree is exactly what Google
 * asks a page not to do. So the rail is pinned to UTC, which is the zone the front matter is
 * written in. Vercel builds in UTC, so nothing on the live site moves.
 */
const day = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const published = day(article.data.published);
const publishedISO = iso(article.data.published);
/* Only a real rewrite has an `updated`; nothing prints where there has not been one. */
const updated = article.data.updated ? day(article.data.updated) : null;
const updatedISO = article.data.updated ? iso(article.data.updated) : null;

/*
 * Where to go next. Articles and quizzes cross-link in both directions, so the quizzes
 * this article names in its front matter come first, then the flagship, with anything
 * already listed dropped rather than printed twice, and the games after them.
 *
 * They are drawn as rooms wearing their own pictures (the dawn pass, 2026-09-21). They
 * used to be a list of dark boxes carrying three lines of text each, which is the shape
 * the owner has called "a soup of dullness" — and the foot of an article is the one place
 * on the page where a reader has finished and is deciding whether to stay.
 */
const named = article.data.quizzes.map(getQuiz).filter(Boolean);
const compass = getQuiz('theology-compass');
const seen = new Set<string>();
const nextQuizzes = [...named, compass].filter(q => {
  if (!q || seen.has(q.slug)) return false;
  seen.add(q.slug);
  return true;
}) as NonNullable<ReturnType<typeof getQuiz>>[];
const nextGames = liveGames();

/*
 * And the other articles. Ones sharing a topic with this piece first, then the rest by
 * date, so a short list is never padded with something unrelated but is never empty
 * either. Three, because they are printed as the paintings they are.
 */
const everything = (await getCollection('articles'))
  .filter(a => !a.data.draft && a.id !== article.id)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()
    || a.data.title.localeCompare(b.data.title));
const shares = (a: (typeof everything)[number]) =>
  a.data.tags.some(t => article.data.tags.includes(t));
const moreReads = [...everything.filter(shares), ...everything.filter(a => !shares(a))].slice(0, 3);

/*
 * The painting's real pixel size, read out of the file's own JPEG header rather than typed
 * anywhere, so the markup can never describe a picture that has since been re-exported. This
 * page is prerendered, so the read happens at build time; a file that cannot be parsed, or
 * cannot be found, simply gives the image no dimensions, which is what "if known" means.
 *
 * Anchored on the working directory rather than on `import.meta.url`: the dev server patches
 * node's fs and a read resolved against the module's own URL fails there with an opaque
 * filesystem error. `astro dev` and `astro build` both run from site/, which is also Vercel's
 * root directory, so the same path is right in both.
 */
function jpegSize(publicPath: string): { width: number; height: number } | null {
  try {
    const b = readFileSync(join(process.cwd(), 'public', publicPath));
    if (b.readUInt16BE(0) !== 0xffd8) return null;
    let i = 2;
    // Written as "length >" rather than "< b.length": a `<` followed by an identifier in an
    // Astro frontmatter is read as the start of a tag, and the page compiles into nonsense.
    while (b.length > i + 9) {
      if (b[i] !== 0xff) { i++; continue; }
      const marker = b[i + 1];
      if (marker === 0xff) { i++; continue; }
      // A start-of-frame marker carries the size. The four in that range that are not frame
      // headers (DHT, JPG, DAC, DNL) are stepped over like any other segment.
      if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
        return { width: b.readUInt16BE(i + 7), height: b.readUInt16BE(i + 5) };
      }
      if (marker === 0x01 || (marker >= 0xd0 && marker <= 0xd9)) { i += 2; continue; }
      i += 2 + b.readUInt16BE(i + 2);
    }
  } catch {}
  return null;
}

const url = new URL(`/articles/${article.id}/`, Astro.site).href;

/*
 * How many words the piece actually is, counted off its own source rather than typed into
 * the front matter where it would go stale on the first edit. The markup is stripped rather
 * than parsed: link text is kept and the address dropped, pictures and fences go entirely,
 * and the marker characters are removed one at a time so that a hyphenated word stays one
 * word. It is an honest count of the prose, which is what wordCount is for.
 */
const plain = article.body
  ? article.body
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
      .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replace(/^\s*-{3,}\s*$/gm, ' ')
      .replace(/[#>*_`~]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
  : '';
const wordCount = plain ? plain.split(' ').length : 0;

/* The shelf this piece sits on, for a search engine that wants to group a site's writing.
   It is the article's own first topic, never one invented here. */
const topic = article.data.tags[0];
const articleSection = topic ? topic.charAt(0).toUpperCase() + topic.slice(1) : null;

/*
 * One Organization, named once and pointed at twice. The home page publishes the full node
 * under the same @id, so an engine that has read both pages holds one entity rather than two
 * that happen to share a name. The owner stays faceless: the author here is the site, which
 * is a type Google names explicitly for organisations, not a stand-in for a person.
 */
const ORGANISATION = {
  '@type': 'Organization',
  '@id': 'https://wiserwalk.com/#organization',
  name: 'Wiser Walk',
  url: 'https://wiserwalk.com/',
  logo: {
    '@type': 'ImageObject',
    url: 'https://wiserwalk.com/icon-512.png',
    width: 512,
    height: 512
  }
};

const painting = article.data.image;
const paintingSize = painting ? jpegSize(painting) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(painting
    ? {
        image: {
          '@type': 'ImageObject',
          url: new URL(painting, Astro.site).href,
          ...(paintingSize ?? {}),
          ...(article.data.imageAlt ? { caption: article.data.imageAlt } : {})
        }
      }
    : {}),
  datePublished: publishedISO,
  /* Only a real rewrite gets a dateModified. A deploy is not an edit, and there is no field
     here that a build timestamp could fill. */
  ...(updatedISO ? { dateModified: updatedISO } : {}),
  ...(wordCount ? { wordCount } : {}),
  /* The same minutes the band prints, in the form schema.org asks for. */
  timeRequired: `PT${article.data.minutes}M`,
  ...(articleSection ? { articleSection } : {}),
  author: ORGANISATION,
  publisher: { '@id': ORGANISATION['@id'] },
  isPartOf: { '@id': 'https://wiserwalk.com/#website' },
  inLanguage: 'en'
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/articles/' },
  { name: article.data.title, url: `/articles/${article.id}/` }
];
import '../../styles/pages/reads.css';
---
<Base
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <ReadingProgress minutes={article.data.minutes} />

  <Hero
    title={article.data.title}
    eyebrow="Article"
    icon="book"
    kind={article.data.image ? 'painting' : 'night'}
    image={article.data.image}
    imageAlt={article.data.imageAlt}
    imagePosition={article.data.imagePosition}
    credit={article.data.imageCredit}
    lede={article.data.description}
    tiles={[
      { n: article.data.minutes, label: 'Minutes' },
      { n: contents.length, label: contents.length === 1 ? 'Section' : 'Sections' },
      { n: article.data.tags.length, label: article.data.tags.length === 1 ? 'Topic' : 'Topics' }
    ]}
    long
  />

  <div class="doc-layout">
    {/*
      One element, two skins (2026-09-21). On a phone it is a compact light block sitting
      directly under the band — the date, then the way through the piece as full-width rows
      on dotted rules. From 62rem the same element becomes the charcoal rail beside the
      reading column, sticky, with the tag, the pace and the way back that a phone has no
      room for. The owner's words on the old one: the bubbles should span the full width,
      each only as tall as its text needs, and dotted lines rather than bubbles.
    */}
    <aside class="doc-rail">
      <div class="rail-ghost" aria-hidden="true">{ghost}</div>
      <div class="side-stick">
        <p class="side-tag">Article</p>
        {/* The reading time is one thing and must wrap as one: left to itself it put the
            numeral at the end of a line and "min read" on the next. */}
        <p class="side-when">
          Published <time datetime={publishedISO}>{published}</time>
          <span class="side-dot" aria-hidden="true">·</span>
          <span class="side-read">{article.data.minutes} min read</span>
        </p>
        {updated && (
          <p class="side-when side-when--upd">
            Updated <time datetime={updatedISO}>{updated}</time>
          </p>
        )}
        {/* Filled in by ReadingProgress, and absent entirely without it. */}
        <div class="side-pace" hidden>
          <span class="side-pace-track"><i></i></span>
          <span class="side-pace-left"></span>
        </div>

        {contents.length > 0 && (
          <nav class="toc" id="contents" aria-label="Contents">
            <p class="toc-head">
              In this article
              <span class="toc-count">{contents.length} {contents.length === 1 ? 'section' : 'sections'}</span>
            </p>
            <ol class="toc-list" id="toc-list">
              {contents.map(c => (
                <li>
                  <a href={`#${c.id}`} data-label={c.label}>
                    <span class="toc-num">{c.n}</span>
                    <span class="toc-label">{c.label}</span>
                    <span class="toc-chev" aria-hidden="true"></span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="side-foot">
          <a class="btn ghost" href="/articles/">All articles</a>
        </div>
      </div>
    </aside>

    {/*
      No panel on a phone. The owner: it makes no sense to put the article inside a content
      box when the screen is already narrow, because the box takes width the reader does not
      have to spare. So the prose sits straight on the page inside the page's own gutter, and
      the sheet comes back only from 46rem, where there is paper to spare.
    */}
    <div class="art-sheet">
      <article class="doc doc--lead doc--article" id="article-body">
        {article.data.answer && (
          <aside class="inshort" aria-label="In short">
            <p class="inshort-head">In short</p>
            <p>{article.data.answer}</p>
          </aside>
        )}
        <Content />
      </article>

    </div>
  </div>

  {(nextQuizzes.length > 0 || nextGames.length > 0) && (
    <section class="doc-next">
      <SectionHead title="Try one" kicker="Where this leads" />
      <NextUp quizzes={nextQuizzes} games={nextGames} />
    </section>
  )}

  {moreReads.length > 0 && (
    <section>
      <SectionHead title="Keep reading" kicker="From the same shelf" />
      <div class="hm-reads reads-foot">
        {moreReads.map(a => (
          <ReadCard id={a.id} title={a.data.title} description={a.data.description}
                    minutes={a.data.minutes} image={a.data.image} imageAlt={a.data.imageAlt}
                    imagePosition={a.data.imagePosition} />
        ))}
      </div>
    </section>
  )}
  {/*
    The foot of the piece, in the order a reader meets it: the thing to do next, the
    other articles, then the two quiet buttons. The share control is hidden until the
    script can tell which of the two it is; with no script there is nothing to press
    that would not have done nothing.
  */}
  <div class="art-end">
    <button class="btn ghost art-share" type="button" hidden
            data-title={article.data.title} data-url={url}>
      <span class="art-share-say">Copy link</span>
    </button>
    <a class="btn ghost art-back" href="/articles/">All articles <Icon name="arrow" size={14} /></a>
  </div>

  {/*
    Sharing the piece, with nothing from anybody else on the page.

    A phone that has the share sheet gets the share sheet, which is the one the reader
    already knows and the only route to the app they actually use. Everything else copies
    the address and says so. No network, no icons from a social network, no script but
    this one: an article that loads a tracker in order to be shared is not worth sharing.

    It sits directly under the button it wires up, so it runs the moment that button
    exists and needs no listener to tell it the page is ready.
  */}
  <script is:inline>
    (function () {
      var btn = document.querySelector('.art-share');
      if (!btn) return;
      var say = btn.querySelector('.art-share-say');
      var title = btn.getAttribute('data-title') || document.title;
      var url = btn.getAttribute('data-url') || location.href;
      var sheet = typeof navigator.share === 'function';
      var clip = navigator.clipboard && navigator.clipboard.writeText;
      if (!sheet && !clip) return;

      if (sheet) say.textContent = 'Share this article';
      btn.hidden = false;

      var resting = say.textContent;
      var timer = 0;
      var said = function (text) {
        say.textContent = text;
        btn.classList.add('is-said');
        window.clearTimeout(timer);
        timer = window.setTimeout(function () {
          say.textContent = resting;
          btn.classList.remove('is-said');
        }, 2400);
      };

      btn.addEventListener('click', function () {
        if (sheet) {
          navigator.share({ title: title, url: url }).catch(function () {});
          return;
        }
        navigator.clipboard.writeText(url).then(
          function () { said('Link copied'); },
          function () { said('Could not copy'); }
        );
      });
    })();
  </script>

</Base>
