---
/**
 * Sounds Like Scripture, the first game.
 *
 * The game is a one-screen app, so it does not sit inside the Base layout: a site header
 * and footer would take the room the card and the two answer buttons need on a phone. It
 * is its own document, carrying the same head the layout would give it (canonical, Open
 * Graph, breadcrumbs, the stored theme, the analytics hook).
 *
 * The markup, styles, script and the pool of lines come from one generated fragment,
 * src/games/sounds-like-scripture.html, written by
 * demos/sounds-like-scripture/scripts/build-page.mjs. It is generated but committed, for the
 * same reason as src/data/compass.json: Vercel's root directory is site/. Never hand-edit
 * it; change demos/sounds-like-scripture/game.src.html and rebuild. The same fragment is
 * the standalone demo, so the two cannot drift.
 */
import fragment from '../../games/sounds-like-scripture.html?raw';

const title = 'Sounds Like Scripture';
const siteName = 'Wiser Walk';
const description =
  'A line appears. Is it in the Bible, or does it only sound like it? Ten lines against the clock, every one quoted word for word, with the citation after each answer.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Split the fragment where its stylesheet ends: what comes before belongs in the head.
const SPLIT = '</style>';
const cut = fragment.indexOf(SPLIT);
if (cut === -1) throw new Error('sounds-like-scripture.html: no </style> to split on');
if (fragment.includes('/*__POOL__*/')) throw new Error('sounds-like-scripture.html: the pool was never injected');

let head = fragment.slice(0, cut + SPLIT.length).replace(/<title>[\s\S]*?<\/title>/, '');
let body = fragment.slice(cut + SPLIT.length);

// The standalone demo has nowhere to link to; the live page does. Both swaps fail the build
// rather than silently doing nothing if the source markup ever changes.
const swap = (html: string, find: string, put: string) => {
  if (!html.includes(find)) throw new Error(`sounds-like-scripture.html: expected markup not found: ${find}`);
  return html.replace(find, () => put);
};

/*
 * One Google Fonts request for the whole site.
 *
 * The generated document asks for its own weight list, which is not the layout's, so a reader
 * crossing from any other page pays for a second render-blocking stylesheet that delivers the
 * same faces. The two strings have to be character-identical or the browser keeps two cache
 * entries, which is the whole point of matching them. The fragment is generated and must never
 * be hand-edited, so the swap happens here, on the copy this page serves, and fails the build
 * if the source markup ever moves.
 */
const FONTS_GAME =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Philosopher:ital,wght@0,400;0,700;1,400;1,700&family=Poppins:wght@500;600;700&display=swap';
/* Since 2026-09-21 the layout serves the faces itself from /fonts/, so the game's Google
   stylesheet becomes the same local one, and the two preconnects to Google go with it. */
const FONTS_LAYOUT = '/fonts/fonts.css?v=2';
head = swap(head, FONTS_GAME, FONTS_LAYOUT);
head = swap(head, '<link rel="preconnect" href="https://fonts.googleapis.com">\n', '');
head = swap(head, '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n', '');

body = swap(
  body,
  '<p class="band-chip">A wiserwalk game</p>',
  '<p class="band-chip"><a class="ww-home" href="/">&larr; Wiser Walk</a></p>'
);
/* The game's result screen ends on an empty marker paragraph (its small print was removed on
   2026-09-22); the live page puts its two onward links in its place. */
body = swap(
  body,
  '<p class="small foot" id="footResult"></p>',
  '<p class="small ww-more"><a href="/q/theology-compass/">Take the Theology Compass</a><span aria-hidden="true"> · </span><a href="/">More from Wiser Walk</a></p>'
);

/* The full trail, as every other template publishes one. It used to skip /games/, which is a
   real indexable hub with its own place in the sitemap, so the one rich result this site can
   realistically earn was being published a step short. */
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Games', item: new URL('/games/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: title, item: canonical }
  ]
};
/* Search and social: the inviting title and description, and this game's own card. */
import { SEO, ogImageFor } from '../../lib/seo';
const seoEntry = SEO['/play/sounds-like-scripture/'];
const socialTitle = seoEntry?.title ?? title;
const socialDescription = seoEntry?.description ?? description;
const ogImage = new URL(ogImageFor('/play/sounds-like-scripture/'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seoEntry ? socialTitle : `${title} — ${siteName}`}</title>
    <meta name="description" content={socialDescription} />
    <link rel="canonical" href={canonical} />
    {/* The same feed autodiscovery the layout gives every other page: a reader app that
        lands here should still find the articles. */}
    <link rel="alternate" type="application/rss+xml" title="Wiser Walk articles" href="/articles/feed.xml" />
    <meta name="robots" content="max-image-preview:large" />
    {/* The same icon links as layouts/Base.astro: this page is its own document. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>
      try {
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'light' || q === 'dark') localStorage.setItem('ww-theme', q);
        var t = q === 'light' || q === 'dark' ? q : localStorage.getItem('ww-theme');
        if (t === 'dark') document.documentElement.dataset.theme = 'dark';
        else document.documentElement.dataset.theme = 'light';
      } catch (e) { document.documentElement.dataset.theme = 'light'; }
    </script>

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* The two the layout sets for every other page, and that this hand-written head had
        drifted away from. The comment at the top of this file claims parity; now it holds. */}
    <meta property="og:image:alt" content={socialTitle} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

    <script is:inline>
      // A challenge link carries a run number, a score and ten answer times after the "#".
      // Nothing personal, but the rule on this site is that no code is ever recorded, so the
      // fragment and any query are stripped before the view is counted.
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
      window.va('beforeSend', function (event) {
        try {
          var u = new URL(event.url);
          u.search = '';
          u.hash = '';
          return Object.assign({}, event, { url: u.toString() });
        } catch (e) {}
        return event;
      });
    </script>

    <Fragment set:html={head} />

    <style is:inline>
      .ww-home, .ww-more a { color: inherit; text-decoration: none; }
      .ww-home:hover, .ww-more a:hover { text-decoration: underline; }
      .ww-more { margin: 1.4rem 0 0; text-align: center; }
      .ww-more a { color: var(--accent); font-weight: 600; white-space: nowrap; }
      /* Each link stays whole. On the narrowest phones the pair no longer fits on one line, so
         they stack, centred, and the dot between them goes rather than ending a line. */
      @media (max-width: 23.99rem) {
        .ww-more a { display: block; }
        .ww-more a + span + a { margin-top: .6rem; }
        .ww-more span { display: none; }
      }
      /* on the stage the links sit in the right-hand column under the buttons, left aligned */
      @media (min-width: 56rem) { #screen-result .ww-more { text-align: left; margin-top: 1.4rem; } }
    </style>
  </head>
  <body>
    <Fragment set:html={body} />
  </body>
</html>
