---
/**
 * The home page, planned as one piece (2026-09-20).
 *
 * The owner's verdict on what stood here: templated, a soup of the same three colours, walls
 * of text, no pictures, no flow. So this page is composed rather than assembled, and it has
 * one idea: the brand's blue-to-orange is a sky at first light, and the site is a walk.
 *
 *   sky        the hero is a real dawn sky, and the quizzes rise out of its lower edge
 *   four rooms each quiz has its own picture, its own ink and its own mark, so none of them
 *              looks like the next: the compass is an instrument on a night ground, the
 *              figures, the gifts and the seven are three Doré engravings in one ink, so the
 *              art is one family and the subjects are not
 *   night      the games sit on a dark band with an hourglass and an old book: a clock and a text
 *   morning    the articles are photographs first and words second
 *   the walk   the footer opens on the walker at dawn, and asks for an address there
 *
 * Every number is computed from the registry. Every picture is free to use (Unsplash) or in
 * the public domain (Doré 1866); the credits are in public/img/CREDITS.md.
 */
import '../styles/pages/home.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CompassWheel from '../components/CompassWheel.astro';
import { QUIZZES, getQuiz, scoreQuiz, resultFor, outcomeHref, quizHref } from '../lib/engine/registry';
import { groupNounPlural } from '../lib/engine/types';
import type { BipolarView } from '../lib/engine/types';
import { liveGames } from '../lib/games';
import slsMeta from '../games/sounds-like-scripture.meta.json';
import wsiMeta from '../games/who-said-it.meta.json';
import audit from '../data/compass-audit.json';
import { getCollection } from 'astro:content';

const compass = getQuiz('theology-compass')!;
const figures = getQuiz('bible-figure');
const gifts = getQuiz('spiritual-gifts');
const sins = getQuiz('seven-deadly-sins');
const games = liveGames();
const sls = games.find(g => g.slug === 'sounds-like-scripture');
const wsi = games.find(g => g.slug === 'who-said-it');

/* The wheel is a REAL result: a published, audited answer sheet scored by the live engine. */
const EXAMPLE = 'Anglican (broad)';
const sheet = (audit.simulations as Array<Record<string, any>>).find(
  s => s.tradition === EXAMPLE && Array.isArray(s.answers)
);
const exampleView = sheet ? (resultFor(compass, scoreQuiz(compass, sheet.answers)) as BipolarView) : null;

const articles = (await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
/* Until articles carry their own picture in front matter, the page pairs them by subject. */
const articleArt = (id: string) =>
  id.includes('grateful') ? { src: '/img/art-gratitude.jpg', alt: 'Two open hands held out together, palms up' }
  : id.includes('joy') ? { src: '/img/art-joy.jpg', alt: 'A woman dancing in a field with the sun low behind her' }
  : { src: '/img/art-walk.jpg', alt: 'A line of footprints along a beach at sunrise' };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wiser Walk',
  url: 'https://wiserwalk.com/',
  description: 'Quizzes, games and articles for understanding yourself, and your walk with God, a little better.'
};
---
<Base
  title="Wiser Walk"
  description="Quizzes, games and articles for understanding yourself, and your walk with God, a little better. Start with the Theology Compass."
  jsonLd={jsonLd}
>
  <section class="hm-hero">
    <img class="hm-hero-img" src="/img/sky-rays.jpg" alt="" width="1800" height="1200" fetchpriority="high" decoding="async" />
    <div class="hm-hero-in">
      <p class="hm-chip"><Icon name="path" size={14} /> {QUIZZES.length} quizzes · {games.length} games · {articles.length} articles</p>
      <h1>Know yourself<br />a little <em>better.</em></h1>
      <p class="hm-lede">
        Quizzes and Bible games for Christians who would rather see themselves clearly than
        comfortably.
      </p>
      <div class="hm-cta">
        <a class="btn" href={quizHref(compass)}>Find your tradition <Icon name="arrow" size={15} /></a>
        <a class="hm-btn-glass" href="/games/"><Icon name="play" size={13} /> Play a game</a>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ four rooms */}
  <section class="hm-rooms" aria-labelledby="hm-quizzes">
    <header class="hm-head hm-head--over">
      <p class="hm-kicker">See where you stand</p>
      <h2 id="hm-quizzes">quizzes</h2>
      <a class="hm-more" href="/quizzes/">All quizzes <Icon name="arrow" size={13} /></a>
    </header>

      <a class="room room--compass dark" href={quizHref(compass)}>
        <div class="room-body">
          <span class="room-mark"><Icon name="compass" size={20} /></span>
          <p class="room-kicker">The flagship</p>
          <h3>{compass.title}</h3>
          <p class="room-say">Six questions that divide Christians, and the tradition that sits nearest you.</p>
          <ul class="room-facts">
            <li><Icon name="clock" size={13} /> {compass.minutes} min</li>
            <li>{compass.items.length} statements</li>
            <li>{compass.outcomes.length} traditions</li>
          </ul>
          <span class="room-go">Start <Icon name="arrow" size={14} /></span>
        </div>
        <div class="room-wheel">
          {exampleView && <CompassWheel view={exampleView} />}
          {exampleView && <p class="room-note">A real result: the published {EXAMPLE} answer sheet.</p>}
        </div>
      </a>

    {/*
      The other quizzes stand on a rail, because there will be more than four. Each keeps a
      width it can breathe in, the rail runs off the right edge behind a fade, and it moves by
      swipe, by drag, by the arrows or by the keyboard. Nothing is squeezed to fit a row.
    */}
    <div class="hm-rail" data-rail>
      <div class="hm-rail-track" data-rail-track tabindex="0" role="group" aria-label="More quizzes">
        {figures && (
          <a class="room room--figures" href={quizHref(figures)}>
            <img src="/img/dore-moses.jpg" alt="Gustave Doré’s engraving of Moses breaking the tablets of the law" loading="lazy" decoding="async" width="1000" height="1255" />
            <div class="room-body">
              <span class="room-mark"><Icon name="users" size={20} /></span>
              <h3>{figures.title}</h3>
              <p class="room-say">Eighteen plain statements about you. None of them mentions the Bible.</p>
              <ul class="room-facts">
                <li><Icon name="clock" size={13} /> {figures.minutes} min</li>
                <li>{figures.outcomes.length} figures</li>
              </ul>
              <span class="room-go">Find yours <Icon name="arrow" size={14} /></span>
            </div>
          </a>
        )}

        {gifts && (
          <a class="room room--gifts" href={quizHref(gifts)}>
            <img src="/img/dore-paul.jpg" alt="Gustave Doré’s engraving of Paul preaching to a gathered church at Thessalonica" loading="lazy" decoding="async" width="565" height="696" />
            <div class="room-body">
              <span class="room-mark"><Icon name="sparkle" size={20} /></span>
              <h3>{gifts.title}</h3>
              <p class="room-say">All {gifts.groups.length} {groupNounPlural(gifts)} the New Testament names.</p>
              <ul class="room-facts">
                <li><Icon name="clock" size={13} /> {gifts.minutes} min</li>
                <li>{gifts.items.length} statements</li>
              </ul>
              <span class="room-go">Take it <Icon name="arrow" size={14} /></span>
            </div>
          </a>
        )}

        {sins && (
          <a class="room room--sins" href={quizHref(sins)}>
            <img src="/img/dore-eden.jpg" alt="Gustave Doré’s engraving of Adam and Eve driven out of Eden" loading="lazy" decoding="async" width="1000" height="1256" />
            {sins.status === 'draft' && <span class="room-tab">Draft</span>}
            <div class="room-body">
              <span class="room-mark"><Icon name="apple" size={20} /></span>
              <h3>{sins.title}</h3>
              <ul class="room-facts">
                <li><Icon name="clock" size={13} /> {sins.minutes} min</li>
                <li>{sins.items.length} statements</li>
              </ul>
              <span class="room-go">Take it <Icon name="arrow" size={14} /></span>
            </div>
          </a>
        )}
      </div>
      <button class="hm-rail-btn hm-rail-btn--prev" type="button" data-rail-prev aria-label="Scroll the quizzes back" hidden><Icon name="arrow" size={18} /></button>
      <button class="hm-rail-btn hm-rail-btn--next" type="button" data-rail-next aria-label="Scroll to more quizzes" hidden><Icon name="arrow" size={18} /></button>
    </div>
  </section>

  {/* ------------------------------------------------------------------------ night */}
  {(sls || wsi) && (
    <section class="hm-night" aria-labelledby="hm-games">
      <img class="hm-night-img" src="/img/game-hourglass.jpg" alt="" loading="lazy" decoding="async" width="1600" height="1067" />
      <header class="hm-head hm-head--dark">
        <p class="hm-kicker">Against the clock</p>
        <h2 id="hm-games">games</h2>
        <a class="hm-more" href="/games/">All games <Icon name="arrow" size={13} /></a>
      </header>
      <div class="hm-games">
        {sls && (
          <a class="game" href={sls.href}>
            <div class="game-say">
              <span class="room-mark room-mark--orange"><Icon name="scroll" size={20} /></span>
              <h3>{sls.title}</h3>
              <p>A line appears. Is it in the Bible, or does it only sound like it?</p>
              <ul class="room-facts">
                <li><Icon name="clock" size={13} /> 2 min a run</li>
                <li>{slsMeta.items} real lines</li>
              </ul>
              <span class="room-go">Play <Icon name="arrow" size={14} /></span>
            </div>
            <div class="mock" aria-hidden="true">
              <div class="mock-fuse"><i></i></div>
              <div class="mock-card"><span class="mock-q">“</span><i></i><i></i><i></i></div>
              <div class="mock-btns"><span>Not in the Bible</span><span>In the Bible</span></div>
            </div>
          </a>
        )}
        {wsi && (
          <a class="game" href={wsi.href}>
            <div class="game-say">
              <span class="room-mark room-mark--blue"><Icon name="quote" size={20} /></span>
              <h3>{wsi.title}</h3>
              <p>A line of speech and four names under it. The wrong name is rarely the odd one out.</p>
              <ul class="room-facts">
                <li><Icon name="clock" size={13} /> 2 min a run</li>
                {wsiMeta.items ? <li>{wsiMeta.items} real lines</li> : null}
              </ul>
              <span class="room-go">Play <Icon name="arrow" size={14} /></span>
            </div>
            <div class="mock mock--names" aria-hidden="true">
              <div class="mock-fuse"><i></i></div>
              <div class="mock-card"><span class="mock-q">“</span><i></i><i></i></div>
              <div class="mock-names"><span>Job</span><span>Eliphaz</span><span>Peter</span><span>Pilate</span></div>
            </div>
          </a>
        )}
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------- morning */}
  {articles.length > 0 && (
    <section class="hm-morning" aria-labelledby="hm-articles">
      <header class="hm-head">
        <p class="hm-kicker">The slow work of formation</p>
        <h2 id="hm-articles">articles</h2>
        <a class="hm-more" href="/articles/">All articles <Icon name="arrow" size={13} /></a>
      </header>
      <div class="hm-reads">
        {articles.map(a => {
          const art = articleArt(a.id);
          return (
            <a class="read" href={`/articles/${a.id}/`}>
              <span class="read-pic">
                <img src={art.src} alt={art.alt} loading="lazy" decoding="async" width="1100" height="733" />
                <span class="read-time"><Icon name="clock" size={12} /> {a.data.minutes} min</span>
              </span>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
              <span class="room-go">Read <Icon name="arrow" size={14} /></span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {/* ------------------------------------------------------------------- traditions */}
  <section class="hm-trads" aria-labelledby="hm-trads">
    <div class="hm-trads-say">
      <span class="room-mark room-mark--blue"><Icon name="compass" size={20} /></span>
      <h2 id="hm-trads">{compass.outcomes.length} traditions, each in its own words</h2>
      <p>Where each one stands on the six questions, described the way its own people would.</p>
      <a class="btn" href={quizHref(compass)}>See where you sit <Icon name="arrow" size={15} /></a>
    </div>
    <ul class="hm-trads-list">
      {compass.outcomes.map(o => (
        <li><a href={outcomeHref(compass, o)}>{o.name}</a></li>
      ))}
    </ul>
  </section>
  <script>
    // The quiz rail: arrows, a fade that only shows where there is more to see, and drag with a
    // mouse (touch already scrolls it). A drag must not also count as a click on the card.
    document.querySelectorAll('[data-rail]').forEach(rail => {
      const track = rail.querySelector('[data-rail-track]');
      const prev = rail.querySelector('[data-rail-prev]');
      const next = rail.querySelector('[data-rail-next]');
      if (!track || !prev || !next) return;
      const sync = () => {
        const max = track.scrollWidth - track.clientWidth;
        const more = max > 4;
        prev.hidden = !more || track.scrollLeft < 8;
        next.hidden = !more || track.scrollLeft > max - 8;
        rail.classList.toggle('has-prev', !prev.hidden);
        rail.classList.toggle('has-next', !next.hidden);
      };
      const step = dir => track.scrollBy({ left: dir * Math.max(260, track.clientWidth * 0.7), behavior: 'smooth' });
      prev.addEventListener('click', () => step(-1));
      next.addEventListener('click', () => step(1));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      let down = false, moved = 0, startX = 0, startLeft = 0;
      track.addEventListener('pointerdown', e => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        down = true; moved = 0; startX = e.clientX; startLeft = track.scrollLeft;
      });
      window.addEventListener('pointermove', e => {
        if (!down) return;
        const dx = e.clientX - startX;
        moved = Math.max(moved, Math.abs(dx));
        if (moved > 4) { track.classList.add('is-dragging'); track.scrollLeft = startLeft - dx; }
      });
      window.addEventListener('pointerup', () => { down = false; setTimeout(() => track.classList.remove('is-dragging'), 0); });
      track.addEventListener('click', e => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); } }, true);
      track.addEventListener('dragstart', e => e.preventDefault());
      sync();
    });
  </script>
</Base>
