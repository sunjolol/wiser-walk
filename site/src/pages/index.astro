---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import SectionHead from '../components/SectionHead.astro';
import CompassFeature from '../components/CompassFeature.astro';
import { QUIZZES, getQuiz, outcomeHref, quizHref } from '../lib/engine/registry';
import { liveGames } from '../lib/games';
import slsMeta from '../games/sounds-like-scripture.meta.json';
import { getCollection } from 'astro:content';

const games = liveGames();
const compass = getQuiz('theology-compass')!;
const articles = (await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 4);

// The owner found the other quizzes buried: list them all here. A draft says so on its tab.
// Published quizzes before drafts: a draft should never sit ahead of a finished quiz.
const otherQuizzes = QUIZZES.filter(q => q.slug !== compass.slug)
  .sort((a, b) => Number(a.status === 'draft') - Number(b.status === 'draft'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wiser Walk',
  url: 'https://wiserwalk.com/',
  description: 'Quizzes, games and articles for understanding yourself, and your walk with God, a little better.'
};
---
<Base
  title="Wiser Walk"
  description="Quizzes, games and articles for understanding yourself, and your walk with God, a little better. Start with the Theology Compass."
  jsonLd={jsonLd}
>
  <Hero
    title="Know yourself a little better."
    blue="yourself"
    orange="better."
    ghost="wiser"
    eyebrow="Quizzes · Games · Articles"
    tiles={[
      { n: compass.items.length, label: 'Statements' },
      { n: compass.groups.length, label: 'Axes' },
      { n: compass.outcomes.length, label: 'Traditions' },
      { n: slsMeta.items, label: 'Game lines' }
    ]}
  >
    Quizzes worth taking, games worth losing and articles worth reading, for Christians who
    would rather see themselves clearly than comfortably.
    <Fragment slot="actions">
      <a class="btn" href={quizHref(compass)}>Take the Theology Compass</a>
      <a class="btn dark" href="/play/sounds-like-scripture/">Play a game</a>
    </Fragment>
  </Hero>

  <SectionHead title="Quizzes" kicker="See where you stand" href="/quizzes/" more="All quizzes" />

  <CompassFeature />

  {otherQuizzes.length > 0 && (
    <div class="scards" style="margin-top:.9rem">
      {otherQuizzes.map(q => (
        <Card href={quizHref(q)} icon={q.icon} title={q.title} text={q.tagline}
              meta={`${q.items.length} statements`} tab={q.status === 'draft' ? 'Draft' : 'Quiz'} go="Take it" />
      ))}
    </div>
  )}

  {games.length > 0 && (
    <>
      <SectionHead title="Games" kicker="Against the clock" href="/games/" more="All games" />
      {games.filter(g => g.slug === 'sounds-like-scripture').map(g => (
        <a class="gamecard" href={g.href}>
          <div class="feature-body">
            <h3>{g.title}</h3>
            <p>{g.tagline}</p>
            <dl class="spec">
              <div><dt>A run</dt><dd>ten lines, a few seconds each</dd></div>
              <div><dt>The pool</dt><dd>{slsMeta.items} lines, quoted word for word</dd></div>
              <div><dt>Your Bible</dt><dd>Protestant, Catholic or Orthodox</dd></div>
            </dl>
            <div class="btn-row"><span class="btn">Play now</span></div>
          </div>
          <div class="gamecard-art dark">
            <div class="dark-ghost" aria-hidden="true">scripture?</div>
            <p class="feature-kicker">In the Bible, or not</p>
            <div class="mock" aria-hidden="true">
              <div class="mock-fuse"><i></i></div>
              <div class="mock-card"><span class="mock-q">“</span><i></i><i></i><i></i></div>
              <div class="mock-btns"><span>Not in the Bible</span><span>In the Bible</span></div>
            </div>
          </div>
        </a>
      ))}
      {games.some(g => g.slug !== 'sounds-like-scripture') && (
        <div class="scards" style="margin-top:.9rem">
          {games.filter(g => g.slug !== 'sounds-like-scripture').map(g => (
            <Card href={g.href} icon={g.icon} title={g.title} text={g.tagline} meta="10 lines a run" tab="Game" go="Play" />
          ))}
        </div>
      )}
    </>
  )}

  {articles.length > 0 && (
    <>
      <SectionHead title="Articles" kicker="The slow work of formation" href="/articles/" more="All articles" />
      <div class="scards">
        {articles.map(a => (
          <Card href={`/articles/${a.id}/`} icon="book" title={a.data.title} text={a.data.description}
                meta={`${a.data.minutes} min read`} tab="Article" go="Read" />
        ))}
      </div>
    </>
  )}

  <SectionHead title="The traditions" kicker="Eighteen families, each in its own words" />
  <ul class="chips">
    {compass.outcomes.map(o => (
      <li><a class="chip-link" href={outcomeHref(compass, o)}>{o.name}</a></li>
    ))}
  </ul>
</Base>
