---
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { liveQuizzes } from '../lib/engine/registry';
import { liveGames } from '../lib/games';
import { getCollection } from 'astro:content';

const quizzes = liveQuizzes();
const games = liveGames();
const articles = (await getCollection('articles'))
  .filter(a => !a.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wiser Walk',
  url: 'https://wiserwalk.com/',
  description: 'Quizzes and articles for understanding yourself, and your walk with God, a little better.'
};
---
<Base
  title="Wiser Walk"
  description="Quizzes, games and articles for understanding yourself, and your walk with God, a little better. Start with the Theology Compass."
  jsonLd={jsonLd}
>
  <Hero title="Know yourself a little better." blue="yourself" orange="better">
      Quizzes worth taking and articles worth reading, for Christians who would rather see
      themselves clearly than comfortably. Nothing you answer leaves your browser.
    <Fragment slot="actions">
      <a class="btn" href="/q/theology-compass/">Take the Theology Compass</a>
      <a class="btn ghost" href="/play/sounds-like-scripture/">Play a game</a>
    </Fragment>
  </Hero>

  <div class="section-head"><h2>Quizzes</h2></div>
  <div class="cards">
    {quizzes.map((q, i) => (
      <Card
        href={`/q/${q.slug}/`}
        icon={q.icon}
        title={q.title}
        text={q.tagline}
        meta={`${q.items.length} statements · about ${q.minutes} minutes`}
        feature={i === 0}
      />
    ))}
  </div>

  {games.length > 0 && (
    <>
      <div class="section-head"><h2>Games</h2></div>
      <div class="cards">
        {games.map(g => (
          <Card href={g.href} icon={g.icon} title={g.title} text={g.tagline} meta={g.meta} />
        ))}
      </div>
    </>
  )}

  {articles.length > 0 && (
    <>
      <div class="section-head"><h2>Articles</h2></div>
      <div class="cards">
        {articles.map(a => (
          <Card href={`/articles/${a.id}/`} icon="book" title={a.data.title} text={a.data.description} meta={`${a.data.minutes} min read`} />
        ))}
      </div>
      <p><a href="/articles/">All articles →</a></p>
    </>
  )}

  <div class="note">
    <p>
      <strong>Why you can trust the results.</strong> The Theology Compass went through an
      adversarial fairness audit: twenty reviewers, 522 findings, 424 applied. Every position
      is described in words its own holders would accept.
      <a href="/method/">Read the method →</a>
    </p>
  </div>
</Base>
