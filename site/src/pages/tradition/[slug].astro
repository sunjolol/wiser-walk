---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import CompassWheel from '../../components/CompassWheel.astro';
import RailStack from '../../components/RailStack.astro';
import TraditionNeighbours from '../../components/TraditionNeighbours.astro';
import CorrectionNote from '../../components/CorrectionNote.astro';
import { theologyCompass } from '../../lib/quizzes/theology-compass';
import { groupHref, quizHref, resultFor } from '../../lib/engine/registry';
import { clip } from '../../lib/seo';
import type { BipolarView } from '../../lib/engine/types';
import profilesA from '../../data/tradition-profiles-a.json';
import profilesB from '../../data/tradition-profiles-b.json';
import '../../styles/pages/tradition.css';

export function getStaticPaths() {
  return theologyCompass.outcomes.map(t => ({ params: { slug: t.slug }, props: { tradition: t } }));
}

const { tradition } = Astro.props;
const quiz = theologyCompass;
const position = tradition.position ?? [];

/**
 * THE PROFILE (2026-09-21).
 *
 * Every one of these eighteen pages used to open with the same two hundred words about what
 * a sketch is, and then say nothing at all in words about the tradition it is named for:
 * eighteen pages that were half identical to each other, competing with each other for the
 * one query each of them should own ("what do Lutherans believe"). The instruments were
 * never the problem. The silence was.
 *
 * So each tradition now carries a written profile, and it sits high on the page as plain
 * visible text under headings a person would recognise. The honest caveat is still here and
 * is said ONCE, in one line, rather than in a paragraph repeated eighteen times.
 *
 * The profiles are split across two files only because two people wrote them; they are one
 * map keyed by the built slug, and a tradition with no entry renders exactly as it did
 * before, instruments and all.
 */
type Profile = {
  in_a_sentence: string;
  what_marks_it_out: string[];
  did_you_know: { text: string; source: string }[];
  family: string;
  read: { placed_from: string; open: { title: string; note: string }[] };
};
const profiles = { ...profilesA, ...profilesB } as unknown as Record<string, Profile | undefined>;
const profile = profiles[tradition.slug];

/**
 * The tradition's own view, built by the SAME call the result page makes for a reader.
 * Nothing here is a second implementation of the scoring: the sketch is a set of
 * coordinates, and this page shows what the engine says about those coordinates — the
 * compass, the six rails, the band adjectives, and the distance to every other sketch.
 */
const view = resultFor(quiz, position) as BipolarView;

/** A tradition is its own nearest neighbour at zero distance; that is arithmetic, not news. */
const neighbours = view.ranked.filter(r => r.slug !== tradition.slug);
const named = view.rows.filter(r => !r.noClaim).length;

/** The ghost word is one word of the name — the first real one, never anything invented. */
const ghost =
  (tradition.name.match(/[A-Za-z]{4,}/g) ?? [tradition.name])[0]!.toLowerCase();

/**
 * Which pole a reading points at, for the small disc beside it. Not a judgement and not a
 * fourth encoding: it is the same fact the rail under it draws, said once more where the
 * rail is not. Hollow inside the band where the instrument names no pole at all.
 */
const side = (row: { value: number; noClaim: boolean }) =>
  row.noClaim ? 'none' : row.value < 50 ? 'left' : 'right';

/**
 * THE NAME A PERSON TYPES (2026-09-21).
 *
 * A tradition's full name carries a parenthetical so a reader can tell two near
 * neighbours apart, and it made the National Baptist page's title 118 characters, of
 * which Google renders about sixty. Nobody searches "National Baptist (NBC USA /
 * historically Black Baptist)". So the title and the description use the name without it.
 *
 * EXCEPT where dropping it would make two pages say the same thing: the two Southern
 * Baptist sketches differ only inside their brackets, and "Southern Baptist beliefs"
 * twice would be one page competing with itself and a reader unable to tell which is
 * which. That is worked out from the data rather than listed here, so a tradition added
 * or renamed later cannot quietly collide.
 */
const strip = (n: string) => n.replace(/\s*\([^)]*\)/g, '').trim();
const stripped = strip(tradition.name);
const collides = quiz.outcomes.filter(o => strip(o.name) === stripped).length > 1;
const searchName = collides ? tradition.name : stripped;

/**
 * The title, as many of the six topics as there is room for.
 *
 * The name goes first because it is the distinctive part and the part that survives
 * truncation; the topics follow in the quiz's own axis order and simply stop when the
 * line reaches the width a result is rendered at. Nothing is dropped for being awkward,
 * only for not fitting.
 */
const TOPICS = ['grace', 'communion', 'gifts', 'authority', 'worship'];
let title = `${searchName} beliefs`;
for (const topic of TOPICS) {
  const next = `${title}${title.endsWith('beliefs') ? ': ' : ', '}${topic}`;
  if (next.length > 60) break;
  title = next;
}

/**
 * The description, in this tradition's OWN band words.
 *
 * All eighteen used to carry one sentence with the name swapped, which is the thing
 * Google's own guidance tells you not to do, and forty-two of its characters went on a
 * caveat that is already the first thing on the page. The band adjectives are audited
 * wording and are printed verbatim; only the little joining phrase after each one is
 * written here, and it is skipped where the band already carries its own topic ("Scripture
 * alone" does not need "on authority" after it).
 *
 * Which axes appear is arithmetic, not editing: the quiz's own axis order, as many as fit
 * in the width a snippet is rendered at, and stop. Nothing is chosen for making a
 * tradition look one way or another, and an axis where the instrument names no position
 * is left out entirely, because naming one there would be the exact claim the hatched
 * band exists to refuse.
 */
const SAYS: Record<string, { say: string; has: RegExp }> = {
  grace: { say: ' on grace', has: /grace/i },
  table: { say: ' at the table', has: /table/i },
  gifts: { say: ' on the gifts', has: /gift/i },
  kingdom: { say: ' on Israel and the church', has: /israel/i },
  authority: { say: ' on authority', has: /scripture|authority/i },
  worship: { say: ' in worship', has: /worship/i }
};
const says = (row: { slug: string; band: string }) => {
  const rule = SAYS[row.slug];
  return rule && !rule.has.test(row.band) ? row.band + rule.say : row.band;
};

const DESC_MAX = 158;
const lead = `Where ${searchName} adherents typically land: `;
const phrases: string[] = [];
let used = lead.length + 1; // the full stop
for (const row of view.rows) {
  if (row.noClaim) continue;
  const phrase = says(row);
  const cost = phrase.length + (phrases.length ? 2 : 0); // ", "
  if (used + cost > DESC_MAX) continue;
  phrases.push(phrase);
  used += cost;
}
const bandDescription = lead + phrases.join(', ') + '.';

/*
 * The description a person reads in a search result.
 *
 * The band-word sentence above is accurate and completely uninviting: "Where Eastern
 * Orthodox adherents typically land: firmly synergist, sacramental...". Nobody clicks a
 * list of adjectives. A tradition that has a written profile therefore leads with its own
 * opening sentence, which is the same sentence at the top of the page, so the snippet and
 * the page agree. The band sentence stays as the fallback for anything not yet written.
 */
const description = profile ? clip(profile.in_a_sentence) : bandDescription;

/*
 * WebPage, not Article: see the same note on the axis template. Nothing on this page is
 * an article, and it was declaring itself one while carrying none of an article's
 * properties. `about` is the tradition itself, which is what the page is genuinely about
 * and the one thing a machine reading it should come away with.
 */
const siteId = new URL('/#website', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${tradition.name} on the Theology Compass`,
  description,
  url: new URL(`/tradition/${tradition.slug}/`, Astro.site).href,
  isPartOf: [
    { '@id': siteId },
    { '@type': 'Quiz', name: quiz.title, url: new URL(quizHref(quiz), Astro.site).href }
  ],
  about: { '@type': 'Thing', name: tradition.name }
};

// There is no traditions index, and the site's nav has none: a tradition page exists
// because the Compass measures distance to it, so the trail runs through the quiz that
// owns it rather than through a section that does not exist.
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quizzes', url: '/quizzes/' },
  { name: quiz.title, url: quizHref(quiz) },
  { name: tradition.name, url: `/tradition/${tradition.slug}/` }
];
---
<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title={tradition.name}
    eyebrow={`${quiz.title} · tradition`}
    icon="compass"
    kind="night"
    long
    tiles={[
      { n: quiz.groups.length, label: 'Axes' },
      { n: named, label: 'Poles named' },
      { n: quiz.outcomes.length - 1, label: 'Others' }
    ]}
  >
    {/* A band with a profile takes no lede: the tradition's own opening sentence is two
        inches below it, and a summary stacked on a summary is the templated feel the whole
        pass exists to remove. A page with no profile keeps the line it had. */}
    {!profile && (
      <Fragment>
        A sketch of where typical adherents land on the six axes, and how near the other
        families sit.
      </Fragment>
    )}
  </Hero>

  <div class="ref ref--trad">
    {profile && (
      <section class="tlead">
        <h2 class="tlead-label">{searchName} in a sentence</h2>
        <p class="tlead-say">{profile.in_a_sentence}</p>
      </section>
    )}

    {/* The honest caveat, said ONCE and in one line. It used to run to a paragraph, word
        for word identical on all eighteen pages, directly above the thing it qualified. */}
    <aside class="caveat">
      <span class="caveat-mark" aria-hidden="true"><Icon name="compass" size={18} /></span>
      <div>
        <p class="caveat-label">How to read the six rails below</p>
        <p>
          They are a sketch of where typical adherents land, <strong>not official
          teaching</strong>, and not a claim that everyone agrees.
        </p>
      </div>
    </aside>

    <div class="feature trad-feature">
      <div class="feature-art dark">
        <div class="dark-ghost" aria-hidden="true">{ghost}</div>
        <p class="feature-kicker">The sketch, drawn</p>
        <CompassWheel view={view} />
        <p class="feature-note">
          Each arm is one axis; length is how far from the centre the sketch sits.
        </p>
      </div>
      <div class="feature-body">
        <p class="feature-kicker trad-kicker">In the quiz's own words</p>
        <h3 class="trad-verdict">
          {view.headlineParts.map((part, i) => (
            <><span class={`verdict-part verdict-part--${part.side}`}>{part.text}</span>{i < view.headlineParts.length - 1 && <span class="verdict-sep">, </span>}</>
          ))}
        </h3>
        {/* Six axes, each with its reading, on hairlines rather than on dotted rules. The
            disc says which pole the reading points at; the band words are the audited ones. */}
        <ul class="axlist">
          {view.rows.map(row => (
            <li>
              <a href={groupHref(quiz, row)}>
                <span class:list={['axlist-dot', `axlist-dot--${side(row)}`]} aria-hidden="true"></span>
                <span class="axlist-name">{row.name}</span>
                <span class="axlist-read">{row.band}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {profile && (
      <>
        {/* The page's substance, in plain visible text. First paragraph set as a lead, the
            rest at reading size: a profile printed entirely in the display face is a wall
            of serif on a phone. */}
        <SectionHead title="What marks it out" kicker="In plain words" />
        <div class="panel layered tprose">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          {profile.what_marks_it_out.map((para, i) => (
            <p class:list={['tprose-p', i === 0 && 'tprose-p--lead']}>{para}</p>
          ))}
        </div>

        {profile.did_you_know.length > 0 && (
          <>
            <SectionHead title="Did you know?" kicker="Worth knowing" />
            <ul class="tfacts">
              {profile.did_you_know.map(fact => (
                <li class="tfact">
                  <span class="tfact-mark" aria-hidden="true"><Icon name="sparkle" size={16} /></span>
                  <p class="tfact-text">{fact.text}</p>
                  <p class="tfact-src">{fact.source}</p>
                </li>
              ))}
            </ul>
          </>
        )}

        <SectionHead title="Where it came from" kicker="Its roots, and its near relatives" />
        <div class="panel layered tprose tprose--short">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          <p class="tprose-p">{profile.family}</p>
        </div>
      </>
    )}

    <SectionHead title="Where it sits on all six questions" kicker="Both poles named on every rail" />
    <div class="panel layered ref-panel ref-panel--quiet">
      <div class="wash" aria-hidden="true"></div>
      <div class="veil" aria-hidden="true"></div>
      <RailStack quiz={quiz} view={view} />
    </div>

    {neighbours.length > 0 && (
      <>
        <SectionHead title="Which traditions are closest?" kicker="Measured across all six" />
        <p class="ref-note">
          Nearness is not agreement: two families can land in the same band for different
          reasons.
        </p>
        <TraditionNeighbours quiz={quiz} ranked={neighbours} limit={6} />
      </>
    )}

    {profile && (
      <>
        {/* What was actually read to place this tradition, in its own confessions and
            standard works, plus two documents a curious reader can open tonight. */}
        <SectionHead title="What we read" kicker="Sources, and where to go next" />
        <div class="tread">
          <div class="tread-src">
            <p class="tread-label">Read to place this tradition</p>
            <p class="tread-cite">{profile.read.placed_from}</p>
          </div>
          {profile.read.open.length > 0 && (
            <ul class="tread-open">
              {profile.read.open.map(doc => (
                <li>
                  <span class="tread-mark" aria-hidden="true"><Icon name="book" size={15} /></span>
                  <p class="tread-title">{doc.title}</p>
                  <p class="tread-note">{doc.note}</p>
                </li>
              ))}
            </ul>
          )}
        </div>
      </>
    )}

    {/* The way back into the quiz, as a room on the night ground the Compass is always
        drawn on. Not a dawn sky: the footer directly below this block is a photograph of
        one, and two skies stacked read as the same picture used twice. */}
    <section class="wayin wayin--night">
      <div class="wayin-ghost" aria-hidden="true">{ghost}</div>
      <div class="wayin-in">
        <span class="wayin-mark" aria-hidden="true"><Icon name="compass" size={20} /></span>
        <p class="wayin-kicker">{quiz.title}</p>
        <h2>See how near you land.</h2>
        <p class="wayin-say">
          Answer the statements and your own position is drawn on these same six rails, with
          the distance to this tradition and to {quiz.outcomes.length - 1} others.
        </p>
        <ul class="wayin-facts">
          <li><Icon name="scroll" size={13} /> {quiz.items.length} statements</li>
          <li><Icon name="clock" size={13} /> About {quiz.minutes} minutes</li>
          <li><Icon name="compass" size={13} /> {quiz.groups.length} axes, both poles named</li>
        </ul>
        <div class="btn-row">
          <a class="btn" href={quizHref(quiz)}>Take the {quiz.title}</a>
        </div>
      </div>
    </section>

    <CorrectionNote subject={tradition.name} />
  </div>
</Base>
