---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import CompassWheel from '../../components/CompassWheel.astro';
import RailStack from '../../components/RailStack.astro';
import TraditionNeighbours from '../../components/TraditionNeighbours.astro';
import CorrectionNote from '../../components/CorrectionNote.astro';
import { theologyCompass } from '../../lib/quizzes/theology-compass';
import { groupHref, quizHref, resultFor } from '../../lib/engine/registry';
import type { BipolarView } from '../../lib/engine/types';

export function getStaticPaths() {
  return theologyCompass.outcomes.map(t => ({ params: { slug: t.slug }, props: { tradition: t } }));
}

const { tradition } = Astro.props;
const quiz = theologyCompass;
const position = tradition.position ?? [];

/**
 * The tradition's own view, built by the SAME call the result page makes for a reader.
 * Nothing here is a second implementation of the scoring: the sketch is a set of
 * coordinates, and this page shows what the engine says about those coordinates — the
 * compass, the six rails, the band adjectives, and the distance to every other sketch.
 */
const view = resultFor(quiz, position) as BipolarView;

/** A tradition is its own nearest neighbour at zero distance; that is arithmetic, not news. */
const neighbours = view.ranked.filter(r => r.slug !== tradition.slug);
const named = view.rows.filter(r => !r.noClaim).length;

/** The ghost word is one word of the name — the first real one, never anything invented. */
const ghost =
  (tradition.name.match(/[A-Za-z]{4,}/g) ?? [tradition.name])[0]!.toLowerCase();

/**
 * Which pole a reading points at, for the small disc beside it. Not a judgement and not a
 * fourth encoding: it is the same fact the rail under it draws, said once more where the
 * rail is not. Hollow inside the band where the instrument names no pole at all.
 */
const side = (row: { value: number; noClaim: boolean }) =>
  row.noClaim ? 'none' : row.value < 50 ? 'left' : 'right';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${tradition.name} on the Theology Compass`,
  description: `Where ${tradition.name} sits on six axes of Christian belief.`,
  url: new URL(`/tradition/${tradition.slug}/`, Astro.site).href
};

// There is no traditions index, and the site's nav has none: a tradition page exists
// because the Compass measures distance to it, so the trail runs through the quiz that
// owns it rather than through a section that does not exist.
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quizzes', url: '/quizzes/' },
  { name: quiz.title, url: quizHref(quiz) },
  { name: tradition.name, url: `/tradition/${tradition.slug}/` }
];
---
<Base
  title={`${tradition.name} beliefs on six questions that divide Christians`}
  description={`Where ${tradition.name} typically sits on grace, communion, spiritual gifts, authority and worship, beside 17 other traditions. A sketch of adherents, not official teaching.`}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title={tradition.name}
    eyebrow={`${quiz.title} · tradition`}
    icon="compass"
    kind="night"
    long
    tiles={[
      { n: quiz.groups.length, label: 'Axes' },
      { n: named, label: 'Poles named' },
      { n: quiz.outcomes.length - 1, label: 'Others' }
    ]}
  >
    A sketch of where typical adherents land on the six axes, and how near the other
    families sit.
  </Hero>

  <div class="ref ref--trad">
    <aside class="caveat">
      <span class="caveat-mark" aria-hidden="true"><Icon name="compass" size={18} /></span>
      <div>
        <p class="caveat-label">Read this first</p>
        <p>
          This is an approximate sketch of where typical adherents land, <strong>not official
          teaching</strong>, and not a claim that everyone in the tradition agrees. It exists
          so the quiz has something to measure distance against.
        </p>
      </div>
    </aside>

    <div class="feature trad-feature">
      <div class="feature-art dark">
        <div class="dark-ghost" aria-hidden="true">{ghost}</div>
        <p class="feature-kicker">The sketch, drawn</p>
        <CompassWheel view={view} />
        <p class="feature-note">
          Each arm is one axis; length is how far from the centre the sketch sits.
        </p>
      </div>
      <div class="feature-body">
        <p class="feature-kicker trad-kicker">In the quiz's own words</p>
        <h3 class="trad-verdict">
          {view.headlineParts.map((part, i) => (
            <><span class={`verdict-part verdict-part--${part.side}`}>{part.text}</span>{i < view.headlineParts.length - 1 && <span class="verdict-sep">, </span>}</>
          ))}
        </h3>
        {/* Six axes, each with its reading, on hairlines rather than on dotted rules. The
            disc says which pole the reading points at; the band words are the audited ones. */}
        <ul class="axlist">
          {view.rows.map(row => (
            <li>
              <a href={groupHref(quiz, row)}>
                <span class:list={['axlist-dot', `axlist-dot--${side(row)}`]} aria-hidden="true"></span>
                <span class="axlist-name">{row.name}</span>
                <span class="axlist-read">{row.band}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <SectionHead title="The six axes" kicker="Both poles named on every rail" />
    <div class="panel layered ref-panel ref-panel--quiet">
      <div class="wash" aria-hidden="true"></div>
      <div class="veil" aria-hidden="true"></div>
      <RailStack quiz={quiz} view={view} />
    </div>

    {neighbours.length > 0 && (
      <>
        <SectionHead title="Nearest neighbours" kicker="By the same arithmetic the quiz uses" />
        <p class="ref-note">
          Distance between two sketches across every axis, on the same scale a reader's
          answers are measured on. Nearness is not agreement: two families can land in the
          same band for different reasons.
        </p>
        <TraditionNeighbours quiz={quiz} ranked={neighbours} limit={6} />
      </>
    )}

    {/* The way back into the quiz, as a room on the night ground the Compass is always
        drawn on. Not a dawn sky: the footer directly below this block is a photograph of
        one, and two skies stacked read as the same picture used twice. */}
    <section class="wayin wayin--night">
      <div class="wayin-ghost" aria-hidden="true">{ghost}</div>
      <div class="wayin-in">
        <span class="wayin-mark" aria-hidden="true"><Icon name="compass" size={20} /></span>
        <p class="wayin-kicker">{quiz.title}</p>
        <h2>See how near you land.</h2>
        <p class="wayin-say">
          Answer the statements and your own position is drawn on these same six rails, with
          the distance to this tradition and to {quiz.outcomes.length - 1} others.
        </p>
        <ul class="wayin-facts">
          <li><Icon name="scroll" size={13} /> {quiz.items.length} statements</li>
          <li><Icon name="clock" size={13} /> About {quiz.minutes} minutes</li>
          <li><Icon name="compass" size={13} /> {quiz.groups.length} axes, both poles named</li>
        </ul>
        <div class="btn-row">
          <a class="btn" href={quizHref(quiz)}>Take the {quiz.title}</a>
        </div>
      </div>
    </section>

    <CorrectionNote subject={tradition.name} />
  </div>
</Base>
