---
import '../../../styles/pages/reads.css';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import SectionHead from '../../../components/SectionHead.astro';
import CompassWheel from '../../../components/CompassWheel.astro';
import OutcomeCards from '../../../components/OutcomeCards.astro';
import RailStack from '../../../components/RailStack.astro';
import CategoryStack from '../../../components/CategoryStack.astro';
import AxisDepth from '../../../components/AxisDepth.astro';
import ShareBlock from '../../../components/ShareBlock.astro';
import SaveResult from '../../../components/SaveResult.astro';
import NextUp from '../../../components/NextUp.astro';
import ReadCard from '../../../components/ReadCard.astro';
import PsalmReading from '../../../components/PsalmReading.astro';
import KindredResult from '../../../components/KindredResult.astro';
import PersonalityResult from '../../../components/PersonalityResult.astro';
import type { KindredData } from '../../../lib/strategies/kindred';
import { QUIZZES, getQuiz, resultFor, decodeFor, outcomeHref } from '../../../lib/engine/registry';
import { groupNoteFor, notesFor, outcomeNounPlural, rankWord } from '../../../lib/engine/types';
import { linkCodeFor, resolveCode } from '../../../lib/engine/links';
import { readEnv } from '../../../lib/email/env';
// The card a shared link shows: the outcome this result names, where one was drawn.
import { resultCardFor } from '../../../lib/seo';
import { ACCOUNTS_VISIBLE } from '../../../lib/account/config';
import { artFor } from '../../../lib/art';
import { FIGURE_PAGES } from '../../../lib/saints/figures';
import { READING } from '../../../lib/strategies/reading';
import { liveGames } from '../../../lib/games';
import { getCollection } from 'astro:content';
// Server only: the whole BSB text of every psalm a reading can print. Never in a client script.
import bsb from '../../../data/psalms.json';
// Server only, likewise: every early Christian's lines, portraits and story, for the share card.
import earlyChristians from '../../../data/which-early-christian.json';

// Rendered on demand: any valid code has a permanent page, without pre-building
// millions of them. Nothing is scored here — the code already carries the scores.
export const prerender = false;

const quiz = getQuiz(Astro.params.quiz);
const raw = String(Astro.params.code ?? '').toUpperCase();
/*
 * The URL may carry the canonical code, the shorter public one, or a six-character short
 * link (engine/links.ts). All three come back as the canonical code, so everything below,
 * the "just took it" note included, sees the code it always saw.
 */
const code = quiz ? await resolveCode(quiz, raw, readEnv(Astro.locals)) : null;
const values = quiz && code ? decodeFor(quiz, code) : null;

if (quiz && values) Astro.response.headers.set('cache-control', 'public, max-age=600');
else Astro.response.status = 404;

const view = quiz && values ? resultFor(quiz, values) : null;

/** The code this page's own links print: the one it was opened by, or its public code. */
const linkCode = quiz && view ? linkCodeFor(quiz, raw, view.code) : '';

// Articles that speak to this quiz, so a result is a doorway rather than a dead end.
const related = quiz
  ? (await getCollection('articles'))
      .filter(a => !a.data.draft && a.data.quizzes?.includes(quiz.slug))
      .slice(0, 3)
  : [];

/*
 * Depth is ordered by how hard the reader actually leaned, and the strongest one opens on
 * load. An axis in the no-claim band still gets a panel — it just sorts last. Suppressing
 * it would leave a centrist with an empty page and no explanation, which is the failure the
 * visible no-claim zone exists to prevent.
 */
const depthOrder =
  view?.shape === 'bipolar'
    ? [...view.rows].sort((a, b) => Math.abs(b.value - 50) - Math.abs(a.value - 50))
    : [];

// Copy for the outcome list. 'central' is handled separately below, as a disclosure.
const outcomeHeading =
  view?.shape === 'bipolar' && view.state === 'loose'
    ? 'Loose neighbours, not matches'
    : 'Closest on the map';

/*
 * What the reader was scored against, in this quiz's own noun. The Compass's sentence is
 * the default and is printed unchanged; a quiz whose outcomes are people supplies its own,
 * because "a sketch of typical adherents" is not true of a person in the Gospels.
 */
const scopeNote =
  quiz?.outcomeScopeNote ??
  `Scored against the listed ${outcomeNounPlural(quiz!)} only — a sketch of typical adherents, ` +
    'not official teaching, and not a complete list of Christian traditions.';

/** No number against an outcome where the quiz forbids it: the rank is said in words. */
const hideScore = Boolean(quiz?.hideOutcomeScore);

/**
 * The axes on which the READER named no position. On a quiz matched against evidence these
 * are left out of the comparison — an axis where the instrument says the reader claims
 * nothing cannot be used to claim they are like somebody — so the closest card says which
 * they were. Harmless everywhere else: a card only reads this where its outcome carries a
 * mask, and no Compass tradition does.
 */
const silentAxes =
  view?.shape === 'bipolar' ? view.rows.filter(r => r.noClaim).map(r => r.name) : [];

/** A gift the reader came out low on needs its caveat beside it, not in a footer. */
const showLow =
  view?.shape === 'unipolar' && Boolean(quiz?.notes?.low) && view.rows.some(r => r.below);

/**
 * Whether this quiz has anything to fold at all.
 *
 * The notes below are a quiz's own words about how to read its ranking, and they are still
 * printed in full — inside one <details> under the result rather than as four stacked
 * panels between the reader and their own result. A quiz that sets none of them (the
 * Compass) renders nothing here, exactly as it did.
 */
const folded = Boolean(
  showLow || quiz?.notes?.result || quiz?.notes?.disputed || quiz?.notes?.omitted
);

/**
 * The sentence that travels with the names in the headline, printed once directly under it.
 *
 * Under the headline rather than down with the other notes, because it qualifies the name a
 * reader has just read in the largest type on the page, and because the share card draws it
 * directly under the same words. It is an array so that "nobody was named" and "no quiz set
 * one" are the same empty case, and never a stray empty box.
 */
const headlineNoteGroups = quiz && view ? groupNoteFor(quiz, view.named, 'result') : [];

/*
 * A result that leads with WHO (Quiz.resultLeadsWithOutcome: the figure quiz). The owner,
 * 2026-09-25: the axis clauses in the big letters "doesn't tell you your result". So the
 * headline is the person: the nearest one, both where two are level, both where nothing is
 * close (said so), and nobody where the reader named no position anywhere, which keeps the
 * engine's own "Near the center" headline. The axis clauses move into the line under it.
 *
 * An outcome's own sentence goes where its name goes (Jesus's, and the canon notes on Judith
 * and Tobit), so the names printed in the headline carry theirs directly under it, and the
 * list below prints every other card's own (OutcomeCards, notes="all").
 */
const leads = Boolean(quiz?.resultLeadsWithOutcome) && view?.shape === 'bipolar';
const leadNames =
  leads && view?.shape === 'bipolar' && view.state !== 'central'
    ? view.ranked.slice(0, view.state === 'near' ? 1 : 2)
    : [];
const leadPre =
  view?.state === 'loose' ? 'No close fit. Nearest, loosely:'
    : view?.state === 'tie' ? 'Jointly closest to'
    : 'Closest to';
const leadSlugs = leadNames.map(r => r.slug);
const headlineNotes =
  quiz && leads ? [...notesFor(quiz, leadSlugs), ...headlineNoteGroups] : headlineNoteGroups;

/*
 * The band's picture: the plate this QUIZ wears on the home page, on /me/ and on its own
 * intro, read off art.ts so a reader never meets two faces for one quiz. The Compass has
 * none on purpose — it is an instrument, and every page draws it on the starry ground.
 *
 * Deliberately NOT the named outcome's own plate. It was tried and taken out again: the
 * figure quiz's verdict names more than one person even when one is clearly nearest
 * ("Nearest on the map: Joseph · Abigail"), so putting the first one's face behind the
 * headline would quietly make that one the answer — and the same rule that forbids a
 * percentage against a person forbids that. A figure's plate belongs on the figure's own
 * page, where the picture's subject is the subject.
 *
 * OVERRULED FOR THE FIGURE QUIZ (the owner, 2026-09-25): now that its headline names the
 * figure the reader is closest to, its band wears that figure's own painting, the one at the
 * top of the figure's page, in colour and placed as that page places it. Where two are level
 * or nothing is close, the first named. Jesus has no page of His own yet, so a result naming
 * Him keeps the quiz's plate.
 */
const art = quiz ? artFor(quiz.slug) : null;
const leadPage = quiz?.slug === 'bible-figure' && leadSlugs[0] ? FIGURE_PAGES[leadSlugs[0]] : undefined;

/*
 * Where to go once the result has been read. The OTHER quizzes, then the games, as rooms
 * with their own pictures — a finished result is the point at which someone is most
 * willing to do another thing and least likely to find one.
 */
const otherQuizzes = quiz ? QUIZZES.filter(q => q.slug !== quiz.slug) : [];
const games = liveGames();

/*
 * A READING (the Psalm quiz) names what someone is going through right now, so two things
 * on this page are different for it.
 *
 * The description. Everywhere else it is the one-line verdict; here that line is the
 * situation itself ("Your own people have turned on you..."), and a page's description is
 * what a chat app prints under a pasted link. The share text leaves the situation out for
 * that reason (strategies/reading.ts), so the link's preview does too: it says which psalm,
 * and the page says why.
 *
 * The share card draws the verse that names the situation, and the text lives in
 * psalms.json, which only the server may read. So it is looked up here and handed down.
 */
const reading = view?.shape === 'reading' ? view : null;
const readingLine = (() => {
  if (!reading) return undefined;
  const ref = READING.outcomes[reading.situation]!.names;
  const [c, v] = ref.split(':').map(Number);
  const psalms = bsb.psalms as unknown as Record<string, { verses: [number, string][] }>;
  const text = psalms[String(c)]?.verses.find(x => x[0] === v)?.[1] ?? '';
  return text ? { text, cite: `Psalm ${ref}` } : undefined;
})();
const description = reading
  ? `${reading.headline}, printed in full, with the reason Athanasius of Alexandria gave ${
      READING.outcomes[reading.situation]!.set ? 'them' : 'it'
    } in the 300s.`
  : view?.summary ?? '';

/*
 * KINDRED SPIRITS ("Which early Christian thinks like you?") name two people, so two things on
 * this page are theirs. The result itself is KindredResult, in the band and under it. And the
 * share card draws the preview's card: the kindred spirit's portrait, name, dates and who they
 * were, the line of theirs the result chose for it, what the two agree on, and the sparring
 * partner. The lines and portraits live in which-early-christian.json, which only the server may
 * read, so they are looked up here and handed down, as the reading's verse is.
 *
 * "Not enough to go on" names nobody. Its page says so and offers the quiz again, and it has no
 * card to share and no result to save (the approved preview drew neither for it).
 */
const kindred = view?.shape === 'kindred' ? view : null;
const kindredThin = kindred?.state === 'thin';
const kindredCard = (() => {
  if (!kindred || !kindred.kindred || !kindred.show) return undefined;
  const EC = earlyChristians as unknown as KindredData;
  const topic = (id: string) => EC.statements.find(s => s.id === id)?.topic ?? '';
  const k = EC.people[kindred.kindred.key]!;
  const s = kindred.sparring ? EC.people[kindred.sparring.key]! : null;
  const cell = kindred.show.card ? k.cells[kindred.show.card] : null;
  return {
    name: k.name,
    dates: k.dates,
    who: k.who,
    portrait: k.portrait.src,
    line: cell?.line ? { text: cell.line, cite: `${k.short}, ${cell.work}` } : null,
    agree: kindred.show.cardTopics.map(topic),
    sparring: s
      ? { name: s.name, portrait: s.portrait.src, on: kindred.show.sparringTopics.map(topic) }
      : null
  };
})();
---
{quiz && view ? (
  <Base
    title={`${view.headline} — ${quiz.title}`}
    description={description}
    noindex={true}
    ogType="article"
    ogImage={resultCardFor(quiz, view) ?? undefined}
  >
    {/*
      THE DAWN PASS, 2026-09-21. This was the last band on the site still wearing the pale
      wash and a giant grey ghost word. It is built out of the kit's own picture-band
      classes now — the quiz's plate printed soft, or the starry ground where the quiz is
      an instrument rather than a person — and the verdict keeps its two inks, because
      kit.css lifts them to the soft blue and #FFD2B0 wherever a band carries a picture.
    */}
    {view.shape !== 'personality' && (<header
      class:list={[
        'band', 'band--long', 'band--pic', 'result-band',
        leadPage ? 'band--photo' : art ? 'band--engraving' : 'band--night',
        (leadPage || art) && 'band--has-img'
      ]}
    >
      {leadPage && (
        <img
          class="band-img band-img--figure"
          src={leadPage.band.picture.src}
          alt=""
          style={`--pos-m:${leadPage.band.posM};--pos-d:${leadPage.band.posD}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
      {!leadPage && art && (
        <img
          class="band-img"
          src={art.src}
          alt=""
          style={[
            `object-position:${art.objectPosition}`,
            art.lift ? `--img-lift:${art.lift}` : ''
          ].filter(Boolean).join(';')}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
      <div class="band-in">
        <p class="band-chip"><Icon name={quiz.icon} size={13} />{quiz.title} · your result</p>
        {view.shape === 'reading' ? (
          /* "You're living Psalm 3", its Greek number, and the verse that names it. */
          <PsalmReading quiz={quiz} view={view} part="band" />
        ) : view.shape === 'kindred' ? (
          /* The kindred spirit's portrait, name, dates and who they were. */
          <KindredResult quiz={quiz} view={view} part="band" />
        ) : leadNames.length > 0 ? (
          <>
            {/* Who, in the big letters; the axis clauses under it in the rails' two colours. */}
            <h1 class="verdict verdict--who">
              <span class="verdict-pre">{leadPre}</span>{' '}
              <span class="verdict-who">{leadNames.map(r => r.name).join(' and ')}</span>
            </h1>
            <p class="lede verdict-axes">
              {view.headlineParts.map((part, i) => (
                <>
                  <span class={`verdict-part verdict-part--${part.side}`}>{part.text}</span>
                  {i < view.headlineParts.length - 1 && <span class="verdict-sep">,</span>}
                  {i < view.headlineParts.length - 1 && ' '}
                </>
              ))}
            </p>
          </>
        ) : (
          <>
            {/* The first thing a reader sees, in the same two colours as the compass and rails. */}
            <h1 class="verdict">
              {view.headlineParts.map((part, i) => (
                <>
                  <span class={`verdict-part verdict-part--${part.side}`}>{part.text}</span>
                  {i < view.headlineParts.length - 1 && <span class="verdict-sep">,</span>}
                  {i < view.headlineParts.length - 1 && ' '}
                </>
              ))}
            </h1>
            <p class="lede">{view.summary}</p>
          </>
        )}

        {/*
          Only for the reader who just finished this, told apart the same way the share
          block tells them apart: a tab-scoped note the runner left behind. A visitor
          opening someone else's link sees nothing here, because nothing of theirs was
          saved. It stands in the band as a glass pill, carrying the same mark as the
          header's own My results link, so the two read as the same place.
        */}
        <p class="saved-pill" id="saved-note" hidden>
          <Icon name="users" size={14} /> Saved to <a href="/me/">{ACCOUNTS_VISIBLE ? 'My profile' : 'My results'}</a>
        </p>
      </div>
    </header>)}{/*
      Hung off the band with no whitespace between them: an expression that renders nothing
      still leaves the newline on each side of it, and the Compass's result page has to come
      out of this change unchanged. The Compass sets no group note, so this renders nothing
      and adds nothing — not a line, not a space.

      The sentence that travels with the names just printed above it, once, whether one of
      them was named or four. Never a badge and never a row: what it qualifies is the
      headline, and the share card draws it under the same words.
    */}{headlineNotes.map(note => (
      <div class="note headline-note"><p>{note}</p></div>
    ))}
    {quiz.status === 'draft' && (
      <div class="note draft"><p><strong>Unaudited draft.</strong>{" " + quiz.draftNote}</p></div>
    )}

    {import.meta.env.DEV && (
      /* Development only, and compiled out of anything that is ever served: ?took=1 says
         this reader just finished, which is the one state the two things below are drawn
         in. Without it they can only be looked at by playing a quiz through by hand. */
      <script is:inline define:vars={{ devSlug: quiz.slug, devCode: view.code }}>
        try {
          var devQuery = new URLSearchParams(location.search);
          if (devQuery.get('took') === '1') {
            sessionStorage.setItem('ww:took:' + devSlug, devCode);
            // A reading's answer-dependent parts need answers too: &answers={"season":"hard",...}
            // (and &none=1 for a result reached through the none page).
            var devAnswers = devQuery.get('answers');
            if (devAnswers) {
              sessionStorage.setItem('ww:answers:' + devSlug, JSON.stringify({
                code: devCode, answers: JSON.parse(devAnswers), fromNone: devQuery.get('none') === '1'
              }));
            }
          }
        } catch (e) {}
      </script>
    )}

    <script is:inline define:vars={{ savedQuizSlug: quiz.slug, savedQuizCode: view.code }}>
      try {
        if (sessionStorage.getItem('ww:took:' + savedQuizSlug) === savedQuizCode) {
          document.getElementById('saved-note').hidden = false;
        }
      } catch (e) {}
    </script>

    {view.shape === 'reading' ? (
      /*
        A reading has no rails and no ranking: the psalm, why, and the whole text. It has no
        outcome list and no depth panels below either (each is skipped by its own test
        further down), because its rows and ranking are empty by design.
      */
      <PsalmReading quiz={quiz} view={view} part="body" />
    ) : view.shape === 'kindred' ? (
      /*
        Kindred spirits: no rails and no bars. Two people, each proved by their own words, then
        everyone from nearest to farthest. It lists everyone itself, so the outcome list below
        is skipped for it too.
      */
      <KindredResult quiz={quiz} view={view} part="body" />
    ) : view.shape === 'personality' ? (
      /*
        The Christian Personality Test: the whole ten-page report, its painted hero standing in
        for the band above, then the result's link. Nothing else on this page is drawn for it
        but the standard pieces under it: no share block (its two cards are in the report), and
        no outcome list or depth panels (each skipped by its own test below).
      */
      <PersonalityResult quiz={quiz} view={view} origin={Astro.site!.origin} linkCode={linkCode} />
    ) : leads ? null : (
    <div class="panel layered result-panel">
      <div class="wash" aria-hidden="true"></div>
      <div class="veil" aria-hidden="true"></div>

      {view.shape === 'bipolar' ? (
        <>
          <CompassWheel view={view} />
          <RailStack quiz={quiz} view={view} />
        </>
      ) : (
        <CategoryStack quiz={quiz} view={view} />
      )}
    </div>
    )}{/*
      These three hang off the end of the panel above with no whitespace between them. An
      expression that renders nothing still leaves the newline on each side of it, and
      three of those are three stray spaces in the Compass's result page — the one page on
      the site that has to come out of this change unchanged.

      A quiz may carry two sentences of its own about what its ranking is: what a low row
      means, and what the whole page is and is not. They sit here, directly under the
      ranking, rather than in a footer a reader has already scrolled past — the gifts draft
      asks the reader to take the result to somebody who has watched them serve, and that is
      the point of the page, not a caveat about it.
    */}{folded && (
      <details class="frame-fold result-fold">
        <summary>
          <span>How to read this result</span>
          <span class="frame-fold-caret" aria-hidden="true"></span>
        </summary>
        <div class="frame-fold-body">
          {showLow && <p>{quiz.notes!.low}</p>}
          {quiz.notes?.result && <p>{quiz.notes.result}</p>}
          {quiz.notes?.disputed && (
            <p>
              {quiz.notes.disputed.text}
              {/*
                {' '} and not a literal space inside the fragment. Inside an expression the
                compiler follows JSX whitespace rules and drops it, which on this page ran the
                sentence straight into the link: "...you have not.The Theology Compass sets".
              */}
              {quiz.notes.disputed.href && quiz.notes.disputed.linkText && (
                <>{' '}<a href={quiz.notes.disputed.href}>{quiz.notes.disputed.linkText}</a></>
              )}
            </p>
          )}
          {quiz.notes?.omitted && (
            <p>
              {quiz.notes.omitted.text}
              {/* Same rule as the note above: the space has to be an expression to survive. */}
              {quiz.notes.omitted.href && quiz.notes.omitted.linkText && (
                <>{' '}<a href={quiz.notes.omitted.href}>{quiz.notes.omitted.linkText}</a></>
              )}
            </p>
          )}
        </div>
      </details>
    )}

    {/*
      Only when the quiz has OUTCOMES — named things measured against, which is a separate
      entity from the rows. On a unipolar quiz `ranked` is just the rows again, and the
      stack above has already shown them in order; printing them twice would be padding.
    */}
    {quiz.outcomes.length > 0 && view.ranked.length > 0 && view.shape !== 'kindred' && (
      <section class="outcomes">
        {view.state === 'central' ? (
          /*
            The lede has just said that no tradition is named. Listing five of them with
            percentages underneath contradicts that at exactly the moment a discernment-
            minded reader is deciding whether the instrument is honest — the nearest here is
            67 units away against a hedge threshold of 45. The numbers are still available
            to anyone who wants them; they are just not presented as an answer.
          */
          <details class="arith">
            <summary>
              <span>Show what the arithmetic returned anyway</span>
              <span class="chev" aria-hidden="true"></span>
            </summary>
            <p class="tags">
              These are distances, not findings. Your answers sit in the no-position band on
              every axis, so none of this is a claim about what you believe.
            </p>
            <ul class="ranked">
              {view.ranked.slice(0, 5).map((r, i) => (
                <li>
                  <span><a href={outcomeHref(quiz, { name: r.name, slug: r.slug })}>{r.name}</a></span>
                  <span>{hideScore ? rankWord(i) : `${r.score}%`}</span>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <>
            <SectionHead
              title={outcomeHeading}
              kicker={leads ? undefined : `Measured against ${quiz.outcomes.length} ${outcomeNounPlural(quiz)}`}
            />
            <p class="tags">
              {view.state === 'loose'
                ? 'Nothing on the list is a close fit. These are the nearest, and "nearest" is doing a lot of work.'
                : scopeNote}
            </p>
            <OutcomeCards
              quiz={quiz}
              ranked={view.ranked}
              leading={view.state === 'tie' ? 2 : view.state === 'loose' ? 0 : 1}
              readerSilent={silentAxes}
              notes={leads ? 'all' : 'leading'}
              notedAbove={leadSlugs}
            />
          </>
        )}
      </section>
    )}{/*
      A result that leads with who has its list first and its rails after it, and no wheel:
      the owner, 2026-09-25, "this just makes it take that much longer to see the interesting
      part which is who you're most like". Hung off the list with no whitespace, so every other
      quiz's page is what it was.
    */}{leads && view.shape === 'bipolar' && (
      <div class="panel layered result-panel result-panel--rails">
        <div class="wash" aria-hidden="true"></div>
        <div class="veil" aria-hidden="true"></div>
        <RailStack quiz={quiz} view={view} />
      </div>
    )}

    {view.shape === 'bipolar' && depthOrder.some(r => quiz.groups.find(g => g.slug === r.slug)?.summary) && (
      <section class="depth-section">
        {/*
          A quiz may name these panels itself. The Compass's two lines are kept as literal
          markup rather than moved into a default string: a text node keeps its own line
          breaks in the built HTML, so writing the same sentence on one line would change
          every Compass result page by a newline. Same words, same bytes.
        */}
        {quiz.notes?.depthTitle || quiz.notes?.depthNote ? (
          <Fragment>
            <SectionHead
              title={quiz.notes.depthTitle ?? 'Where these differences come from'}
              kicker={leads ? undefined : `${depthOrder.length} axes, the strongest lean first`}
            />
            {quiz.notes.depthNote && <p class="tags">{quiz.notes.depthNote}</p>}
          </Fragment>
        ) : (
          <Fragment>
        <SectionHead
          title="Where these differences come from"
          kicker={`${depthOrder.length} axes, the strongest lean first`}
        />
        <p class="tags">
          Each one is a real disagreement between Christians who read the same Bible. Both
          cases below are stated by people who hold them.
        </p>
          </Fragment>
        )}
        {depthOrder.map((row, i) => <AxisDepth quiz={quiz} row={row} open={i === 0} />)}
      </section>
    )}

    {!kindredThin && view.shape !== 'personality' && (
      <ShareBlock quiz={quiz} view={view} origin={Astro.site!.origin} line={readingLine}
                  kindred={kindredCard} linkCode={linkCode} />
    )}

    {/*
      Save it, or take it yourself: the one ask on a result page, for every shape, a reading
      too. It sends nothing about the result anywhere; the result is already on this device,
      and the account picks it up from there once a password is chosen.
    */}
    {!kindredThin && <SaveResult quiz={quiz} view={view} linkCode={linkCode} />}
    {view.shape === 'personality' && (
      /*
        The personality report also knows its taker when they come back later (a private entry
        or the shelf, PersonalityResult.astro), where the save box only reads this tab's note.
        So the box follows the report's own mark, set before this ran.
      */
      <script is:inline>
        try {
          if (document.documentElement.getAttribute('data-pq-who') === 'taker') {
            var pqSave = document.getElementById('save');
            if (pqSave && pqSave.dataset.who !== 'taker') {
              pqSave.dataset.who = 'taker';
              var pqGo = document.getElementById('save-go');
              if (pqGo) { pqGo.classList.remove('glass'); pqGo.textContent = 'Save my result'; }
            }
          }
        } catch (e) {}
      </script>
    )}

    {/*
      The way on. A result used to end on the email form and, for some quizzes, three grey
      cards of article titles — which is a dead end dressed as a list. The other quizzes and
      the games stand here as rooms wearing their own pictures, and the articles written
      alongside this quiz stand under them as the paintings they are.
    */}
    {(otherQuizzes.length > 0 || games.length > 0) && (
      <section class="nextup">
        <SectionHead title="Keep going" kicker="Take another, or play one" />
        <NextUp quizzes={otherQuizzes} games={games} />
      </section>
    )}

    {related.length > 0 && (
      <section>
        <SectionHead
          title="Worth reading"
          kicker="Written alongside this quiz"
          href="/articles/"
          more="All articles"
        />
        <div class="hm-reads reads-foot">
          {related.map(a => (
            <ReadCard id={a.id} title={a.data.title} description={a.data.description}
                      minutes={a.data.minutes} image={a.data.image} imageAlt={a.data.imageAlt}
                      imagePosition={a.data.imagePosition} />
          ))}
        </div>
      </section>
    )}
  </Base>
) : (
  <Base title="Result not found" description="That result link is not valid." noindex={true}>
    <div class="prose">
      <h1>That link is not a valid result</h1>
      <p>
        Result codes are exact. One wrong character and there is no way to recover the
        answers.
      </p>
      <p>
        If someone sent you this link, ask them for it again — and check that nothing was
        cut off at the end.
      </p>
      <p><a href="/quizzes/">Take a quiz →</a></p>
    </div>
  </Base>
)}
