---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Icon from '../../../components/Icon.astro';
import AxisMap from '../../../components/AxisMap.astro';
import HistoryTimeline from '../../../components/HistoryTimeline.astro';
import PassagePills from '../../../components/PassagePills.astro';
import CorrectionNote from '../../../components/CorrectionNote.astro';
import CompassCard from '../../../components/CompassCard.astro';
import MineNote from '../../../components/MineNote.astro';
import { QUIZZES, getQuiz, groupHref, quizHref } from '../../../lib/engine/registry';
import {
  capitalise, groupNoun, groupNounPlural, isSplitReadMore, outcomeNoun, outcomeNounPlural,
  readMoreAll
} from '../../../lib/engine/types';
import { paragraphs } from '../../../lib/prose';
import { artFor } from '../../../lib/art';
import { clip } from '../../../lib/seo';

/**
 * Long-form pages for a quiz's groups. The route is generic; only groups that carry
 * written content get a page, so a quiz without axis essays simply produces none.
 */
export function getStaticPaths() {
  return QUIZZES.flatMap(q =>
    q.groups
      .filter(g => g.summary)
      .map(g => ({ params: { quiz: q.slug, axis: g.slug }, props: { group: g } }))
  );
}

const { group } = Astro.props;
const quiz = getQuiz(Astro.params.quiz)!;
const bipolar = Boolean(group.left && group.right);
const index = quiz.groups.findIndex(g => g.slug === group.slug);

// Further reading is pole-split on a bipolar axis because the sources are: Bondage of the
// Will argues one side, Arminius the other. Flattening them would put a book under the
// position its author wrote against.
const split = isSplitReadMore(group.readMore) ? group.readMore : null;
const reading = readMoreAll(group.readMore);

// The full text, still as two mirrored panels. This is the page the result page truncates
// TO, so the prose is whole here — but a disagreement between two positions should read as
// a disagreement on the indexable page as well, not as one long paragraph about a topic.
const parts = group.summaryParts;

const history = group.history ?? [];
const passages = group.passages ?? [];
const statements = quiz.items.filter(it => it.group === index).length;
const placed = quiz.outcomes.filter(o => Array.isArray(o.position)).length;

/**
 * What this quiz places on its rails, in its own noun: traditions on the Compass, figures
 * on the figure quiz. The default is "traditions", so every Compass sentence is unchanged.
 */
const plural = outcomeNounPlural(quiz);
/**
 * The Compass calls its eighteen outcomes "families" in this one kicker, because they are
 * tradition families rather than denominations. Another quiz has no families, so it uses
 * its own plural; the Compass's word is kept exactly.
 */
const collective = quiz.outcomeNounPlural ?? 'families';

/**
 * A unipolar group may carry the passage it is NAMED FROM, quoted, and the recorded acts
 * that show what it has looked like. Both are this group's own — unlike `passages`, which
 * is a list of references both poles of an axis argue from and is assigned to neither.
 */
const quoted = group.quoted ?? [];
const acts = group.acts ?? [];

/**
 * THE ANSWER BLOCK, AND WHY IT IS AT THE TOP AND NOT BEHIND ANYTHING (2026-09-21).
 *
 * Someone arrives here having typed "have the gifts of the spirit ceased" or "predestination
 * vs free will". The page used to open on a chart and make them read four hundred words of
 * an essay before anything answered them. So a group may now carry the question in the words
 * a person actually types, a forty-to-fifty word answer naming both views, and a short
 * paragraph on what changes depending on which is true.
 *
 * All of it is plain visible HTML under a heading, on purpose: a search engine gives full
 * weight to what is on the page and little or none to what sits inside a pop-out, a hover or
 * a closed panel, and the substance a reader came for is exactly what must not be hidden.
 * The first screen stays clean by ORDER — answer first, depth below — not by concealment.
 *
 * Every field is optional and generic. The gifts will use the same three, and a group that
 * carries none of them renders the page exactly as it rendered before this existed.
 */
const answer = group.shortAnswer;
const dyk = group.didYouKnow ?? [];

/**
 * Headings a searcher would recognise, rather than the site's own filing labels.
 *
 * "Where the traditions sit" and "The two cases" were internal vocabulary: true, short, and
 * meaningless to anyone who had not already read the rest of the site. These say what the
 * section answers. They stay derived from the quiz's own nouns, so the figure quiz's axes
 * and the gifts get sentences about figures and gifts rather than about traditions.
 */
const mapTitle = `Where does each ${outcomeNoun(quiz)} sit?`;
const caseTitle = 'What does each side believe?';
const historyTitle = 'How did this disagreement develop?';
const passagesTitle = bipolar
  ? 'Which Bible passages do both sides argue from?'
  : 'Which Bible passages are these?';

/**
 * Tiles are counts of things that are on this page, taken from the data. Nothing here is
 * a headline number invented to fill a row: if an axis carries no chronology, that tile
 * does not appear.
 */
const tiles = [
  { n: statements, label: 'Statements' },
  ...(history.length ? [{ n: history.length, label: 'Moments' }] : []),
  ...(passages.length ? [{ n: passages.length, label: 'Passages' }] : []),
  // "Recorded acts" is the truth for every group that has not said otherwise. The two that
  // have — the word of knowledge and interpreting tongues — have no recorded act in the New
  // Testament at all, so the tile counts what the list actually holds.
  ...(acts.length
    ? [{ n: acts.length, label: group.actsHeading ? 'Passages' : 'Recorded acts' }]
    : []),
  ...(bipolar && placed
    ? [{ n: placed, label: capitalise(plural) }]
    : [{ n: quiz.groups.length, label: capitalise(groupNounPlural(quiz)) }])
];

// Siblings that actually have a page of their own, in the quiz's own order.
const siblings = quiz.groups.filter(g => g.summary);
const at = siblings.findIndex(g => g.slug === group.slug);
const prev = at > 0 ? siblings[at - 1] : null;
const next = at >= 0 && at < siblings.length - 1 ? siblings[at + 1] : null;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
/* A gift's page is what someone searching "gift of tongues" or "spiritual gift of mercy" wants:
   the title says so. Other ranked quizzes keep the plain name. */
const isGift = quiz.slug === 'spiritual-gifts';

/**
 * THE HEADING, AND THE TITLE, AND WHY THEY ARE NOT THE SAME STRING (2026-09-21).
 *
 * These pages used to put the subject in the <title> and the site's own filing label in
 * the <h1>: /axis/theology-compass/table/ shipped "Table" as its heading under a title
 * about real presence and the memorial view, and /axis/spiritual-gifts/prophecy/ shipped
 * "prophecy", in lower case. Somebody arriving from a search met a single word that did
 * not obviously belong to what they had clicked.
 *
 * So the heading now says what the page is. On a bipolar axis it is the string the title
 * has always used, with BOTH pole names in it and neither of them first by preference —
 * the two inks are the site's own, blue for the left pole and orange for the right, and
 * neither ink means better. On a gift it is the form a person says out loud, "The gift of
 * prophecy". The short name is inside the heading in every case, so the filing label is
 * not lost anywhere; the chip above it stays the quiz, which is the one thing the heading
 * does not say.
 *
 * The title keeps its own job, which is to be findable: "spiritual gift of prophecy" is
 * what people type, and the passage after the colon is what makes all nineteen different
 * from one another instead of nineteen copies of one tail.
 */
const namedInFull = group.name.startsWith('the ');
const giftHeading = namedInFull ? cap(group.name) : `The gift of ${group.name}`;
/** The searchable form of the same gift, for the title only. */
const giftPhrase = /gift/.test(group.name)
  ? cap(group.name)
  : namedInFull
    ? `${cap(group.name)}, a spiritual gift`
    : `The spiritual gift of ${group.name}`;
/** The first passage this group is named from. Every gift has one; an axis has none. */
const firstRef = quoted[0]?.ref;

/*
 * The heading over the whole description, and why it is no longer "What is X?".
 *
 * A bipolar group lands here only when its summary could not be split safely, and "What is
 * Pace?" would be the site's own filing label asked as a question; it is still two sides, so
 * it is still that question.
 *
 * A unipolar group with an answer block above it has ALREADY been asked what it is, in the
 * words a person types ("What is the spiritual gift of mercy?"). Asking it again four
 * hundred words later as "What is showing mercy?" read as a stutter and split one search
 * between two headings. So the second heading asks the next question instead, which is what
 * the description underneath actually answers: what it looks like in an ordinary church. A
 * group with no answer block — the sins draft — keeps the question it always had.
 */
const namedSubject = isGift
  ? giftHeading.charAt(0).toLowerCase() + giftHeading.slice(1)
  : group.name;
/* A two-pole group that reaches this heading has no cases stated by holders (the Compass's
   do, under caseTitle): today that is the figure quiz, whose axes are temperament, and
   "What does each side believe?" said they were beliefs. */
const meansTitle = bipolar
  ? 'What does each side look like?'
  : group.shortAnswer
    ? isGift
      ? `What does ${namedSubject} look like in a church?`
      : `What does ${group.name} look like day to day?`
    : `What is ${group.name}?`;

/*
 * QUIET GROUP PAGES (Quiz.quietGroupPages: the seven deadly sins, the owner's notes of
 * 2026-09-25). No small accent line over any section title; the group's own painting across
 * the whole band with its facts at a glance as the tiles; the name capitalised in the heading
 * ("pride" read as a mistake); and the one-sentence summary as the band's lede, where it
 * introduces the page, instead of a section of its own under a heading it did not answer.
 */
const quiet = Boolean(quiz.quietGroupPages);
const own = group.band;
const k = (kicker: string | undefined) => (quiet ? undefined : kicker);

const heading = bipolar
  ? `${group.name}: ${group.left} or ${group.right}`
  : isGift
    ? giftHeading
    : quiet
      ? cap(group.name)
      : group.name;
const title = group.title ?? (bipolar
  ? heading
  : isGift
    ? (firstRef ? `${giftPhrase}: ${firstRef}` : giftPhrase)
    : group.name);

/*
 * A gift's description, built from that gift's own data so that no two of the nineteen
 * are the same sentence with one word swapped. The passage is the one the page quotes;
 * the count is the list the page actually prints, and it is called what the page calls it
 * — two of the gifts have no recorded act in the New Testament at all and say so, so
 * their lists are passages about the gift rather than acts of it.
 */
const actsWord = group.actsHeading ? 'passages on it' : 'recorded acts';
/*
 * The short answer wherever one is written: it was composed to be read cold by somebody who
 * has not seen the page, which is exactly what a search listing is, and it says what the
 * gift IS rather than what the page contains. The old sentence described the furniture
 * ("quoted in full, with four recorded acts, each cited") to a reader who had not yet been
 * told what the gift was. seo.ts still overrides both of the Compass's shapes; the count
 * sentence stays as the fallback for a group that carries no answer.
 */
const metaDescription = clip(
  group.shortAnswer ??
    (isGift
      ? `${cap(group.name)} in ${firstRef}, quoted in full, with ${acts.length} ${actsWord}, ` +
        'each cited. Part of a free spiritual gifts test, all 19 gifts.'
      : group.summary!)
);
const ghost = group.name.toLowerCase();
/* An axis wears its parent quiz's picture: it is a page ABOUT that quiz. */
const art = artFor(quiz.slug);

/*
 * THE WAY IN AT THE FOOT (2026-09-22): the quiz's own card, the one it wears everywhere
 * (the owner: "literally everywhere it appears it should be standardized"). The Compass's
 * is the shared CompassCard; any other quiz's is its engraving room, as on the home page
 * and /quizzes/, drawn here WITHOUT its plate, because the plate is already the band at the
 * top of this page and no page shows one picture twice.
 *
 * Its one line is about this page's subject, and every number in it is counted.
 */
const isCompass = quiz.slug === 'theology-compass';
const NUMBER_WORDS = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
  'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen',
  'nineteen', 'twenty'
];
const word = (n: number) => NUMBER_WORDS[n] ?? String(n);
const cardSay = bipolar
  ? `See where you land between ${group.left} and ${group.right}, and ` +
    (isCompass
      ? `on ${word(quiz.groups.length - 1)} more questions that divide Christians.`
      : `which ${outcomeNoun(quiz)} sits nearest you.`)
  : `See where ${namedSubject} ranks for you among all ${word(quiz.groups.length)}.`;
/** The second fact, counted the way /quizzes/ counts it: 25 figures, 19 gifts, 14 statements. */
const cardFact = quiz.outcomes.length
  ? `${quiz.outcomes.length} ${plural}`
  : quiz.groupNounPlural
    ? `${quiz.groups.length} ${groupNounPlural(quiz)}`
    : `${quiz.items.length} statements`;

/*
 * WebPage, not Article.
 *
 * It was typed Article and carried none of Article's properties — no author, no date, no
 * publisher, no image — while its own head said og:type website. Nothing here is an
 * article in any ordinary sense: it is a reference page about a subject, which is what
 * WebPage means. `about` names the subject, and on a bipolar axis it names BOTH poles and
 * neither first, because a machine reading this page must not be told that one end of a
 * disagreement is what the page is about and the other is not.
 *
 * The WebSite id is the one the home page publishes. The two strings have to stay
 * identical or the graph does not join up.
 */
const siteId = new URL('/#website', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: heading,
  description: clip(group.shortAnswer ?? group.summary!, 200),
  url: new URL(groupHref(quiz, group), Astro.site).href,
  isPartOf: [
    { '@id': siteId },
    { '@type': 'Quiz', name: quiz.title, url: new URL(quizHref(quiz), Astro.site).href }
  ],
  about: bipolar
    ? [{ '@type': 'Thing', name: group.left }, { '@type': 'Thing', name: group.right }]
    : { '@type': 'Thing', name: isGift ? giftHeading : group.name },
  ...(own ?? art
    ? {
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: new URL((own ?? art)!.src, Astro.site).href,
          caption: (own ?? art)!.alt
        }
      }
    : {}),
  // Both poles' works, in the order the audit lists them. The page is an argument about
  // what other people believe, so the works it rests on are part of the record.
  ...(reading.length ? { citation: reading } : {})
};

// A draft quiz is noindex, so its axes publish no trail either.
const breadcrumbs =
  quiz.status === 'draft'
    ? null
    : [
        { name: 'Home', url: '/' },
        { name: 'Quizzes', url: '/quizzes/' },
        { name: quiz.title, url: quizHref(quiz) },
        // The gifts are stored in lower case, because they are words in a list in a
        // letter. A trail is shown in a search result, and "prophecy" in the middle of a
        // line of capitalised steps reads as a mistake rather than as a decision.
        { name: isGift ? cap(group.name) : group.name, url: groupHref(quiz, group) }
      ];
---
<Base
  title={title}
  description={metaDescription}
  noindex={quiz.status === 'draft'}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  {own ? (
    <Hero
      title={heading}
      kind="colour"
      image={own.src}
      imageAlt={own.alt}
      imagePos={{ m: own.posM, d: own.posD }}
      lede={quiet ? group.summary : undefined}
      tiles={group.glance ?? tiles}
      credit={own.credit}
    />
  ) : (
    <Hero
      title={heading}
      blue={bipolar ? group.left : undefined}
      orange={bipolar ? group.right : undefined}
      kind={art ? 'engraving' : 'night'}
      image={art?.src}
      imageAlt={art?.alt}
      imagePosition={art?.objectPosition}
      imageLift={art?.lift}
      long={heading.length > 24}
      tiles={tiles}
    />
  )}
  {/*
    The band has no lede, on either shape of page.

    A bipolar axis used to print its two poles here, under a one-word heading, in a line
    with an arrow between them. The heading now says them itself, in the same two inks and
    in the same order, so the line under it was the same eight words again and the band
    read as a stutter at 390 and at 1360 alike. Both poles are still printed
    unconditionally, which is the rule; they are printed once.

    A group with no poles used to print the QUIZ's tagline here, so a page about tongues
    opened on "Fifty-seven statements, nineteen gifts, and a conversation to have
    afterwards" — a line that says nothing about tongues and repeats the tile beneath it.
    The gift's own words are the section under the band, where they are not a caption on
    somebody else's picture.
  */}

  <div class="ref ref--axis">
    {quiz.status === 'draft' && quiz.draftNote && (
      <div class="note draft ref-draft">
        <p><strong>Unaudited draft.</strong>{' ' + quiz.draftNote}</p>
      </div>
    )}

    {/*
      A category, for a reader who has taken this quiz on this device: its row from their own
      result, first, where somebody who came from their result looks for it. Hidden until
      MineNote finds a result, so anyone else meets the page as it was. A two-pole axis marks
      the reader on the map further down instead.
    */}
    {!bipolar && <MineNote quiz={quiz} kind="axis" index={index} />}

    {/*
      The answer, first, in the words the question was asked in. See the note above the
      `answer` const: this is visible crawlable text and it is deliberately above the
      instruments, because a chart is not an answer to a question somebody typed.
    */}
    {answer && (
      <>
        {/* No question written: the kicker would repeat the heading word for word. */}
        <SectionHead
          title={group.question ?? 'The short answer'}
          kicker={group.question ? k('The short answer') : undefined}
        />
        <div class="panel layered ref-panel answer">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          <p class="answer-lead">{answer}</p>
          {group.whyItMatters && (
            <div class="answer-why">
              <h3>Why it matters</h3>
              <p>{group.whyItMatters}</p>
            </div>
          )}
        </div>
      </>
    )}

    {bipolar && placed > 0 && (
      <>
        <SectionHead
          title={mapTitle}
          kicker={k(`All ${placed} ${collective} on one rail`)}
        />
        <section class="dark amap-panel" data-you-host="map">
          <div class="dark-ghost" aria-hidden="true">{ghost}</div>
          <p class="feature-kicker">
            <Icon name="compass" size={13} /> One axis, everybody on it
          </p>
          {/* The reader, for one who has taken this quiz on this device: one line, where
              they landed in the band words, and a "You" mark on the map's rail. */}
          <MineNote quiz={quiz} kind="axis" index={index} />
          <AxisMap quiz={quiz} group={group} index={index} />
          {/* The mark is printed here and moved onto the map's rail by MineNote's script,
              because AxisMap is the map for every visitor and carries nothing of anyone's. */}
          <span class="you-mark" data-you-axis={index} data-you-into=".amap-rail" data-you-geo="value" hidden aria-hidden="true"><span class="you-tag">You</span></span>
        </section>
      </>
    )}

    {/*
      This block and the one after it hang off their neighbours with no whitespace between
      them. An expression that renders nothing still leaves the newline on each side of it,
      and on a quiz with no quotations — every quiz but the gifts draft — those newlines are
      stray spaces in a page that has to come out of this change unchanged.

      The passage this group is NAMED FROM, quoted, ABOVE the plain description rather than
      below it: a gift's name is not a heading someone chose, it is a word in a list in a
      letter, so the list's own words come first and the description answers them. A unipolar group's name is not a
      heading someone chose: it is a word in a list in a letter, and the honest thing is to
      print the list's own words and say which translation they are. Nothing is added.
    */}{quoted.length > 0 && (
      <>
        <SectionHead
          title="Where does the Bible name it?"
          kicker={k(group.quotedFrom ?? 'Quoted in full')}
        />
        <section class="dark quoted-panel">
          <div class="dark-ghost" aria-hidden="true">{ghost}</div>
          {!quiet && (
            <p class="feature-kicker">
              <Icon name={quiz.icon} size={13} /> {isGift ? "In the list's own words" : "In the Bible's own words"}
            </p>
          )}
          <ul class="quoted">
            {quoted.map(q => (
              <li class="quoted-item">
                <blockquote class="quoted-text">{q.text}</blockquote>
                <p class="quoted-ref">{q.ref}</p>
              </li>
            ))}
          </ul>
          {group.quotedFrom && <p class="quoted-from">{group.quotedFrom}</p>}
        </section>
      </>
    )}{parts ? (
      <>
        <SectionHead title={caseTitle} kicker="Each case stated by people who hold it" />
        <div class="cases">
          <article class="case case--left">
            <span class="case-tag" aria-hidden="true">Left pole</span>
            <h3>{group.left}</h3>
            <p>{parts.left}</p>
          </article>
          <article class="case case--right">
            <span class="case-tag" aria-hidden="true">Right pole</span>
            <h3>{group.right}</h3>
            <p>{parts.right}</p>
          </article>
        </div>

        {parts.between && (
          <aside class="axis-note axis-note--between">
            <p class="axis-note-label">Between the poles</p>
            <p>{parts.between}</p>
          </aside>
        )}
        {parts.caution && (
          <aside class="axis-note axis-note--caution">
            <p class="axis-note-label">About this axis</p>
            <p>{parts.caution}</p>
          </aside>
        )}
      </>
    ) : quiet && own ? null : (
      <>
        {/* A group with two poles is an axis whatever the quiz calls its groups: the figure
            quiz names none, and the engine's fallback word, "category", is not the reader's. */}
        <SectionHead
          title={meansTitle}
          kicker={k(`${bipolar ? 'Axis' : capitalise(groupNoun(quiz))} ${index + 1} of ${quiz.groups.length}`)}
        />
        <div class="panel layered ref-panel">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          {/*
            Whole, and in paragraphs. Nothing is cut and nothing is reordered — the break is
            put at a sentence end, three sentences to a paragraph, because the gifts draft's
            longest summaries run to twelve and twelve sentences of display serif in one
            block at 390px is a wall. A summary of three or fewer comes out as the one
            paragraph it already was, so the sins draft's pages are unchanged.
          */}
          {paragraphs(group.summary!).map(p => <p class="ref-lead">{p}</p>)}
        </div>
      </>
    )}{/*
      Three true things, each with what it was checked against printed beside it.

      Hung off its neighbours with no whitespace, like the blocks above, because an
      expression that renders nothing still leaves the newline on each side of it. Every
      item is data: nothing here is written in the template, and a group with no items
      produces no section at all.
    */}{dyk.length > 0 && (
      <>
        <SectionHead
          title="Did you know?"
          kicker={k(dyk.length === 1 ? 'One thing worth knowing, with its source' : `${dyk.length} things worth knowing, each with its source`)}
        />
        <div class="panel layered ref-panel ref-panel--quiet dyk-panel">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          <ul class="dyk">
            {dyk.map(k => (
              <li class="dyk-item">
                <p class="dyk-text">{k.text}</p>
                <p class="dyk-source">{k.source}</p>
              </li>
            ))}
          </ul>
        </div>
      </>
    )}{/*
      What it has looked like, in recorded acts only. Each row is a reference and one
      sentence saying what somebody DID — never an inference about a reader, and never a
      claim that these people had this gift; the page says what the text records.
    */}{acts.length > 0 && (
      <>
        {/*
          A group may name this list itself, because for two of the gifts the page's own
          words are false: the New Testament calls no act a word of knowledge, Acts never
          shows anyone interpreting tongues, and both summaries directly above say so. A
          heading counting three of Paul's sentences as "3 recorded acts" would contradict
          the paragraph it sits under. Every other group keeps these words exactly.

          The question is WHO, not what. "What does it look like?" was one word away from the
          heading over the description above it, and two headings that ask the same thing
          four hundred words apart split one search between them. This list is not another
          description: it is named people doing the thing, each with the verse it is recorded
          in, which is its own question and the one a reader has next.
        */}
        <SectionHead
          title={group.actsHeading ?? 'Who did this in the Bible?'}
          kicker={k(group.actsKicker ?? `${acts.length} recorded acts, each cited`)}
        />
        <div class="panel layered ref-panel ref-panel--quiet">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          <ol class="acts">
            {acts.map(a => (
              <li class="act">
                <p class="act-ref">{a.ref}</p>
                <p class="act-what">{a.what}</p>
              </li>
            ))}
          </ol>
        </div>
      </>
    )}

    {history.length > 0 && (
      <>
        <SectionHead title={historyTitle} kicker={k('In order, with dates and sources')} />
        <div class="panel layered ref-panel ref-panel--tl">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          <HistoryTimeline history={history} heading="h3" />
        </div>
      </>
    )}

    {passages.length > 0 && (
      <>
        <SectionHead
          id="sources"
          title={passagesTitle}
          kicker={k('Argued from by both sides, assigned to neither')}
        />
        <div class="panel layered ref-panel ref-panel--pg ref-panel--quiet">
          <div class="wash" aria-hidden="true"></div>
          <div class="veil" aria-hidden="true"></div>
          <PassagePills refs={passages} heading="h3" />
        </div>
      </>
    )}

    {reading.length > 0 && (
      <>
        <SectionHead
          title="Further reading"
          kicker={k(split ? 'Split by pole, because the books are' : `${reading.length} works`)}
        />
        {split ? (
          <div class="reading">
            <section class="reading-col reading-col--left">
              <h3>{group.left}</h3>
              <ul>{split.left.map(r => <li>{r}</li>)}</ul>
            </section>
            <section class="reading-col reading-col--right">
              <h3>{group.right}</h3>
              <ul>{split.right.map(r => <li>{r}</li>)}</ul>
            </section>
          </div>
        ) : (
          <div class="reading">
            <section class="reading-col">
              <ul>{reading.map(r => <li>{r}</li>)}</ul>
            </section>
          </div>
        )}
      </>
    )}

    {/*
      The way back into the quiz: the quiz's own card (see the note above `cardSay`). The
      engraving room is drawn on its plate's own brown with no plate in it, because the
      plate is the band at the top of this page. Styles: .qcard in pages/reference.css.
    */}
    {isCompass ? (
      <CompassCard level={2} kicker="Your turn" say={cardSay} />
    ) : (
      <div class="qcard-wrap">
        <a class={`qcard qcard--plain qcard--${quiz.slug}`} href={quizHref(quiz)}>
          <div class="qcard-body">
            <p class="qcard-kicker">Your turn</p>
            <h2 class="qcard-title">{quiz.title}</h2>
            <p class="qcard-say">{cardSay}</p>
            <ul class="qcard-facts">
              <li><Icon name="clock" size={13} /> {quiz.minutes} min</li>
              <li>{cardFact}</li>
            </ul>
            <span class="qcard-go go-pill">Start <Icon name="arrow" size={16} /></span>
          </div>
        </a>
      </div>
    )}

    {(prev || next) && (
      <nav class="pager" aria-label="Other axes">
        {prev ? (
          <a class="pager-link pager-link--prev" href={groupHref(quiz, prev)}>
            <span class="pager-dir">Previous</span>
            <span class="pager-name">{prev.name}</span>
            {prev.left && prev.right && (
              <span class="pager-poles">
                <b class="pole-l">{prev.left}</b>
                <i aria-hidden="true">↔</i>
                <b class="pole-r">{prev.right}</b>
              </span>
            )}
          </a>
        ) : <span></span>}
        {next && (
          <a class="pager-link pager-link--next" href={groupHref(quiz, next)}>
            <span class="pager-dir">Next</span>
            <span class="pager-name">{next.name}</span>
            {next.left && next.right && (
              <span class="pager-poles">
                <b class="pole-l">{next.left}</b>
                <i aria-hidden="true">↔</i>
                <b class="pole-r">{next.right}</b>
              </span>
            )}
          </a>
        )}
      </nav>
    )}

    <CorrectionNote subject={`${group.name} axis`} />
  </div>
</Base>
