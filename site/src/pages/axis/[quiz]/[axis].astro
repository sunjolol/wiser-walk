---
import Base from '../../../layouts/Base.astro';
import { QUIZZES, getQuiz, quizHref } from '../../../lib/engine/registry';
import { isSplitReadMore, readMoreAll } from '../../../lib/engine/types';

/**
 * Long-form pages for a quiz's groups. The route is generic; only groups that carry
 * written content get a page, so a quiz without axis essays simply produces none.
 */
export function getStaticPaths() {
  return QUIZZES.flatMap(q =>
    q.groups
      .filter(g => g.summary)
      .map(g => ({ params: { quiz: q.slug, axis: g.slug }, props: { group: g } }))
  );
}

const { group } = Astro.props;
const quiz = getQuiz(Astro.params.quiz)!;
const bipolar = Boolean(group.left && group.right);

// Further reading is pole-split on a bipolar axis because the sources are: Bondage of the
// Will argues one side, Arminius the other. Flattening them would put a book under the
// position its author wrote against.
const split = isSplitReadMore(group.readMore) ? group.readMore : null;
const reading = readMoreAll(group.readMore);

// The full text, still as two mirrored panels. This is the page the result page truncates
// TO, so the prose is whole here — but a disagreement between two positions should read as
// a disagreement on the indexable page as well, not as one long paragraph about a topic.
const parts = group.summaryParts;

const title = bipolar ? `${group.name}: ${group.left} or ${group.right}` : group.name;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: group.summary!.slice(0, 200),
  url: new URL(`/axis/${quiz.slug}/${group.slug}/`, Astro.site).href,
  isPartOf: { '@type': 'Quiz', name: quiz.title, url: new URL(`/q/${quiz.slug}/`, Astro.site).href }
};
---
<Base
  title={title}
  description={group.summary!.slice(0, 155)}
  noindex={quiz.status === 'draft'}
  jsonLd={jsonLd}
>
  <div class="prose">
    <p class="eyebrow">{quiz.emoji} {quiz.title}</p>
    <h1>{group.emoji} {group.name}</h1>
    {bipolar && <p class="lede">{group.left} ↔ {group.right}</p>}
  </div>

  {parts ? (
    <div class="axis-cases">
      <div class="poles-split">
        <section class="pole-panel pole-panel--left">
          <h4>{group.left}</h4>
          <p>{parts.left}</p>
        </section>
        <section class="pole-panel pole-panel--right">
          <h4>{group.right}</h4>
          <p>{parts.right}</p>
        </section>
      </div>
      {parts.between && (
        <p class="between"><strong>Between the poles.</strong> {parts.between}</p>
      )}
      {parts.caution && (
        <p class="caution"><strong>About this axis.</strong> {parts.caution}</p>
      )}
    </div>
  ) : (
    <div class="prose"><p>{group.summary}</p></div>
  )}

  <div class="prose">

    {group.history && group.history.length > 0 && (
      <>
        <h2>{bipolar ? 'How the question arose' : 'How this has been understood'}</h2>
        <ol>
          {group.history.map(h => <li><strong>{h.when}</strong> — {h.what}</li>)}
        </ol>
      </>
    )}

    {group.passages && group.passages.length > 0 && (
      <>
        {/* "Both sides" is a bipolar claim. A category has no second side to argue back. */}
        <h2>{bipolar ? 'Passages both sides argue from' : 'Passages'}</h2>
        <p>{group.passages.join(' · ')}</p>
      </>
    )}

    {reading.length > 0 && (
      <>
        <h2>Read further</h2>
        {split ? (
          <div class="read-split">
            <div>
              <h3>{group.left}</h3>
              <ul>{split.left.map(r => <li>{r}</li>)}</ul>
            </div>
            <div>
              <h3>{group.right}</h3>
              <ul>{split.right.map(r => <li>{r}</li>)}</ul>
            </div>
          </div>
        ) : (
          <ul>{reading.map(r => <li>{r}</li>)}</ul>
        )}
      </>
    )}

    <p><a href={quizHref(quiz)}>Take the {quiz.title} →</a></p>
  </div>
</Base>
