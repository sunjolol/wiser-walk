---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import HistoryTimeline from '../../../components/HistoryTimeline.astro';
import PassagePills from '../../../components/PassagePills.astro';
import CorrectionNote from '../../../components/CorrectionNote.astro';
import { QUIZZES, getQuiz, groupHref, quizHref } from '../../../lib/engine/registry';
import { isSplitReadMore, readMoreAll } from '../../../lib/engine/types';

/**
 * Long-form pages for a quiz's groups. The route is generic; only groups that carry
 * written content get a page, so a quiz without axis essays simply produces none.
 */
export function getStaticPaths() {
  return QUIZZES.flatMap(q =>
    q.groups
      .filter(g => g.summary)
      .map(g => ({ params: { quiz: q.slug, axis: g.slug }, props: { group: g } }))
  );
}

const { group } = Astro.props;
const quiz = getQuiz(Astro.params.quiz)!;
const bipolar = Boolean(group.left && group.right);

// Further reading is pole-split on a bipolar axis because the sources are: Bondage of the
// Will argues one side, Arminius the other. Flattening them would put a book under the
// position its author wrote against.
const split = isSplitReadMore(group.readMore) ? group.readMore : null;
const reading = readMoreAll(group.readMore);

// The full text, still as two mirrored panels. This is the page the result page truncates
// TO, so the prose is whole here — but a disagreement between two positions should read as
// a disagreement on the indexable page as well, not as one long paragraph about a topic.
const parts = group.summaryParts;

const title = bipolar ? `${group.name}: ${group.left} or ${group.right}` : group.name;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: group.summary!.slice(0, 200),
  url: new URL(groupHref(quiz, group), Astro.site).href,
  isPartOf: { '@type': 'Quiz', name: quiz.title, url: new URL(quizHref(quiz), Astro.site).href },
  // Both poles' works, in the order the audit lists them. The page is an argument about
  // what other people believe, so the works it rests on are part of the record.
  ...(reading.length ? { citation: reading } : {})
};

// A draft quiz is noindex, so its axes publish no trail either.
const breadcrumbs =
  quiz.status === 'draft'
    ? null
    : [
        { name: 'Home', url: '/' },
        { name: 'Quizzes', url: '/quizzes/' },
        { name: quiz.title, url: quizHref(quiz) },
        { name: group.name, url: groupHref(quiz, group) }
      ];
---
<Base
  title={title}
  description={group.summary!.slice(0, 155)}
  noindex={quiz.status === 'draft'}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <div class="prose">
    <p class="eyebrow"><Icon name={quiz.icon} size={15} /> {quiz.title}</p>
    <h1>{group.name}</h1>
    {bipolar && <p class="lede">{group.left} ↔ {group.right}</p>}
  </div>

  {parts ? (
    <div class="axis-cases">
      <div class="poles-split">
        <section class="pole-panel pole-panel--left">
          <h4>{group.left}</h4>
          <p>{parts.left}</p>
        </section>
        <section class="pole-panel pole-panel--right">
          <h4>{group.right}</h4>
          <p>{parts.right}</p>
        </section>
      </div>
      {parts.between && (
        <p class="between"><strong>Between the poles.</strong> {parts.between}</p>
      )}
      {parts.caution && (
        <p class="caution"><strong>About this axis.</strong> {parts.caution}</p>
      )}
    </div>
  ) : (
    <div class="prose"><p>{group.summary}</p></div>
  )}

  <div class="prose">

    {group.history && group.history.length > 0 && (
      <HistoryTimeline history={group.history} heading="h3" />
    )}

    {/*
      One heading over the two things a reader would go looking for: the texts the argument
      is made from, and the books that make it. They were already both on the page; what was
      missing was the word "Sources" over them, so nobody had to guess that this is where
      the working is. Nothing is added here and nothing is attributed to a pole that the
      audited data does not already attribute.
    */}
    {((group.passages && group.passages.length > 0) || reading.length > 0) && (
      <>
        <h2 id="sources">Sources</h2>

        {group.passages && group.passages.length > 0 && (
          <PassagePills refs={group.passages} heading="h3" />
        )}

        {reading.length > 0 && (
          <>
            <h3>Further reading</h3>
            {split ? (
              <div class="read-split">
                <div>
                  <h4>{group.left}</h4>
                  <ul>{split.left.map(r => <li>{r}</li>)}</ul>
                </div>
                <div>
                  <h4>{group.right}</h4>
                  <ul>{split.right.map(r => <li>{r}</li>)}</ul>
                </div>
              </div>
            ) : (
              <ul>{reading.map(r => <li>{r}</li>)}</ul>
            )}
          </>
        )}
      </>
    )}

    <p><a href={quizHref(quiz)}>Take the {quiz.title} →</a></p>

    <CorrectionNote subject={`${group.name} axis`} />
  </div>
</Base>
