---
/**
 * The games index: a sibling of the home page, not a list of plain cards.
 *
 * The band, then the same composed game card the home page draws, then the charcoal
 * block that says where the lines come from. Every number on this page is counted from
 * the built game's own metadata, never typed.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import GameCard from '../components/GameCard.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { liveGames } from '../lib/games';
import slsMeta from '../games/sounds-like-scripture.meta.json';

const games = liveGames();

/**
 * The facts under each game's title. They are per game because they are the game's own
 * rules; a game with nothing to say here falls back to its one-line meta.
 */
const FACTS: Record<string, { specs: Array<{ k: string; v: string }>; ghost: string; kicker: string; answers: [string, string] }> = {
  'sounds-like-scripture': {
    specs: [
      { k: 'A run', v: 'ten lines, a few seconds each' },
      { k: 'The pool', v: `${slsMeta.items} lines, quoted word for word` },
      { k: 'Drawn from', v: `${slsMeta.sources} public-domain editions` },
      { k: 'Your Bible', v: 'Protestant, Catholic or Orthodox' }
    ],
    ghost: 'scripture?',
    kicker: 'In the Bible, or not',
    answers: ['Not in the Bible', 'In the Bible']
  }
};

const composed = games.filter(g => FACTS[g.slug]);
const plain = games.filter(g => !FACTS[g.slug]);

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Games', url: '/games/' }];
---
<Base
  title="Games"
  description="Games played against the clock that count what you know, never how devout you are. Every line and every answer is real and citable."
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="Games"
    ghost="play"
    eyebrow="Against the clock"
    icon="scroll"
    blue="Games"
    tiles={[
      { n: slsMeta.items, label: 'Lines' },
      { n: slsMeta.sources, label: 'Editions' },
      { n: 10, label: 'Lines a run' }
    ]}
  >
    Short, hard, and honest about their sources. A game here counts what you know, never how
    devout you are, and nothing about how you played leaves your browser.
  </Hero>

  <SectionHead
    title="Playable now"
    kicker={games.length === 1 ? 'One game so far' : `${games.length} games so far`}
  />

  {composed.map(g => (
    <GameCard
      game={g}
      specs={FACTS[g.slug]!.specs}
      ghost={FACTS[g.slug]!.ghost}
      kicker={FACTS[g.slug]!.kicker}
      answers={FACTS[g.slug]!.answers}
    />
  ))}

  {plain.length > 0 && (
    <div class="scards" style="margin-top:.9rem">
      {plain.map(g => (
        <Card href={g.href} icon={g.icon} title={g.title} text={g.tagline} meta={g.meta} tab="Game" go="Play" />
      ))}
    </div>
  )}

  <section class="dark pledge">
    <div class="dark-ghost" aria-hidden="true">quoted</div>
    <p class="feature-kicker"><Icon name="scroll" size={13} /> Where the lines come from</p>
    <h2>Every line is quoted, never written.</h2>
    <p>
      Each line is lifted word for word out of a public-domain edition and checked back
      against the file it came from. The readers who rated them for difficulty were shown
      the lines by number, with no idea which book any of them was in. After every answer
      you get the exact reference and a link to the file it was taken from.
    </p>
    <div class="btn-row">
      <a class="btn" href="/method/#the-game">How the game was made</a>
      <a class="btn ghost" href="/quizzes/">Take a quiz instead</a>
    </div>
  </section>
</Base>
