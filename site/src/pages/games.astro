---
/**
 * The games hub, recomposed for the dawn pass (2026-09-21).
 *
 * What stood here: one composed card for the first game, the second game dropped underneath
 * as a plain stripe card a tenth the size, and then a charcoal block explaining how the
 * lines were gathered. Two games of equal standing shown as a headliner and a footnote, and
 * a page whose job is to get someone playing ending on process talk.
 *
 * Now both games get the same room: a dark card carrying its own mark, its own ink, the
 * counted facts and a small drawing of what a player actually meets. Play is in the band, on
 * every card, and at the foot of each game's short rules below. Where the lines come from is
 * said once, in the band's own line, and in full after every answer inside the game.
 *
 * Every number on this page is read from the built game's metadata; nothing is typed but the
 * rules a game states on its own page (a run is ten lines, about two minutes).
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import GameCard from '../components/GameCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { liveGames } from '../lib/games';
import slsMeta from '../games/sounds-like-scripture.meta.json';
import wsiMeta from '../games/who-said-it.meta.json';

const games = liveGames();

/**
 * What each game shows on its card. The ghost glyph and the ink keep two dark cards from
 * reading as one; `run` is the length of a run, which each game states on its own page; the facts
 * are counted off the built pool; and `preview` is the drawing, whose line and names come
 * off that same metadata so a card is one real question out of the game and nothing typed.
 */
type CardSpec = {
  ghost: 'quote' | 'ask';
  ink: 'orange' | 'blue';
  run: number;
  /** The size of this game's pool, for the band's count across every game. */
  items: number;
  facts: string[];
  preview:
    | { kind: 'binary'; answers: [string, string]; line?: string | null }
    | { kind: 'names'; names?: string[] | null; line?: string | null };
};

const SPEC: Record<string, CardSpec> = {
  'sounds-like-scripture': {
    ghost: 'ask',
    ink: 'orange',
    run: 10,
    items: slsMeta.items,
    /* No "N real lines" pill on a card (the owner, 2026-09-22): the count stays in the band's
       tiles above, across both games, and on each game's own page. */
    facts: [`${slsMeta.sources} editions`],
    preview: {
      kind: 'binary',
      answers: ['Not in the Bible', 'In the Bible'],
      // One line from the built pool, word for word, with no citation beside it.
      line: (slsMeta as { cover?: string | null }).cover ?? null
    }
  },
  'who-said-it': {
    ghost: 'quote',
    ink: 'blue',
    run: 10,
    items: wsiMeta.items || 0,
    facts: wsiMeta.speakers ? [`${wsiMeta.speakers} speakers`] : [],
    /*
     * One real line and the four real names under it, both straight out of the built
     * pool's metadata, which never records which of the four spoke. Alphabetical, and
     * none of them marked: the card asks exactly what the first screen of the game asks.
     */
    preview: {
      kind: 'names',
      line: (wsiMeta as { cover?: string | null }).cover ?? null,
      names: (wsiMeta as { coverNames?: string[] | null }).coverNames ?? null
    }
  }
};

/**
 * WHAT A PLAYER IS ABOUT TO MEET, in words, under the cards.
 *
 * Short on purpose (the owner, 2026-09-22: inviting, never a wall of text). Each game gets a
 * question for a title and four points a reader can take in at a glance, each a bold lead-in
 * and one or two plain sentences; then its way in. The words are the owner's, checked against
 * the games themselves: the answer buttons are named as the game names them, "quick, right
 * answers score more" is the game's scoring (a right answer earns more the more of its clock is
 * left), and both games' first screens show the traps and the canon choice named here.
 *
 * `text` may carry an <em> for a button's name; it is set as HTML, and only ever from this file.
 */
type Point = { lead: string; text: string };
type Say = { kicker: string; title: string; points: Point[] };

const SAY: Record<string, Say> = {
  'sounds-like-scripture': {
    kicker: 'Sounds Like Scripture',
    title: 'Is this line in the Bible?',
    points: [
      { lead: 'Call it.', text: 'A line appears. Tap <em>In the Bible</em> or <em>Not in the Bible</em> before the clock runs out.' },
      { lead: 'Ten lines a run.', text: 'A few seconds each, and quick, right answers score more.' },
      { lead: 'No easy fakes.', text: 'The lines that aren’t Scripture come from old books Christians have read for centuries, and old and modern English turn up on both sides.' },
      { lead: 'Your Bible.', text: 'Choose Protestant, Catholic or Orthodox before you start, and the answers follow it.' }
    ]
  },
  'who-said-it': {
    kicker: 'Who Said It?',
    title: 'Which of the four said it?',
    points: [
      { lead: 'Pick the speaker.', text: 'A line of speech from the Bible, four names underneath. Tap the one who said it.' },
      { lead: 'Ten lines a run.', text: 'A few seconds each, and quick, right answers score more.' },
      { lead: 'Close calls on purpose.', text: 'Job’s friends sound like God, and the Pharisees sound like the disciples.' },
      { lead: 'Learn as you go.', text: 'After every answer you see who said it and where to read it.' }
    ]
  }
};

/*
 * The daily round, which both games already have: the "Today's Challenge" button on each start
 * screen draws its ten from the date (UTC), not from chance, and never skips lines a player has
 * seen, so everyone who plays it that day meets the same ten. In Sounds Like Scripture the ten
 * also depend on the Bible chosen, because what counts as Scripture decides the draw, hence the
 * last sentence. No link: the round is reached from each game's own first screen.
 *
 * The streak point is the owner's, kept on his word (2026-09-22) although neither game counts
 * days in a row yet: the day streak is to be built before this page is widely read, and he
 * would rather not come back to rewrite it. When it is built, it must match these words.
 */
const DAILY: Say = {
  kicker: 'Every day',
  title: 'Today’s Challenge',
  points: [
    { lead: 'New every day.', text: 'Both games have a daily round of ten lines, and a fresh one starts each day.' },
    { lead: 'The same ten for everyone.', text: 'Play it on the same day as a friend and compare scores. In Sounds Like Scripture, choose the same Bible.' },
    { lead: 'Keep your streak going.', text: 'Play Today’s Challenge each day and your streak counts up.' }
  ]
};

/* Every live game gets a room, drawn or not: a game whose drawing nobody has made yet still
   belongs on the hub, and the card simply carries its words and its way in. */
const specs = games.map(g => SPEC[g.slug]);
/* The daily panel says "both games", so it is drawn only while both are live. */
const hasDaily = ['sounds-like-scripture', 'who-said-it'].every(slug => games.some(g => g.slug === slug));
/** Counted across the whole shelf, so the band never reports one game's pool as the site's. */
const totalLines = specs.reduce((n, s) => n + (s?.items ?? 0), 0);
const runs = specs.filter(Boolean).map(s => s!.run);
const sameRun = runs.length > 0 && runs.every(r => r === runs[0]);

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Games', url: '/games/' }];

/*
 * The hub was the one page of the four with no page-level markup at all, so it said nothing
 * about what kind of page it is while /quizzes/ and /articles/ both did. A list of the games,
 * in the order they are drawn, built off the same registry the cards are. No rich result comes
 * of it; it makes the page's type explicit and brings it in line with its siblings.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Games',
  url: new URL('/games/', Astro.site).href,
  isPartOf: { '@id': 'https://wiserwalk.com/#website' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: games.length,
    itemListElement: games.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.title,
      url: new URL(g.href, Astro.site).href
    }))
  }
};
---
<Base
  title="Games"
  description="Games played against the clock that count what you know, never how devout you are. Every line and every answer is real and citable."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  {/*
    No accent on the title. Blue means the left pole of an axis everywhere else on the
    site, and a one-word page title painted entirely in it makes the accent mean nothing.
  */}
  <Hero
    title="Games"
    kind="night"
    image="/img/game-manuscript.jpg"
    imageAlt=""
    imagePosition="50% 24%"
    tiles={[
      { n: games.length, label: games.length === 1 ? 'Game' : 'Games' },
      /* "2,168", as each game's own tiles print their counts ("1,261"), never a bare "2168" */
      ...(totalLines ? [{ n: totalLines.toLocaleString('en-US'), label: 'Real lines' }] : []),
      ...(sameRun ? [{ n: runs[0]!, label: 'Lines a run' }] : [])
    ]}
  >
    Short, hard, and honest about their sources. A game here counts what you know, never how
    devout you are, and every line is quoted from a real edition.
    {games[0] && (
      <a slot="actions" class="btn" href={games[0].href}>
        Play {games[0].title} <Icon name="arrow" size={15} />
      </a>
    )}
  </Hero>

  <div class="ghub">
    {games.map((g, i) => {
      const s = SPEC[g.slug];
      return (
        <GameCard
          game={g}
          ghost={s?.ghost}
          ink={s?.ink ?? (i % 2 === 0 ? 'orange' : 'blue')}
          clock={s ? '2 min a run' : undefined}
          facts={s?.facts}
          preview={s?.preview}
        />
      );
    })}
  </div>

  {/*
    The words under the cards: what a player wants to know before tapping Play, as a short list
    per game rather than paragraphs, ending on that game's own way in (a .go-pill in its ink).
    Plain panels, the site's own, so they read as the page explaining itself and not as two more
    cards competing with the two above. The daily round, which both games share, spans the
    width under them.
  */}
  <SectionHead title="How the games work" />
  <div class="gsay">
    {games.map(g => {
      const s = SAY[g.slug];
      const ink = SPEC[g.slug]?.ink ?? 'blue';
      return s ? (
        <section class={`pnl gsay-pnl gsay-pnl--${ink}`}>
          <div class="pnl-head">
            <p class="pnl-kicker">{s.kicker}</p>
            <h3 class="pnl-title">{s.title}</h3>
          </div>
          <ul class="gsay-points">
            {s.points.map(p => <li><b>{p.lead}</b><span set:html={p.text} /></li>)}
          </ul>
          <a class="go-pill gsay-go" href={g.href} aria-label={`Play ${g.title}`}>Play <Icon name="arrow" size={16} /></a>
        </section>
      ) : null;
    })}
    {hasDaily && (
      <section class="pnl gsay-pnl gsay-pnl--daily">
        <div class="pnl-head">
          <p class="pnl-kicker">{DAILY.kicker}</p>
          <h3 class="pnl-title">{DAILY.title}</h3>
        </div>
        <ul class="gsay-points">
          {DAILY.points.map(p => <li><b>{p.lead}</b><span set:html={p.text} /></li>)}
        </ul>
      </section>
    )}
  </div>
</Base>
