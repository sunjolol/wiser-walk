---
/**
 * My results.
 *
 * The owner: finding an old result is impossible today, and that feels bad. It does — a
 * result lives in its URL and nowhere else, so closing the tab loses it. Every finished quiz
 * saves itself on the device, and this page is where they are.
 *
 * What the SERVER renders is the invitation: one room per quiz, every one of them saying
 * "Start". What the BROWSER does is fill in the rooms a reader has actually finished,
 * from the shelf, scored back through the same engine the result page uses. That order
 * matters: with the script blocked, or with storage blocked, or on a brand-new device, the
 * page is still a set of doorways rather than an empty box apologising for itself.
 *
 * An account changes nothing about that order. The device's own shelf is still what paints
 * this page, first and always; the account is asked for what it holds afterwards, and the
 * page is repainted only if it turns out to hold more. A reader who is offline, or signed
 * out, or has never heard of an account, sees exactly what they saw before.
 *
 * Where the account is ASKED for matters as much as what it does. It lives in the band at
 * the top, under the headline, in both states: it was a panel at the foot of a three
 * thousand pixel page, sitting on the footer's own sign-up box, and a phone showed two
 * email fields with two different buttons one above the other. There is one box now, and
 * it is on the first screen.
 *
 * Two switches, asked two different questions. What a SIGNED-IN browser is shown asks only
 * whether there is a project behind the build, so the owner can sign in on the live domain
 * and see his own account working while the public still sees today's page. What a
 * SIGNED-OUT reader is shown — the invitation, the box, the way in — waits for the links
 * to be switched on.
 *
 * Nothing here prints a number against a person. The figure quiz's result carries a name,
 * and a name travels with its own words — the view's headline and summary, verbatim, and
 * nothing else.
 */
import '../styles/pages/me.css';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CompassWheel from '../components/CompassWheel.astro';
import { QUIZZES, getQuiz, quizHref, scoreQuiz, resultFor } from '../lib/engine/registry';
import { groupNounPlural, outcomeNounPlural } from '../lib/engine/types';
import type { BipolarView, Quiz } from '../lib/engine/types';
import { artFor, COLOUR_PRINT } from '../lib/art';
import { SITUATIONS } from '../lib/strategies/reading';
import { liveGames } from '../lib/games';
import { ACCOUNTS_READY, ACCOUNTS_VISIBLE } from '../lib/account/config';
import audit from '../data/compass-audit.json';
import slsMeta from '../games/sounds-like-scripture.meta.json';
import wsiMeta from '../games/who-said-it.meta.json';

/* Finished quizzes first, drafts last, as everywhere else on the site. */
const quizzes = [...QUIZZES].sort(
  (a, b) => Number(a.status === 'draft') - Number(b.status === 'draft')
);

/*
 * The rooms are the same cards the rest of the site offers (the owner, 2026-09-22: the ones
 * here "look totally different"). The Compass is the shared card's twin: the night ground and
 * a real wheel in its corner, the published, audited Eastern Orthodox answer sheet scored by
 * the live engine, exactly as components/CompassCard.astro draws it. It is an example, so it
 * is shown only while the reader has no Compass result of their own: beside a result of
 * theirs it would read as that result (me.css hides it on a finished room).
 */
const compass = getQuiz('theology-compass');
const EXAMPLE = 'Eastern Orthodox';
const exampleSheet = (audit.simulations as Array<Record<string, any>>).find(
  s => s.tradition === EXAMPLE && Array.isArray(s.answers)
);
const example = compass && exampleSheet
  ? (resultFor(compass, scoreQuiz(compass, exampleSheet.answers)) as BipolarView)
  : null;
/* Its one sentence is the shared card's too (CompassCard.astro's default `say`), so the Compass
   is introduced in the same words here as on the home page and /quizzes/. Every other room says
   its quiz's own tagline, as /quizzes/ does. */
const COMPASS_SAY = 'Six questions that divide Christians, and the tradition that sits nearest you.';

/**
 * The counted facts on a room, after the minutes: the Compass says what its shared card says
 * (its statements and its traditions); every other quiz what /quizzes/ says of it. A quiz
 * with outcomes names them (25 figures); a ranking names its categories only when it has a
 * true word for them (19 gifts), because "7 categories" is the engine's vocabulary. The
 * Psalm quiz counts the situations it can name, as /quizzes/ does: it has no statements.
 */
const factsFor = (q: Quiz): string[] =>
  q.slug === compass?.slug
    ? [`${q.items.length} statements`, `${q.outcomes.length} ${outcomeNounPlural(q)}`]
    : [
        q.strategy.shape === 'reading'
          ? `${SITUATIONS.length} situations`
          : q.outcomes.length
            ? `${q.outcomes.length} ${outcomeNounPlural(q)}`
            : q.groupNounPlural
              ? `${q.groups.length} ${groupNounPlural(q)}`
              : `${q.items.length} statements`
      ];

/**
 * Each game's room, as the home page draws it: its ghost glyph in the corner, its ink, its
 * one sentence (the home page's words) and a drawing of one real question out of the built
 * pool (the line, word for word, and the answers a player meets under it; never which one is
 * right). No count of lines: that stays on the game's own page.
 *
 * `best` is what the game already keeps on the device, from its own SPEC: a personal best,
 * written by the game and read here. A game that keeps nothing simply has no key, so its room
 * shows the way in and no score. Signed in, the best of the two — this device's and the
 * account's — is written back both ways, which is the only thing a game puts in an account.
 *
 * A game with no entry here still gets its room, with its own tagline and no drawing.
 */
type GameRoom = {
  best: string;
  ghost: 'ask' | 'quote';
  ink: 'orange' | 'blue';
  say: string;
  preview:
    | { kind: 'binary'; line: string | null; answers: [string, string] }
    | { kind: 'names'; line: string | null; names: string[] };
};
const GAME_ROOM: Record<string, GameRoom> = {
  'sounds-like-scripture': {
    best: 'sls.best',
    ghost: 'ask',
    ink: 'orange',
    say: 'A line appears. Is it in the Bible, or does it only sound like it?',
    preview: {
      kind: 'binary',
      line: (slsMeta as { cover?: string | null }).cover ?? null,
      answers: ['Not in the Bible', 'In the Bible']
    }
  },
  'who-said-it': {
    best: 'wsi.best',
    ghost: 'quote',
    ink: 'blue',
    say: 'A line of speech and four names under it. The wrong name is rarely the odd one out.',
    preview: {
      kind: 'names',
      line: (wsiMeta as { cover?: string | null }).cover ?? null,
      names: (wsiMeta as { coverNames?: string[] | null }).coverNames ?? []
    }
  }
};
const GLYPH = { quote: '“', ask: '?' } as const;
const games = liveGames();
---
<Base
  title={ACCOUNTS_VISIBLE ? 'My profile' : 'My results'}
  description={ACCOUNTS_VISIBLE
    ? 'Every quiz you have finished, and the games you have played.'
    : 'Every quiz you have finished on this device, and the games you have played.'}
  noindex={true}
>
  <section class="me-band">
    <img class="me-band-img" src="/img/sky-rays.jpg" alt="" width="1800" height="1200"
         fetchpriority="high" decoding="async" />
    <div class="me-band-in">
      {/* No chip over the headline (the owner, 2026-09-22): "On this device" and "Saved to your
          account" are both said again lower down, where they mean something. */}
      <h1>My <em>{
        /* "My profile" once the header's way here says so; until then, today's words. Inside
           the expression, so a build with the doors shut prints exactly what it did. */
        ACCOUNTS_VISIBLE ? 'profile.' : 'results.'
      }</em></h1>
      <p class="me-count" id="me-count">Everything you finish here waits for you on this page.</p>{ACCOUNTS_VISIBLE && (
        /*
          Hung off the paragraph above with no whitespace between them, and the same again
          between the two blocks below, because an expression that renders nothing still
          leaves the whitespace on each side of it. With no project behind the build this
          page has to come out of the change exactly as it went in, down to the byte, and
          two blank lines here cost it two spaces.

          The invitation, INSIDE the band, on the first screen of a phone. It was a dark
          panel three thousand pixels down, landing on the footer's own sign-up box, so a
          phone showed two email fields one above the other and the account read as an
          afterthought. It is the first thing this page has to say about itself, so it is
          said where the page starts. Its twin below is what somebody signed in sees, and
          which of the two is on screen is settled before the first paint, from the
          attribute the layout writes in <head>.

          The field, the button and the small print are the account pages' own, so the box
          here and the box on /account/sign-up/ read as one thing rather than two designs
          for one job.
        */
        <div class="me-ask me-ask--out">
          {/*
            "Keep them for good." has nothing to point at on a page that has just said
            "Nothing saved yet", so the longer line is what the server prints and the
            script shortens it once it knows there is something on the shelf.
          */}
          <p class="me-ask-say" data-role="join-head">Keep your results for good, on every device.</p>
          {/*
            A GET to the sign-up page, so the form still does something with the script
            blocked: it lands on the page that asks the same question, with the address it
            was given. With the script running, the submit is handled here and the reader
            never sees that page at all.
          */}
          <form class="me-join" id="me-join" method="get" action="/account/sign-up/">
            <div class="me-join-row">
              <span class="me-join-cell">
                <label class="sr-only" for="me-join-email">Your email address</label>
                <span class="me-join-icon" aria-hidden="true"><Icon name="mail" size={17} /></span>
                <input class="me-join-field" id="me-join-email" type="email" name="email" required
                       autocomplete="email" inputmode="email" placeholder="you@example.com" />
              </span>
              <button class="btn me-join-btn" type="submit">Email me a link</button>
            </div>
          </form>
          {/* Outside the form, and holding its line from the first paint, so an answer
              landing never shunts the small print down the screen. */}
          <p class="me-join-status" id="me-join-status" role="status" aria-live="polite"></p>
          {/* The sign-up page's own sentence, word for word: the same ask says the same thing. */}
          <p class="me-ask-small">
            We will email you a link to set a password, and a note now and then when something
            new is made.
          </p>
          <p class="me-ask-alt">
            Already have an account? <a class="me-ask-go" href="/account/sign-in/">Log in</a>
          </p>
        </div>
      )}{ACCOUNTS_READY && (
        /*
          And what somebody signed in sees, in the same place and the same shell. Gated on
          there being a project and nothing else: a browser with an account behind it gets
          its account whether or not the public can see the way in, which is how the owner
          tests the whole of it on the live domain first.
        */
        <div class="me-ask me-ask--in">
          <p class="me-who"><span data-role="who-pre">Logged in as</span> <span class="me-who-at" data-role="who"></span></p>
          {/* Only ever shown when the account has refused a new result for want of room.
              The quiet type, because it is an explanation of where the newest results are,
              not an alarm. */}
          <p class="me-ask-small" data-role="full" hidden>
            Your account is full. New results are kept on this device only.
          </p>
          <p class="me-synced" data-role="synced">&nbsp;</p>
          <p class="me-ask-alt">
            <a class="me-ask-go" href="/account/">Your account</a>
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="me-rooms" id="me-rooms" aria-label="Quizzes">
    {quizzes.map((quiz, i) => {
      const art = artFor(quiz.slug);
      const href = quizHref(quiz);
      return (
        <article class:list={['mroom', art ? 'mroom--pic' : 'mroom--plain', `mroom--${quiz.slug}`]} data-quiz={quiz.slug} data-href={href}>
          {art && (
            /* The first two rooms are on screen the moment the band is scrolled past, and a
               room whose picture has not arrived is a flat brown box with no quiz in it.
               Those two load with the page; the rest wait until they are near. A picture
               art.ts marks `colour` (the Christian Personality Test's eight paintings) is
               printed as it is, never through the plates' sepia (me.css .mroom > img). */
            <img src={art.src} alt={art.alt} loading={i < 2 ? 'eager' : 'lazy'} decoding="async"
                 width="1000" height="1255"
                 style={`object-position:${art.objectPosition}${art.colour ? `;${COLOUR_PRINT}` : ''}`} />
          )}
          {/* A draft says so once, in the corner, as it does on the home page and /quizzes/. */}
          {quiz.status === 'draft' && <span class="mroom-tab">Draft</span>}
          {quiz.slug === compass?.slug && example && (
            /* Somebody else's result, so it is hidden from a screen reader: read out on this
               page, six axes and their leanings would sound like the reader's own. */
            <div class="mroom-eg" aria-hidden="true"><CompassWheel view={example} /></div>
          )}
          <div class="mroom-body">
            <h2>{quiz.title}</h2>

            {/* Filled in by the script from the shelf, and shown only when there is one. */}
            <div class="mroom-has" data-role="has" hidden>
              <p class="mroom-verdict" data-role="headline"></p>
              <p class="mroom-say" data-role="summary"></p>
              <p class="mroom-when" data-role="when"></p>
              <div class="mroom-acts">
                <a class="mroom-go go-pill" data-role="see" href={href}>See the result <Icon name="arrow" size={16} /></a>
                <a class="mroom-again" href={href}>Take it again</a>
              </div>
              <details class="mroom-past" data-role="past" hidden>
                <summary><span data-role="past-count"></span></summary>
                <ul data-role="past-list"></ul>
              </details>
            </div>

            {/* What a reader who has not taken it sees, and what everyone sees first. */}
            <div class="mroom-none" data-role="none">
              <p class="mroom-say">{quiz.slug === compass?.slug ? COMPASS_SAY : quiz.tagline}</p>
              <ul class="mroom-facts">
                <li><Icon name="clock" size={13} /> {quiz.minutes} min</li>
                {factsFor(quiz).map(f => <li>{f}</li>)}
              </ul>
              <a class="mroom-go go-pill" href={href}>Start <Icon name="arrow" size={16} /></a>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  {games.length > 0 && (
    <section class="me-games" aria-label="Games">
      <h2 class="me-head">games</h2>
      <div class="me-games-row">
        {games.map(game => {
          const room = GAME_ROOM[game.slug];
          return (
            <article class:list={['mgame', `mgame--${room?.ink ?? 'orange'}`]} data-best={room?.best ?? ''}>
              {room && <span class={`corner-ghost corner-ghost--${room.ghost}`} aria-hidden="true">{GLYPH[room.ghost]}</span>}
              <div class="mgame-say">
                {/* The last two words held together, so a narrow column never ends the title
                    on one of them alone ("Sounds Like / Scripture", not "… / Scripture"). */}
                <h3>{game.title.replace(/ (?=\S+$)/, '\u00A0')}</h3>
                {/* The best score is the game's own, read from where the game keeps it, and
                    printed under the name in the game's ink. Until there is one, the room
                    says what the game is and how long a run takes. */}
                <p class="mgame-best" data-role="best" hidden></p>
                <p class="mgame-line">{room?.say ?? game.tagline}</p>
                <ul class="mroom-facts"><li><Icon name="clock" size={13} /> 2 min a run</li></ul>
                <a class="mroom-go go-pill" href={game.href}>Play <Icon name="arrow" size={16} /></a>
              </div>
              {room && (
                <div class="mock" aria-hidden="true">
                  <div class="mock-fuse"><i></i></div>
                  {room.preview.line
                    ? <div class="mock-card mock-card--line"><span class="mock-q">“</span><q>{room.preview.line}</q></div>
                    : <div class="mock-card"><span class="mock-q">“</span><i></i><i></i>{room.preview.kind === 'binary' && <i></i>}</div>}
                  {room.preview.kind === 'binary' ? (
                    <div class="mock-btns"><span>{room.preview.answers[0]}</span><span>{room.preview.answers[1]}</span></div>
                  ) : (
                    <div class="mgame-names">
                      {(room.preview.names.length ? room.preview.names : ['', '', '', '']).map(n => <span>{n}</span>)}
                    </div>
                  )}
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>
  )}

  {!ACCOUNTS_VISIBLE && (
    /*
      Today's panel, unchanged, and still what a signed-out reader gets until the way in is
      switched on. Where there IS a project it takes the --out class as well, so the same
      rule that hides the invitation from somebody signed in hides this from him too: he
      must not be told accounts are on the way while he is using one.
    */
    <section class:list={['dark', 'me-keep', ACCOUNTS_READY && 'me-keep--out']}>
      <h2>Kept on this device.</h2>
      <p>
        These are saved on this device only. Accounts are on the way, so you can keep them for
        good and see them anywhere. Leave your email and we will tell you when.
      </p>
      <a class="me-keep-go go-pill" href="#foot-signup">Leave your email <Icon name="arrow" size={16} /></a>
    </section>
  )}

  <p class="me-clear" hidden id="me-clear-row">
    <button class="me-clear-btn" id="me-clear" type="button">Clear my results from this device</button>
    {/* Clearing the device cannot fail in a way worth saying out loud; clearing an account
        can, and then the button has to be able to say so. So the line exists only where
        there is an account to fail. */}
    {ACCOUNTS_READY && (
      <span class="me-clear-say" id="me-clear-say" role="status" aria-live="polite"></span>
    )}
  </p>

  <script>
    import { getQuiz, resultFor, decodeFor, scoreQuiz, encodeFor } from '../lib/engine/registry';
    import { leadFor } from '../lib/engine/types';
    import { clearShelf, readableResults } from '../lib/shelf';
    // The shorter code a link prints, where a quiz has one (engine/links.ts).
    import { publicCodeSync } from '../lib/engine/links';
    // One tiny pure module: the reader of a 60-byte key. Everything that can actually talk
    // to an account is fetched on demand, below, and only when there is an account to talk
    // to.
    import { readHint } from '../lib/account/session';

    /** When this page and the account last agreed. Written here, read here, nowhere else. */
    const SYNCED_KEY = 'ww.acct.synced';

    if (import.meta.env.DEV) {
      /*
       * Screenshot switch, and only ever in a local dev build: `import.meta.env.DEV` is
       * replaced with false when the site is built and this whole block goes with it.
       * ?seed=1 puts two real finished results on the shelf so the page can be judged as
       * somebody with a history sees it; ?seed=0 takes them off again. The codes are made
       * by the engine itself rather than typed in, so they decode like any other.
       */
      try {
        const seed = new URLSearchParams(location.search).get('seed');
        if (seed === '0') localStorage.removeItem('ww.shelf.v1');
        if (seed === '1') {
          const now = Date.now();
          const rows = [['theology-compass', 0], ['spiritual-gifts', 3 * 86400000]].map(
            ([slug, ago], n) => {
              const quiz = getQuiz(slug);
              const sheet = quiz.items.map((_, i) => [2, -1, 1, -2, 2, 1][(i + n) % 6]);
              return {
                quiz: slug,
                code: encodeFor(quiz, scoreQuiz(quiz, sheet)),
                at: new Date(now - ago).toISOString()
              };
            }
          );
          localStorage.setItem('ww.shelf.v1', JSON.stringify(rows));
        }
        // ?seed=<quiz>:<code> puts that one result on the shelf, to see how a given result reads.
        if (seed && seed.includes(':')) {
          const [slug, code] = seed.split(':');
          localStorage.setItem('ww.shelf.v1', JSON.stringify([
            { quiz: slug, code: code.toUpperCase(), at: new Date().toISOString() }
          ]));
        }
      } catch (e) {}
    }

    const rooms = [...document.querySelectorAll('.mroom')];
    if (rooms.length) {
      const pick = (root, role) => root.querySelector(`[data-role="${role}"]`);
      /*
       * The attribute the layout writes in <head>, and nothing beside it. It is only ever
       * written where there is a project behind the build, so it answers the whole question
       * on its own — and it answers the right one: a browser that is signed in gets its
       * account whether or not the public can see the way in yet.
       */
      const signedIn = () => document.documentElement.dataset.account === 'in';

      /**
       * How many results the account holds, once it has been asked.
       *
       * The device keeps the most recent two hundred and the account keeps the lot, so the
       * two numbers can honestly differ. When they do, the page says so out loud rather than
       * quietly showing the smaller one — the same honesty as the "39 older ones are not
       * listed" line inside a room.
       */
      let serverTotal = 0;

      /** Plain words. A date stamp is a machine's way of saying when. */
      const whenWords = (iso) => {
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return '';
        const now = new Date();
        const day = (x) => new Date(x.getFullYear(), x.getMonth(), x.getDate()).getTime();
        const days = Math.round((day(now) - day(d)) / 86400000);
        if (days <= 0) return 'today';
        if (days === 1) return 'yesterday';
        if (days < 7) return `${days} days ago`;
        const sameYear = d.getFullYear() === now.getFullYear();
        return d.toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          ...(sameYear ? {} : { year: 'numeric' })
        });
      };

      /**
       * The same, with the clock where the day alone would not tell two runs apart. A list
       * of earlier results that reads "today, today, today" is a list of nothing.
       */
      const whenExactly = (iso) => {
        const words = whenWords(iso);
        if (words !== 'today' && words !== 'yesterday') return words;
        const t = new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
        return `${words} at ${t}`;
      };

      const paint = () => {
        const saved = readableResults();
        const byQuiz = new Map();
        saved.forEach(e => {
          if (!byQuiz.has(e.quiz)) byQuiz.set(e.quiz, []);
          byQuiz.get(e.quiz).push(e);
        });

        let taken = 0;
        rooms.forEach(room => {
          const slug = room.dataset.quiz;
          const quiz = getQuiz(slug);
          const runs = (quiz && byQuiz.get(slug)) || [];
          const has = pick(room, 'has');
          const none = pick(room, 'none');
          const latest = runs[0];

          if (!latest) {
            room.classList.remove('is-taken');
            room.style.order = '';
            has.hidden = true;
            none.hidden = false;
            return;
          }

          const values = decodeFor(quiz, latest.code);
          const view = resultFor(quiz, values);
          taken++;

          /*
           * Worked out from the stored code every time, never stored as words, so an old result
           * reads the way the result page reads now. Where the quiz leads with who (the figure
           * quiz), the person is the main line and the axis clauses the smaller one under it.
           */
          const lead = leadFor(quiz, view);
          pick(room, 'headline').textContent = lead ? lead.line : view.headline;
          pick(room, 'summary').textContent = lead ? view.headline : view.summary;
          pick(room, 'when').textContent = `Taken ${whenWords(latest.at)}`;
          pick(room, 'see').setAttribute('href', `/r/${slug}/${publicCodeSync(quiz, latest.code)}/`);

          const past = pick(room, 'past');
          const older = runs.slice(1);
          const SHOWN = 8;
          if (older.length) {
            pick(room, 'past-count').textContent =
              older.length === 1 ? '1 earlier result' : `${older.length} earlier results`;
            const list = pick(room, 'past-list');
            list.textContent = '';
            older.slice(0, SHOWN).forEach(run => {
              const li = document.createElement('li');
              const a = document.createElement('a');
              a.href = `/r/${slug}/${publicCodeSync(quiz, run.code)}/`;
              a.textContent = whenExactly(run.at);
              li.appendChild(a);
              list.appendChild(li);
            });
            // The summary counts every earlier run; the list shows the most recent eight.
            // Saying "39 earlier results" over a list of eight would be the page telling a
            // small lie about itself, so the rest are counted out loud instead.
            if (older.length > SHOWN) {
              const li = document.createElement('li');
              li.className = 'mroom-past-rest';
              li.textContent = `${older.length - SHOWN} older ones are not listed`;
              list.appendChild(li);
            }
            past.hidden = false;
          } else {
            past.hidden = true;
            past.open = false;
          }

          has.hidden = false;
          none.hidden = true;
          room.classList.add('is-taken');
          // What you have done comes before what you have not. Set rather than sorted, so
          // nothing is moved in the document and nothing jumps as the script runs.
          room.style.order = '-1';
        });

        const count = document.getElementById('me-count');
        if (count) {
          count.textContent = taken
            ? `${taken} of ${rooms.length} quizzes taken`
            : 'Nothing saved yet. Take one, and it will be here when you come back.';
        }
        const clearRow = document.getElementById('me-clear-row');
        if (clearRow) clearRow.hidden = !saved.length;
        const clearBtn = document.getElementById('me-clear');
        if (clearBtn) {
          clearBtn.textContent = signedIn()
            ? 'Clear my results everywhere'
            : 'Clear my results from this device';
        }

        // "Keep them for good" wants something to point at, and on a page that has just
        // said "Nothing saved yet" there is nothing. The server prints the longer line and
        // this shortens it once the shelf turns out to hold something.
        const joinHead = document.querySelector('[data-role="join-head"]');
        if (joinHead) {
          joinHead.textContent = saved.length
            ? 'Keep them for good, on every device.'
            : 'Keep your results for good, on every device.';
        }

        // Only when the account genuinely holds more than the shelf can. Saying it when the
        // two agree would be a page talking about itself for no reason.
        const synced = document.querySelector('[data-role="synced"]');
        if (synced && serverTotal > saved.length) {
          synced.textContent =
            `${saved.length} shown here, ${serverTotal} saved to your account.`;
        }
      };

      paint();

      /* ------------------------------------------------------------------ the account -- */

      /* The same three states, and the same say() shape, as the site's two other forms. */
      const sayJoin = (text, kind) => {
        const status = document.getElementById('me-join-status');
        if (!status) return;
        status.textContent = text;
        status.className = 'me-join-status' + (kind ? ` is-${kind}` : '');
      };
      const sayClear = (text, kind) => {
        const status = document.getElementById('me-clear-say');
        if (!status) return;
        status.textContent = text;
        status.className = 'me-clear-say' + (kind ? ` is-${kind}` : '');
      };

      /**
       * Ask the account what it holds, and repaint if it held more.
       *
       * Everything above has already run, so this cannot delay a single thing on the page.
       * A failure says nothing at all: the reader's results are genuinely on the screen in
       * front of them, and an error about syncing would be the page worrying out loud.
       *
       * Results and the three game values the games put in an account are both settled
       * inside syncNow, which owns those rules and is tested against them. This page only
       * asks, and then draws whatever came back.
       */
      const catchUp = async () => {
        const who = document.querySelector('[data-role="who"]');
        const hint = readHint();
        if (who && hint) who.textContent = hint.email;
        // No address to print means no sentence: "Logged in as" on its own is worse than a
        // line that quietly holds its space. The line is reserved either way.
        if (!hint) {
          const pre = document.querySelector('[data-role="who-pre"]');
          if (pre) pre.textContent = '';
        }

        const synced = document.querySelector('[data-role="synced"]');
        // What the last visit managed, so the line holds something while this one is in
        // flight rather than sitting blank and then filling in. It says where the results
        // went, not what the machinery did: nobody reading their own results came here to
        // hear the word synced.
        let before = null;
        try { before = localStorage.getItem(SYNCED_KEY); } catch (e) {}
        if (synced && before && whenExactly(before)) {
          synced.textContent = `Saved to your account ${whenExactly(before)}.`;
        }

        try {
          const { syncNow } = await import('../lib/account/sync');
          const done = await syncNow();

          // The account has told this browser it is not signed in: the account was deleted,
          // or signed out from somewhere else, and sync has dropped the hint. Everything
          // keyed on the attribute goes back to the signed-out page, which is the true one.
          // Only a real refusal gets here; an unreachable server leaves the hint alone.
          if (!readHint()) {
            delete document.documentElement.dataset.account;
            // The mark in the header was lit for the account. What is behind it now is
            // whatever this device holds, which is the rule the layout paints everywhere
            // else; without this it would go on saying there is something until the next
            // page load.
            if (!readableResults().length) {
              document.querySelector('.site-head .nav-me')?.classList.remove('has-saved');
            }
            paint();
            return;
          }

          // Said whether or not the rest of the sync went through: a full account is the
          // one failure a reader can do something about, and it explains why a result they
          // finished on another device is not here.
          if (done && done.full) {
            const full = document.querySelector('[data-role="full"]');
            if (full) full.hidden = false;
          }

          if (done && done.ok) {
            serverTotal = typeof done.serverTotal === 'number' ? done.serverTotal : 0;
            try { localStorage.setItem(SYNCED_KEY, new Date().toISOString()); } catch (e) {}
            // Said before the repaint, because where the account holds more than this device
            // can the repaint has something more useful to put on the same line.
            if (synced) synced.textContent = 'Saved to your account just now.';
            paint();
            // A best score can come down from the account as well as go up to it.
            paintGames();
          }
        } catch (e) {
          /* Offline, or the account is down. The page is already right. */
        }
      };

      if (signedIn()) catchUp();

      const join = document.getElementById('me-join');
      // The answer sits over the small print (see me.css). Touching the field again takes it
      // away, so what the address is for is back in view before anything is sent a second time.
      document.getElementById('me-join-email')?.addEventListener('input', () => sayJoin('', ''));
      join?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const field = document.getElementById('me-join-email');
        const button = join.querySelector('button[type="submit"]');
        const email = (field?.value ?? '').trim();
        if (!email) {
          sayJoin('Enter your email address.', 'bad');
          field?.focus();
          return;
        }
        button.disabled = true;
        sayJoin('Sending…', 'busy');
        let done = { ok: false, say: 'That did not go through. Try again in a moment.' };
        try {
          const { requestLink } = await import('../lib/account/client');
          done = await requestLink(email);
        } catch (e) {}
        if (done.ok) {
          // Handed over in this tab's own storage, which is where the page that prints it
          // back looks for it, and is the same thing the sign-up and forgotten-password
          // pages do. Never in the address: an address in a URL is an address in the
          // browser's history and in a server's log, for nothing.
          try { sessionStorage.setItem('ww.acct.to', email); } catch (e) {}
          window.location.href = '/account/check-email/';
          return;
        }
        button.disabled = false;
        sayJoin(done.say || 'That did not go through. Try again in a moment.', 'bad');
      });

      document.getElementById('me-clear')?.addEventListener('click', async () => {
        const button = document.getElementById('me-clear');
        const everywhere = signedIn();
        const sure = window.confirm(
          everywhere
            ? 'Clear every result, on this device and in your account? This cannot be undone. The links themselves still work if you have them.'
            : 'Clear every result saved on this device? The links themselves still work if you have them.'
        );
        if (!sure) return;

        if (everywhere) {
          /*
           * The account first, and the device only if that worked. The obvious order is the
           * wrong one: clearing here and failing there puts everything back at the next
           * sync, and a reader watching that happen is right to decide the button is broken.
           */
          button.disabled = true;
          sayClear('Clearing…', 'busy');
          let done = { ok: false, say: 'That did not go through. Try again in a moment.' };
          try {
            const { clearEverywhere } = await import('../lib/account/sync');
            done = await clearEverywhere();
          } catch (e) {}
          button.disabled = false;
          if (!done.ok) {
            sayClear(done.say || 'That did not go through. Try again in a moment.', 'bad');
            return;
          }
          serverTotal = 0;
        }

        clearShelf();
        sayClear('', '');
        paint();
        paintGames();
        // The dot in the header is painted once, on load, by an inline script in the layout.
        // Without this it would go on saying there is something here while the page says
        // there is not, until the next page load. Signed in it stays: the account is still
        // behind the mark, and the next load would light it again anyway.
        if (!everywhere) {
          document.querySelector('.site-head .nav-me')?.classList.remove('has-saved');
        }
      });

      /* A game writes its own best score; this only reads it. */
      function paintGames() {
        document.querySelectorAll('.mgame').forEach(card => {
          const key = card.dataset.best;
          if (!key) return;
          let best = null;
          try { best = JSON.parse(localStorage.getItem(key)); } catch (e) {}
          const line = card.querySelector('[data-role="best"]');
          if (typeof best !== 'number' || !Number.isFinite(best) || best <= 0) {
            line.hidden = true;
            return;
          }
          line.textContent = `Your best: ${best.toLocaleString()}`;
          line.hidden = false;
        });
      }
      paintGames();

      if (import.meta.env.DEV) {
        /*
         * The other screenshot switches, and out of every built page with the block above:
         * the three things the ask can say that only a network can normally produce. They
         * are here so the reserved line, the busy button and the two longest sentences the
         * band ever prints can be looked at rather than guessed at.
         */
        const state = new URLSearchParams(location.search).get('state');
        const button = document.querySelector('#me-join button[type="submit"]');
        if (state === 'busy' && button) { button.disabled = true; sayJoin('Sending…', 'busy'); }
        if (state === 'error') {
          sayJoin('Give it a minute before asking again. If an email was sent, it is in your inbox by now.', 'bad');
        }
        if (state === 'full') {
          const full = document.querySelector('[data-role="full"]');
          if (full) full.hidden = false;
          const synced = document.querySelector('[data-role="synced"]');
          if (synced) synced.textContent = '2 shown here, 214 saved to your account.';
        }
      }
    }
  </script>
</Base>
