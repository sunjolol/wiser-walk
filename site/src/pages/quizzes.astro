---
/**
 * The quiz hub, recomposed for the dawn pass (2026-09-21).
 *
 * What stood here: an index of four stripe cards, and then the same four quizzes AGAIN as
 * feature blocks, each with a paragraph of description and a dotted spec list. Four screens
 * of a phone, the same thing said twice, and nothing to look at. That is the page the owner
 * meant by templated, over-explained, "a soup of dullness".
 *
 * So the hub is now what the home page calls a room, at full size: ONE block per quiz, each
 * with its own picture, its own ink and its own mark, the lot inside about two phone screens.
 * The Compass keeps the instrument treatment — the dark starry ground and its real wheel,
 * scored by the live engine from a published audited answer sheet — and every other quiz
 * wears the Doré plate that `lib/art.ts` already pairs with it, so a reader who met a quiz on
 * the home page meets the same face here.
 *
 * Rules this page keeps: every number is counted from the registry, never typed; no quiz is
 * harder to find than another, so a draft gets the same block and only a small tab to say so;
 * and nothing here explains an audit, a draft or how the site is made.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import CompassWheel from '../components/CompassWheel.astro';
import { QUIZZES, getQuiz, scoreQuiz, resultFor, quizHref } from '../lib/engine/registry';
import { groupNounPlural, outcomeNounPlural } from '../lib/engine/types';
import type { Quiz, BipolarView } from '../lib/engine/types';
import type { IconName } from '../lib/icons';
import { artFor } from '../lib/art';
import audit from '../data/compass-audit.json';

const compass = getQuiz('theology-compass')!;
/** The Compass first, then registry order; published first, drafts after. */
const ordered = [compass, ...QUIZZES.filter(q => q.slug !== compass.slug)];
const live = ordered.filter(q => q.status === 'live');
const drafts = ordered.filter(q => q.status === 'draft');
const shelf = [...live, ...drafts];
const rest = shelf.filter(q => q.slug !== compass.slug);
/* Counted per shelf, not in one lump: a tile reading "32 statements" beside "1 published"
   counts a draft's statements into the published quizzes. */
const liveStatements = live.reduce((n, q) => n + q.items.length, 0);
const figureQuiz = getQuiz('bible-figure');
const giftsQuiz = getQuiz('spiritual-gifts');

/**
 * The wheel is a REAL result: a published, audited answer sheet scored by the live engine.
 *
 * Deliberately NOT the sheet the home page draws. A reader who has just scrolled past the
 * Eastern Orthodox compass learns nothing from meeting it again, and two different published
 * sheets show at a glance that the instrument gives different shapes to different people.
 */
const EXAMPLE = 'Reformed Baptist (1689)';
const sheet = (audit.simulations as Array<Record<string, any>>).find(
  s => s.tradition === EXAMPLE && Array.isArray(s.answers)
);
const exampleView = sheet ? (resultFor(compass, scoreQuiz(compass, sheet.answers)) as BipolarView) : null;

/** Small numbers read as words, the way the quizzes' own taglines write them. */
const WORDS = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'
];
const word = (n: number) => WORDS[n] ?? String(n);

/**
 * The second fact on a room, after the minutes: what you come away with.
 *
 * Read off the quiz, so a new quiz brings its own. A quiz with outcomes names them (18
 * traditions, 25 figures); a ranking names its categories only when it has a true word for
 * them (19 gifts), because "7 categories" is the engine's vocabulary on a reader's page.
 */
const countFact = (q: Quiz): string =>
  q.outcomes.length
    ? `${q.outcomes.length} ${outcomeNounPlural(q)}`
    : q.groupNounPlural
      ? `${q.groups.length} ${groupNounPlural(q)}`
      : `${q.items.length} statements`;

/**
 * A mark and an ink per quiz, so no two rooms read alike.
 *
 * The quiz data's own `icon` is what a small stripe card needs and two quizzes share
 * 'scroll' there, which on a page of four large rooms would be two boxes you have to read to
 * tell apart. The inks are the home page's, kept the same on purpose: one quiz, one face.
 */
const MARK: Record<string, IconName> = {
  'bible-figure': 'users',
  'spiritual-gifts': 'sparkle',
  'seven-deadly-sins': 'apple'
};
const INK: Record<string, string> = {
  'bible-figure': '#EADFCB',
  'spiritual-gifts': '#FFC98F',
  'seven-deadly-sins': '#F2A596'
};
const markFor = (q: Quiz): IconName => MARK[q.slug] ?? q.icon;

const roomStyle = (q: Quiz) => {
  const art = artFor(q.slug);
  return [
    `--room-ink:${INK[q.slug] ?? 'var(--blue-soft)'}`,
    art?.lift ? `--img-lift:${art.lift}` : '',
    /* art.ts sets a lift under 1 on exactly the plates whose printing is unusually light —
       Doré's Thessalonians is mostly white wall — and white type cannot be read on those
       without more shade. So the same fact that dims the plate also deepens its scrim. */
    art?.lift && art.lift < 1 ? '--room-dim:.38' : '',
    art ? `--img-pos:${art.objectPosition}` : ''
  ].filter(Boolean).join(';');
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Quizzes',
  url: new URL('/quizzes/', Astro.site).href,
  /* Live quizzes only. A draft is noindex, so listing it here would offer search engines a
     page we have asked them not to keep. */
  hasPart: live.map(q => ({
    '@type': 'Quiz',
    name: q.title,
    url: new URL(`/q/${q.slug}/`, Astro.site).href
  }))
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quizzes', url: '/quizzes/' }
];
---
<Base
  title="Quizzes"
  description="Self-assessments for Christians who would rather see themselves clearly than comfortably."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="See where you actually stand."
    blue="actually"
    eyebrow="Self-assessments"
    icon="compass"
    kind="photo"
    image="/img/sky-rays.jpg"
    imagePosition="72% 30%"
    tiles={[
      /* "Published" and "in draft", never a bare count of both: /about/ counts the audited
         quiz alone, and two pages that disagree about how many quizzes exist is the kind of
         thing a reader screenshots. The draft tile goes when the last draft does, rather
         than sitting on the page reading zero. */
      /* What a reader gets, not how the shelf is managed: "published" and "in draft" are
         the site's housekeeping, and a draft already says so on its own room. */
      { n: ordered.length, label: 'Quizzes' },
      { n: compass.outcomes.length, label: 'Traditions' },
      ...(figureQuiz ? [{ n: figureQuiz.outcomes.length, label: 'Figures' }] : []),
      ...(giftsQuiz ? [{ n: giftsQuiz.groups.length, label: 'Gifts' }] : [])
    ]}
  >
    Self-assessments for Christians who would rather see themselves clearly than
    comfortably.
    {/* The flagship, in the band: a reader who already knows what they came for should not
        have to scroll for the way in. */}
    <a slot="actions" class="btn" href={quizHref(compass)}>
      Take the {compass.title} <Icon name="arrow" size={15} />
    </a>
  </Hero>

  <div class="qhub-head">
    <p class="qhub-kicker">{word(QUIZZES.length)} in all</p>
    <h2 class="qhub-title">every quiz</h2>
  </div>

  {/* The flagship: an instrument on a night ground, drawn from a real answer sheet. */}
  <a class="qroom qroom--flag dark" href={quizHref(compass)}>
    <div class="qroom-wheel">
      {exampleView && <CompassWheel view={exampleView} />}
      {exampleView && <p class="qroom-note">A real result: the published {EXAMPLE} answer sheet.</p>}
    </div>
    <div class="qroom-body">
      <span class="qroom-mark"><Icon name="compass" size={20} /></span>
      <p class="qroom-kicker">The flagship</p>
      <h3>{compass.title}</h3>
      <p class="qroom-say">{compass.tagline}</p>
      <ul class="qroom-facts">
        <li><Icon name="clock" size={13} /> {compass.minutes} min</li>
        <li>{compass.items.length} statements</li>
        <li>{countFact(compass)}</li>
      </ul>
      <span class="qroom-go">Start <Icon name="arrow" size={14} /></span>
    </div>
  </a>

  {/* Every other quiz, one room each, in its own plate and its own ink. */}
  <div class="qhub-rooms">
    {rest.map(q => {
      const art = artFor(q.slug);
      return (
        <a class:list={['qroom', art ? 'qroom--pic' : 'qroom--night']} href={quizHref(q)} style={roomStyle(q)}>
          {art && (
            <img src={art.src} alt={art.alt} loading="lazy" decoding="async" width="820" height="1029" />
          )}
          {q.status === 'draft' && <span class="qroom-tab">Draft</span>}
          <div class="qroom-body">
            <span class="qroom-mark"><Icon name={markFor(q)} size={20} /></span>
            <h3>{q.title}</h3>
            <p class="qroom-say">{q.tagline}</p>
            <ul class="qroom-facts">
              <li><Icon name="clock" size={13} /> {q.minutes} min</li>
              <li>{countFact(q)}</li>
            </ul>
            <span class="qroom-go">Take it <Icon name="arrow" size={14} /></span>
          </div>
        </a>
      );
    })}
  </div>
</Base>
