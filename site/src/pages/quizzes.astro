---
/**
 * The quiz hub.
 *
 * The rule this page is built on: no quiz is harder to find than another. So it opens with
 * an index of EVERY quiz, one equal card each, close enough to the top that a phone reader
 * meets all of them before the flagship's feature block; then it gives each quiz that same
 * feature block, in the same size, with a draft marked as a draft and nothing else changed.
 * A quiz that leaves draft status therefore takes the Compass's prominence — the block, the
 * index card, the search listing — by one field changing in its data file, and no edit here.
 *
 * Every number on this page is counted from the registry at build time. The one exception is
 * REVIEWED below, and it is a deliberate one.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import QuizFeature from '../components/QuizFeature.astro';
import QuizIndexCard from '../components/QuizIndexCard.astro';
import Icon from '../components/Icon.astro';
import { QUIZZES, getQuiz, quizHref } from '../lib/engine/registry';
import { outcomeNounPlural } from '../lib/engine/types';
import type { Quiz } from '../lib/engine/types';

const compass = getQuiz('theology-compass')!;
/** The Compass first, then registry order — on the index and in the feature blocks alike. */
const ordered = [compass, ...QUIZZES.filter(q => q.slug !== compass.slug)];
const live = ordered.filter(q => q.status === 'live');
const drafts = ordered.filter(q => q.status === 'draft');
/* Counted per shelf, not in one lump: a tile reading "32 statements" beside "1 published"
   counts a draft's statements into the published quiz. */
const liveStatements = live.reduce((n, q) => n + q.items.length, 0);
const draftStatements = drafts.reduce((n, q) => n + q.items.length, 0);

/**
 * An audit is not in the quiz data, so a quiz claims one only by being named here, by hand.
 * This is the one line on the page that is typed rather than counted, and it stays that way
 * on purpose: a draft must not inherit a sentence about twenty reviewers by being added to
 * an array. When another quiz passes the same audit, add it here in the same breath.
 */
const REVIEWED: Record<string, string> = { 'theology-compass': '20 adversarial reviewers' };

/** Small numbers read as words, the way the quizzes' own taglines write them. */
const WORDS = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
  'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen',
  'nineteen', 'twenty'
];
const word = (n: number) => WORDS[n] ?? String(n);

const bipolar = (q: Quiz) => q.strategy.shape === 'bipolar';
/** What a quiz's groups are called wherever the page has to name them in the plural. */
const groupNoun = (q: Quiz) => (bipolar(q) ? 'axes' : 'categories');
/** The small-caps line over a feature block's title: what shape the instrument is. */
/* Short enough to sit on one line beside a draft's chip at 360px: a kicker that wraps
   leaves one tracked uppercase word stranded under the chip. */
const kicker = (q: Quiz) =>
  bipolar(q)
    ? `${word(q.groups.length)} axes · both ends named`
    : `${word(q.groups.length)} categories · ranked`;
/**
 * The index card's line of facts, and the rotated tag on its stripe. Between them each
 * card carries its length, its size and its shape, and carries none of them twice: the tag
 * takes the minutes because a rotated tag has room for a word and a half, and a quiz whose
 * groups are called categories would run off the bottom of the stripe.
 */
const facts = (q: Quiz) => `${q.items.length} statements · ${q.groups.length} ${groupNoun(q)}`;
const tag = (q: Quiz) => `${q.minutes} min`;

/**
 * The spec rows beside a quiz. Bipolar quizzes are matched against a list of outcomes and
 * say how long it is; a unipolar quiz has none — it ranks a reader's own categories — so it
 * says what it names instead, rather than printing "0 traditions" from an empty array.
 */
const specs = (q: Quiz) => [
  { dt: 'Takes', dd: `about ${q.minutes} minutes` },
  { dt: 'Statements', dd: `${q.items.length}, across ${q.groups.length} ${groupNoun(q)}` },
  q.outcomes.length
    ? { dt: 'Compares you with', dd: `${q.outcomes.length} ${outcomeNounPlural(q)}` }
    : { dt: 'Names', dd: `the strongest of ${word(q.groups.length)}, in words` },
  // The site's standing rule, printed where a reader decides whether to take the thing.
  ...(q.hideOutcomeScore ? [{ dt: 'Never shown', dd: 'a number against a person' }] : []),
  ...(REVIEWED[q.slug] ? [{ dt: 'Reviewed by', dd: REVIEWED[q.slug]! }] : [])
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Quizzes',
  url: new URL('/quizzes/', Astro.site).href,
  /* Live quizzes only. A draft is noindex, so listing it here would offer search engines a
     page we have asked them not to keep. */
  hasPart: live.map(q => ({
    '@type': 'Quiz',
    name: q.title,
    url: new URL(`/q/${q.slug}/`, Astro.site).href
  }))
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quizzes', url: '/quizzes/' }
];
---
<Base
  title="Quizzes"
  description="Self-assessments for Christians who would rather see themselves clearly than comfortably. Scored in your browser; nothing is stored."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="See where you actually stand."
    blue="actually"
    ghost="quizzes"
    eyebrow="Self-assessments"
    icon="compass"
    tiles={[
      /* "Published" and "in draft", never a bare count of both: /about/ counts the audited
         quiz alone, and two pages that disagree about how many quizzes exist is the kind of
         thing a reader screenshots. The draft tile goes when the last draft does, rather
         than sitting on the page reading zero. */
      { n: live.length, label: 'Published' },
      { n: liveStatements, label: 'Statements' },
      { n: compass.outcomes.length, label: 'Traditions' },
      ...(drafts.length ? [{ n: drafts.length, label: 'In draft' }] : [])
    ]}
  >
    Self-assessments for Christians who would rather see themselves clearly than
    comfortably. Each one is scored entirely in your browser.
  </Hero>

  {/*
    The index, first thing under the band.
    Every quiz on the site, one card each, the same size, in one screen and a half of a
    phone — so that nobody has to scroll past the flagship to learn what else is here.
  */}
  <div class="sect qz-indexhead">
    <div class="sect-text">
      <p class="sect-kicker">
        {word(QUIZZES.length)} in all{drafts.length ? ', drafts included' : ''}
      </p>
      <h2 class="sect-title">Every quiz</h2>
    </div>
  </div>

  <div class="qz-index">
    {ordered.map(q => (
      <QuizIndexCard
        href={quizHref(q)}
        icon={q.icon}
        title={q.title}
        text={q.tagline}
        meta={tag(q)}
        tab={q.status === 'draft' ? 'Draft' : 'Quiz'}
        facts={facts(q)}
      />
    ))}
  </div>

  {/*
    Then the same feature block for each quiz, published first. The head says "the flagship"
    only while there is one published quiz to be the flagship of.
  */}
  <SectionHead
    title={live.length > 1 ? 'Published' : 'The flagship'}
    kicker="Audited before it was published"
    href="/method/"
    more="The method"
  />

  {live.map(q => (
    <QuizFeature quiz={q} kicker={kicker(q)} spec={specs(q)} href={quizHref(q)}>
      {/* The Compass is the only quiz with an audit to show, so it is the only one with the
          button that shows it. */}
      {q.slug === compass.slug && (
        <a slot="more" class="btn ghost" href="/method/">How it was made fair</a>
      )}
    </QuizFeature>
  ))}

  {drafts.length > 0 && (
    <>
      <SectionHead title="In draft" kicker="Written, not yet audited" id="in-draft" />

      {/* The warning, once, above the blocks it applies to, in the words it has always had. */}
      <aside class="qz-draftbox qz-draftnote">
        <div class="qz-draftnote-text">
          <p class="feature-kicker"><Icon name="flame" size={13} /> What draft means here</p>
          <p>
            Written but not yet through the fairness audit. You can take them; treat the
            results as a conversation starter rather than a verdict.
          </p>
        </div>
        <dl class="spec">
          <div><dt>Audited</dt><dd>Not yet</dd></div>
          {/* A count, and nothing about review: two of these drafts have had five adversarial
              reviews each, which "written and unreviewed" made into a false line. What each
              one has been through is on its own page, in its own words. */}
          <div><dt>Statements</dt><dd>{draftStatements}, across {word(drafts.length)} drafts</dd></div>
          <div><dt>In search</dt><dd>Not listed</dd></div>
          <div><dt>Your result</dt><dd>Scored and shareable as usual</dd></div>
        </dl>
      </aside>

      {drafts.map(q => (
        <QuizFeature quiz={q} kicker={kicker(q)} spec={specs(q)} href={quizHref(q)} />
      ))}
    </>
  )}

  <section class="dark pledge qz-pledge">
    <div class="dark-ghost" aria-hidden="true">yours</div>
    <div class="qz-pledge-text">
      <p class="feature-kicker"><Icon name="scroll" size={13} /> What happens to your answers</p>
      <h2>Nothing you answer leaves your browser.</h2>
      <p>
        No account, no email, nothing stored — a result link carries your scores and nothing
        else, which is also why you have to keep the link if you want the result.
      </p>
    </div>
    <dl class="spec">
      <div><dt>Scored</dt><dd>On your own device</dd></div>
      <div><dt>Stored</dt><dd>Nothing, at either end</dd></div>
      <div><dt>Result link</dt><dd>Your scores, nothing else</dd></div>
    </dl>
    <div class="btn-row"><a class="btn" href="/method/#your-answers">What is kept</a></div>
  </section>
</Base>
