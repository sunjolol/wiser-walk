---
/**
 * The quiz hub.
 *
 * The rule this page is built on: no quiz is harder to find than another. So it opens with
 * an index of EVERY quiz, one equal card each, close enough to the top that a phone reader
 * meets all of them before the flagship's feature block; then it gives each quiz that same
 * feature block, in the same size, with a draft marked as a draft and nothing else changed.
 * A quiz that leaves draft status therefore takes the Compass's prominence — the block, the
 * index card, the search listing — by one field changing in its data file, and no edit here.
 *
 * Every number on this page is counted from the registry at build time. The one exception is
 * REVIEWED below, and it is a deliberate one.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import QuizFeature from '../components/QuizFeature.astro';
import QuizIndexCard from '../components/QuizIndexCard.astro';
import { QUIZZES, getQuiz, quizHref } from '../lib/engine/registry';
import { groupNounPlural, outcomeNoun } from '../lib/engine/types';
import type { Quiz } from '../lib/engine/types';

const compass = getQuiz('theology-compass')!;
/** The Compass first, then registry order — on the index and in the feature blocks alike. */
const ordered = [compass, ...QUIZZES.filter(q => q.slug !== compass.slug)];
const live = ordered.filter(q => q.status === 'live');
const drafts = ordered.filter(q => q.status === 'draft');
/* Published first, drafts after, in one list: one head covers the lot and a draft is marked
   on its own card and its own block, which is all a reader needs to know about it here. */
const shelf = [...live, ...drafts];
/* Counted per shelf, not in one lump: a tile reading "32 statements" beside "1 published"
   counts a draft's statements into the published quiz. */
const liveStatements = live.reduce((n, q) => n + q.items.length, 0);

/** Small numbers read as words, the way the quizzes' own taglines write them. */
const WORDS = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
  'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen',
  'nineteen', 'twenty'
];
const word = (n: number) => WORDS[n] ?? String(n);

const bipolar = (q: Quiz) => q.strategy.shape === 'bipolar';
/**
 * What a quiz's groups are called wherever the page has to name them in the plural.
 *
 * A bipolar quiz's are axes. A unipolar quiz's are "categories" unless it has a truer word
 * of its own: the gifts draft's nineteen are gifts, and "19 categories" on its card is the
 * engine's vocabulary leaking onto a reader's page.
 */
const groupWord = (q: Quiz) => (bipolar(q) ? 'axes' : groupNounPlural(q));
/** The small-caps line over a feature block's title: what shape the instrument is. */
/* Short enough to sit on one line beside a draft's chip at 360px: a kicker that wraps
   leaves one tracked uppercase word stranded under the chip. */
const kicker = (q: Quiz) =>
  bipolar(q)
    ? `${word(q.groups.length)} axes · both ends named`
    : `${word(q.groups.length)} ${groupNounPlural(q)} · ranked`;
/**
 * The index card's line of facts, and the rotated tag on its stripe. Between them each
 * card carries its length, its size and its shape, and carries none of them twice: the tag
 * takes the minutes because a rotated tag has room for a word and a half, and a quiz whose
 * groups are called categories would run off the bottom of the stripe.
 */
const facts = (q: Quiz) => `${q.items.length} statements · ${q.groups.length} ${groupWord(q)}`;
const tag = (q: Quiz) => `${q.minutes} min`;

/**
 * Three rows: how long it takes, how big it is, and what you come away with. All three are
 * read off the quiz, so a new quiz brings its own and nothing here is typed per quiz. The
 * last row is the one a reader is actually deciding on, and it is the same sentence for
 * every quiz of a shape: a bipolar quiz names the nearest of its outcomes, a ranking names
 * the reader's strongest.
 */
const specs = (q: Quiz) => [
  { dt: 'Takes', dd: `about ${q.minutes} minutes` },
  { dt: 'Statements', dd: `${q.items.length}, across ${q.groups.length} ${groupWord(q)}` },
  {
    dt: 'You get',
    dd: q.outcomes.length
      ? `the ${outcomeNoun(q)} nearest you, of ${q.outcomes.length}`
      : `your strongest ${groupNounPlural(q)}, ranked`
  }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Quizzes',
  url: new URL('/quizzes/', Astro.site).href,
  /* Live quizzes only. A draft is noindex, so listing it here would offer search engines a
     page we have asked them not to keep. */
  hasPart: live.map(q => ({
    '@type': 'Quiz',
    name: q.title,
    url: new URL(`/q/${q.slug}/`, Astro.site).href
  }))
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quizzes', url: '/quizzes/' }
];
---
<Base
  title="Quizzes"
  description="Self-assessments for Christians who would rather see themselves clearly than comfortably."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="See where you actually stand."
    blue="actually"
    ghost="quizzes"
    eyebrow="Self-assessments"
    icon="compass"
    tiles={[
      /* "Published" and "in draft", never a bare count of both: /about/ counts the audited
         quiz alone, and two pages that disagree about how many quizzes exist is the kind of
         thing a reader screenshots. The draft tile goes when the last draft does, rather
         than sitting on the page reading zero. */
      { n: live.length, label: 'Published' },
      { n: liveStatements, label: 'Statements' },
      { n: compass.outcomes.length, label: 'Traditions' },
      ...(drafts.length ? [{ n: drafts.length, label: 'In draft' }] : [])
    ]}
  >
    Self-assessments for Christians who would rather see themselves clearly than
    comfortably.
  </Hero>

  {/*
    The index, first thing under the band.
    Every quiz on the site, one card each, the same size, in one screen and a half of a
    phone — so that nobody has to scroll past the flagship to learn what else is here.
  */}
  <div class="sect qz-indexhead">
    <div class="sect-text">
      <p class="sect-kicker">
        {word(QUIZZES.length)} in all{drafts.length ? ', drafts included' : ''}
      </p>
      <h2 class="sect-title">Every quiz</h2>
    </div>
  </div>

  <div class="qz-index">
    {shelf.map(q => (
      <QuizIndexCard
        href={quizHref(q)}
        icon={q.icon}
        title={q.title}
        text={q.tagline}
        meta={tag(q)}
        tab={q.status === 'draft' ? 'Draft' : 'Quiz'}
        facts={facts(q)}
      />
    ))}
  </div>

  {/*
    Then the same feature block for each quiz, published first and a draft after. One head
    over the lot: a draft carries its own chip on its own block, which says everything the
    two heads and the panel of explanation between them used to say at length.
  */}
  <SectionHead title="What each one asks" kicker="One block each" />

  {shelf.map(q => (
    <QuizFeature quiz={q} kicker={kicker(q)} spec={specs(q)} href={quizHref(q)} />
  ))}
</Base>
