---
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { QUIZZES } from '../lib/engine/registry';

const live = QUIZZES.filter(q => q.status === 'live');
const drafts = QUIZZES.filter(q => q.status === 'draft');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Quizzes',
  url: new URL('/quizzes/', Astro.site).href,
  hasPart: live.map(q => ({
    '@type': 'Quiz',
    name: q.title,
    url: new URL(`/q/${q.slug}/`, Astro.site).href
  }))
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quizzes', url: '/quizzes/' }
];
---
<Base
  title="Quizzes"
  description="Self-assessments for Christians who would rather see themselves clearly than comfortably. Scored in your browser; nothing is stored."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero title="Quizzes" eyebrow="Self-assessments" icon="compass">
      Each one is scored entirely in your browser. No account, no email, nothing stored —
      a result link carries your scores and nothing else.
  </Hero>

  <div class="cards">
    {live.map(q => (
      <Card href={`/q/${q.slug}/`} icon={q.icon} title={q.title} text={q.tagline} meta={`${q.items.length} statements · about ${q.minutes} minutes`} />
    ))}
  </div>

  {drafts.length > 0 && (
    <>
      <h2>In draft</h2>
      <p class="tags">
        Written but not yet through the fairness audit. You can take them; treat the
        results as a conversation starter rather than a verdict.
      </p>
      <div class="cards">
        {drafts.map(q => (
          <Card href={`/q/${q.slug}/`} icon={q.icon} title={q.title} text={q.tagline} meta={`${q.items.length} statements · unaudited draft`} />
        ))}
      </div>
    </>
  )}
</Base>
