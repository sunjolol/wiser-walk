---
/**
 * One saint or early Christian: /saints/<slug>/. The page itself is components/PersonPage.astro
 * (the owner's rules for every saint page are written there); this route adds the search listing,
 * the structured data and the breadcrumbs.
 */
import Base from '../../layouts/Base.astro';
import PersonPage from '../../components/PersonPage.astro';
import { SAINTS } from '../../lib/saints/data';
import { plain } from '../../lib/saints/rich';
import type { SaintPage } from '../../lib/saints/types';

export function getStaticPaths() {
  return Object.values(SAINTS).map(p => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const p: SaintPage = SAINTS[(Astro.props as { slug: string }).slug]!;
/* ---- search and structured data */
const url = new URL(`/saints/${p.slug}/`, Astro.site).href;
const LICENSE: Record<string, string> = {
  CC0: 'https://creativecommons.org/publicdomain/zero/1.0/',
  'Public domain': 'https://creativecommons.org/publicdomain/mark/1.0/',
  'CC BY-SA 2.0': 'https://creativecommons.org/licenses/by-sa/2.0/'
};
const pic = p.band.picture;
const imageLd = {
  '@type': 'ImageObject',
  contentUrl: new URL(pic.src, Astro.site).href,
  width: pic.width, height: pic.height,
  ...(LICENSE[pic.license] ? { license: LICENSE[pic.license] } : {}),
  ...(pic.creator ? { creator: { '@type': 'Person', name: pic.creator } } : {}),
  ...(pic.credit ? { creditText: pic.credit } : {})
};
const org = { '@type': 'Organization', name: 'Wiser Walk', url: new URL('/', Astro.site).href };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: p.seo.title,
  description: p.seo.description,
  url,
  mainEntityOfPage: url,
  datePublished: p.published,
  dateModified: p.modified,
  image: imageLd,
  author: org,
  publisher: org,
  about: {
    '@type': 'Person',
    name: p.name,
    ...(p.person.alternateName?.length ? { alternateName: p.person.alternateName } : {}),
    ...(p.person.birthPlace ? { birthPlace: p.person.birthPlace } : {}),
    ...(p.person.deathPlace ? { deathPlace: p.person.deathPlace } : {}),
    description: plain(p.who),
    image: imageLd.contentUrl,
    sameAs: p.person.sameAs
  },
  isPartOf: { '@type': 'CollectionPage', name: 'Saints and early Christians', url: new URL('/saints/', Astro.site).href }
};
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Saints and early Christians', url: '/saints/' },
  { name: p.name, url: `/saints/${p.slug}/` }
];---
<Base title={p.seo.title} description={p.seo.description} jsonLd={jsonLd} breadcrumbs={breadcrumbs} ogType="article">
  <PersonPage p={p} crumb={{ href: '/saints/', label: 'Saints and early Christians' }} />
</Base>
