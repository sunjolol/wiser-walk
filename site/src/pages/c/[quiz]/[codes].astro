---
/**
 * Two results on one page.
 *
 * Rendered on demand from the two codes in the URL, exactly as a single result is, and for
 * the same reason: any valid pair has a permanent page and nothing is stored on our side.
 *
 * What this page is NOT allowed to do, in order of how badly it would go wrong:
 *
 * 1. **No percentage, score or "match" between two people.** The instrument measures where
 *    someone sits between two named poles. It has no opinion about two people at all, and
 *    inventing one is the same class of error as naming a position the quiz does not name.
 * 2. **Never the word "agree".** Two readers in one band have landed in the same band; they
 *    have not agreed about anything, and the quiz has not asked them to.
 * 3. **Never suggest one should move toward the other.** Both poles are described in words
 *    their holders would accept; a page that nudged would forfeit that in one sentence.
 * 4. **No name, initial or label in the URL**, and no tradition named for the pair. The two
 *    codes carry scores and nothing else.
 */
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Hero from '../../../components/Hero.astro';
import SectionHead from '../../../components/SectionHead.astro';
import RailOverlay from '../../../components/RailOverlay.astro';
import CategoryStack from '../../../components/CategoryStack.astro';
import NextUp from '../../../components/NextUp.astro';
import {
  QUIZZES, getQuiz, parseCodes, compare, resultHref, groupHref, inviteHref, CODE_SEPARATOR, MAX_CODES
} from '../../../lib/engine/registry';
import { groupNounPlural } from '../../../lib/engine/types';
import { linkCodeFor, resolveCode } from '../../../lib/engine/links';
import { readEnv } from '../../../lib/email/env';
import { firstSentence } from '../../../lib/prose';
import { artFor } from '../../../lib/art';
import { liveGames } from '../../../lib/games';

export const prerender = false;

const quiz = getQuiz(Astro.params.quiz);
/*
 * Each half may be a canonical code, a shorter public one or a six-character short link,
 * and the two may differ (engine/links.ts). Each is turned into its canonical code first,
 * and the pair then goes through the same guard as ever. Either half failing fails the page.
 */
const parts = String(Astro.params.codes ?? '').split(CODE_SEPARATOR);
const env = readEnv(Astro.locals);
const canon = quiz && parts.length === MAX_CODES
  ? await Promise.all(parts.map(p => resolveCode(quiz, p, env)))
  : null;
const sheets = quiz && canon?.every(Boolean) ? parseCodes(quiz, canon.join(CODE_SEPARATOR)) : null;

if (quiz && sheets) Astro.response.headers.set('cache-control', 'public, max-age=600');
else Astro.response.status = 404;

const cmp = quiz && sheets ? compare(quiz, sheets[0]!, sheets[1]!) : null;

// Re-encoded from the decoded scores, so these are the canonical codes whatever case,
// padding or form arrived in the URL. The "which one is you" note is keyed on them.
const codeA = cmp?.a.code ?? '';
const codeB = cmp?.b.code ?? '';
// What the page's own links print: each half as it came, or its public code.
const linkA = quiz && cmp ? linkCodeFor(quiz, parts[0] ?? '', codeA) : '';
const linkB = quiz && cmp ? linkCodeFor(quiz, parts[1] ?? '', codeB) : '';

const heading =
  cmp?.shape === 'bipolar'
    ? `Same band on ${cmp.sameCount} of ${cmp.total}`
    : 'Two rankings, side by side';

/*
 * The page opens by saying, in plain words, what it is about to draw.
 *
 * A reader arriving from a link has never seen this instrument. Before any rail is shown
 * they are told how many rows there are and - the thing this page must never be mistaken
 * for - that nothing here scores one of them against the other.
 *
 * It used to spell out the markers as well, and then the key directly under it spelled the
 * same markers out again, better. The band keeps the size of the thing and the promise; how
 * a marker is drawn belongs to the key beside the drawing.
 */
const lede =
  cmp?.shape === 'bipolar'
    ? `Both of you on the same ${cmp.total} rows, each drawn where your own answers landed. ` +
      'Nothing here scores one of you against the other.'
    : `Both of you ranked on the same ${cmp?.rows.length ?? 0} ` +
      `${quiz ? groupNounPlural(quiz) : 'categories'}. ` +
      'Nothing here scores one of you against the other.';

/** The fact under the section head: where the two are furthest apart, or that they are not. */
const gapNote =
  cmp?.shape === 'bipolar'
    ? cmp.widest
      ? `Furthest apart on ${cmp.widest.name}; exactly together on ` +
        `${cmp.rows.filter(r => r.gap === 0).length} of ${cmp.total}.`
      : 'Every row puts the two of you on the same point.'
    : cmp?.sharedTop
      ? 'The category that came out strongest is the same one for both of you.'
      : 'The category that came out strongest is a different one for each of you.';

// The widest-gap axis gets its two mirrored pole panels, from the audited split.
// AxisDepth is deliberately not reused: it marks one pole as "yours" from a single row's
// value, and on this page that would quietly make one of the two readers the subject.
const widestGroup =
  cmp?.shape === 'bipolar' && cmp.widest
    ? quiz!.groups.find(g => g.slug === cmp.widest!.slug)
    : undefined;
const widestParts = widestGroup?.summaryParts;

const inviteUrlA = quiz ? `${Astro.site!.origin}${inviteHref(quiz, linkA)}` : '';
const inviteUrlB = quiz ? `${Astro.site!.origin}${inviteHref(quiz, linkB)}` : '';

/* The way on, as on a single result: the other quizzes and the games as rooms. */
const otherQuizzes = quiz ? QUIZZES.filter(q => q.slug !== quiz.slug) : [];
const games = liveGames();

// Counts, never a score between the two people: how many axes the quiz has, how many
// statements produced them, and — for a bipolar quiz — how many rows put the two in the
// same audited band. Nothing here is a percentage of agreement.
const tiles = quiz && cmp
  ? cmp.shape === 'bipolar'
    ? [
        { n: `${cmp.sameCount}/${cmp.total}`, label: 'Same band' },
        { n: quiz.groups.length, label: 'Axes' },
        { n: quiz.items.length, label: 'Statements' }
      ]
    : [
        { n: quiz.groups.length, label: 'Categories' },
        { n: quiz.items.length, label: 'Statements' }
      ]
  : [];
---
{quiz && cmp ? (
  <Base
    title={`${heading} — ${quiz.title}`}
    description={`Two ${quiz.title} results on the same rails. ${lede}`}
    noindex={true}
  >
    <Hero
      title={heading}
      kind={artFor(quiz.slug) ? 'engraving' : 'night'}
      image={artFor(quiz.slug)?.src}
      imageAlt={artFor(quiz.slug)?.alt}
      imagePosition={artFor(quiz.slug)?.objectPosition}
      imageLift={artFor(quiz.slug)?.lift}
      lede={lede}
      tiles={tiles}
      long={true}
    />

    {quiz.status === 'draft' && (
      <div class="note draft" style="margin-top:1.4rem">
        <p><strong>Unaudited draft.</strong>{" " + quiz.draftNote}</p>
      </div>
    )}

    <SectionHead title="Side by side" kicker="Two results on one set of rails" />
    <p class="tags">{gapNote}</p>

    <div
      class="panel layered result-panel cmp-panel"
      data-role="overlay"
      data-quiz={quiz.slug}
      data-code-a={codeA}
      data-code-b={codeB}
    >
      <div class="wash" aria-hidden="true"></div>
      <div class="veil" aria-hidden="true"></div>

      {cmp.shape === 'bipolar' ? (
        <Fragment>
          {/*
            The legend, written against what RailOverlay actually draws.

            It draws identity as SHAPE - a filled disc for the first reader, a ring for
            the second - and colours each marker by the side it landed on, blue toward
            the left pole, orange toward the right, grey inside the band where the quiz
            names neither. It shades the run between the two markers in neutral ink, and
            hatches the band. The component's own legend is suppressed in play.css so
            there is exactly one, and it says all four of those things. Colour is never
            an identity here, which is the sentence a reader needs before the first row.
          */}
          <p class="ov-legend cmp-legend">
            <span class="ov-key">
              <span class="ov-mark ov-mark--solid" aria-hidden="true"></span>
              <span><span data-who="a" data-self="you" data-other="them">the first</span>, a filled disc</span>
            </span>
            <span class="ov-key">
              <span class="ov-mark ov-mark--ring" aria-hidden="true"></span>
              <span><span data-who="b" data-self="you" data-other="them">the second</span>, a ring</span>
            </span>
            <span class="ov-key">
              <span class="ov-mark ov-mark--run" aria-hidden="true"></span>
              <span>the run between the two</span>
            </span>
            <span class="ov-key">
              <span class="legend-swatch" aria-hidden="true"></span>
              <span>the quiz names neither pole</span>
            </span>
          </p>
          <p class="cmp-legend-note">
            A marker is painted in the colour of the side it landed on — blue toward the
            left pole, orange toward the right, grey inside the hatched band. The colour
            says which side, never which person; the shape says which person.
          </p>
          <RailOverlay quiz={quiz} cmp={cmp} />
        </Fragment>
      ) : (
        <div class="ov-columns">
          <div class="ov-column">
            <h3 data-who="a" data-self="You" data-other="Them">First</h3>
            <CategoryStack quiz={quiz} view={cmp.a} />
          </div>
          <div class="ov-column">
            <h3 data-who="b" data-self="You" data-other="Them">Second</h3>
            <CategoryStack quiz={quiz} view={cmp.b} />
          </div>
        </div>
      )}
    </div>

    {cmp.shape === 'bipolar' && cmp.widest && widestParts && (
      <section>
        <SectionHead title="The widest gap" kicker={`Where ${cmp.widest.name} comes apart`} />
        <p class="tags">
          Both positions below are stated by people who hold them.
        </p>
        <div class="poles-split cmp-poles">
          <section class="pole-panel pole-panel--left">
            <h4>{cmp.widest.left}</h4>
            <p>{firstSentence(widestParts.left)}</p>
          </section>
          <section class="pole-panel pole-panel--right">
            <h4>{cmp.widest.right}</h4>
            <p>{firstSentence(widestParts.right)}</p>
          </section>
        </div>
        <p class="depth-more">
          <a href={groupHref(quiz, cmp.widest)}>More on {cmp.widest.name} →</a>
        </p>
      </section>
    )}

    <section>
      <SectionHead title="Each on its own" kicker="The full result behind each code" />
      <div class="btn-row">
        <a class="btn ghost" href={resultHref(quiz, linkA)}
           data-who="a" data-self="Your result" data-other="Their result">The first result</a>
        <a class="btn ghost" href={resultHref(quiz, linkB)}
           data-who="b" data-self="Your result" data-other="Their result">The second result</a>
      </div>
    </section>


    <section class="dark pledge invite-block">
      <div class="dark-ghost" aria-hidden="true">send</div>
      <p class="feature-kicker"><Icon name="compass" size={13} /> Add a third reader</p>
      <h2>Send this to someone else.</h2>
      {/*
        The same box as the invite on a result page, label and caption word for word, so the
        invitation reads the same wherever it is found. The caption says what the paragraph
        here used to say, so the paragraph went.
      */}
      <div class="share-box">
        <label class="share-label" for="invite-url">Compare with a friend</label>
        <div class="share-link">
          <input id="invite-url" data-role="invite-url" type="text" readonly value={inviteUrlA}
                 data-url-a={inviteUrlA} data-url-b={inviteUrlB} spellcheck="false" />
          <button class="btn ghost" data-role="copy-invite" type="button">Copy link</button>
        </div>
        <p class="share-note">
          Send this to a friend. When they finish the quiz, you both see your answers side by side.
        </p>
      </div>
    </section>

    {/*
      Under the invite, not above it: sending this on is what this page is for, and the way
      to the rest of the site comes after it rather than in front of it.
    */}
    {(otherQuizzes.length > 0 || games.length > 0) && (
      <section class="nextup">
        <SectionHead title="Keep going" kicker="Take another, or play one" />
        <NextUp quizzes={otherQuizzes} games={games} />
      </section>
    )}

    <script>
      /*
       * Who is looking.
       *
       * The server renders the neutral first/second wording, so the page is already correct
       * with no script at all - and correct for the commonest reader, who was sent the link
       * and is in neither role. Only when a tab-scoped note the quiz runner left behind
       * PROVES the viewer is one of the two does anything change. Nothing is sent anywhere.
       */
      document.querySelectorAll('[data-role="overlay"]').forEach(function (root) {
        const codeA = root.dataset.codeA || '';
        const codeB = root.dataset.codeB || '';

        let took = null;
        try { took = sessionStorage.getItem('ww:took:' + root.dataset.quiz); } catch (e) {}
        const self = took && took === codeA ? 'a' : took && took === codeB ? 'b' : null;
        if (!self) return;

        // The legend, the column headings and the two result links all swap together, so
        // the marker shapes and the words can never end up describing different people.
        document.querySelectorAll('[data-who]').forEach(function (node) {
          const text = node.dataset.who === self ? node.dataset.self : node.dataset.other;
          if (text) node.textContent = text;
        });

        // The rails' spoken description says the same thing the legend now shows.
        document.querySelectorAll('.rail-track[data-label-a]').forEach(function (track) {
          const label = self === 'a' ? track.dataset.labelA : track.dataset.labelB;
          if (label) track.setAttribute('aria-label', label);
        });

        // The invite offers the viewer's OWN link, so whoever they send it to is compared
        // with them rather than with whoever sent them here.
        const field = document.querySelector('[data-role="invite-url"]');
        const own = field && (self === 'a' ? field.dataset.urlA : field.dataset.urlB);
        if (field && own) field.value = own;
      });

      document.querySelectorAll('[data-role="invite-url"]').forEach(function (field) {
        field.addEventListener('focus', function () { field.select(); });
      });
      document.querySelectorAll('[data-role="copy-invite"]').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          const field = document.querySelector('[data-role="invite-url"]');
          if (!field) return;
          field.select();
          const was = btn.textContent;
          try { await navigator.clipboard.writeText(field.value); btn.textContent = 'Copied'; }
          catch (e) { btn.textContent = 'Press Ctrl+C'; }
          setTimeout(function () { btn.textContent = was; }, 1800);
        });
      });
    </script>
  </Base>
) : (
  <Base title="Comparison not found" description="That comparison link is not valid." noindex={true}>
    <div class="prose">
      <h1>That link is not a valid comparison</h1>
      <p>
        A comparison link carries two result codes, joined by a dot. Both have to be exact.
        One wrong character and there is no way to recover the answers.
      </p>
      <p>
        If someone sent you this link, ask them for it again, and check that nothing was cut
        off at the end.
      </p>
      <p><a href="/quizzes/">Take a quiz →</a></p>
    </div>
  </Base>
)}
