---
/**
 * The account room.
 *
 * Not a doorway, so it wears no photograph: the dark starry ground says plainly that this
 * is the back of the house. Four things can be done here and each is a room of its own with
 * its own mark, because four boxes of grey text have to be read to be told apart.
 *
 * Signed-in state is painted by the browser, the way /me/ does it, and for the same reason:
 * every page on this site is static and cached, so the server cannot know who is reading.
 * What the server renders is the honest signed-out version; a tiny inline script decides
 * which of the two is showing BEFORE first paint, so nothing flashes and nothing moves.
 *
 * Deleting really deletes: the account, the address, the results on the server and the
 * results on this device. The room says so in one line rather than hiding it behind a
 * confirmation nobody reads.
 */
import '../../styles/pages/account.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AccountBand from '../../components/AccountBand.astro';
import { ACCOUNTS_READY, MIN_PASSWORD } from '../../lib/account/config';

const HEADS = [
  {
    state: 'in',
    eyebrow: 'Your account',
    icon: 'users' as const,
    title: 'Your account.',
    accent: 'account.'
  },
  {
    state: 'out',
    fallback: true,
    eyebrow: 'Your account',
    icon: 'users' as const,
    title: 'Your account.',
    accent: 'account.',
    lede: 'You are not signed in on this browser.'
  }
];
---
<Base
  title="Your account"
  description="What your Wiser Walk account keeps, and how to change or end it."
  noindex={true}
>
  {/*
    Decided before first paint, from the 60-byte hint the account writes beside the session.
    Read raw rather than through lib/account/session, because this runs inline on load and
    pulling in a module to look at one key would be a module for a class name — the same
    reasoning as the header's saved-results dot in Base.astro.
  */}
  <script is:inline>
    (function () {
      var email = '';
      try {
        var hint = JSON.parse(localStorage.getItem('ww.acct.v1'));
        if (hint && typeof hint.e === 'string') email = hint.e;
      } catch (e) {}
      window.__wwAccountEmail = email;
      document.documentElement.dataset.acct = email ? 'in' : 'out';
    })();
  </script>

  {!ACCOUNTS_READY ? (
    <AccountBand
      eyebrow="Your account"
      icon="users"
      title="Accounts are not switched on yet."
      accent="not switched on yet."
      lede="Everything you finish is still saved on this device in the meantime, and it is all on one page."
    >
      <p class="ac-acts">
        <a class="btn ac-btn" href="/me/">See my results <Icon name="arrow" size={16} /></a>
      </p>
    </AccountBand>
  ) : (
    <>
      <AccountBand kind="night" ghost="account" heads={HEADS}>
        <div class="ac-when ac-when--fallback" data-state="out">
          <p class="ac-acts">
            <a class="btn ac-btn" href="/account/sign-in/">Sign in</a>
            <a class="ac-go" href="/account/sign-up/">Make an account</a>
          </p>
        </div>

        <div class="ac-when" data-state="in">
          <p class="ac-who">Signed in as <span id="ac-email">this browser</span></p>
          {/*
            Filled during parse rather than after it, so the line never shows a placeholder
            to somebody who is signed in. The height is held by .ac-who either way.
          */}
          <script is:inline>
            (function () {
              var slot = document.getElementById('ac-email');
              if (slot && window.__wwAccountEmail) slot.textContent = window.__wwAccountEmail;
            })();
          </script>
          {/*
            Both values are EMPTY until the server has answered. A page that prints "Set"
            before it has asked is telling somebody a fact about their account that it has
            not checked, and the row would have to correct itself a second later. The rows
            keep their height either way: see .spec dd:empty in account.css.
          */}
          <dl class="spec">
            <div><dt>Password</dt><dd id="ac-spec-pw"></dd></div>
            <div><dt id="ac-spec-n-label">Results saved</dt><dd id="ac-spec-n"></dd></div>
          </dl>
          {/* Shown only when the server could not be reached at all: the page stays as it
              is rather than telling somebody they are signed out when they are not. */}
          <p class="ac-stale" id="ac-stale" hidden>
            We could not reach your account just now. What you see here may be out of date.
          </p>
        </div>
      </AccountBand>

      <div class="ac-when" data-state="in">
        <section class="ac-acct" aria-label="Your account">
          {/* ------------------------------------------------------- change the password */}
          {/* The one room with a form in it, so from the tablet up its words stand beside
              its fields instead of leaving half a panel empty. */}
          <article class="ac-room ac-room--wide">
            <div class="ac-room-say">
              <span class="ac-mark"><Icon name="key" size={20} /></span>
              <h3>Change your password.</h3>
              <p>You will stay signed in here. Anywhere else you are signed in stays as it is.</p>
            </div>
            <div class="ac-room-do">
            <form id="ac-pw-form" novalidate>
              <div class="ac-row">
                <span class="ac-cell">
                  <label class="sr-only" for="ac-pw-old">Your password now</label>
                  <span class="ac-cell-icon" aria-hidden="true"><Icon name="key" size={17} /></span>
                  <input class="ac-field" id="ac-pw-old" name="current" type="password" required
                         autocomplete="current-password" placeholder="Your password now" />
                </span>
                <span class="ac-cell">
                  <label class="sr-only" for="ac-pw-new">Your new password</label>
                  <span class="ac-cell-icon" aria-hidden="true"><Icon name="key" size={17} /></span>
                  <input class="ac-field ac-field--pw" id="ac-pw-new" name="next" type="password" required
                         minlength={MIN_PASSWORD} autocomplete="new-password" placeholder="Your new password" />
                  <button class="ac-show" type="button" data-show="ac-pw-new" aria-pressed="false">Show</button>
                </span>
                <p class="ac-rule">At least {MIN_PASSWORD} characters.</p>
                <button class="btn ac-btn" id="ac-pw-go" type="submit">Save the new password</button>
              </div>
            </form>
            <p class="ac-status ac-panel-light" id="ac-pw-status" role="status" aria-live="polite"></p>
            </div>
          </article>

          {/* -------------------------------------------------------------- the notes */}
          <article class="ac-room">
            <span class="ac-mark"><Icon name="mail" size={20} /></span>
            <h3>Notes about new quizzes and games.</h3>
            <p>
              A short note when something new is made, and nothing else. Turning it off
              never affects signing in.
            </p>
            <button class="ac-switch" id="ac-notes" type="button" role="switch" aria-checked="true">
              <span class="ac-switch-track" aria-hidden="true"><span class="ac-switch-knob"></span></span>
              <span class="ac-switch-word" id="ac-notes-word">On</span>
            </button>
            <p class="ac-status ac-panel-light" id="ac-notes-status" role="status" aria-live="polite"></p>
          </article>

          {/* ---------------------------------------------------------------- signing out */}
          <article class="ac-room">
            <span class="ac-mark"><Icon name="door" size={20} /></span>
            <h3>Sign out of this browser.</h3>
            <p>
              Your results stay on this device, and everything is still in your account when
              you come back.
            </p>
            <p class="ac-acts">
              <button class="btn ghost" id="ac-out" type="button">Sign out</button>
            </p>
            <p class="ac-status ac-panel-light" id="ac-out-status" role="status" aria-live="polite"></p>
          </article>

          {/* ------------------------------------------------------------------ deleting */}
          <article class="ac-room">
            <span class="ac-mark"><Icon name="bin" size={20} /></span>
            <h3>Delete my account.</h3>
            {/* The confirmation quotes this sentence rather than repeating it, so the room
                and the dialog can never drift into promising two different things. */}
            <p id="ac-del-say">
              Your email address, your results and your best scores go, from our side and
              from this device, and none of it can be brought back.
            </p>
            <button class="ac-quiet" id="ac-del" type="button">Delete my account</button>
            <p class="ac-status ac-panel-light" id="ac-del-status" role="status" aria-live="polite"></p>
          </article>
        </section>

        <p class="ac-fine">
          Your answers to a quiz are never sent anywhere: the scoring happens in your
          browser and what your account holds is the short result code, which is the same
          thing that is already in the link. Games keep your best score, and which Bible you
          chose in Sounds Like Scripture.
        </p>
      </div>
    </>
  )}

  <script>
    import {
      whoAmI, changePassword, setNotes, signOut, deleteAccount, countResults
    } from '../../lib/account/client';

    const room = document.getElementById('ac-pw-form');
    if (room) {
      const pick = id => document.getElementById(id);
      /* Screenshot switches, read first because one of them pins the signed-in state that
         the real check below would otherwise undo. Dev only: `import.meta.env.DEV` is
         replaced with false when the site is built and this goes with it. */
      const shown = import.meta.env.DEV ? new URLSearchParams(location.search).get('state') : null;
      if (shown === 'in' || shown === 'out') document.documentElement.dataset.acct = shown;

      const sayOn = (id, text, kind) => {
        const line = pick(id);
        line.textContent = text;
        line.className = 'ac-status ac-panel-light' + (kind ? ' is-' + kind : '');
      };
      const busyOn = (id, on, word, rest) => {
        const button = pick(id);
        button.disabled = on;
        button.textContent = on ? word : rest;
      };

      const results = n => (n === 1 ? '1 result' : n + ' results');

      /*
       * "Results saved" is a fact about the ACCOUNT, so it is the account that is asked.
       * The device's shelf is capped at 200 and the account holds far more than that, and a
       * page headed "Your account" printing the device's number under that label is the
       * kind of small untruth this page exists not to tell.
       *
       * Until the server answers, the row says nothing. If it cannot answer, the device's
       * own count is printed with the label changed to say what it counts. The key is read
       * raw rather than through lib/shelf, the way the header's saved-results dot is,
       * because this page needs a length and not the module that knows how to score one.
       */
      const onDevice = () => {
        try {
          const saved = JSON.parse(localStorage.getItem('ww.shelf.v1'));
          return Array.isArray(saved) ? saved.length : 0;
        } catch (e) {
          return 0;
        }
      };
      // `shown` is null in every real build, so this is the live path; in dev it leaves the
      // screenshot switches below in charge of what the two rows say.
      if (!shown && document.documentElement.dataset.acct === 'in') {
        countResults().then(n => {
          if (typeof n === 'number') {
            pick('ac-spec-n').textContent = results(n);
            return;
          }
          pick('ac-spec-n-label').textContent = 'Results on this device';
          pick('ac-spec-n').textContent = results(onDevice());
        });
      }

      document.querySelectorAll('.ac-show').forEach(toggle => {
        toggle.addEventListener('click', () => {
          const field = pick(toggle.dataset.show);
          const showing = field.type === 'text';
          field.type = showing ? 'password' : 'text';
          toggle.setAttribute('aria-pressed', String(!showing));
          toggle.textContent = showing ? 'Show' : 'Hide';
        });
      });

      // ---- who, and what the switch should be showing ----------------------------------
      const notes = pick('ac-notes');
      const notesWord = pick('ac-notes-word');
      const paintNotes = on => {
        notes.setAttribute('aria-checked', String(on));
        notesWord.textContent = on ? 'On' : 'Off';
      };

      whoAmI().then(who => {
        if (who === 'unreachable') {
          // The request never arrived, or the project is having a rest. That is not somebody
          // signed out: the header still says they are, and a page that contradicts the
          // header is worse than a page that admits it is looking at yesterday's answer.
          if (!shown) pick('ac-stale').hidden = false;
          return;
        }
        if (!who) {
          // The server itself said there is nobody here. Show the door rather than leaving
          // controls that cannot work behind a name that is no longer true.
          if (!shown) document.documentElement.dataset.acct = 'out';
          return;
        }
        pick('ac-email').textContent = who.email;
        pick('ac-spec-pw').textContent = who.passwordSet ? 'Set' : 'Not set yet';
        paintNotes(!who.notesOff);
      });

      // ---- change the password ---------------------------------------------------------
      room.addEventListener('submit', event => {
        event.preventDefault();
        if (pick('ac-pw-go').disabled) return;
        busyOn('ac-pw-go', true, 'Saving…');
        sayOn('ac-pw-status', 'Saving…', 'busy');

        changePassword(pick('ac-pw-old').value, pick('ac-pw-new').value).then(done => {
          busyOn('ac-pw-go', false, '', 'Save the new password');
          if (!done.ok) {
            sayOn('ac-pw-status', done.say, 'bad');
            return;
          }
          room.reset();
          sayOn('ac-pw-status', 'Saved. Use the new one next time.', 'ok');
        });
      });

      // ---- the notes -------------------------------------------------------------------
      notes.addEventListener('click', () => {
        const next = notes.getAttribute('aria-checked') !== 'true';
        paintNotes(next);
        sayOn('ac-notes-status', 'Saving…', 'busy');
        setNotes(next).then(done => {
          if (!done.ok) {
            paintNotes(!next);
            sayOn('ac-notes-status', done.say, 'bad');
            return;
          }
          sayOn('ac-notes-status', next ? 'On. We will let you know.' : 'Off. Your account is untouched.', 'ok');
        });
      });

      // ---- sign out --------------------------------------------------------------------
      pick('ac-out').addEventListener('click', () => {
        busyOn('ac-out', true, 'Signing out…');
        signOut().then(() => { location.href = '/me/'; });
      });

      // ---- delete ----------------------------------------------------------------------
      pick('ac-del').addEventListener('click', () => {
        /* The promise is read off the room itself, whitespace tidied, so the dialog and the
           page say the same thing word for word however either is edited later. */
        const promise = pick('ac-del-say').textContent.replace(/\s+/g, ' ').trim();
        if (!window.confirm('Delete your account? ' + promise)) return;
        busyOn('ac-del', true, 'Deleting…');
        sayOn('ac-del-status', 'Deleting…', 'busy');
        deleteAccount().then(done => {
          if (!done.ok) {
            busyOn('ac-del', false, '', 'Delete my account');
            sayOn('ac-del-status', done.say, 'bad');
            return;
          }
          /* The account is gone. The mailing list is a different company, and when it would
             not let go of the address the reader is told here, on the page that promised it,
             rather than being sent to the home page believing something that is not so. The
             wait is long enough to read two sentences: there is nothing true left on this
             page to stay for. */
          if (done.listRemoved === false) {
            busyOn('ac-del', true, 'Account deleted');
            sayOn(
              'ac-del-status',
              'Your account is gone. We could not take your address off our email list just ' +
                'now. The unsubscribe link in any email from us will do it.',
              'ok'
            );
            window.setTimeout(() => { location.href = '/'; }, 10000);
            return;
          }
          location.href = '/';
        });
      });

      if (shown) {
        document.documentElement.dataset.acct = shown === 'out' ? 'out' : 'in';
        pick('ac-email').textContent = 'reader@example.com';
        pick('ac-spec-pw').textContent = 'Set';
        pick('ac-spec-n').textContent = '7 results';
        if (shown === 'stale') pick('ac-stale').hidden = false;
        if (shown === 'waiting') { pick('ac-spec-pw').textContent = ''; pick('ac-spec-n').textContent = ''; }
        if (shown === 'device') {
          pick('ac-spec-n-label').textContent = 'Results on this device';
          pick('ac-spec-n').textContent = '3 results';
        }
        if (shown === 'busy') { busyOn('ac-pw-go', true, 'Saving…'); sayOn('ac-pw-status', 'Saving…', 'busy'); }
        if (shown === 'error') sayOn('ac-pw-status', 'That is not your password now. Have another go.', 'bad');
        if (shown === 'off') paintNotes(false);
      }
    }
  </script>
</Base>
