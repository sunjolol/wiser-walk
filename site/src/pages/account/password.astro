---
/**
 * Choose a password. The page the emailed link lands on.
 *
 * The riskiest page in the flow: the reader has come out of their mail app, possibly on a
 * different device from the one they signed up on, and has exactly one job. So there is one
 * field, no confirm field (the commonest place a non-expert gets stuck), the rule printed
 * before they type, and one button.
 *
 * THE PAGE MAKES NO NETWORK CALL ON LOAD WHEN IT HAS A LINK. A mail scanner, a corporate
 * link checker or an email provider's own click tracker that opens this address gets a
 * static file that calls nothing, so the one-time token is still there when the person
 * arrives. The token is spent on submit and not before. Arriving with NO link is the one
 * case that asks the server anything, because somebody whose link was spent by a press that
 * never finished is already signed in and needs finishing rather than a second email.
 *
 * FIVE STATES, NOT ONE PAGE WITH THREE TOASTS. Arriving from a sign-up link, from a reset
 * link, from the link sent to somebody who already has an account, with a link that has
 * already been used, and with no link at all are five different situations, and each gets
 * its own headline. Which one is showing is decided by the inline script below, before first
 * paint, so nothing flashes and nothing moves: the rules that act on `data-acct` live in
 * account.css.
 */
import '../../styles/pages/account.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AccountBand from '../../components/AccountBand.astro';
import { ACCOUNTS_READY, MIN_PASSWORD } from '../../lib/account/config';

/* The last two words of a headline are tied, so no width ever leaves one word alone on the
   last line (the owner's rule: a lone last word is "super sloppy"). */
const tie = (s: string) => s.replace(/ (?=\S+$)/, String.fromCharCode(160));

/* Five heads, one per state (the SEO guard counts them by AccountBand's exact markup, so
   the list stays five). Ledes only where the heading cannot carry it alone: somebody who
   already had an account, and a link that has run out. Every title has four words or
   more, so it can break as two and two: "Choose a password." could only ever leave
   "password." on a line of its own, or "Choose" on one. */
const HEADS = [
  {
    state: 'choose',
    fallback: true,
    title: tie('Now choose a password.'),
    accent: tie('a password.')
  },
  {
    state: 'new',
    title: tie('Choose a new password.'),
    accent: tie('new password.')
  },
  {
    /* The link that goes to an address which already has an account. Its email says so and
       its button says "Choose a new password", so the page it lands on says the same: a
       reader who had simply forgotten must not be left wondering whether they have just
       made a second account. */
    state: 'back',
    title: tie('Choose a new password.'),
    accent: tie('new password.'),
    lede: 'You already have an account. This replaces your old password.'
  },
  {
    state: 'expired',
    title: tie('That link has expired.'),
    accent: tie('has expired.'),
    lede: 'Links work for an hour, and only once.'
  },
  {
    state: 'code',
    title: tie('Use the code instead.'),
    accent: tie('code instead.')
  }
];
---
<Base
  title="Choose a password"
  description="Set the password you will log in with."
  noindex={true}
  referrer="no-referrer"
>
  {/*
    The token must not sit in the address bar while somebody reads the page, and this page
    must not depend on a bundle loading to know what it is. Both are settled here, before
    the band below is parsed. The kind is read from the query first and then the fragment,
    because a link can be rewritten in transit and it costs four lines to survive it.

    THE TOKEN IS KEPT FOR THE TAB, and written before the address bar is cleaned. A phone
    that discards a background tab while somebody goes to their mail app for the six digits
    reloads this page with the query already gone, and a page holding the only copy of the
    token in a variable would have thrown a perfectly good link away. sessionStorage is the
    tab's own, it is dropped the moment the link is spent, and the same token is sitting in
    the reader's inbox either way, so keeping it costs nothing.
  */}
  <script is:inline>
    (function () {
      var LINK = 'ww.acct.link';
      try {
        var here = new URL(location.href);
        var t = here.searchParams.get('t') || here.searchParams.get('token_hash') || '';
        var k = here.searchParams.get('k') || here.searchParams.get('type') || '';
        if (!t && here.hash) {
          var frag = new URLSearchParams(here.hash.replace(/^#/, ''));
          t = frag.get('token_hash') || frag.get('t') || '';
          k = frag.get('type') || frag.get('k') || k;
        }
        var arrived = Boolean(t);
        if (arrived) {
          try { sessionStorage.setItem(LINK, JSON.stringify({ t: t, k: k })); } catch (e) {}
        } else {
          try {
            var held = JSON.parse(sessionStorage.getItem(LINK));
            if (held && typeof held.t === 'string' && held.t) {
              t = held.t;
              k = typeof held.k === 'string' ? held.k : '';
            }
          } catch (e) {}
        }
        window.__wwAccount = { token: t, kind: k };
        if (arrived) history.replaceState(null, '', here.pathname);
        document.documentElement.dataset.acct = !t
          ? 'code'
          : k === 'recovery' ? 'new' : k === 'magiclink' ? 'back' : 'choose';
      } catch (e) {
        document.documentElement.dataset.acct = 'code';
      }
    })();
  </script>

  {!ACCOUNTS_READY ? (
    <AccountBand
      title="Accounts are not switched on yet."
      accent="not switched on yet."
      lede="Everything you finish is still saved on this device in the meantime, and it is all on one page."
    >
      <p class="ac-acts">
        <a class="btn ac-btn" href="/me/">See my results <Icon name="arrow" size={16} /></a>
      </p>
    </AccountBand>
  ) : (
    <AccountBand heads={HEADS}>
      {/* ------------------------------------------ the link worked: one field, one button */}
      <div class="ac-body ac-body--fallback" data-state="token">
        <form class="ac-form" id="ac-token-form" method="post" novalidate>
          {/* The address this password belongs to, for the password manager and nobody
              else: without it a new password is saved against nothing. Filled from the
              address the reader typed, then from the account itself once the link is spent. */}
          <input id="ac-user" name="username" type="email" autocomplete="username" hidden />
          <div class="ac-row">
            <div class="ac-group">
              <label class="ac-label" for="ac-pw">New password</label>
              <p class="ac-rule" id="ac-pw-rule">At least {MIN_PASSWORD} characters.</p>
              <span class="ac-cell">
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="key" size={17} /></span>
                <input class="ac-field ac-field--pw" id="ac-pw" name="password" type="password" required
                       minlength={MIN_PASSWORD} autocomplete="new-password"
                       spellcheck="false" autocapitalize="none" autocorrect="off"
                       aria-describedby="ac-pw-rule ac-token-status" />
                <button class="ac-show" type="button" data-show="ac-pw" aria-pressed="false">Show</button>
              </span>
            </div>
            <p class="ac-status" id="ac-token-status" role="status" aria-live="polite"></p>
            <button class="btn ac-btn" id="ac-token-go" type="submit">Save and log in</button>
          </div>
        </form>
      </div>

      {/* --------------------------------------------- the link is spent: ask for another */}
      <div class="ac-body" data-state="expired">
        <form class="ac-form ac-form--one" id="ac-again-form" method="post" novalidate>
          <div class="ac-row ac-row--one">
            <div class="ac-group">
              <label class="ac-label" for="ac-again-email">Email address</label>
              <span class="ac-cell">
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="mail" size={17} /></span>
                <input class="ac-field" id="ac-again-email" name="email" type="email" required
                       autocomplete="email" inputmode="email" spellcheck="false" autocapitalize="none"
                       aria-describedby="ac-again-status" />
              </span>
            </div>
            <p class="ac-status" id="ac-again-status" role="status" aria-live="polite"></p>
            <button class="btn ac-btn" id="ac-again-go" type="submit">Email me a new link</button>
          </div>
        </form>
      </div>

      {/* --------------------------------------------------- no link at all: the six digits */}
      <div class="ac-body" data-state="code">
        <form class="ac-form" id="ac-code-form" method="post" novalidate>
          <div class="ac-row">
            {/* `username`, not `email`: this address is what the new password is saved
                against, and a password manager only pairs the two on that word. */}
            <div class="ac-group">
              <label class="ac-label" for="ac-code-email">Email address</label>
              <span class="ac-cell">
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="mail" size={17} /></span>
                <input class="ac-field" id="ac-code-email" name="email" type="email" required
                       autocomplete="username" inputmode="email" spellcheck="false" autocapitalize="none"
                       aria-describedby="ac-code-status" />
              </span>
            </div>
            {/* No maxlength: a code pasted with a space or a stray newline must arrive whole,
                and the client takes the spaces out. */}
            <div class="ac-group">
              <label class="ac-label" for="ac-code">6-digit code from the email</label>
              <span class="ac-cell">
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="clock" size={17} /></span>
                <input class="ac-field ac-field--code" id="ac-code" name="code" type="text" required
                       inputmode="numeric" autocomplete="one-time-code" spellcheck="false"
                       aria-describedby="ac-code-status" />
              </span>
            </div>
            <div class="ac-group">
              <label class="ac-label" for="ac-code-pw">New password</label>
              <p class="ac-rule" id="ac-code-rule">At least {MIN_PASSWORD} characters.</p>
              <span class="ac-cell">
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="key" size={17} /></span>
                <input class="ac-field ac-field--pw" id="ac-code-pw" name="password" type="password" required
                       minlength={MIN_PASSWORD} autocomplete="new-password"
                       spellcheck="false" autocapitalize="none" autocorrect="off"
                       aria-describedby="ac-code-rule ac-code-status" />
                <button class="ac-show" type="button" data-show="ac-code-pw" aria-pressed="false">Show</button>
              </span>
            </div>
            <p class="ac-status" id="ac-code-status" role="status" aria-live="polite"></p>
            <button class="btn ac-btn" id="ac-code-go" type="submit">Save and log in</button>
          </div>
          <p class="ac-under"><a href="/account/forgot/" id="ac-code-new">Ask for a new link instead</a></p>
        </form>
      </div>
    </AccountBand>
  )}

  <script>
    import {
      finishWithToken, finishWithCode, finishWithSession, requestReset, sayFor, whoAmI
    } from '../../lib/account/client';
    import { readHint, storedSession } from '../../lib/account/session';
    import { wirePasswordToggles, flagFields, carryEmail, carriedEmail } from '../../lib/account/form';

    const tokenForm = document.getElementById('ac-token-form') as HTMLFormElement | null;
    if (tokenForm) {
      const field = (id: string) => document.getElementById(id) as HTMLInputElement;
      /* What the reader arrived with: the link out of the address bar, or the copy this tab
         kept when the address bar was cleaned. Set by the inline script in the head. */
      const arrived: { token: string; kind: string } =
        (window as unknown as { __wwAccount?: { token: string; kind: string } }).__wwAccount ?? { token: '', kind: '' };

      wirePasswordToggles(document);

      /* The address they gave on the page that sent the email, if this is the same tab; the
         one typed on another account page otherwise. It fills the hidden username, the
         expired state's field and the code state's field, so nobody types it twice. */
      let known = '';
      try { known = sessionStorage.getItem('ww.acct.to') || ''; } catch { /* blocked: they type it */ }
      if (!known) known = carriedEmail();
      const user = field('ac-user');
      const fillKnown = (address: string) => {
        if (!address) return;
        user.value = address;
        for (const id of ['ac-again-email', 'ac-code-email']) {
          if (!field(id).value) field(id).value = address;
        }
      };
      fillKnown(known);

      /* The kept copy goes the moment the link is spent, one way or the other. Leaving a
         used token in the tab would only give the page a second chance to be told it had
         expired. */
      const dropLink = () => {
        try { sessionStorage.removeItem('ww.acct.link'); } catch { /* nothing kept */ }
      };

      /* True when there is no link but there IS a session: the token was spent by a press
         that never got as far as the password. Then the password is all that is left to do,
         and re-verifying would spend a link that has already gone. */
      let onSession = false;

      const sayOn = (id: string, text: string, kind?: string) => {
        const line = document.getElementById(id)!;
        line.textContent = text;
        line.className = 'ac-status' + (kind ? ' is-' + kind : '');
      };
      /* Busy is said in words, not by a button fading out. */
      const busyOn = (id: string, on: boolean, word: string) => {
        const button = document.getElementById(id) as HTMLButtonElement;
        button.disabled = on;
        button.textContent = word;
      };

      /* Leaving for the profile: the account's own address goes into the hidden field first,
         so a password manager that saves on the way out saves it against the right name. */
      const done = () => {
        dropLink();
        fillKnown(readHint()?.email ?? '');
        location.href = '/me/';
      };

      /* The one place the whole flow can strand somebody: a link that has been spent. It is
         a state of this page, with its own headline, not a red line over the wrong one. */
      const goExpired = () => {
        dropLink();
        document.documentElement.dataset.acct = 'expired';
      };

      // ---- the link worked -------------------------------------------------------------
      tokenForm.addEventListener('submit', event => {
        event.preventDefault();
        const button = document.getElementById('ac-token-go') as HTMLButtonElement;
        if (button.disabled) return;
        const pw = field('ac-pw');
        flagFields([pw], false);
        busyOn('ac-token-go', true, 'Saving…');
        sayOn('ac-token-status', 'Saving…', 'busy');

        const password = pw.value;
        // Finishing on a session that is already open is the same act with the first half
        // already done, so it is the same form and the same button.
        (onSession ? finishWithSession(password) : finishWithToken({
          tokenHash: arrived.token,
          kind: arrived.kind,
          password
        })).then(result => {
          if (result.ok) {
            done();
            return;
          }
          busyOn('ac-token-go', false, 'Save and log in');
          if (result.code === 'expired') {
            goExpired();
            return;
          }
          if (result.code === 'weak' || result.code === 'same') {
            flagFields([pw], true);
            pw.focus();
          }
          sayOn('ac-token-status', result.say, 'bad');
        });
      });

      // ---- ask for another -------------------------------------------------------------
      field('ac-again-email').form!.addEventListener('submit', event => {
        event.preventDefault();
        const button = document.getElementById('ac-again-go') as HTMLButtonElement;
        if (button.disabled) return;
        const input = field('ac-again-email');
        const email = input.value.trim();
        flagFields([input], false);
        if (!email) {
          flagFields([input], true);
          sayOn('ac-again-status', 'Enter your email address.', 'bad');
          input.focus();
          return;
        }
        busyOn('ac-again-go', true, 'Sending…');
        sayOn('ac-again-status', 'Sending…', 'busy');

        requestReset(email).then(result => {
          if (!result.ok) {
            busyOn('ac-again-go', false, 'Email me a new link');
            if (result.code === 'address') {
              flagFields([input], true);
              input.focus();
            }
            sayOn('ac-again-status', result.say, 'bad');
            return;
          }
          try { sessionStorage.setItem('ww.acct.to', email); } catch { /* the next page copes */ }
          location.href = '/account/check-email/?k=recovery';
        });
      });

      // ---- the six digits --------------------------------------------------------------
      document.getElementById('ac-code-new')?.addEventListener('click', () => carryEmail(field('ac-code-email').value));

      field('ac-code').form!.addEventListener('submit', event => {
        event.preventDefault();
        const button = document.getElementById('ac-code-go') as HTMLButtonElement;
        if (button.disabled) return;
        const email = field('ac-code-email');
        const code = field('ac-code');
        const pw = field('ac-code-pw');
        flagFields([email, code, pw], false);

        // What is missing, first field first, before anything is sent.
        const missing: [HTMLInputElement, string] | null =
          !email.value.trim() ? [email, 'Enter your email address.']
          : !code.value.trim() ? [code, 'Enter the 6-digit code from the email.']
          : null;
        if (missing) {
          flagFields([missing[0]], true);
          sayOn('ac-code-status', missing[1], 'bad');
          missing[0].focus();
          return;
        }

        busyOn('ac-code-go', true, 'Saving…');
        sayOn('ac-code-status', 'Saving…', 'busy');

        finishWithCode({
          email: email.value.trim(),
          code: code.value,
          password: pw.value
        }).then(result => {
          if (result.ok) {
            done();
            return;
          }
          busyOn('ac-code-go', false, 'Save and log in');
          const where =
            result.code === 'expired' ? code
            : result.code === 'weak' || result.code === 'same' ? pw
            : result.code === 'address' ? email
            : null;
          if (where) {
            flagFields([where], true);
            where.focus();
          }
          sayOn('ac-code-status', result.code === 'expired'
            ? 'That code has expired or is wrong. Check it, or ask for a new link below.'
            : result.say, 'bad');
        });
      });

      /*
       * No link anywhere, which is two different people.
       *
       * One typed the address in or came back to a tab that had lost it, and the six digits
       * are their way through. The other pressed the button, the verify worked, the link was
       * spent, and then the phone rang before the password landed: they are logged in
       * already, with a confirmed account and no password, and telling them to ask for
       * another email would be telling them to fix something that is not broken.
       *
       * So the server is asked exactly once, and only when a live session is sitting in this
       * browser. A reader who arrived WITH a link still causes no call on load.
       */
      if (!arrived.token) {
        const open = storedSession();
        if (open && open.expiresAt > Date.now()) {
          whoAmI().then(who => {
            if (!who || who === 'unreachable') return;
            if (who.passwordSet) {
              location.href = '/account/';
              return;
            }
            onSession = true;
            user.value = who.email;
            document.documentElement.dataset.acct = 'choose';
          });
        }
      }

      /* Screenshot switches. Dev only: the whole block goes when the site is built. */
      if (import.meta.env.DEV) {
        const state = new URLSearchParams(location.search).get('state');
        // A link in the query would be cleaned out of the address bar before this runs, so
        // the token states are asked for by name.
        if (state === 'choose' || state === 'busy' || state === 'error') document.documentElement.dataset.acct = 'choose';
        if (state === 'expired') { goExpired(); fillKnown('reader@example.com'); }
        if (state === 'code') document.documentElement.dataset.acct = 'code';
        if (state === 'new') document.documentElement.dataset.acct = 'new';
        if (state === 'back') document.documentElement.dataset.acct = 'back';
        if (state === 'busy') { busyOn('ac-token-go', true, 'Saving…'); sayOn('ac-token-status', 'Saving…', 'busy'); }
        if (state === 'error') { flagFields([field('ac-pw')], true); sayOn('ac-token-status', sayFor('weak'), 'bad'); }
        if (state === 'code-error') {
          document.documentElement.dataset.acct = 'code';
          fillKnown('reader@example.com');
          field('ac-code').value = '483 205';
          flagFields([field('ac-code')], true);
          sayOn('ac-code-status', 'That code has expired or is wrong. Check it, or ask for a new link below.', 'bad');
        }
      }
    }
  </script>
</Base>
