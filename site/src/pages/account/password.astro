---
/**
 * Choose a password. The page the emailed link lands on.
 *
 * The riskiest page in the flow: the reader has come out of their mail app, possibly on a
 * different device from the one they signed up on, and has exactly one job. So there is one
 * field, no confirm field (the commonest place a non-expert gets stuck), the rule printed
 * before they type, and one button.
 *
 * THE PAGE MAKES NO NETWORK CALL ON LOAD WHEN IT HAS A LINK. A mail scanner, a corporate
 * link checker or an email provider's own click tracker that opens this address gets a
 * static file that calls nothing, so the one-time token is still there when the person
 * arrives. The token is spent on submit and not before. Arriving with NO link is the one
 * case that asks the server anything, because somebody whose link was spent by a press that
 * never finished is already signed in and needs finishing rather than a second email.
 *
 * FIVE STATES, NOT ONE PAGE WITH THREE TOASTS. Arriving from a sign-up link, from a reset
 * link, from the link sent to somebody who already has an account, with a link that has
 * already been used, and with no link at all are five different situations, and each gets
 * its own headline. Which one is showing is decided by the inline script below, before first
 * paint, so nothing flashes and nothing moves: the rules that act on `data-acct` live in
 * account.css.
 */
import '../../styles/pages/account.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AccountBand from '../../components/AccountBand.astro';
import { ACCOUNTS_READY, MIN_PASSWORD } from '../../lib/account/config';

const HEADS = [
  {
    state: 'choose',
    fallback: true,
    eyebrow: 'One step',
    icon: 'path' as const,
    title: 'Choose a password.',
    accent: 'password.',
    lede: 'This is how you sign in from now on.'
  },
  {
    state: 'new',
    eyebrow: 'One step',
    icon: 'path' as const,
    title: 'Choose a new password.',
    accent: 'new password.',
    lede: 'This is how you sign in from now on.'
  },
  {
    /* The link that goes to an address which already has an account. Its email says so and
       its button says "Choose a new password", so the page it lands on says the same: a
       reader who had simply forgotten must not be left wondering whether they have just
       made a second account. */
    state: 'back',
    eyebrow: 'Your account',
    icon: 'users' as const,
    title: 'Choose a new password.',
    accent: 'new password.',
    lede: 'You already have an account. This replaces the password you had.'
  },
  {
    state: 'expired',
    eyebrow: 'That link',
    icon: 'clock' as const,
    title: 'That link has expired.',
    accent: 'expired.',
    lede: 'Links work for an hour, and only once. Ask for a new one below.'
  },
  {
    state: 'code',
    eyebrow: 'The code',
    icon: 'mail' as const,
    title: 'Use the code instead.',
    accent: 'instead.',
    lede: 'Six digits, printed in the same email.'
  }
];
---
<Base
  title="Choose a password"
  description="Set the password you will sign in with."
  noindex={true}
  referrer="no-referrer"
>
  {/*
    The token must not sit in the address bar while somebody reads the page, and this page
    must not depend on a bundle loading to know what it is. Both are settled here, before
    the band below is parsed. The kind is read from the query first and then the fragment,
    because a link can be rewritten in transit and it costs four lines to survive it.

    THE TOKEN IS KEPT FOR THE TAB, and written before the address bar is cleaned. A phone
    that discards a background tab while somebody goes to their mail app for the six digits
    reloads this page with the query already gone, and a page holding the only copy of the
    token in a variable would have thrown a perfectly good link away. sessionStorage is the
    tab's own, it is dropped the moment the link is spent, and the same token is sitting in
    the reader's inbox either way, so keeping it costs nothing.
  */}
  <script is:inline>
    (function () {
      var LINK = 'ww.acct.link';
      try {
        var here = new URL(location.href);
        var t = here.searchParams.get('t') || here.searchParams.get('token_hash') || '';
        var k = here.searchParams.get('k') || here.searchParams.get('type') || '';
        if (!t && here.hash) {
          var frag = new URLSearchParams(here.hash.replace(/^#/, ''));
          t = frag.get('token_hash') || frag.get('t') || '';
          k = frag.get('type') || frag.get('k') || k;
        }
        var arrived = Boolean(t);
        if (arrived) {
          try { sessionStorage.setItem(LINK, JSON.stringify({ t: t, k: k })); } catch (e) {}
        } else {
          try {
            var held = JSON.parse(sessionStorage.getItem(LINK));
            if (held && typeof held.t === 'string' && held.t) {
              t = held.t;
              k = typeof held.k === 'string' ? held.k : '';
            }
          } catch (e) {}
        }
        window.__wwAccount = { token: t, kind: k };
        if (arrived) history.replaceState(null, '', here.pathname);
        document.documentElement.dataset.acct = !t
          ? 'code'
          : k === 'recovery' ? 'new' : k === 'magiclink' ? 'back' : 'choose';
      } catch (e) {
        document.documentElement.dataset.acct = 'code';
      }
    })();
  </script>

  {!ACCOUNTS_READY ? (
    <AccountBand
      eyebrow="Your account"
      icon="users"
      title="Accounts are not switched on yet."
      accent="not switched on yet."
      lede="Everything you finish is still saved on this device in the meantime, and it is all on one page."
    >
      <p class="ac-acts">
        <a class="btn ac-btn" href="/me/">See my results <Icon name="arrow" size={16} /></a>
      </p>
    </AccountBand>
  ) : (
    <>
      <AccountBand heads={HEADS}>
        {/* ---------------------------------------- the link worked: one field, one button */}
        <div class="ac-body ac-body--fallback" data-state="token">
          <form class="ac-form" id="ac-token-form" novalidate>
            <div class="ac-row">
              <span class="ac-cell">
                <label class="sr-only" for="ac-pw">Your new password</label>
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="key" size={17} /></span>
                <input class="ac-field ac-field--pw" id="ac-pw" name="password" type="password"
                       required minlength={MIN_PASSWORD} autocomplete="new-password"
                       placeholder="Your new password" />
                <button class="ac-show" type="button" data-show="ac-pw" aria-pressed="false">Show</button>
              </span>
              <p class="ac-rule">At least {MIN_PASSWORD} characters. Anything you will remember.</p>
              <button class="btn ac-btn" id="ac-token-go" type="submit">Save it and sign in</button>
            </div>
          </form>
          <p class="ac-status" id="ac-token-status" role="status" aria-live="polite"></p>
        </div>

        {/* ------------------------------------------- the link is spent: ask for another */}
        <div class="ac-body" data-state="expired">
          <form class="ac-form" id="ac-again-form" novalidate>
            <div class="ac-row ac-row--one">
              <span class="ac-cell">
                <label class="sr-only" for="ac-again-email">Your email address</label>
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="mail" size={17} /></span>
                <input class="ac-field" id="ac-again-email" name="email" type="email" required
                       autocomplete="email" inputmode="email" placeholder="you@example.com" />
              </span>
              <button class="btn ac-btn" id="ac-again-go" type="submit">Send me a new one</button>
            </div>
          </form>
          <p class="ac-status" id="ac-again-status" role="status" aria-live="polite"></p>
        </div>

        {/* ------------------------------------------------- no link at all: the six digits */}
        <div class="ac-body" data-state="code">
          <form class="ac-form" id="ac-code-form" novalidate>
            <div class="ac-row">
              <span class="ac-cell">
                <label class="sr-only" for="ac-code-email">Your email address</label>
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="mail" size={17} /></span>
                <input class="ac-field" id="ac-code-email" name="email" type="email" required
                       autocomplete="email" inputmode="email" placeholder="you@example.com" />
              </span>
              <span class="ac-cell">
                <label class="sr-only" for="ac-code">The six-digit code from the email</label>
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="clock" size={17} /></span>
                <input class="ac-field ac-field--code" id="ac-code" name="code" type="text" required
                       inputmode="numeric" autocomplete="one-time-code" maxlength="9"
                       placeholder="483 205" />
              </span>
              <span class="ac-cell">
                <label class="sr-only" for="ac-code-pw">Your new password</label>
                <span class="ac-cell-icon" aria-hidden="true"><Icon name="key" size={17} /></span>
                <input class="ac-field ac-field--pw" id="ac-code-pw" name="password" type="password"
                       required minlength={MIN_PASSWORD} autocomplete="new-password"
                       placeholder="Your new password" />
                <button class="ac-show" type="button" data-show="ac-code-pw" aria-pressed="false">Show</button>
              </span>
              <p class="ac-rule">At least {MIN_PASSWORD} characters. Anything you will remember.</p>
              <button class="btn ac-btn" id="ac-code-go" type="submit">Save it and sign in</button>
            </div>
          </form>
          <p class="ac-status" id="ac-code-status" role="status" aria-live="polite"></p>
          <p class="ac-acts">
            <a class="ac-go" href="/account/forgot/">Send me a new link instead</a>
          </p>
        </div>
      </AccountBand>

      <section class="ac-panel dark" aria-labelledby="ac-keeps">
        <span class="dark-ghost" aria-hidden="true">kept</span>
        <span class="ac-mark"><Icon name="users" size={20} /></span>
        <h2 id="ac-keeps">Your results come with you.</h2>
        <p>
          Everything you have already finished on this device joins your account the moment
          you save this, and anything you do from now on lands there too.
        </p>
      </section>
    </>
  )}

  <script>
    import {
      finishWithToken, finishWithCode, finishWithSession, requestReset, sayFor, whoAmI
    } from '../../lib/account/client';
    import { storedSession } from '../../lib/account/session';

    const tokenForm = document.getElementById('ac-token-form');
    if (tokenForm) {
      const pick = id => document.getElementById(id);
      /* What the reader arrived with: the link out of the address bar, or the copy this tab
         kept when the address bar was cleaned. Set by the inline script in the head. */
      const arrived = window.__wwAccount || { token: '', kind: '' };

      /* The kept copy goes the moment the link is spent, one way or the other. Leaving a
         used token in the tab would only give the page a second chance to be told it had
         expired. */
      const dropLink = () => {
        try { sessionStorage.removeItem('ww.acct.link'); } catch (e) {}
      };

      /* True when there is no link but there IS a session: the token was spent by a press
         that never got as far as the password. Then the password is all that is left to do,
         and re-verifying would spend a link that has already gone. */
      let onSession = false;

      const sayOn = (id, text, kind) => {
        const line = pick(id);
        line.textContent = text;
        line.className = 'ac-status' + (kind ? ' is-' + kind : '');
      };
      /* Busy is said in words, not by a button fading out. */
      const busyOn = (id, on, word, rest) => {
        const button = pick(id);
        button.disabled = on;
        button.textContent = on ? word : rest;
      };

      /* A word, not an eye: there is no eye in the mark set, and 44px of text beats 17px of
         picture under a thumb. */
      document.querySelectorAll('.ac-show').forEach(toggle => {
        toggle.addEventListener('click', () => {
          const field = pick(toggle.dataset.show);
          const showing = field.type === 'text';
          field.type = showing ? 'password' : 'text';
          toggle.setAttribute('aria-pressed', String(!showing));
          toggle.textContent = showing ? 'Show' : 'Hide';
        });
      });

      /* The one place the whole flow can strand somebody: a link that has been spent. It is
         a state of this page, with its own headline, not a red line over the wrong one. */
      const goExpired = () => {
        dropLink();
        document.documentElement.dataset.acct = 'expired';
        const known = pick('ac-again-email');
        try {
          const to = sessionStorage.getItem('ww.acct.to');
          if (to && !known.value) known.value = to;
        } catch (e) {}
      };

      // ---- the link worked -------------------------------------------------------------
      tokenForm.addEventListener('submit', event => {
        event.preventDefault();
        const button = pick('ac-token-go');
        if (button.disabled) return;
        busyOn('ac-token-go', true, 'Saving…');
        sayOn('ac-token-status', 'Saving…', 'busy');

        const password = pick('ac-pw').value;
        // Finishing on a session that is already open is the same act with the first half
        // already done, so it is the same form and the same button.
        (onSession ? finishWithSession(password) : finishWithToken({
          tokenHash: arrived.token,
          kind: arrived.kind,
          password
        })).then(done => {
          if (done.ok) {
            dropLink();
            location.href = '/me/';
            return;
          }
          busyOn('ac-token-go', false, '', 'Save it and sign in');
          if (done.code === 'expired') {
            goExpired();
            return;
          }
          sayOn('ac-token-status', done.say, 'bad');
        });
      });

      // ---- ask for another -------------------------------------------------------------
      document.getElementById('ac-again-form').addEventListener('submit', event => {
        event.preventDefault();
        const button = pick('ac-again-go');
        if (button.disabled) return;
        const email = pick('ac-again-email').value.trim();
        busyOn('ac-again-go', true, 'Sending…');
        sayOn('ac-again-status', 'Sending…', 'busy');

        requestReset(email).then(done => {
          if (!done.ok) {
            busyOn('ac-again-go', false, '', 'Send me a new one');
            sayOn('ac-again-status', done.say, 'bad');
            return;
          }
          try { sessionStorage.setItem('ww.acct.to', email); } catch (e) {}
          location.href = '/account/check-email/?k=recovery';
        });
      });

      // ---- the six digits --------------------------------------------------------------
      document.getElementById('ac-code-form').addEventListener('submit', event => {
        event.preventDefault();
        const button = pick('ac-code-go');
        if (button.disabled) return;
        busyOn('ac-code-go', true, 'Saving…');
        sayOn('ac-code-status', 'Saving…', 'busy');

        finishWithCode({
          email: pick('ac-code-email').value.trim(),
          code: pick('ac-code').value,
          password: pick('ac-code-pw').value
        }).then(done => {
          if (done.ok) {
            dropLink();
            location.href = '/me/';
            return;
          }
          busyOn('ac-code-go', false, '', 'Save it and sign in');
          sayOn('ac-code-status', done.code === 'expired'
            ? 'That code has run out. Ask for a new email below.'
            : done.say, 'bad');
        });
      });

      /*
       * No link anywhere, which is two different people.
       *
       * One typed the address in or came back to a tab that had lost it, and the six digits
       * are their way through. The other pressed the button, the verify worked, the link was
       * spent, and then the phone rang before the password landed: they are signed in
       * already, with a confirmed account and no password, and telling them to ask for
       * another email would be telling them to fix something that is not broken.
       *
       * So the server is asked exactly once, and only when a live session is sitting in this
       * browser. A reader who arrived WITH a link still causes no call on load.
       */
      if (!arrived.token) {
        const open = storedSession();
        if (open && open.expiresAt > Date.now()) {
          whoAmI().then(who => {
            if (!who || who === 'unreachable') return;
            if (who.passwordSet) {
              location.href = '/account/';
              return;
            }
            onSession = true;
            document.documentElement.dataset.acct = 'choose';
          });
        }
      }

      /* Screenshot switches. Dev only: the whole block goes when the site is built. */
      if (import.meta.env.DEV) {
        const state = new URLSearchParams(location.search).get('state');
        if (state === 'expired') goExpired();
        if (state === 'code') document.documentElement.dataset.acct = 'code';
        if (state === 'new') document.documentElement.dataset.acct = 'new';
        if (state === 'back') document.documentElement.dataset.acct = 'back';
        if (state === 'busy') { busyOn('ac-token-go', true, 'Saving…'); sayOn('ac-token-status', 'Saving…', 'busy'); }
        if (state === 'error') sayOn('ac-token-status', sayFor('weak'), 'bad');
      }
    }
  </script>
</Base>
