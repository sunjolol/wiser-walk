---
/**
 * Log in. Email and the password they chose.
 *
 * The model for every account page since the design pass of 2026-09-22 (the brief is
 * design/accounts/PASS-BRIEF.md). Built the way the forms a reader already knows are built:
 * a label they can see above each field, the fields and the button on the first screen of a
 * phone with nothing above them but the heading, "Forgot your password?" as a plain link
 * straight under the button, and one line for somebody who has no account yet. No lede that
 * repeats the heading, no reasons, no small print.
 *
 * One message covers both fields whatever goes wrong, so nothing here tells a stranger
 * which addresses have accounts.
 *
 * The route stays /account/sign-in/ (links in sent emails point at it); every WORD on the
 * site says "Log in", because "Sign in" and "Sign up" differ by two letters and people press
 * the wrong one.
 */
import '../../styles/pages/account.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AccountBand from '../../components/AccountBand.astro';
import { ACCOUNTS_READY } from '../../lib/account/config';
---
<Base
  title="Log in"
  description="Log in to Wiser Walk with your email and password."
  noindex={true}
>
  {!ACCOUNTS_READY ? (
    <AccountBand
      eyebrow="Your account"
      icon="users"
      title="Accounts are not switched on yet."
      accent="not switched on yet."
      lede="Everything you finish is still saved on this device in the meantime, and it is all on one page."
    >
      <p class="ac-acts">
        <a class="btn ac-btn" href="/me/">See my results <Icon name="arrow" size={16} /></a>
      </p>
    </AccountBand>
  ) : (
    <AccountBand eyebrow="Welcome back" icon="users" title="Log in." accent="in.">
      {/*
        GOOGLE GOES HERE, LATER, AND NOTHING MOVES WHEN IT DOES.
        One 52px "Continue with Google" control above the fields, then a hairline of the
        brand's gradient with the word "or" across it (.ac-btn--plain and .ac-or in
        account.css). It is not rendered until it works: a control that does nothing is worse
        than a control that is not there.
      */}
      {/* method="post": if the script has not loaded when Enter is pressed, the browser
          must not put the password in the address bar, which is what a form with no method
          does. The static page answers a POST with an error; nothing is sent anywhere. */}
      <form class="ac-form" id="ac-form" method="post" novalidate>
        {/* Hidden from people, irresistible to naive bots. Not a CAPTCHA and never will be. */}
        <p class="hp" aria-hidden="true">
          <label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="ac-row">
          <div class="ac-group">
            <label class="ac-label" for="ac-email">Email address</label>
            <span class="ac-cell">
              <span class="ac-cell-icon" aria-hidden="true"><Icon name="mail" size={17} /></span>
              <input class="ac-field" id="ac-email" name="email" type="email" required
                     autocomplete="username" inputmode="email" spellcheck="false" autocapitalize="none"
                     aria-describedby="ac-status" />
            </span>
          </div>
          <div class="ac-group">
            <label class="ac-label" for="ac-pw">Password</label>
            <span class="ac-cell">
              <span class="ac-cell-icon" aria-hidden="true"><Icon name="key" size={17} /></span>
              <input class="ac-field ac-field--pw" id="ac-pw" name="password" type="password" required
                     autocomplete="current-password" spellcheck="false" autocapitalize="none" autocorrect="off"
                     aria-describedby="ac-status" />
              <button class="ac-show" type="button" data-show="ac-pw" aria-pressed="false">Show</button>
            </span>
          </div>
          <p class="ac-status" id="ac-status" role="status" aria-live="polite"></p>
          <button class="btn ac-btn" id="ac-go" type="submit">Log in</button>
        </div>
        <p class="ac-under"><a href="/account/forgot/" id="ac-forgot">Forgot your password?</a></p>
      </form>
      <p class="ac-alt ac-alt--foot">New here? <a href="/account/sign-up/">Sign up</a></p>
    </AccountBand>
  )}

  <script>
    import { signIn, sayFor } from '../../lib/account/client';
    import { wirePasswordToggles, safeNext, flagFields, carryEmail, carriedEmail } from '../../lib/account/form';

    const form = document.getElementById('ac-form') as HTMLFormElement | null;
    if (form) {
      const status = document.getElementById('ac-status')!;
      const button = document.getElementById('ac-go') as HTMLButtonElement;
      const email = document.getElementById('ac-email') as HTMLInputElement;
      const pw = document.getElementById('ac-pw') as HTMLInputElement;

      wirePasswordToggles(form);
      if (!email.value) email.value = carriedEmail();

      const say = (text: string, kind?: string) => {
        status.textContent = text;
        status.className = 'ac-status' + (kind ? ' is-' + kind : '');
      };
      const busy = (on: boolean) => {
        button.disabled = on;
        button.textContent = on ? 'Logging in…' : 'Log in';
      };

      // The address travels to "forgot your password" in session storage, not the URL.
      document.getElementById('ac-forgot')?.addEventListener('click', () => carryEmail(email.value));

      form.addEventListener('submit', event => {
        event.preventDefault();
        if (button.disabled) return;
        flagFields([email, pw], false);
        // The honeypot. A bot that fills it is told nothing and nothing is sent.
        const trap = form.elements.namedItem('website') as HTMLInputElement | null;
        if (trap && trap.value) {
          say(sayFor('wrong'), 'bad');
          return;
        }
        if (!email.value.trim() || !pw.value) {
          flagFields([!email.value.trim() ? email : null, !pw.value ? pw : null], true);
          say(!email.value.trim() ? 'Enter your email address.' : 'Enter your password.', 'bad');
          (!email.value.trim() ? email : pw).focus();
          return;
        }

        busy(true);
        say('Logging in…', 'busy');
        signIn(email.value, pw.value).then(done => {
          if (done.ok) {
            location.href = safeNext(new URLSearchParams(location.search).get('next'));
            return;
          }
          busy(false);
          // Keep the address, clear the password: the one they typed was wrong, and a field
          // that still holds it invites pressing the button again unchanged.
          if (done.code === 'wrong') {
            pw.value = '';
            flagFields([email, pw], true);
            pw.focus();
          }
          say(done.say, 'bad');
        });
      });

      /* Screenshot switches. Dev only: the whole block goes when the site is built. */
      if (import.meta.env.DEV) {
        const state = new URLSearchParams(location.search).get('state');
        if (state === 'busy') { busy(true); say('Logging in…', 'busy'); }
        if (state === 'error') { flagFields([email, pw], true); say(sayFor('wrong'), 'bad'); }
      }
    }
  </script>
</Base>
