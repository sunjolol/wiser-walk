---
/**
 * Check your email.
 *
 * Somebody lands here having just acted, and leaves again within a minute. So the page is
 * the band and nothing under it: the address printed back big, because the commonest
 * failure in this whole flow is a typo and showing it is the fix; the exact subject line and
 * sender to look for; the way round a missing email; and the six digits for a link that
 * will not open.
 *
 * THE SUBJECT IS NAMED WORD FOR WORD. Sign-up and "you already have an account" send
 * different emails under ONE subject (emails.ts), so the page can print it without knowing
 * which went, and a stranger learns nothing about who has an account here. `?k=recovery`
 * says the email was a reset, which has its own subject; it carries nothing personal.
 *
 * The address comes out of sessionStorage, written by the page that sent the email, NOT out
 * of the URL. It would only ever have been in the reader's own address bar, but it would
 * also have been in a server log, and there is no reason for it to be. When it is not there
 * (a new tab, storage blocked, the honeypot) the address line and the resend are left out,
 * and one link to ask again takes their place.
 */
import '../../styles/pages/account.css';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AccountBand from '../../components/AccountBand.astro';
import { ACCOUNTS_READY } from '../../lib/account/config';
import { SUBJECT_SET, SUBJECT_RESET } from '../../lib/account/emails';

const quoted = (subject: string) => `“${subject}”`;
/* The last two words of a headline are tied, so no width ever leaves one word alone on the
   last line (the owner's rule: a lone last word is "super sloppy"). */
const tie = (s: string) => s.replace(/ (?=\S+$)/, String.fromCharCode(160));
---
<Base
  title="Check your email"
  description="What to look for in your inbox, and how to ask again."
  noindex={true}
>
  {!ACCOUNTS_READY ? (
    <AccountBand
      eyebrow="Your account"
      icon="users"
      title="Accounts are not switched on yet."
      accent="not switched on yet."
      lede="Everything you finish is still saved on this device in the meantime, and it is all on one page."
    >
      <p class="ac-acts">
        <a class="btn ac-btn" href="/me/">See my results <Icon name="arrow" size={16} /></a>
      </p>
    </AccountBand>
  ) : (
    <AccountBand eyebrow="Sent" icon="mail" title={tie('Now check your email.')} accent={tie('your email.')}>
      <div class="ac-sent">
        {/* Empty and hidden until the script below finds the address. A stand-in such as
            "the address you gave us" printed in display type read as a heading, and a line
            that cannot say the real thing is better left out than faked (2026-09-22). */}
        <div class="ac-to" id="ac-to-box" hidden>
          <p class="ac-to-addr" id="ac-to"></p>
          <p class="ac-alt">Wrong address? <a href="/account/sign-up/" id="ac-back">Change it</a></p>
        </div>
        <p class="ac-look">
          Look for <b id="ac-subject" data-reset={quoted(SUBJECT_RESET)}>{quoted(SUBJECT_SET)}</b> from
          Wiser Walk. The link works for an hour.
        </p>
        <p class="ac-look">Not there? Check spam or promotions.</p>
        {/* The wait in words, then the button in its place; both hold the same 52px, so the
            swap moves nothing. Sixty seconds, because that is Supabase's own cooldown per
            address and a resend inside it would only be refused. With no address there is
            nothing to resend to, so the page says where to go instead of counting down to
            a button that cannot work. */}
        <div class="ac-again" id="ac-again-box" hidden>
          <p class="ac-wait" id="ac-wait">You can ask again in 60s</p>
          <button class="btn ac-btn ac-btn--glass" id="ac-again" type="button" hidden>Send it again</button>
        </div>
        <p class="ac-alt" id="ac-other"><a href="/account/sign-up/" id="ac-other-link">Ask for another email</a></p>
        {/*
          Settled here rather than by the bundle, so the address, the subject and the way to
          ask again are right on first paint instead of changing under somebody who has
          already started reading. With the script blocked the page is the no-address one.
        */}
        <script is:inline>
          (function () {
            var to = '';
            try { to = sessionStorage.getItem('ww.acct.to') || ''; } catch (e) {}
            if (to) {
              document.getElementById('ac-to').textContent = to;
              document.getElementById('ac-to-box').hidden = false;
              document.getElementById('ac-again-box').hidden = false;
              document.getElementById('ac-other').hidden = true;
            }
            if (/[?&]k=recovery(&|$)/.test(location.search)) {
              var subject = document.getElementById('ac-subject');
              subject.textContent = subject.getAttribute('data-reset');
              document.getElementById('ac-back').setAttribute('href', '/account/forgot/');
              document.getElementById('ac-other-link').setAttribute('href', '/account/forgot/');
            }
          })();
        </script>
        <p class="ac-status" id="ac-status" role="status" aria-live="polite"></p>
        <p class="ac-alt"><a href="/account/password/" id="ac-code">Use the 6-digit code instead</a></p>
      </div>
    </AccountBand>
  )}

  <script>
    import { requestLink, requestReset, sayFor } from '../../lib/account/client';
    import { carryEmail } from '../../lib/account/form';

    const addr = document.getElementById('ac-to');
    if (addr) {
      const status = document.getElementById('ac-status')!;
      const again = document.getElementById('ac-again') as HTMLButtonElement;
      const wait = document.getElementById('ac-wait')!;
      const recovery = new URLSearchParams(location.search).get('k') === 'recovery';

      let email = '';
      try { email = sessionStorage.getItem('ww.acct.to') || ''; } catch { /* blocked: no resend */ }

      // "Change it" and the code page both open with the address already in the field.
      const carry = () => carryEmail(email);
      document.getElementById('ac-back')?.addEventListener('click', carry);
      document.getElementById('ac-code')?.addEventListener('click', carry);

      const say = (text: string, kind?: string) => {
        status.textContent = text;
        status.className = 'ac-status' + (kind ? ' is-' + kind : '');
      };

      /* Counted down in words, then the button. Not a greyed button with a number on it:
         a control that cannot be pressed reads as broken, and a sentence reads as a wait. */
      let left = 0;
      let timer = 0;
      const tick = () => {
        if (left > 0) {
          wait.textContent = 'You can ask again in ' + left + 's';
          wait.hidden = false;
          again.hidden = true;
          left -= 1;
          return;
        }
        window.clearInterval(timer);
        wait.hidden = true;
        again.hidden = false;
      };
      const hold = (seconds: number) => {
        left = seconds;
        window.clearInterval(timer);
        tick();
        timer = window.setInterval(tick, 1000);
      };

      again.addEventListener('click', () => {
        // The button is only ever shown with an address to send to.
        if (again.disabled || !email) return;
        again.disabled = true;
        again.textContent = 'Sending…';
        say('');
        (recovery ? requestReset(email) : requestLink(email)).then(done => {
          again.disabled = false;
          again.textContent = 'Send it again';
          if (!done.ok) {
            say(done.say, 'bad');
            return;
          }
          say('Sent again.', 'ok');
          hold(60);
        });
      });

      // They asked for an email a second ago, so the wait starts now rather than on a press.
      // No address, no wait: the inline script has put "Ask for another email" there.
      if (email) hold(60);

      /* Screenshot switches. Dev only: the whole block goes when the site is built.
         `?state=none` is the page with no address, which is also what a bare load shows. */
      if (import.meta.env.DEV) {
        const state = new URLSearchParams(location.search).get('state');
        if (state && state !== 'none') {
          addr.textContent = 'reader@example.com';
          email = 'reader@example.com';
          document.getElementById('ac-to-box')!.hidden = false;
          document.getElementById('ac-again-box')!.hidden = false;
          document.getElementById('ac-other')!.hidden = true;
        }
        if (state === 'wait') { window.clearInterval(timer); left = 42; tick(); window.clearInterval(timer); }
        if (state && state !== 'wait' && state !== 'none') { window.clearInterval(timer); left = 0; tick(); }
        if (state === 'error') say(sayFor('cooldown'), 'bad');
        if (state === 'sent') say('Sent again.', 'ok');
        if (state === 'busy') { again.disabled = true; again.textContent = 'Sending…'; }
        if (state === 'long') addr.textContent = 'a.very.long.address.for.testing@some-long-domain.example.com';
      }
    }
  </script>
</Base>
