---
import Hero from '../components/Hero.astro';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { QUIZZES, liveQuizzes, getQuiz } from '../lib/engine/registry';
import { liveGames } from '../lib/games';
import { ACCOUNTS_READY } from '../lib/account/config';
import { artFor } from '../lib/art';
import audit from '../data/compass-audit.json';

/*
 * The three counts below are read off the registry and the content collection, so the
 * page cannot drift out of date the way a typed number would.
 */
const quizzes = liveQuizzes();
/*
 * A quiz that has not been through the audit is real, listed and countable — the quizzes
 * index prints it — so this page counts it too rather than quietly reporting a smaller
 * site. The two pages cannot disagree about how many quizzes exist.
 */
const drafts = QUIZZES.filter(q => q.status !== 'live');
const games = liveGames();
const articles = (await getCollection('articles')).filter(a => !a.data.draft);
const compass = getQuiz('theology-compass')!;
const game = games[0];

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

/*
 * The pictures for the three rooms below.
 *
 * The quizzes wear Doré's engravings everywhere on this site, so the quizzes room takes
 * one from art.ts rather than a photograph: the band above this is already the dawn sky,
 * and the same picture twice on one page has been rejected once already. The games take
 * the manuscript page they are drawn on everywhere else, and the articles take the
 * painting the articles index opens with — colour, where the quizzes are ink.
 */
const quizPic = artFor('bible-figure');
const READS_PIC = '/img/reads-harvest.jpg';

/*
 * The fairness figures are counted off the audit file the method page publishes, so this
 * page cannot claim a number that page does not show.
 */
const changes = (audit.changelog ?? []).length;
const refused = (audit.disputed ?? []).length;
const sheets = (audit.simulations ?? []).filter(
  (s: Record<string, any>) => Array.isArray(s.answers) && s.answers.length
).length;

/*
 * The address people write to when something here is wrong. One constant, printed twice on
 * this page (once in the prose, once as the button beside it), so the two can never drift.
 * It is a real mailbox the owner made; nothing on the site sends to it automatically.
 */
const CONTACT = 'info@wiserwalk.com';

/* Creative Commons Attribution 4.0: the licence the words and the quiz data are published
   under, said once here and marked up so a machine reading the page can see it too. It
   covers what this site wrote. The Bible text and the pictures are public-domain works that
   were never ours to license, which the section below says plainly. */
const LICENCE = 'https://creativecommons.org/licenses/by/4.0/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Wiser Walk',
  url: new URL('/about/', Astro.site).href,
  license: LICENCE
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' }
];
---
<Base
  title="About"
  description="What Wiser Walk is, what it is not, and who is behind it."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="About"
    eyebrow="Wiser Walk"
    icon="compass"
    kind="photo"
    image="/img/sky-rays.jpg"
    imagePosition="24% 14%"
    tiles={[
      { n: quizzes.length + drafts.length, label: quizzes.length + drafts.length === 1 ? 'Quiz' : 'Quizzes' },
      { n: drafts.length, label: 'In draft' },
      { n: games.length, label: games.length === 1 ? 'Game' : 'Games' },
      { n: articles.length, label: articles.length === 1 ? 'Article' : 'Articles' }
    ]}
  >
      Wiser Walk is a place to understand yourself a little better — through quizzes worth
      taking and articles worth reading.
  </Hero>

  <SectionHead title="What this is" kicker="Three kinds of thing, one idea" />

  <section class="pnl pnl--split">
    <div class="doc doc--lead">
      <p>
        Self-assessments and short essays for Christians who would rather see themselves
        clearly than comfortably. Some of the quizzes are serious, some are lighter. Not all
        of them are about theology: some are about character, some about gifts, some about how
        well you actually know the Bible.
      </p>
      <p>
        The quizzes are the door. The articles are what is on the other side of it.
      </p>
      {/* Method left the nav, so this is the way to it: one plain sentence, on the page a
          reader goes to when they want to know who is behind the thing. */}
      <p><a href="/method/">How the quizzes are made and checked</a>.</p>
    </div>
    <aside class="pnl-aside">
      <p class="pnl-kicker">The site, in facts</p>
      <dl class="spec spec--quiet">
        <div><dt>Quizzes</dt><dd>{quizzes.length} live, {drafts.length} in draft</dd></div>
        <div><dt>Games</dt><dd>{plural(games.length, 'game', 'games')}</dd></div>
        <div><dt>Articles</dt><dd>{plural(articles.length, 'piece', 'pieces')}</dd></div>
        <div><dt>Costs</dt><dd>Nothing</dd></div>
      </dl>
    </aside>
  </section>

  {/*
    The three kinds of thing, as rooms (the dawn pass, 2026-09-21). They were three stripe
    cards, which is the shape every list on the site had worn out; each one now carries the
    picture that kind of thing wears everywhere else, so the page shows what it describes.
    The pictures are decorative: each card is one link, and its title says where it goes.
  */}
  <ul class="ab-rooms">
    <li>
      <a class="ab-room ab-room--ink" href="/quizzes/">
        <img src={quizPic!.src} alt="" loading="lazy" decoding="async"
             width="820" height="1029" style={`object-position:${quizPic!.objectPosition}`} />
        <span class="nx-body">
          <span class="nx-mark" aria-hidden="true"><Icon name={compass.icon} size={18} /></span>
          <span class="nx-kind">{plural(quizzes.length, 'quiz', 'quizzes')}</span>
          <b class="nx-title">Quizzes</b>
          <span class="nx-say">{compass.tagline}</span>
          <span class="nx-go">All quizzes <Icon name="arrow" size={14} /></span>
        </span>
      </a>
    </li>
    {game && (
      <li>
        <a class="ab-room" href="/games/">
          <img src="/img/game-manuscript.jpg" alt="" loading="lazy" decoding="async"
               width="1400" height="858" style="object-position:50% 40%" />
          <span class="nx-body">
            <span class="nx-mark" aria-hidden="true"><Icon name={game.icon} size={18} /></span>
            <span class="nx-kind">{plural(games.length, 'game', 'games')}</span>
            <b class="nx-title">Games</b>
            <span class="nx-say">{game.tagline}</span>
            <span class="nx-go">All games <Icon name="arrow" size={14} /></span>
          </span>
        </a>
      </li>
    )}
    <li>
      <a class="ab-room" href="/articles/">
        <img src={READS_PIC} alt="" loading="lazy" decoding="async"
             width="1280" height="1011" style="object-position:50% 46%" />
        <span class="nx-body">
          <span class="nx-mark" aria-hidden="true"><Icon name="book" size={18} /></span>
          <span class="nx-kind">{plural(articles.length, 'piece', 'pieces')}</span>
          <b class="nx-title">Articles</b>
          <span class="nx-say">Plain, practical writing on Christian formation: gratitude, joy, and what it actually means to be Christ-like.</span>
          <span class="nx-go">All articles <Icon name="arrow" size={14} /></span>
        </span>
      </a>
    </li>
  </ul>

  <SectionHead title="What this is not" kicker="Four things worth saying plainly" />

  {/*
    Still no promises about storage here. An account is something a reader may have and may
    not, so a flat line about it on this page would be a claim about a thing half of them
    have never seen; what is kept, and when, is said once on /method/, where it can be kept
    current, and this page links there in the section below.
  */}
  <ul class="facts facts--pair">
    <li><strong>Not a verdict on your faith.</strong> No quiz here scores anyone as a better or worse Christian.</li>
    <li><strong>Not a recruiting tool.</strong> The Compass tells you where you already stand; it does not argue you toward a position.</li>
    <li><strong>Not a church.</strong> Nothing here substitutes for one.</li>
    {ACCOUNTS_READY
      ? <li><strong>Not a mailing list you get put on.</strong> There is one. Nothing is sent unless you type your address in yourself, the box you type it into says what will come, and one link in any email stops it.</li>
      : <li><strong>Not a mailing list you get put on.</strong> There is one, and it is entirely opt-in: nothing is sent unless you type your address in and ask.</li>}
  </ul>

  <SectionHead title="On fairness" kicker="The one failure this site cannot afford" />

  <section class="pnl pnl--split dark">
    <div class="dark-ghost" aria-hidden="true">fairness</div>
    <div class="pnl-head">
      <p class="pnl-kicker"><Icon name="compass" size={13} /> The standard</p>
      <h2 class="pnl-title">Described in terms its holders would recognise.</h2>
    </div>
    <div>
      <div class="doc">
        <p>
          The hardest part of a quiz like this is describing a position you disagree with in
          terms its holders would recognise. That is the standard everything here is held to,
          and the <a href="/method/">method page</a> shows the working — including the findings
          that were raised and deliberately not applied.
        </p>
        <p>
          If you hold a position and think it is described unfairly, that is worth hearing.
          Being wrong about someone else's belief is the one failure this site cannot afford.
        </p>
        {/*
          Contact, and the only address on the site (the owner's steer, 2026-09-21). It sits
          in the fairness section rather than under a "Contact" heading of its own, because
          this is the message worth getting: a reader who recognises their own church in a
          description and can say what it gets wrong. The line asks for the three things that
          make a correction actionable, so an email arrives ready to act on instead of
          starting a conversation.
        */}
        <p>
          Write to <a href={`mailto:${CONTACT}`}>{CONTACT}</a>. Quote the line, say what it
          should say instead, and name the confession, catechism or standard work you would
          look it up in. That is enough to act on.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn" href={`mailto:${CONTACT}`}>Email a correction</a>
        <a class="btn ghost" href="/method/">The method</a>
        <a class="btn ghost" href="/method/changelog/">What changed</a>
      </div>
    </div>
    <aside class="pnl-aside">
      <p class="pnl-kicker">The audit, in figures</p>
      <dl class="spec spec--quiet">
        <div><dt>Traditions on the map</dt><dd>{compass.outcomes.length}</dd></div>
        <div><dt>Changes published</dt><dd>{changes}</dd></div>
        <div><dt>Argued and refused</dt><dd>{refused}</dd></div>
        <div><dt>Answer sheets re-tested</dt><dd>{sheets}</dd></div>
      </dl>
    </aside>
  </section>

  {/*
    What a reader may do with all of this (the owner's decision, 2026-09-21). The id is what
    the one line in the footer points at, so the link lands on the permission rather than at
    the top of the page.

    The permission comes first and in plain words, because that is the sentence a Sunday
    school teacher standing at a photocopier needs. The licence name and the two exceptions
    follow underneath, on the same page and as visible text rather than behind a link: they
    are the answer to "yes, but really?", and a reader who has to click for that has been
    told half of something. There is no block of legal text, and there is not going to be.
  */}
  <SectionHead id="use" title="Take it with you" kicker="What you may do with everything here" />

  <section class="pnl pnl--split">
    <div class="doc doc--lead">
      <p>
        <strong>Use it.</strong> Print anything here for a class, a small group or a church,
        or quote it, as long as you say where it came from and link back.
      </p>
      <p>
        That is a real permission and not a slogan. The writing on this site and the data
        behind the quizzes are published under a Creative Commons
        <a href={LICENCE} rel="license">Attribution 4.0 licence</a>, which lets anyone copy,
        print, translate, adapt and hand on the work, for money or not, on one condition:
        credit Wiser Walk and link to where you found it.
      </p>
      <p>
        Two things here were never ours to give away, and both are already free. The Bible
        text is the Berean Standard Bible and the World English Bible, British Edition, and
        the people who made each of them put it into the public domain. The paintings and
        engravings are public-domain works too, each credited under the picture it belongs
        to. Nobody needs our permission for any of that, or anyone else's.
      </p>
      <p>
        No permission form, no request needed. If you do something interesting with it,
        <a href={`mailto:${CONTACT}`}>tell us</a>, because it is good to know.
      </p>
    </div>
    <aside class="pnl-aside">
      {/* No mark on this kicker: the two other light asides on this page carry none, and a
          lone icon here would read as an accident rather than a decision. */}
      <p class="pnl-kicker">In short</p>
      <dl class="spec spec--quiet">
        <div><dt>The writing</dt><dd>CC BY 4.0</dd></div>
        <div><dt>The quiz data</dt><dd>CC BY 4.0</dd></div>
        <div><dt>Bible text</dt><dd>Public domain</dd></div>
        <div><dt>Pictures</dt><dd>Public domain</dd></div>
        <div><dt>Asking first</dt><dd>Not needed</dd></div>
      </dl>
    </aside>
  </section>
</Base>
