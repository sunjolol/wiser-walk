---
import Base from '../../../layouts/Base.astro';
import { decode, AXES } from '../../../lib/compass';
export function getStaticPaths() { return []; }
const { a, b } = Astro.params;
const sa = decode(String(a).toUpperCase());
const sb = decode(String(b).toUpperCase());
---
<Base title="Compare compasses" description="Two results side by side.">
  <h1>Compare</h1>
  {sa && sb ? (
    <ul>{AXES.map((ax, i) => <li>{ax.name}: {sa[i]} vs {sb[i]}</li>)}</ul>
  ) : <p>Scaffold: needs two valid codes.</p>}
</Base>
