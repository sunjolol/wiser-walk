---
/**
 * The comparison hub.
 *
 * Twelve pairs, and the useful thing to say about them is not alphabetical order: it is how
 * far apart the two actually land on the instrument. So the cards are grouped by how many of
 * the six axes put the pair in the SAME AUDITED BAND — a number computed here from the
 * audited positions, never typed — and a reader can see at a glance that Catholic and
 * Orthodox share five of six while Baptist and Catholic share none.
 *
 * The one thing that grouping must not be allowed to imply is agreement, so the line under
 * the band says what a band is and what it is not, once, before the first card.
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CompareCard from '../../components/CompareCard.astro';
import CompassCard from '../../components/CompassCard.astro';
import Icon from '../../components/Icon.astro';
import { compare } from '../../lib/engine/registry';
import type { BipolarComparison } from '../../lib/engine/compare';
import {
  COMPARISONS, COMPARE_QUIZ, comparedTraditions, compareHref, traditionOf
} from '../../lib/comparisons';
import '../../styles/pages/compare.css';

const quiz = COMPARE_QUIZ;

/** Every pair with its own same-band count, from the same call each page makes. */
const pairs = COMPARISONS.map(c => {
  const cmp = compare(quiz, traditionOf(c.a).position ?? [], traditionOf(c.b).position ?? []) as BipolarComparison;
  return { c, same: cmp.sameCount };
}).sort((x, y) => y.same - x.same || x.c.slug.localeCompare(y.c.slug));

/*
 * Three shelves, by the instrument's own reading. The boundaries are stated in the kicker of
 * each one, so nothing is grouped by a rule the reader cannot check against the cards.
 */
const BANDS: Array<{ id: string; title: string; kicker: string; keep: (n: number) => boolean }> = [
  {
    id: 'near',
    title: 'Near neighbours',
    kicker: 'Same band on four or more of the six',
    keep: n => n >= 4
  },
  {
    id: 'mixed',
    title: 'Common ground, and real differences',
    kicker: 'Same band on two or three of the six',
    keep: n => n === 2 || n === 3
  },
  {
    id: 'apart',
    title: 'Furthest apart',
    kicker: 'Same band on one of the six, or none',
    keep: n => n <= 1
  }
];
const shelves = BANDS.map(b => ({ ...b, items: pairs.filter(p => b.keep(p.same)) }))
  .filter(b => b.items.length > 0);

const traditions = comparedTraditions();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Compare traditions',
  url: new URL('/compare/', Astro.site).href,
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  hasPart: COMPARISONS.map(c => ({
    '@type': 'WebPage',
    name: c.h1,
    description: c.description,
    url: new URL(compareHref(c.slug), Astro.site).href
  }))
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare/' }
];
const many = COMPARISONS.length;

/*
 * The Compass card's sentence, counted from the quiz rather than typed, so it cannot go on
 * saying "eighteen" after a statement or a tradition is added. Spelled out, as the site
 * writes small counts in running prose.
 */
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
  'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen',
  'nineteen', 'twenty'];
const spell = (n: number) => WORDS[n] ?? String(n);
---
<Base
  title="Compare traditions"
  description="What is the difference between Lutheran and Reformed, Calvinism and Arminianism, Catholic and Orthodox? Each pair side by side on six audited axes."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="Compare traditions"
    kind="painting"
    image="/img/compare-peter-paul.jpg"
    imageAlt=""
    imagePosition="50% 10%"
    credit="El Greco, Saint Peter and Saint Paul, 1590–1600"
    lede="What is the actual difference between two churches? Each pair answered in a
          paragraph, then drawn on the same six rails."
    tiles={[
      { n: many, label: many === 1 ? 'Comparison' : 'Comparisons' },
      { n: traditions.length, label: 'Traditions' },
      { n: quiz.groups.length, label: 'Axes drawn' }
    ]}
  />

  <div class="cmpx cmpx--hub">
    {shelves.map(shelf => (
      <section class="cmpx-shelf">
        <SectionHead title={shelf.title} id={`shelf-${shelf.id}`} />
        {shelf.id === 'near' && (
          <p class="cmpx-note">
            Landing in the same band is not agreeing: two families can reach one band by
            different roads, and the pages say where each road ran.
          </p>
        )}
        {/* Each card carries its own count, as the ghost behind its words and in its colour
            (components/CompareCard.astro); the kicker above says what the count is of. */}
        <div class="cmpx-cards">
          {shelf.items.map(({ c }) => <CompareCard c={c} />)}
        </div>
      </section>
    ))}

    {traditions.length > 0 && (
      <section class="cmpx-shelf">
        <SectionHead title="Or read one on its own" />
        <ul class="cmpx-trads">
          {traditions.map(t => (
            <li>
              <a href={`/tradition/${t.slug}/`}>
                <span>{t.name}</span><Icon name="arrow" size={13} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="cmpx-way">
      <CompassCard level={2} />
    </div>
  </div>
</Base>
