---
/**
 * One person from the Bible, as the figure quiz places them.
 *
 * This is the tradition page's sibling, and deliberately so: the same band, the same dark
 * feature half with the instrument on it, the same rails, the same neighbour list, and the
 * quiz's own card at the foot. What differs is what the page is made of. A tradition's
 * position is a sketch of where adherents land; a figure's position is an ARGUMENT FROM THE
 * TEXT, so the page prints the argument — every cited act that put the figure where they
 * are, grouped by axis, with both pole names on every heading.
 *
 * Rules this page keeps, in the order it would be wrong to break them:
 *
 * 1. **No percentage against a person, anywhere.** The quiz sets hideOutcomeScore, so the
 *    neighbour list ranks by bar length and says "Closest" in words. "84% like Jesus" is the
 *    sentence this site exists not to print.
 * 2. **Every sentence comes from the data.** No commentary is written here. The `did` lines,
 *    the quotations, the references, the band adjectives and the axis summaries are all in
 *    the quiz or in bible-figures.json; this file arranges them.
 * 3. **Two kinds of middle, never conflated.** A coordinate at 50 because the text records
 *    acts toward BOTH poles is said to be that; a coordinate at 50 because the text records
 *    nothing on that axis is said to be that. The data tells them apart (a not-shown cell is
 *    a single item with a null ref), and so does the page.
 * 4. **noindex while the quiz is a draft**, and no breadcrumb trail either: a trail is a
 *    claim about where a page sits in a site search engines are invited to read.
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import CorrectionNote from '../../components/CorrectionNote.astro';
import FigureRecord from '../../components/FigureRecord.astro';
import PersonPage from '../../components/PersonPage.astro';
import { bibleFigure } from '../../lib/quizzes/bible-figure';
import type { FigureOutcome } from '../../lib/quizzes/bible-figure';
import { quizHref } from '../../lib/engine/registry';
import { outcomeNounPlural } from '../../lib/engine/types';
import { artFor, artForOutcome } from '../../lib/art';
import { clip } from '../../lib/seo';
import { FIGURE_PAGES } from '../../lib/saints/figures';
import { plain } from '../../lib/saints/rich';

export function getStaticPaths() {
  return bibleFigure.outcomes.map(f => ({ params: { slug: f.slug }, props: { figure: f } }));
}

const { figure } = Astro.props as { figure: FigureOutcome };
const quiz = bibleFigure;
const isDraft = quiz.status === 'draft';

/** Counted as components/FigureRecord.astro counts them, for the band's tiles and the title. */
const momentCount = quiz.groups.reduce((n, g) => n + (figure.evidence[g.key] ?? []).filter(e => e.ref).length, 0);
const matchedAxes = figure.mask.filter(m => m === 'shown').length;

/* Doré's own plate of this person where one exists and shows nothing violent; the quiz's
   picture where it does not. A page never pretends to a portrait the plates do not hold. */
const art = artForOutcome(quiz.slug, figure.slug);
/**
 * The card at the foot is the quiz's own engraving card, as the home page and /quizzes/
 * draw it (the owner, 2026-09-22: "literally everywhere it appears it should be
 * standardized"), and it carries the QUIZ's plate only when this page is not already
 * showing that plate in the band. A page that shows one picture twice is the mistake the
 * owner has already rejected once; null here means the card is drawn on the plate's own
 * brown without it (Moses, and the five figures who have no plate of their own).
 */
const quizArt = artFor(quiz.slug);
const wayArt = quizArt && quizArt.src !== art?.src ? quizArt : null;
const NUMBER_WORDS = [
  'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
  'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen',
  'nineteen', 'twenty'
];
/** The card's one line, about this person; the count is the quiz's own, and not one of its
    statements mentions the Bible (the home page's room says the same). */
const cardSay =
  `Answer ${NUMBER_WORDS[quiz.items.length] ?? quiz.items.length} plain statements about ` +
  `you, none of them about the Bible, and see how near you land to ${figure.name}.`;
/** The second fact, counted the way /quizzes/ counts it. */
const cardFact = `${quiz.outcomes.length} ${outcomeNounPlural(quiz)}`;
const cardStyle = wayArt
  ? [
      `--img-pos:${wayArt.objectPosition}`,
      wayArt.lift ? `--img-lift:${wayArt.lift}` : '',
      /* a plate art.ts dims for being printed light gets a deeper scrim, as on /quizzes/ */
      wayArt.lift && wayArt.lift < 1 ? '--room-dim:.38' : ''
    ].filter(Boolean).join(';')
  : undefined;

/**
 * THE TITLE AND THE DESCRIPTION (2026-09-21).
 *
 * The pages that rank for these people are titled around "in the Bible" and "character",
 * and this one was titled "What was Rahab like?", a narrower phrasing than anyone types.
 * So the name and "in the Bible" go first, and what the page actually holds follows.
 * ", with verses" is added only where it fits inside the width a result is rendered at,
 * which is why a long name simply stops after the count.
 *
 * What the description may NOT say: that the page reads a personality off a person. It
 * holds recorded acts, each cited, and the axes are temperament rather than virtue, so
 * that is the word it uses. It also does not say "beside 24 others": the page lists six
 * neighbours, not twenty-four.
 */
const base = `${figure.name} in the Bible: ${momentCount} recorded acts`;
const title = base.length + 13 <= 60 ? `${base}, with verses` : base;
const description = clip(
  `${momentCount} recorded acts of ${figure.name}, each with its verse, and what they ` +
  'show about temperament. Part of a free Bible character quiz.'
);

/*
 * WebPage, not Article. The page was declaring itself an Article while carrying none of
 * an article's properties, and its own head said og:type website at the same time. It is
 * a reference page about a person, which is what WebPage and `about` a Person say.
 *
 * The plate is declared the page's primary image ONLY where it is this person's own.
 * Five figures have no usable plate and wear the quiz's picture instead, which is Doré's
 * Moses; telling a machine that the primary image of a page about Rahab is an engraving
 * of Moses breaking the tablets is a small untruth, and a small untruth in markup is
 * still one. `artForOutcome` hands back the quiz's own object when it falls back, so the
 * question is answered by identity: if this is a different object, it was drawn for this
 * person. If that ever stops being true the check fails towards saying nothing, which is
 * the right way for it to fail.
 */
const ownPlate = art !== quizArt;
const siteId = new URL('/#website', Astro.site).href;
const jsonLd = isDraft
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: `${figure.name} on ${quiz.title}`,
      description,
      url: new URL(`/figure/${figure.slug}/`, Astro.site).href,
      isPartOf: [
        { '@id': siteId },
        { '@type': 'Quiz', name: quiz.title, url: new URL(quizHref(quiz), Astro.site).href }
      ],
      about: { '@type': 'Person', name: figure.name },
      ...(ownPlate && art
        ? {
            primaryImageOfPage: {
              '@type': 'ImageObject',
              url: new URL(art.src, Astro.site).href,
              caption: art.alt
            }
          }
        : {})
    };

const breadcrumbs = isDraft
  ? null
  : [
      { name: 'Home', url: '/' },
      { name: 'Quizzes', url: '/quizzes/' },
      { name: quiz.title, url: quizHref(quiz) },
      { name: figure.name, url: `/figure/${figure.slug}/` }
    ];

/*
 * A FIGURE WITH A PAGE OF ITS OWN (src/data/figures/<slug>.json): drawn like a saint's page, with
 * the quiz's record as its section "Where the quiz places him" and the quiz's card among the
 * quizzes. Its search listing, structured data and trail are the page's own, as a saint's are.
 */
const full = FIGURE_PAGES[figure.slug];
const fullUrl = new URL(`/figure/${figure.slug}/`, Astro.site).href;
const LICENSE: Record<string, string> = {
  CC0: 'https://creativecommons.org/publicdomain/zero/1.0/',
  'Public domain': 'https://creativecommons.org/publicdomain/mark/1.0/'
};
const fullOrg = { '@type': 'Organization', name: 'Wiser Walk', url: new URL('/', Astro.site).href };
const fullPic = full?.band.picture;
const fullLd = full && fullPic
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: full.seo.title,
      description: full.seo.description,
      url: fullUrl,
      mainEntityOfPage: fullUrl,
      datePublished: full.published,
      dateModified: full.modified,
      image: {
        '@type': 'ImageObject',
        contentUrl: new URL(fullPic.src, Astro.site).href,
        width: fullPic.width, height: fullPic.height,
        ...(LICENSE[fullPic.license] ? { license: LICENSE[fullPic.license] } : {}),
        ...(fullPic.creator ? { creator: { '@type': 'Person', name: fullPic.creator } } : {}),
        ...(fullPic.credit ? { creditText: fullPic.credit } : {})
      },
      author: fullOrg,
      publisher: fullOrg,
      about: {
        '@type': 'Person',
        name: full.name,
        ...(full.person.alternateName?.length ? { alternateName: full.person.alternateName } : {}),
        ...(full.person.birthPlace ? { birthPlace: full.person.birthPlace } : {}),
        ...(full.person.deathPlace ? { deathPlace: full.person.deathPlace } : {}),
        description: plain(full.who),
        sameAs: full.person.sameAs
      },
      isPartOf: [
        { '@type': 'CollectionPage', name: 'Saints and early Christians', url: new URL('/saints/', Astro.site).href },
        { '@type': 'Quiz', name: quiz.title, url: new URL(quizHref(quiz), Astro.site).href }
      ]
    }
  : null;
const fullCrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Saints and early Christians', url: '/saints/' },
  { name: figure.name, url: `/figure/${figure.slug}/` }
];
---
{full ? (
<Base title={full.seo.title} description={full.seo.description} jsonLd={fullLd} breadcrumbs={fullCrumbs} ogType="article">
  <PersonPage
    p={full}
    crumb={{ href: '/saints/#group=bible', label: 'People of the Bible' }}
    extraQuiz={{ href: quizHref(quiz), title: quiz.title, say: cardSay, img: (quizArt ?? art)?.src ?? '/img/durer-jerome.jpg' }}
    recordTitle={`Where the quiz places ${full.she ? 'her' : 'him'}`}
  >
    <div slot="record" class="ref ref--figure ref--in-person">
      <FigureRecord figure={figure} inPerson />
      <CorrectionNote subject={figure.name} />
    </div>
  </PersonPage>
</Base>
) : (
<Base
  title={title}
  description={description}
  noindex={isDraft}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title={figure.name}
    kind={art ? 'engraving' : 'night'}
    image={art?.src}
    imageAlt={art?.alt}
    imagePosition={art?.objectPosition}
    imageLift={art?.lift}
    long
    lede={figure.who}
    tiles={[
      { n: quiz.groups.length, label: 'Axes' },
      { n: momentCount, label: 'Cited acts' },
      { n: matchedAxes, label: 'Axes matched on' },
      { n: quiz.outcomes.length - 1, label: 'Others' }
    ]}
  />

  <div class="ref ref--figure">
    <FigureRecord figure={figure} />

    {/* The way back into the quiz: the quiz's own engraving card (see the note above
        `wayArt`). The plate is decorative here and carries no alt text: the card is one
        link, and the picture is described where it is the subject. Styles: .qcard in
        pages/reference.css. */}
    <div class="qcard-wrap">
      <a
        class:list={['qcard', wayArt ? 'qcard--pic' : 'qcard--plain', `qcard--${quiz.slug}`]}
        href={quizHref(quiz)}
        style={cardStyle}
      >
        {wayArt && (
          <img class="qcard-img" src={wayArt.src} alt="" loading="lazy" decoding="async" width="820" height="1029" />
        )}
        <div class="qcard-body">
          <p class="qcard-kicker">Your turn</p>
          <h2 class="qcard-title">{quiz.title}</h2>
          <p class="qcard-say">{cardSay}</p>
          <ul class="qcard-facts">
            <li><Icon name="clock" size={13} /> {quiz.minutes} min</li>
            <li>{cardFact}</li>
          </ul>
          <span class="qcard-go go-pill">Start <Icon name="arrow" size={16} /></span>
        </div>
      </a>
    </div>

    <CorrectionNote subject={figure.name} />
  </div>
</Base>
)}
