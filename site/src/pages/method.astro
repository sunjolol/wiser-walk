---
import Hero from '../components/Hero.astro';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import JumpBar from '../components/JumpBar.astro';
import Icon from '../components/Icon.astro';
import audit from '../data/compass-audit.json';
import { theologyCompass } from '../lib/quizzes/theology-compass';

import CorrectionNote from '../components/CorrectionNote.astro';
import { ACCOUNTS_READY, ACCOUNTS_VISIBLE } from '../lib/account/config';
/* The page's name for /me/, as the header names it: "My profile" once the public can see
   accounts, today's "My results" until then. */
const ME = ACCOUNTS_VISIBLE ? 'My profile' : 'My results';

const sheets = (audit.simulations ?? []) as Array<Record<string, any>>;
const landed = sheets.filter(s => Array.isArray(s.answers) && s.answers.length);
const disputed = (audit.disputed ?? []) as Array<Record<string, any>>;

/*
 * Every sheet's nearest tradition is its own — the check beside each name below is read
 * off the audit file, not asserted, so the list cannot claim a pass the data does not
 * show. If one ever failed, it would print without the mark rather than silently.
 */
const landsOnItself = (s: Record<string, any>) =>
  Array.isArray(s.nearest) && s.nearest[0] && s.nearest[0].name === s.tradition;

const SECTIONS = [
  { id: 'the-promise', label: 'The promise' },
  { id: 'the-audit', label: 'The audit' },
  { id: 'the-test', label: 'The test' },
  { id: 'the-numbers', label: 'The numbers' },
  { id: 'your-answers', label: 'Your answers' },
  { id: 'the-game', label: 'The game' }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How the Theology Compass was made',
  description: 'The adversarial fairness audit behind the Theology Compass, in public.',
  url: new URL('/method/', Astro.site).href
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Method', url: '/method/' }
];
---
<Base
  title="How this was made"
  description="The adversarial fairness audit behind the Theology Compass: twenty reviewers, 522 findings, 424 applied, and every answer sheet re-tested."
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <Hero
    title="How this was made"
    blue="made"
    kind="night"
    tiles={[
      { n: 20, label: 'Reviewers' },
      { n: 522, label: 'Findings' },
      { n: 424, label: 'Applied' },
      { n: disputed.length, label: 'Disputes' }
    ]}
  >
      A quiz that tells people what they believe has to be fair to beliefs its author does
      not hold. This page is the working, in public.
  </Hero>

  <div class="method">
    <JumpBar label="On this page" items={SECTIONS} numbered />

    <SectionHead id="the-promise" title="The promise" kicker="What every position on the map is held to" />

    <section class="pnl dark">
      <div class="dark-ghost" aria-hidden="true">fair</div>
      <div class="pnl-head">
        <p class="pnl-kicker"><Icon name="compass" size={13} /> The standard</p>
        <h2 class="pnl-title">In words its own holders would accept.</h2>
      </div>
      <div class="doc">
        <p>
          Every position on the Compass is described in words its own holders would accept. No
          band adjective names a rival tradition, flatters one side, or belittles the other.
          Nothing is invented: positions are traced to a confession, a council, or a standard
          work, and both poles of every axis are stated by someone who holds them.
        </p>
      </div>
    </section>

    <SectionHead id="the-audit" title="The audit" kicker="Twenty reviewers, briefed to find the unfairness" />

    <section class="pnl pnl--split">
      <div class="doc">
        <p>
          Twenty adversarial reviewers read the instrument, each briefed to find where it was
          unfair to a particular tradition or simply wrong. They raised <strong>522 findings</strong>.
          Each was then put through three independent verification lenses — is it accurate, is
          it a genuine fairness problem, and is the change necessary — and
          <strong>424 were kept and applied</strong>, including all 42 rated as blockers.
        </p>
        <p>
          Six tradition families were added during the audit because the original list did not
          represent them, bringing the map to {theologyCompass.outcomes.length}. A further
          {disputed.length} findings were considered and deliberately <em>not</em> applied. Every
          change, with its reason and the wording before and after, and every refusal, is on
          <a href="/method/changelog/">its own page</a>.
        </p>
      </div>
      <aside class="pnl-aside">
        <p class="pnl-kicker">The audit in figures</p>
        <dl class="spec spec--quiet">
          <div><dt>Reviewers</dt><dd>20, adversarial</dd></div>
          <div><dt>Findings raised</dt><dd>522</dd></div>
          <div><dt>Kept and applied</dt><dd>424</dd></div>
          <div><dt>Blockers</dt><dd>42, all applied</dd></div>
          <div><dt>Families added</dt><dd>6</dd></div>
          <div><dt>Traditions now</dt><dd>{theologyCompass.outcomes.length}</dd></div>
          <div><dt>Not applied</dt><dd>{disputed.length}</dd></div>
        </dl>
      </aside>
    </section>

    <SectionHead id="the-test" title="The test that has to pass" kicker={`${landed.length} answer sheets, re-scored before anything ships`} />

    <section class="pnl pnl--split">
      <div class="doc">
        <p>
          The audit produced {landed.length} answer sheets — one filled in as a well-catechised
          member of each tradition would answer it. The instrument only works if each sheet
          lands on its own tradition. All {landed.length} do, at 87–95% match.
        </p>
        <p>
          That check runs automatically before anything ships, against both the quiz engine and
          the original demo page, which implement the scoring independently. If a change to the
          wording or the scoring quietly moved someone's result, the build fails.
        </p>
      </div>
      <aside class="pnl-aside">
        <ul class="tiles">
          <li class="tile"><b>{landed.length}</b><span>Answer sheets</span></li>
          <li class="tile"><b>2</b><span>Implementations</span></li>
        </ul>
      </aside>
    </section>

    <SectionHead id="the-numbers" title="What the numbers mean" kicker="And what they do not mean" />

    <ul class="facts">
      <li>
        A match percentage is distance on the map, expressed against the widest gap between
        any two listed traditions. It is not a claim about how good a Christian anyone is.
      </li>
      <li>
        Axes near the middle name no position. A midpoint is not a conviction, so the
        headline only reports axes that actually lean.
      </li>
      <li>
        If nothing is close, the result says so rather than forcing a label. Answering
        “Unsure” throughout names no tradition at all.
      </li>
      <li>
        The listed traditions are a sketch of where typical adherents land, not official
        teaching, and not a complete list of Christian traditions.
      </li>
    </ul>

    <SectionHead id="your-answers" title="Your answers" kicker="What leaves your browser, and when" />

    <div class="stack stack--2">
      {/*
        Two truths, and the page prints whichever one is true of THIS build. Until the account
        keys are set there is no account to have, so a reader gets exactly the words the site
        has carried all along ("there is no account, and nothing about your result is stored on
        our side"). The moment accounts can exist, even unlinked, that sentence is false, and
        the second version takes its place. The owner's condition for shipping the hidden
        account code was that nothing about the site changes; this is how that holds here.
      */}
      {ACCOUNTS_READY ? (
        <Fragment>
      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">Scored on your device</p>
          <h2 class="pnl-title">Your answers stay here.</h2>
        </div>
        <div class="doc">
          <p>
            Every quiz is scored in your browser, and the answers themselves are never sent
            anywhere. A result link carries your scores, encoded, and nothing else. That is also
            why a broken link cannot be recovered.
          </p>
          <p>
            A result you finish is saved in your own browser, so you can find it again on
            <a href="/me/">{ME}</a>. Clearing the lot is one button on that page.
          </p>
          <p>
            The Psalm quiz works the same way. Your psalm is kept on this device and, when you
            are signed in, in your account, and its link carries only the psalm, never how you
            answered. While the tab is open it also remembers your answers, so the result can
            show you what led there; closing the tab forgets them.
          </p>
        </div>
      </section>

      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">If you have an account</p>
          <h2 class="pnl-title">What it keeps.</h2>
        </div>
        <div class="doc">
          <p>
            An account exists so your results are not stranded on one device. What it holds is
            the address you signed up with, the same result codes your browser already keeps and
            the date of each one, and three things from the games: your best score in each, and
            the Bible you chose for Sounds Like Scripture. Not your answers, which never leave
            your browser either way.
          </p>
          <p>
            This browser also keeps a short note of being signed in and of what it has already
            sent up, so the page knows where it stands before it asks. Clearing your browser's
            site data erases that note.
          </p>
          <p>
            One button on <a href="/me/">{ME}</a> clears every result from this device and
            from every other device you sign in on. A cleared result leaves a marker behind, and
            that marker is how your other devices know to drop it too: which quiz, which code and
            when, and nothing else. It is erased ninety days later, or when you delete your
            account, whichever comes first. Deleting the account takes the rest with it.
          </p>
        </div>
      </section>

      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">The email list</p>
          <h2 class="pnl-title">Only if you ask for it.</h2>
        </div>
        <div class="doc">
          <p>
            At the foot of every page you can sign up for news of new quizzes and games; that
            sends our email provider the address you typed and nothing else. At the bottom of a
            result page you can ask for a short follow-up series about the axes you leaned on
            hardest, which sends the address and the code from your result link, because the code
            is what makes those emails about <em>your</em> result rather than a generic one.
          </p>
          <p>
            This page used to say there was no email list. There is one now; saying otherwise
            while running one would be the same kind of dishonesty the rest of this page exists to
            rule out.
          </p>
        </div>
      </section>
        </Fragment>
      ) : (
        <Fragment>
      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">Scored on your device</p>
          <h2 class="pnl-title">Nothing is sent.</h2>
        </div>
        <div class="doc">
          <p>
            Every quiz is scored in your browser. Answers are never sent to a server, there is no
            account, and nothing about your result is stored on our side. A result link carries
            only your scores, encoded — which is also why a broken link cannot be recovered.
          </p>
          <p>
            A result you finish is now saved in your own browser, so you can find it again on
            <a href="/me/">{ME}</a>. It stays on that device and is not sent anywhere, and
            clearing the lot is one button on that page.
          </p>
          <p>
            The Psalm quiz works the same way. Your psalm is kept on this device, and its link
            carries only the psalm, never how you answered. While the tab is open it also
            remembers your answers, so the result can show you what led there; closing the tab
            forgets them.
          </p>
        </div>
      </section>

      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">The two exceptions</p>
          <h2 class="pnl-title">Only if you ask for it.</h2>
        </div>
        <div class="doc">
          <p>
            There are two exceptions, and each only happens if you ask for it. At the foot of
            every page you can sign up for news of new quizzes and games; that sends our email
            provider the address you typed and nothing else. And at the bottom
            of a result page you can request a short follow-up series about the axes you leaned on
            hardest. If you fill that form in, two things are sent to our email provider: the
            address you typed, and the code from your result link. The code is what makes the
            emails about <em>your</em> result rather than a generic one. Nothing else is sent, and
            if you fill in neither form, nothing leaves your browser at all.
          </p>
          <p>
            This page used to say there was no email list. There is one now; saying otherwise
            while running one would be the same kind of dishonesty the rest of this page exists to
            rule out.
          </p>
        </div>
      </section>
        </Fragment>
      )}

      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">Page views</p>
          <h2 class="pnl-title">Counted, cookieless, never joined up.</h2>
        </div>
        <div class="doc">
          <p>
            Page views are counted in aggregate, through Vercel's web analytics. It is cookieless:
            nothing is stored on your device, and you are not followed from one site to another.
            Your answers are never sent to it, and no account, address or identity is attached to
            a view. What it records is which page was opened. A result page's address contains
            your result code, so the code is stripped before the view is counted: a result view is
            recorded as the quiz's result path and nothing more. A comparison link carries two
            codes and is treated the same way, so a pair of results is never recorded together
            either. Nothing is joined up to a person.
          </p>
        </div>
      </section>
    </div>

    <SectionHead id="the-game" title="The game" kicker="What Sounds Like Scripture keeps, and where its lines come from" />

    <div class="stack stack--2">
      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">{ACCOUNTS_READY ? 'On your device' : 'On your device, nowhere else'}</p>
          <h2 class="pnl-title">Four things in local storage.</h2>
        </div>
        <div class="doc">
          <p>
            <a href="/play/sounds-like-scripture/">Sounds Like Scripture</a> is scored in your browser
            like everything else here. To avoid showing you the same line twice, it keeps four
            things in your browser's own storage{ACCOUNTS_READY ? '' : ', on your device and nowhere else'}: the Bible you
            chose, your best score, which lines you have already seen, and a tally of which
            sources have fooled you. Clearing your browser's site data erases all of it. A
            challenge link carries the run's number, one score and ten answer times, with no name
            attached, and that part of the address is stripped before the page view is counted.
          </p>
        </div>
      </section>

      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">Where the lines come from</p>
          <h2 class="pnl-title">Quoted word for word.</h2>
        </div>
        <div class="doc">
          <p>
            No line in the game was written or reworded by us or by a machine. Each one is quoted
            word for word from a public-domain edition, the citation is shown after every answer
            with a link to the source text, and a script checks every line against its source
            file before the game is built. Three things are evened out for display only, so none
            of them gives a line away: LORD and GOD, which the King James Version and the World
            English Bible print in small capitals, are shown as Lord and God; pronouns for God,
            Jesus and the Holy Spirit are capitalised on every line, whatever the source printed;
            and quotation marks are shown in one style. Whether a book counts as part of the Bible follows the canon you choose:
            Protestant, Catholic or Orthodox. If a citation is wrong, tell us.
          </p>
        </div>
      </section>

      <section class="pnl">
        <div class="pnl-head">
          <p class="pnl-kicker">Who Said It?</p>
          <h2 class="pnl-title">The labels are not ours.</h2>
        </div>
        <div class="doc">
          <p>
            <a href="/play/who-said-it/">Who Said It?</a> follows the same word-for-word rule: every
            line is quoted straight from a public-domain edition of the sixty-six books, never written or reworded by us
            or by a machine. Who spoke is not our judgement either. It is taken from Glyssen's
            character data, published by SIL and Faith Comes By Hearing under the MIT licence, and
            a line is used only where that data names one speaker for the verse. Those labels are
            other people's scholarship, so one of them can be wrong: if you think a line is put in
            the wrong mouth, <a
              href="https://github.com/sunjolol/wiser-walk/issues/new?title=Correction%3A%20Who%20Said%20It%3F"
              rel="noopener">tell us</a> with the reference and we will look. Like its sibling, the
            game keeps three things in your browser's own storage{ACCOUNTS_READY ? '' : ' and nowhere else'}: your best
            score, which lines you have already seen, and the tally of which pairs of speakers you
            mix up.
          </p>
        </div>
      </section>
    </div>

    <CorrectionNote subject="Method page" />
  </div>
</Base>
